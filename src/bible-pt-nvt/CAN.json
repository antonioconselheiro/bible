{"chapters":[{"chapter":1,"verses":[{"verse":{"start":1,"end":1},"text":"Este é o cântico dos cânticos de Salomão."},{"verse":{"start":0,"end":0},"text":"A Amada"},{"verse":{"start":2,"end":2},"text":"Beije-me, beije-me mais uma vez,"},{"verse":{"start":0,"end":0},"text":"pois seu amor é mais doce que o vinho."},{"verse":{"start":3,"end":3},"text":"Como é agradável seu perfume;"},{"verse":{"start":0,"end":0},"text":"seu nome é como a fragrância que se espalha."},{"verse":{"start":0,"end":0},"text":"Não é de admirar que todas as moças o amem!"},{"verse":{"start":4,"end":4},"text":"Leve-me com você; venha, vamos depressa!"},{"verse":{"start":0,"end":0},"text":"O rei me trouxe ao quarto dele."},{"verse":{"start":0,"end":0},"text":"As mulheres de Jerusalém"},{"verse":{"start":0,"end":0},"text":"Ó rei, estamos alegres e felizes por sua causa!"},{"verse":{"start":0,"end":0},"text":"Celebraremos seu amor mais que o vinho."},{"verse":{"start":0,"end":0},"text":"A Amada"},{"verse":{"start":0,"end":0},"text":"Com razão elas o amam."},{"verse":{"start":5,"end":5},"text":"Sou morena e bela,"},{"verse":{"start":0,"end":0},"text":"ó mulheres de Jerusalém;"},{"verse":{"start":0,"end":0},"text":"morena como as tendas de Quedar,"},{"verse":{"start":0,"end":0},"text":"bela como as cortinas de Salomão."},{"verse":{"start":6,"end":6},"text":"Não me olhem assim porque sou morena;"},{"verse":{"start":0,"end":0},"text":"o sol me escureceu a pele."},{"verse":{"start":0,"end":0},"text":"Meus irmãos se zangaram comigo"},{"verse":{"start":0,"end":0},"text":"e me obrigaram a cuidar de seus vinhedos;"},{"verse":{"start":0,"end":0},"text":"de mim mesma, de minha videira, não pude cuidar."},{"verse":{"start":7,"end":7},"text":"Diga-me, meu amor, aonde levará seu rebanho hoje?"},{"verse":{"start":0,"end":0},"text":"Onde fará suas ovelhas descansarem ao meio-dia?"},{"verse":{"start":0,"end":0},"text":"Por que eu andaria sem rumo, como uma prostituta,"},{"verse":{"start":0,"end":0},"text":"entre seus amigos e os rebanhos deles?"},{"verse":{"start":0,"end":0},"text":"O Amado"},{"verse":{"start":8,"end":8},"text":"Se você não sabe, mais bela de todas as mulheres,"},{"verse":{"start":0,"end":0},"text":"siga a trilha de meu rebanho"},{"verse":{"start":0,"end":0},"text":"e leve seus cabritos para pastar junto às tendas dos pastores."},{"verse":{"start":9,"end":9},"text":"Você é cativante, minha querida,"},{"verse":{"start":0,"end":0},"text":"como uma égua entre os cavalos do faraó."},{"verse":{"start":10,"end":10},"text":"Como são belas suas faces;"},{"verse":{"start":0,"end":0},"text":"seus brincos realçam sua beleza!"},{"verse":{"start":0,"end":0},"text":"Como é lindo seu pescoço,"},{"verse":{"start":0,"end":0},"text":"enfeitado com um colar de joias!"},{"verse":{"start":11,"end":11},"text":"Faremos para você brincos de ouro"},{"verse":{"start":0,"end":0},"text":"com enfeites de prata."},{"verse":{"start":0,"end":0},"text":"A Amada"},{"verse":{"start":12,"end":12},"text":"O rei está deitado em seu sofá,"},{"verse":{"start":0,"end":0},"text":"encantado com a fragrância de meu perfume."},{"verse":{"start":13,"end":13},"text":"Meu amado é como uma delicada bolsa de mirra"},{"verse":{"start":0,"end":0},"text":"que repousa entre meus seios."},{"verse":{"start":14,"end":14},"text":"É como um ramo de flores de hena"},{"verse":{"start":0,"end":0},"text":"dos vinhedos de En-Gedi."},{"verse":{"start":0,"end":0},"text":"O Amado"},{"verse":{"start":15,"end":15},"text":"Como você é linda, minha querida,"},{"verse":{"start":0,"end":0},"text":"como você é linda!"},{"verse":{"start":0,"end":0},"text":"Seus olhos são como pombas."},{"verse":{"start":0,"end":0},"text":"A Amada"},{"verse":{"start":16,"end":16},"text":"Como você é belo, meu amor,"},{"verse":{"start":0,"end":0},"text":"como você é encantador!"},{"verse":{"start":0,"end":0},"text":"A grama macia é nosso leito;"},{"verse":{"start":17,"end":17},"text":"os ramos perfumados do cedro são as vigas de nossa casa,"},{"verse":{"start":0,"end":0},"text":"e os pinheiros aromáticos, os caibros do telhado."}]},{"chapter":2,"verses":[{"verse":{"start":0,"end":0},"text":"A Amada"},{"verse":{"start":1,"end":1},"text":"Eu sou a flor que nasce na planície de Sarom,"},{"verse":{"start":0,"end":0},"text":"o lírio que cresce no vale."},{"verse":{"start":0,"end":0},"text":"O Amado"},{"verse":{"start":2,"end":2},"text":"Como um lírio entre os espinhos,"},{"verse":{"start":0,"end":0},"text":"assim é minha querida entre as moças."},{"verse":{"start":0,"end":0},"text":"A Amada"},{"verse":{"start":3,"end":3},"text":"Como uma macieira entre as árvores do bosque,"},{"verse":{"start":0,"end":0},"text":"assim é meu amado entre os rapazes."},{"verse":{"start":0,"end":0},"text":"À sua sombra agradável eu me sento"},{"verse":{"start":0,"end":0},"text":"e saboreio seus deliciosos frutos."},{"verse":{"start":4,"end":4},"text":"Ele me trouxe ao salão de banquetes;"},{"verse":{"start":0,"end":0},"text":"seu grande amor por mim é evidente."},{"verse":{"start":5,"end":5},"text":"Fortaleçam-me com bolos de passas,"},{"verse":{"start":0,"end":0},"text":"revigorem-me com maçãs,"},{"verse":{"start":0,"end":0},"text":"pois desfaleço de amor."},{"verse":{"start":6,"end":6},"text":"Seu braço esquerdo está sob a minha cabeça,"},{"verse":{"start":0,"end":0},"text":"e o direito me abraça."},{"verse":{"start":7,"end":7},"text":"Prometam, ó mulheres de Jerusalém,"},{"verse":{"start":0,"end":0},"text":"pelas gazelas e corças selvagens,"},{"verse":{"start":0,"end":0},"text":"que não despertarão o amor antes do tempo."},{"verse":{"start":8,"end":8},"text":"Ah, ouço meu amado chegando!"},{"verse":{"start":0,"end":0},"text":"Ele salta sobre os montes,"},{"verse":{"start":0,"end":0},"text":"pula sobre as colinas."},{"verse":{"start":9,"end":9},"text":"Meu amado é como a gazela,"},{"verse":{"start":0,"end":0},"text":"como o jovem cervo."},{"verse":{"start":0,"end":0},"text":"Vejam, lá está ele atrás do muro,"},{"verse":{"start":0,"end":0},"text":"observando pelas janelas,"},{"verse":{"start":0,"end":0},"text":"espiando por entre as grades."},{"verse":{"start":10,"end":10},"text":"Meu amado me disse:"},{"verse":{"start":0,"end":0},"text":"\"Levante-se, minha querida!"},{"verse":{"start":0,"end":0},"text":"Venha comigo, minha bela!"},{"verse":{"start":11,"end":11},"text":"Veja, o inverno acabou,"},{"verse":{"start":0,"end":0},"text":"e as chuvas passaram."},{"verse":{"start":12,"end":12},"text":"As flores estão brotando;"},{"verse":{"start":0,"end":0},"text":"chegou a época das canções,"},{"verse":{"start":0,"end":0},"text":"e o arrulhar das pombas enche o ar."},{"verse":{"start":13,"end":13},"text":"As figueiras começam a dar frutos,"},{"verse":{"start":0,"end":0},"text":"e as videiras perfumadas florescem."},{"verse":{"start":0,"end":0},"text":"Levante-se, minha querida!"},{"verse":{"start":0,"end":0},"text":"Venha comigo, minha bela!\"."},{"verse":{"start":0,"end":0},"text":"O Amado"},{"verse":{"start":14,"end":14},"text":"Minha pomba está escondida entre as pedras,"},{"verse":{"start":0,"end":0},"text":"oculta nas fendas das rochas."},{"verse":{"start":0,"end":0},"text":"Mostre-me seu rosto"},{"verse":{"start":0,"end":0},"text":"e deixe-me ouvir sua voz."},{"verse":{"start":0,"end":0},"text":"Pois sua voz é doce,"},{"verse":{"start":0,"end":0},"text":"e seu rosto é lindo."},{"verse":{"start":0,"end":0},"text":"As mulheres de Jerusalém"},{"verse":{"start":15,"end":15},"text":"Peguem todas as raposas,"},{"verse":{"start":0,"end":0},"text":"as raposinhas,"},{"verse":{"start":0,"end":0},"text":"antes que destruam o vinhedo do amor,"},{"verse":{"start":0,"end":0},"text":"pois as videiras estão em flor!"},{"verse":{"start":0,"end":0},"text":"A Amada"},{"verse":{"start":16,"end":16},"text":"Meu amado é meu, e eu sou dele;"},{"verse":{"start":0,"end":0},"text":"ele pastoreia entre os lírios."},{"verse":{"start":17,"end":17},"text":"Antes que soprem as brisas do amanhecer,"},{"verse":{"start":0,"end":0},"text":"e fujam as sombras da noite,"},{"verse":{"start":0,"end":0},"text":"volte para mim, meu amor, como a gazela,"},{"verse":{"start":0,"end":0},"text":"como o jovem cervo nos montes íngremes."}]},{"chapter":3,"verses":[{"verse":{"start":0,"end":0},"text":"A Amada"},{"verse":{"start":1,"end":1},"text":"Certa noite, na cama, ansiei por meu amado;"},{"verse":{"start":0,"end":0},"text":"ansiei por ele, mas ele não veio."},{"verse":{"start":2,"end":2},"text":"Pensei: \"Vou me levantar e andar pela cidade,"},{"verse":{"start":0,"end":0},"text":"vou procurá-lo em todas as ruas e praças;"},{"verse":{"start":0,"end":0},"text":"sim, vou em busca de meu amado\"."},{"verse":{"start":0,"end":0},"text":"Procurei por toda parte,"},{"verse":{"start":0,"end":0},"text":"mas não o encontrei."},{"verse":{"start":3,"end":3},"text":"Os guardas me pararam enquanto faziam a ronda,"},{"verse":{"start":0,"end":0},"text":"e eu lhes perguntei: \"Vocês viram meu amado?\"."},{"verse":{"start":4,"end":4},"text":"Pouco depois de me afastar deles,"},{"verse":{"start":0,"end":0},"text":"encontrei meu amado!"},{"verse":{"start":0,"end":0},"text":"Segurei-o e abracei-o com força;"},{"verse":{"start":0,"end":0},"text":"levei-o à casa de minha mãe,"},{"verse":{"start":0,"end":0},"text":"à cama onde fui concebida."},{"verse":{"start":5,"end":5},"text":"Prometam, ó mulheres de Jerusalém,"},{"verse":{"start":0,"end":0},"text":"pelas gazelas e corças selvagens,"},{"verse":{"start":0,"end":0},"text":"que não despertarão o amor antes do tempo."},{"verse":{"start":0,"end":0},"text":"As mulheres de Jerusalém"},{"verse":{"start":6,"end":6},"text":"O que é isso que vem subindo do deserto,"},{"verse":{"start":0,"end":0},"text":"como nuvem de fumaça?"},{"verse":{"start":0,"end":0},"text":"De onde vem esse perfume de mirra e incenso,"},{"verse":{"start":0,"end":0},"text":"o aroma de todo tipo de especiaria?"},{"verse":{"start":7,"end":7},"text":"Vejam, é a liteira de Salomão,"},{"verse":{"start":0,"end":0},"text":"cercada por sessenta homens valentes,"},{"verse":{"start":0,"end":0},"text":"os melhores soldados de Israel!"},{"verse":{"start":8,"end":8},"text":"São todos habilidosos com a espada,"},{"verse":{"start":0,"end":0},"text":"guerreiros experientes."},{"verse":{"start":0,"end":0},"text":"Cada um traz sua espada,"},{"verse":{"start":0,"end":0},"text":"pronto para defender o rei dos perigos da noite."},{"verse":{"start":9,"end":9},"text":"A liteira do rei Salomão é feita"},{"verse":{"start":0,"end":0},"text":"de madeira importada do Líbano."},{"verse":{"start":10,"end":10},"text":"As colunas são de prata,"},{"verse":{"start":0,"end":0},"text":"a cobertura é de ouro,"},{"verse":{"start":0,"end":0},"text":"as almofadas são de tecido púrpura."},{"verse":{"start":0,"end":0},"text":"Foi enfeitada com carinho"},{"verse":{"start":0,"end":0},"text":"pelas mulheres de Jerusalém."},{"verse":{"start":0,"end":0},"text":"A Amada"},{"verse":{"start":11,"end":11},"text":"Mulheres de Sião,"},{"verse":{"start":0,"end":0},"text":"venham ver o rei Salomão!"},{"verse":{"start":0,"end":0},"text":"Ele usa a coroa que sua mãe lhe deu no dia em que ele se casou,"},{"verse":{"start":0,"end":0},"text":"no dia mais feliz de sua vida."}]},{"chapter":4,"verses":[{"verse":{"start":0,"end":0},"text":"O Amado"},{"verse":{"start":1,"end":1},"text":"Você é linda, minha querida,"},{"verse":{"start":0,"end":0},"text":"como você é linda!"},{"verse":{"start":0,"end":0},"text":"Seus olhos por trás do véu"},{"verse":{"start":0,"end":0},"text":"são como pombas."},{"verse":{"start":0,"end":0},"text":"Seu cabelo é como um rebanho de cabras"},{"verse":{"start":0,"end":0},"text":"que desce pelas encostas de Gileade."},{"verse":{"start":2,"end":2},"text":"Seus dentes são brancos como ovelhas"},{"verse":{"start":0,"end":0},"text":"recém-tosquiadas e lavadas."},{"verse":{"start":0,"end":0},"text":"Seu sorriso é perfeito;"},{"verse":{"start":0,"end":0},"text":"cada dente tem seu par ideal."},{"verse":{"start":3,"end":3},"text":"Seus lábios são como uma fita vermelha;"},{"verse":{"start":0,"end":0},"text":"sua boca é linda."},{"verse":{"start":0,"end":0},"text":"Suas faces por trás do véu"},{"verse":{"start":0,"end":0},"text":"são rosadas como romãs."},{"verse":{"start":4,"end":4},"text":"Seu pescoço é belo, como a torre de Davi,"},{"verse":{"start":0,"end":0},"text":"enfeitada com escudos de mil guerreiros valentes."},{"verse":{"start":5,"end":5},"text":"Seus dois seios são como duas crias de gazela,"},{"verse":{"start":0,"end":0},"text":"filhotes gêmeos que se alimentam entre os lírios."},{"verse":{"start":6,"end":6},"text":"Antes que soprem as brisas do amanhecer,"},{"verse":{"start":0,"end":0},"text":"e fujam as sombras da noite,"},{"verse":{"start":0,"end":0},"text":"irei ao monte de mirra"},{"verse":{"start":0,"end":0},"text":"e à colina de incenso."},{"verse":{"start":7,"end":7},"text":"Você é inteiramente linda, minha querida;"},{"verse":{"start":0,"end":0},"text":"não há em você defeito algum!"},{"verse":{"start":8,"end":8},"text":"Venha comigo do Líbano, minha noiva,"},{"verse":{"start":0,"end":0},"text":"venha comigo do Líbano."},{"verse":{"start":0,"end":0},"text":"Desça do monte Amana,"},{"verse":{"start":0,"end":0},"text":"dos cumes do Senir e do Hermom,"},{"verse":{"start":0,"end":0},"text":"onde os leões têm suas tocas"},{"verse":{"start":0,"end":0},"text":"e os leopardos vivem nas montanhas."},{"verse":{"start":9,"end":9},"text":"Você conquistou meu coração,"},{"verse":{"start":0,"end":0},"text":"minha amiga, minha noiva."},{"verse":{"start":0,"end":0},"text":"Você o cativou com um só olhar de relance,"},{"verse":{"start":0,"end":0},"text":"com um só enfeite de seu colar."},{"verse":{"start":10,"end":10},"text":"Seu amor é delicioso,"},{"verse":{"start":0,"end":0},"text":"minha amiga, minha noiva."},{"verse":{"start":0,"end":0},"text":"Seu amor é melhor que vinho;"},{"verse":{"start":0,"end":0},"text":"seu perfume é mais agradável que especiarias."},{"verse":{"start":11,"end":11},"text":"Seus lábios são doces como néctar, minha noiva;"},{"verse":{"start":0,"end":0},"text":"debaixo de sua língua há mel e leite."},{"verse":{"start":0,"end":0},"text":"Seus vestidos são perfumados"},{"verse":{"start":0,"end":0},"text":"como os cedros do Líbano."},{"verse":{"start":12,"end":12},"text":"Você é meu jardim particular, minha amiga, minha noiva,"},{"verse":{"start":0,"end":0},"text":"nascente fechada, fonte escondida."},{"verse":{"start":13,"end":13},"text":"Seus renovos guardam um paraíso de romãs"},{"verse":{"start":0,"end":0},"text":"com especiarias raras:"},{"verse":{"start":0,"end":0},"text":"hena e nardo,"},{"verse":{"start":14,"end":14},"text":"nardo e açafrão,"},{"verse":{"start":0,"end":0},"text":"cálamo perfumado e canela,"},{"verse":{"start":0,"end":0},"text":"com todas as árvores de incenso, com mirra, aloés"},{"verse":{"start":0,"end":0},"text":"e todas as outras especiarias finas."},{"verse":{"start":15,"end":15},"text":"Você é uma fonte de jardim,"},{"verse":{"start":0,"end":0},"text":"um poço de água fresca"},{"verse":{"start":0,"end":0},"text":"que desce dos montes do Líbano."},{"verse":{"start":0,"end":0},"text":"A Amada"},{"verse":{"start":16,"end":16},"text":"Desperte, vento norte!"},{"verse":{"start":0,"end":0},"text":"Levante-se, vento sul!"},{"verse":{"start":0,"end":0},"text":"Soprem em meu jardim"},{"verse":{"start":0,"end":0},"text":"e espalhem sua fragrância por toda parte."},{"verse":{"start":0,"end":0},"text":"Entre em seu jardim, meu amor,"},{"verse":{"start":0,"end":0},"text":"e saboreie seus melhores frutos."}]},{"chapter":5,"verses":[{"verse":{"start":0,"end":0},"text":"O Amado"},{"verse":{"start":1,"end":1},"text":"Entrei em meu jardim, minha amiga, minha noiva!"},{"verse":{"start":0,"end":0},"text":"Recolhi mirra com minhas especiarias,"},{"verse":{"start":0,"end":0},"text":"comi meu favo com mel,"},{"verse":{"start":0,"end":0},"text":"bebi meu vinho com leite."},{"verse":{"start":0,"end":0},"text":"As mulheres de Jerusalém"},{"verse":{"start":0,"end":0},"text":"Comam e bebam, amado e amada!"},{"verse":{"start":0,"end":0},"text":"Sim, bebam de seu amor quanto puderem!"},{"verse":{"start":0,"end":0},"text":"A Amada"},{"verse":{"start":2,"end":2},"text":"Eu dormia, mas meu coração estava desperto,"},{"verse":{"start":0,"end":0},"text":"quando ouvi meu amado bater à porta e chamar:"},{"verse":{"start":0,"end":0},"text":"\"Abra a porta para mim, minha amiga, minha querida,"},{"verse":{"start":0,"end":0},"text":"minha pomba, minha perfeita."},{"verse":{"start":0,"end":0},"text":"Minha cabeça está molhada de orvalho,"},{"verse":{"start":0,"end":0},"text":"e meu cabelo, úmido do sereno da noite\"."},{"verse":{"start":3,"end":3},"text":"Eu respondi:"},{"verse":{"start":0,"end":0},"text":"\"Já tirei a túnica;"},{"verse":{"start":0,"end":0},"text":"vou ter de me vestir de novo?"},{"verse":{"start":0,"end":0},"text":"Já lavei os pés;"},{"verse":{"start":0,"end":0},"text":"vou ter de sujá-los?\"."},{"verse":{"start":4,"end":4},"text":"Meu amado tentou destrancar a porta,"},{"verse":{"start":0,"end":0},"text":"e meu coração se agitou."},{"verse":{"start":5,"end":5},"text":"Levantei-me de um salto para abrir a porta ao meu amor."},{"verse":{"start":0,"end":0},"text":"Minhas mãos destilavam perfume"},{"verse":{"start":0,"end":0},"text":"e de meus dedos pingava mirra,"},{"verse":{"start":0,"end":0},"text":"quando puxei o ferrolho."},{"verse":{"start":6,"end":6},"text":"Abri para meu amado,"},{"verse":{"start":0,"end":0},"text":"mas ele já havia partido!"},{"verse":{"start":0,"end":0},"text":"Meu coração quase parou de tristeza."},{"verse":{"start":0,"end":0},"text":"Procurei por ele,"},{"verse":{"start":0,"end":0},"text":"mas não o encontrei."},{"verse":{"start":0,"end":0},"text":"Chamei por ele,"},{"verse":{"start":0,"end":0},"text":"mas ele não respondeu."},{"verse":{"start":7,"end":7},"text":"Os guardas me encontraram"},{"verse":{"start":0,"end":0},"text":"enquanto faziam a ronda."},{"verse":{"start":0,"end":0},"text":"Bateram-me e feriram-me,"},{"verse":{"start":0,"end":0},"text":"arrancaram-me o manto,"},{"verse":{"start":0,"end":0},"text":"aqueles guardas dos muros."},{"verse":{"start":8,"end":8},"text":"Prometam, ó mulheres de Jerusalém:"},{"verse":{"start":0,"end":0},"text":"Se encontrarem meu amado,"},{"verse":{"start":0,"end":0},"text":"digam-lhe que desfaleço de amor."},{"verse":{"start":0,"end":0},"text":"As mulheres de Jerusalém"},{"verse":{"start":9,"end":9},"text":"Diga-nos, mulher de beleza incomparável:"},{"verse":{"start":0,"end":0},"text":"Por que seu amado é melhor que todos os outros?"},{"verse":{"start":0,"end":0},"text":"O que ele tem de tão especial"},{"verse":{"start":0,"end":0},"text":"para fazermos a você essa promessa?"},{"verse":{"start":0,"end":0},"text":"A Amada"},{"verse":{"start":10,"end":10},"text":"Meu amado é moreno e fascinante;"},{"verse":{"start":0,"end":0},"text":"ele se destaca no meio da multidão!"},{"verse":{"start":11,"end":11},"text":"Sua cabeça é como o ouro puro,"},{"verse":{"start":0,"end":0},"text":"seu cabelo ondulado, preto como o corvo."},{"verse":{"start":12,"end":12},"text":"Seus olhos são como pombas"},{"verse":{"start":0,"end":0},"text":"junto aos riachos,"},{"verse":{"start":0,"end":0},"text":"incrustados como joias"},{"verse":{"start":0,"end":0},"text":"lavadas em leite."},{"verse":{"start":13,"end":13},"text":"Suas faces são como jardins de especiarias"},{"verse":{"start":0,"end":0},"text":"que espalham sua fragrância."},{"verse":{"start":0,"end":0},"text":"Seus lábios são como lírios"},{"verse":{"start":0,"end":0},"text":"perfumados com mirra."},{"verse":{"start":14,"end":14},"text":"Seus braços são como barras redondas de ouro,"},{"verse":{"start":0,"end":0},"text":"enfeitadas com berilo."},{"verse":{"start":0,"end":0},"text":"Seu ventre é como marfim polido,"},{"verse":{"start":0,"end":0},"text":"que resplandece com safiras."},{"verse":{"start":15,"end":15},"text":"Suas pernas são como colunas de mármore"},{"verse":{"start":0,"end":0},"text":"apoiadas em bases de ouro puro."},{"verse":{"start":0,"end":0},"text":"Seu porte é majestoso,"},{"verse":{"start":0,"end":0},"text":"como o dos cedros do Líbano."},{"verse":{"start":16,"end":16},"text":"Sua voz é a própria doçura;"},{"verse":{"start":0,"end":0},"text":"ele é desejável em todos os sentidos."},{"verse":{"start":0,"end":0},"text":"Esse, ó mulheres de Jerusalém,"},{"verse":{"start":0,"end":0},"text":"é meu amado, meu amigo."}]},{"chapter":6,"verses":[{"verse":{"start":0,"end":0},"text":"As mulheres de Jerusalém"},{"verse":{"start":1,"end":1},"text":"Para onde foi seu amado,"},{"verse":{"start":0,"end":0},"text":"ó mulher de beleza incomparável?"},{"verse":{"start":0,"end":0},"text":"Diga-nos que caminho ele tomou,"},{"verse":{"start":0,"end":0},"text":"e a ajudaremos a encontrá-lo."},{"verse":{"start":0,"end":0},"text":"A Amada"},{"verse":{"start":2,"end":2},"text":"Meu amado desceu a seu jardim,"},{"verse":{"start":0,"end":0},"text":"aos canteiros de especiarias,"},{"verse":{"start":0,"end":0},"text":"para pastorear nos jardins"},{"verse":{"start":0,"end":0},"text":"e para colher lírios."},{"verse":{"start":3,"end":3},"text":"Eu sou de meu amado, e meu amado é meu;"},{"verse":{"start":0,"end":0},"text":"ele pastoreia entre os lírios."},{"verse":{"start":0,"end":0},"text":"O Amado"},{"verse":{"start":4,"end":4},"text":"Você é linda, minha querida,"},{"verse":{"start":0,"end":0},"text":"como a bela cidade de Tirza."},{"verse":{"start":0,"end":0},"text":"Sim, é linda como Jerusalém,"},{"verse":{"start":0,"end":0},"text":"majestosa como um exército com bandeiras ao vento."},{"verse":{"start":5,"end":5},"text":"Desvie de mim seus olhos,"},{"verse":{"start":0,"end":0},"text":"pois eles me dominam."},{"verse":{"start":0,"end":0},"text":"Seu cabelo é como um rebanho de cabras"},{"verse":{"start":0,"end":0},"text":"que desce pelas encostas de Gileade."},{"verse":{"start":6,"end":6},"text":"Seus dentes são brancos como ovelhas"},{"verse":{"start":0,"end":0},"text":"recém-lavadas."},{"verse":{"start":0,"end":0},"text":"Seu sorriso é perfeito;"},{"verse":{"start":0,"end":0},"text":"cada dente tem seu par ideal."},{"verse":{"start":7,"end":7},"text":"Suas faces por trás do véu"},{"verse":{"start":0,"end":0},"text":"são rosadas como romãs."},{"verse":{"start":8,"end":8},"text":"Mesmo entre sessenta rainhas,"},{"verse":{"start":0,"end":0},"text":"oitenta concubinas"},{"verse":{"start":0,"end":0},"text":"e incontáveis moças,"},{"verse":{"start":9,"end":9},"text":"eu ainda escolheria minha pomba, minha perfeita,"},{"verse":{"start":0,"end":0},"text":"a predileta de sua mãe,"},{"verse":{"start":0,"end":0},"text":"muito amada por aquela que a deu à luz."},{"verse":{"start":0,"end":0},"text":"As moças a veem e dizem que ela é feliz;"},{"verse":{"start":0,"end":0},"text":"até mesmo as rainhas e as concubinas do rei a elogiam:"},{"verse":{"start":10,"end":10},"text":"\"Quem é essa que se levanta como o amanhecer,"},{"verse":{"start":0,"end":0},"text":"bela como a lua,"},{"verse":{"start":0,"end":0},"text":"brilhante como o sol,"},{"verse":{"start":0,"end":0},"text":"majestosa como um exército com bandeiras ao vento?\"."},{"verse":{"start":0,"end":0},"text":"A Amada"},{"verse":{"start":11,"end":11},"text":"Desci ao bosque das nogueiras"},{"verse":{"start":0,"end":0},"text":"e fui ao vale ver as novas plantas,"},{"verse":{"start":0,"end":0},"text":"ver se as videiras tinham brotado"},{"verse":{"start":0,"end":0},"text":"e se as romãs tinham florescido."},{"verse":{"start":12,"end":12},"text":"Antes que eu me desse conta,"},{"verse":{"start":0,"end":0},"text":"meu desejo me levou à carruagem de um nobre."},{"verse":{"start":0,"end":0},"text":"As mulheres de Jerusalém"},{"verse":{"start":13,"end":13},"text":"Volte, volte para junto de nós, sulamita!"},{"verse":{"start":0,"end":0},"text":"Volte, volte para que a vejamos outra vez!"},{"verse":{"start":0,"end":0},"text":"O Amado"},{"verse":{"start":0,"end":0},"text":"Por que vocês olham para a sulamita"},{"verse":{"start":0,"end":0},"text":"enquanto ela se move com tanta graça entre duas fileiras de dançarinas?"}]},{"chapter":7,"verses":[{"verse":{"start":1,"end":1},"text":"Como são lindos seus pés calçados com sandálias,"},{"verse":{"start":0,"end":0},"text":"moça com porte de princesa!"},{"verse":{"start":0,"end":0},"text":"As curvas de seus quadris são como joias,"},{"verse":{"start":0,"end":0},"text":"trabalho de artífice habilidoso."},{"verse":{"start":2,"end":2},"text":"Seu umbigo tem forma perfeita,"},{"verse":{"start":0,"end":0},"text":"como taça cheia de vinho de boa mistura."},{"verse":{"start":0,"end":0},"text":"Sua cintura é como um monte de trigo"},{"verse":{"start":0,"end":0},"text":"cercado de lírios."},{"verse":{"start":3,"end":3},"text":"Seus dois seios são como duas crias,"},{"verse":{"start":0,"end":0},"text":"como filhotes gêmeos da gazela."},{"verse":{"start":4,"end":4},"text":"Seu pescoço é gracioso"},{"verse":{"start":0,"end":0},"text":"como uma torre de marfim."},{"verse":{"start":0,"end":0},"text":"Seus olhos são como os açudes cristalinos de Hesbom,"},{"verse":{"start":0,"end":0},"text":"junto à porta de Bete-Rabim."},{"verse":{"start":0,"end":0},"text":"Seu nariz é belo como a torre do Líbano,"},{"verse":{"start":0,"end":0},"text":"de onde se avista Damasco."},{"verse":{"start":5,"end":5},"text":"Sua cabeça é majestosa como o monte Carmelo,"},{"verse":{"start":0,"end":0},"text":"e o brilho de seu cabelo irradia nobreza;"},{"verse":{"start":0,"end":0},"text":"o rei é prisioneiro de suas tranças."},{"verse":{"start":6,"end":6},"text":"Como você é linda!"},{"verse":{"start":0,"end":0},"text":"Como você é agradável, meu amor,"},{"verse":{"start":0,"end":0},"text":"e cheia de delícias!"},{"verse":{"start":7,"end":7},"text":"É esbelta como uma palmeira,"},{"verse":{"start":0,"end":0},"text":"e seus seios são como os cachos de frutos."},{"verse":{"start":8,"end":8},"text":"Eu disse: \"Subirei a palmeira"},{"verse":{"start":0,"end":0},"text":"e me apossarei de seus frutos\"."},{"verse":{"start":0,"end":0},"text":"Que seus seios sejam como cachos de uva,"},{"verse":{"start":0,"end":0},"text":"e que o aroma de sua respiração tenha o perfume das maçãs."},{"verse":{"start":9,"end":9},"text":"Que seus beijos sejam como o melhor vinho."},{"verse":{"start":0,"end":0},"text":"A Amada"},{"verse":{"start":0,"end":0},"text":"Sim, vinho que escorre para meu amado,"},{"verse":{"start":0,"end":0},"text":"que flui suave por lábios e dentes."},{"verse":{"start":10,"end":10},"text":"Eu sou de meu amado,"},{"verse":{"start":0,"end":0},"text":"e ele me deseja."},{"verse":{"start":11,"end":11},"text":"Venha, meu amor, vamos aos campos,"},{"verse":{"start":0,"end":0},"text":"passar a noite entre as flores silvestres."},{"verse":{"start":12,"end":12},"text":"Vamos levantar cedo para ir aos vinhedos"},{"verse":{"start":0,"end":0},"text":"ver se as videiras brotaram,"},{"verse":{"start":0,"end":0},"text":"se as flores abriram"},{"verse":{"start":0,"end":0},"text":"e se as romãs já estão em flor;"},{"verse":{"start":0,"end":0},"text":"ali eu lhe darei meu amor."},{"verse":{"start":13,"end":13},"text":"Ali as mandrágoras espalham sua fragrância,"},{"verse":{"start":0,"end":0},"text":"e os melhores frutos estão à nossa porta,"},{"verse":{"start":0,"end":0},"text":"delícias novas e antigas,"},{"verse":{"start":0,"end":0},"text":"que guardei para você, meu amado."}]},{"chapter":8,"verses":[{"verse":{"start":0,"end":0},"text":"A Amada"},{"verse":{"start":1,"end":1},"text":"Quem dera você fosse meu irmão,"},{"verse":{"start":0,"end":0},"text":"amamentado nos seios de minha mãe."},{"verse":{"start":0,"end":0},"text":"Então eu poderia beijá-lo publicamente,"},{"verse":{"start":0,"end":0},"text":"e ninguém me criticaria."},{"verse":{"start":2,"end":2},"text":"Eu o levaria ao lar de minha infância,"},{"verse":{"start":0,"end":0},"text":"e ali você me ensinaria."},{"verse":{"start":0,"end":0},"text":"Eu lhe daria de beber vinho com especiarias,"},{"verse":{"start":0,"end":0},"text":"o néctar de minhas romãs."},{"verse":{"start":3,"end":3},"text":"Seu braço esquerdo estaria sob a minha cabeça,"},{"verse":{"start":0,"end":0},"text":"e o direito me abraçaria."},{"verse":{"start":4,"end":4},"text":"Prometam, ó mulheres de Jerusalém,"},{"verse":{"start":0,"end":0},"text":"que não despertarão o amor antes do tempo."},{"verse":{"start":0,"end":0},"text":"As mulheres de Jerusalém"},{"verse":{"start":5,"end":5},"text":"Quem é essa que vem subindo do deserto,"},{"verse":{"start":0,"end":0},"text":"apoiada em seu amado?"},{"verse":{"start":0,"end":0},"text":"A Amada"},{"verse":{"start":0,"end":0},"text":"Despertei você debaixo da macieira,"},{"verse":{"start":0,"end":0},"text":"onde sua mãe o deu à luz,"},{"verse":{"start":0,"end":0},"text":"onde, com muitas dores, ela o trouxe ao mundo."},{"verse":{"start":6,"end":6},"text":"Coloque-me como selo sobre seu coração,"},{"verse":{"start":0,"end":0},"text":"como selo sobre seu braço."},{"verse":{"start":0,"end":0},"text":"Pois o amor é forte como a morte,"},{"verse":{"start":0,"end":0},"text":"e o ciúme, exigente como a sepultura."},{"verse":{"start":0,"end":0},"text":"O amor arde como fogo,"},{"verse":{"start":0,"end":0},"text":"como as labaredas mais intensas."},{"verse":{"start":7,"end":7},"text":"As muitas águas não podem apagar o amor,"},{"verse":{"start":0,"end":0},"text":"nem os rios podem afogá-lo."},{"verse":{"start":0,"end":0},"text":"Se algum homem tentasse usar todas as suas riquezas"},{"verse":{"start":0,"end":0},"text":"para comprar o amor,"},{"verse":{"start":0,"end":0},"text":"sua oferta seria por completo desprezada."},{"verse":{"start":0,"end":0},"text":"Os irmãos da Amada"},{"verse":{"start":8,"end":8},"text":"Temos uma irmãzinha,"},{"verse":{"start":0,"end":0},"text":"que ainda é jovem demais para ter seios."},{"verse":{"start":0,"end":0},"text":"O que faremos por nossa irmã,"},{"verse":{"start":0,"end":0},"text":"se alguém a pedir em casamento?"},{"verse":{"start":9,"end":9},"text":"Se ela for um muro,"},{"verse":{"start":0,"end":0},"text":"nós a protegeremos com uma torre de prata."},{"verse":{"start":0,"end":0},"text":"Se ela for uma porta,"},{"verse":{"start":0,"end":0},"text":"nós a fecharemos com uma tranca de cedro."},{"verse":{"start":0,"end":0},"text":"A Amada"},{"verse":{"start":10,"end":10},"text":"Eu sou um muro,"},{"verse":{"start":0,"end":0},"text":"e meus seios são suas torres."},{"verse":{"start":0,"end":0},"text":"Quando meu amado olha para mim,"},{"verse":{"start":0,"end":0},"text":"ele se agrada do que vê."},{"verse":{"start":11,"end":11},"text":"Salomão tem um vinhedo em Baal-Hamom,"},{"verse":{"start":0,"end":0},"text":"que ele arrenda para lavradores."},{"verse":{"start":0,"end":0},"text":"Cada um lhe paga mil peças de prata"},{"verse":{"start":0,"end":0},"text":"para colher os frutos."},{"verse":{"start":12,"end":12},"text":"Quanto a meu vinhedo, faço dele o que quero,"},{"verse":{"start":0,"end":0},"text":"e Salomão não precisa pagar mil peças de prata."},{"verse":{"start":0,"end":0},"text":"Darei, contudo, duzentas peças"},{"verse":{"start":0,"end":0},"text":"aos que cuidam de seus frutos."},{"verse":{"start":0,"end":0},"text":"O Amado"},{"verse":{"start":13,"end":13},"text":"Minha querida, que mora nos jardins,"},{"verse":{"start":0,"end":0},"text":"seus companheiros ouvem atentamente sua voz;"},{"verse":{"start":0,"end":0},"text":"deixe-me ouvi-la também!"},{"verse":{"start":0,"end":0},"text":"A Amada"},{"verse":{"start":14,"end":14},"text":"Venha correndo, meu amado! Seja como a gazela,"},{"verse":{"start":0,"end":0},"text":"como o jovem cervo sobre os montes de especiarias."}]}]}