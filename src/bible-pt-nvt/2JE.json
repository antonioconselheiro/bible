{"chapters":[{"chapter":1,"verses":[{"verse":{"start":0,"end":0},"text":"Grande tristeza em Jerusalém"},{"verse":{"start":1,"end":1},"text":"A cidade que antes era cheia de gente"},{"verse":{"start":0,"end":0},"text":"agora está deserta."},{"verse":{"start":0,"end":0},"text":"Antes era grande entre as nações,"},{"verse":{"start":0,"end":0},"text":"agora está sozinha, como uma viúva."},{"verse":{"start":0,"end":0},"text":"Antes era rainha de toda a terra,"},{"verse":{"start":0,"end":0},"text":"agora é escrava."},{"verse":{"start":2,"end":2},"text":"Ela passa a noite aos prantos;"},{"verse":{"start":0,"end":0},"text":"lágrimas correm por seu rosto."},{"verse":{"start":0,"end":0},"text":"De todos os seus amantes,"},{"verse":{"start":0,"end":0},"text":"não resta um sequer para consolá-la."},{"verse":{"start":0,"end":0},"text":"Todos os seus amigos a traíram"},{"verse":{"start":0,"end":0},"text":"e se tornaram seus inimigos."},{"verse":{"start":3,"end":3},"text":"Judá foi levada para o exílio"},{"verse":{"start":0,"end":0},"text":"e oprimida com cruel escravidão."},{"verse":{"start":0,"end":0},"text":"Vive entre as nações"},{"verse":{"start":0,"end":0},"text":"e não tem lugar para descansar."},{"verse":{"start":0,"end":0},"text":"Seus inimigos a perseguiram,"},{"verse":{"start":0,"end":0},"text":"e ela não tem a quem recorrer."},{"verse":{"start":4,"end":4},"text":"As estradas para Sião estão de luto,"},{"verse":{"start":0,"end":0},"text":"pois as multidões já não vêm celebrar as festas."},{"verse":{"start":0,"end":0},"text":"Os portões da cidade estão em silêncio,"},{"verse":{"start":0,"end":0},"text":"os sacerdotes gemem,"},{"verse":{"start":0,"end":0},"text":"as moças choram."},{"verse":{"start":0,"end":0},"text":"Como é amargo seu destino!"},{"verse":{"start":5,"end":5},"text":"Seus adversários se tornaram seus senhores,"},{"verse":{"start":0,"end":0},"text":"e seus inimigos prosperam,"},{"verse":{"start":0,"end":0},"text":"pois o"},{"verse":{"start":0,"end":0},"text":"por seus muitos pecados."},{"verse":{"start":0,"end":0},"text":"Seus filhos foram capturados"},{"verse":{"start":0,"end":0},"text":"e levados para o exílio."},{"verse":{"start":6,"end":6},"text":"A bela Sião"},{"verse":{"start":0,"end":0},"text":"foi despojada de toda a sua majestade."},{"verse":{"start":0,"end":0},"text":"Seus príncipes são como cervos famintos"},{"verse":{"start":0,"end":0},"text":"em busca de pasto."},{"verse":{"start":0,"end":0},"text":"Estão fracos demais para fugir"},{"verse":{"start":0,"end":0},"text":"do inimigo que os persegue."},{"verse":{"start":7,"end":7},"text":"Em meio à sua tristeza e às suas andanças,"},{"verse":{"start":0,"end":0},"text":"Jerusalém se lembra de seu antigo esplendor."},{"verse":{"start":0,"end":0},"text":"Agora, porém, caiu nas mãos de seu inimigo,"},{"verse":{"start":0,"end":0},"text":"e não há quem a ajude."},{"verse":{"start":0,"end":0},"text":"Seu inimigo a derrubou"},{"verse":{"start":0,"end":0},"text":"e zombou de sua queda."},{"verse":{"start":8,"end":8},"text":"Jerusalém pecou terrivelmente,"},{"verse":{"start":0,"end":0},"text":"por isso foi jogada fora como trapo imundo."},{"verse":{"start":0,"end":0},"text":"Todos que antes a honravam agora a desprezam,"},{"verse":{"start":0,"end":0},"text":"pois a viram nua e humilhada."},{"verse":{"start":0,"end":0},"text":"Só resta a ela gemer"},{"verse":{"start":0,"end":0},"text":"e esconder o rosto."},{"verse":{"start":9,"end":9},"text":"Com sua impureza, contaminou as vestes"},{"verse":{"start":0,"end":0},"text":"e não pensou nas consequências."},{"verse":{"start":0,"end":0},"text":"Agora está caída no chão,"},{"verse":{"start":0,"end":0},"text":"e não há quem a levante."},{"verse":{"start":0,"end":0},"text":"\""},{"verse":{"start":0,"end":0},"text":"\"O inimigo triunfou.\""},{"verse":{"start":10,"end":10},"text":"O inimigo a saqueou"},{"verse":{"start":0,"end":0},"text":"e levou todos os seus valiosos bens."},{"verse":{"start":0,"end":0},"text":"Ela viu estrangeiros profanarem seu templo sagrado,"},{"verse":{"start":0,"end":0},"text":"o lugar em que o"},{"verse":{"start":11,"end":11},"text":"Seu povo geme, à procura de pão;"},{"verse":{"start":0,"end":0},"text":"trocaram seus tesouros por alimento para sobreviver."},{"verse":{"start":0,"end":0},"text":"\"Olha,"},{"verse":{"start":0,"end":0},"text":"\"e vê como sou desprezada!"},{"verse":{"start":12,"end":12},"text":"\"Isso tudo nada significa para vocês que passam por mim?"},{"verse":{"start":0,"end":0},"text":"Olhem ao redor e vejam se há dor igual à minha,"},{"verse":{"start":0,"end":0},"text":"que o"},{"verse":{"start":0,"end":0},"text":"quando se acendeu sua ira."},{"verse":{"start":13,"end":13},"text":"\"Do céu enviou fogo que me queima os ossos;"},{"verse":{"start":0,"end":0},"text":"pôs uma armadilha em meu caminho e me fez voltar atrás."},{"verse":{"start":0,"end":0},"text":"Deixou-me devastada,"},{"verse":{"start":0,"end":0},"text":"atormentada o dia todo por uma doença."},{"verse":{"start":14,"end":14},"text":"\"Trançou meus pecados como uma corda"},{"verse":{"start":0,"end":0},"text":"para me prender ao jugo do exílio."},{"verse":{"start":0,"end":0},"text":"O Senhor me tirou a força e me entregou a meus inimigos;"},{"verse":{"start":0,"end":0},"text":"estou indefesa nas mãos deles."},{"verse":{"start":15,"end":15},"text":"\"O Senhor tratou meus homens valentes"},{"verse":{"start":0,"end":0},"text":"com desprezo."},{"verse":{"start":0,"end":0},"text":"Por ordem sua, um grande exército veio"},{"verse":{"start":0,"end":0},"text":"para esmagar meus jovens guerreiros."},{"verse":{"start":0,"end":0},"text":"O Senhor pisou a amada cidade de Jerusalém"},{"verse":{"start":0,"end":0},"text":"como se pisam uvas no tanque de prensar."},{"verse":{"start":16,"end":16},"text":"\"Choro por todas essas coisas,"},{"verse":{"start":0,"end":0},"text":"lágrimas correm por meu rosto."},{"verse":{"start":0,"end":0},"text":"Não resta ninguém para me consolar,"},{"verse":{"start":0,"end":0},"text":"estão longe os que poderiam me animar."},{"verse":{"start":0,"end":0},"text":"Meus filhos não têm futuro,"},{"verse":{"start":0,"end":0},"text":"pois o inimigo nos conquistou.\""},{"verse":{"start":17,"end":17},"text":"Sião estende as mãos,"},{"verse":{"start":0,"end":0},"text":"mas ninguém a consola."},{"verse":{"start":0,"end":0},"text":"O"},{"verse":{"start":0,"end":0},"text":"a respeito de seu povo, Israel:"},{"verse":{"start":0,"end":0},"text":"\"Que seus vizinhos sejam seus inimigos!"},{"verse":{"start":0,"end":0},"text":"Que Jerusalém seja jogada fora como trapo imundo!\"."},{"verse":{"start":18,"end":18},"text":"\"O"},{"verse":{"start":0,"end":0},"text":"\"pois me rebelei contra ele."},{"verse":{"start":0,"end":0},"text":"Ouçam todos os povos"},{"verse":{"start":0,"end":0},"text":"e vejam minha angústia,"},{"verse":{"start":0,"end":0},"text":"pois meus filhos e filhas"},{"verse":{"start":0,"end":0},"text":"foram levados para o exílio."},{"verse":{"start":19,"end":19},"text":"\"Pedi ajuda a meus aliados,"},{"verse":{"start":0,"end":0},"text":"mas eles me traíram."},{"verse":{"start":0,"end":0},"text":"Meus sacerdotes e meus líderes"},{"verse":{"start":0,"end":0},"text":"morreram de fome na cidade,"},{"verse":{"start":0,"end":0},"text":"enquanto procuravam alimento"},{"verse":{"start":0,"end":0},"text":"para sobreviver."},{"verse":{"start":20,"end":20},"text":"\""},{"verse":{"start":0,"end":0},"text":"Meu coração está aflito,"},{"verse":{"start":0,"end":0},"text":"e minha alma, desesperada,"},{"verse":{"start":0,"end":0},"text":"pois me rebelei terrivelmente contra ti."},{"verse":{"start":0,"end":0},"text":"Nas ruas, a espada mata,"},{"verse":{"start":0,"end":0},"text":"e, em casa, só há morte."},{"verse":{"start":21,"end":21},"text":"\"Outros ouviram meus gemidos,"},{"verse":{"start":0,"end":0},"text":"mas ninguém veio me consolar."},{"verse":{"start":0,"end":0},"text":"Quando meus inimigos souberam de minha desgraça,"},{"verse":{"start":0,"end":0},"text":"se alegraram de ver o que tu havias feito."},{"verse":{"start":0,"end":0},"text":"Ah, traze o dia que prometeste,"},{"verse":{"start":0,"end":0},"text":"em que eles sofrerão como eu sofri!"},{"verse":{"start":22,"end":22},"text":"\"Vê todas as maldades deles,"},{"verse":{"start":0,"end":0},"text":"e castiga-os"},{"verse":{"start":0,"end":0},"text":"como me castigaste,"},{"verse":{"start":0,"end":0},"text":"por todos os meus pecados."},{"verse":{"start":0,"end":0},"text":"Meus gemidos são muitos,"},{"verse":{"start":0,"end":0},"text":"e meu coração está enfermo.\""}]},{"chapter":2,"verses":[{"verse":{"start":0,"end":0},"text":"A ira de Deus pelo pecado"},{"verse":{"start":1,"end":1},"text":"Em sua ira, o Senhor"},{"verse":{"start":0,"end":0},"text":"cobriu com uma sombra a bela Sião."},{"verse":{"start":0,"end":0},"text":"A mais gloriosa das cidades de Israel"},{"verse":{"start":0,"end":0},"text":"foi lançada por terra das alturas dos céus."},{"verse":{"start":0,"end":0},"text":"No dia de sua grande ira,"},{"verse":{"start":0,"end":0},"text":"o Senhor não teve compaixão nem mesmo de seu templo."},{"verse":{"start":2,"end":2},"text":"Sem piedade, o"},{"verse":{"start":0,"end":0},"text":"todas as casas de Israel."},{"verse":{"start":0,"end":0},"text":"Em sua ira, derrubou"},{"verse":{"start":0,"end":0},"text":"os muros fortificados da bela Jerusalém."},{"verse":{"start":0,"end":0},"text":"Jogou-os por terra"},{"verse":{"start":0,"end":0},"text":"e humilhou o reino e seus governantes."},{"verse":{"start":3,"end":3},"text":"Toda a força de Israel"},{"verse":{"start":0,"end":0},"text":"desapareceu sob a sua ira ardente."},{"verse":{"start":0,"end":0},"text":"Retirou sua proteção"},{"verse":{"start":0,"end":0},"text":"durante os ataques do inimigo."},{"verse":{"start":0,"end":0},"text":"Como labaredas de fogo,"},{"verse":{"start":0,"end":0},"text":"consome tudo ao redor."},{"verse":{"start":4,"end":4},"text":"Prepara o arco para atacar seu povo,"},{"verse":{"start":0,"end":0},"text":"como se fosse seu inimigo."},{"verse":{"start":0,"end":0},"text":"Usa contra eles sua força"},{"verse":{"start":0,"end":0},"text":"para matar os melhores jovens."},{"verse":{"start":0,"end":0},"text":"Derrama como fogo sua fúria"},{"verse":{"start":0,"end":0},"text":"sobre a tenda da bela Sião."},{"verse":{"start":5,"end":5},"text":"Sim, o Senhor derrotou Israel"},{"verse":{"start":0,"end":0},"text":"como se fosse seu inimigo."},{"verse":{"start":0,"end":0},"text":"Destruiu seus palácios"},{"verse":{"start":0,"end":0},"text":"e demoliu suas fortalezas."},{"verse":{"start":0,"end":0},"text":"Trouxe tristeza e choro sem fim"},{"verse":{"start":0,"end":0},"text":"sobre a bela Jerusalém."},{"verse":{"start":6,"end":6},"text":"Derrubou com violência seu templo,"},{"verse":{"start":0,"end":0},"text":"como uma cabana num jardim."},{"verse":{"start":0,"end":0},"text":"O"},{"verse":{"start":0,"end":0},"text":"as festas sagradas e os sábados."},{"verse":{"start":0,"end":0},"text":"Reis e sacerdotes caíram juntos"},{"verse":{"start":0,"end":0},"text":"diante de sua ira ardente."},{"verse":{"start":7,"end":7},"text":"O Senhor rejeitou seu altar"},{"verse":{"start":0,"end":0},"text":"e desprezou seu santuário."},{"verse":{"start":0,"end":0},"text":"Entregou os palácios de Jerusalém"},{"verse":{"start":0,"end":0},"text":"a seus inimigos."},{"verse":{"start":0,"end":0},"text":"No templo do"},{"verse":{"start":0,"end":0},"text":"como se fosse um dia de celebração."},{"verse":{"start":8,"end":8},"text":"O"},{"verse":{"start":0,"end":0},"text":"a derrubar os muros da bela Sião."},{"verse":{"start":0,"end":0},"text":"Traçou planos detalhados para sua destruição"},{"verse":{"start":0,"end":0},"text":"e fez o que planejou."},{"verse":{"start":0,"end":0},"text":"Por isso as fortificações e os muros"},{"verse":{"start":0,"end":0},"text":"caíram diante dele."},{"verse":{"start":9,"end":9},"text":"Os portões de Jerusalém afundaram na terra;"},{"verse":{"start":0,"end":0},"text":"ele despedaçou suas trancas."},{"verse":{"start":0,"end":0},"text":"Seu rei e seus príncipes foram exilados entre as nações;"},{"verse":{"start":0,"end":0},"text":"sua lei deixou de existir."},{"verse":{"start":0,"end":0},"text":"Seus profetas não recebem mais"},{"verse":{"start":0,"end":0},"text":"visões do"},{"verse":{"start":10,"end":10},"text":"Os líderes da bela Jerusalém"},{"verse":{"start":0,"end":0},"text":"sentam-se no chão em silêncio."},{"verse":{"start":0,"end":0},"text":"Vestem-se de pano de saco"},{"verse":{"start":0,"end":0},"text":"e jogam pó sobre a cabeça."},{"verse":{"start":0,"end":0},"text":"As moças de Jerusalém"},{"verse":{"start":0,"end":0},"text":"abaixam a cabeça, envergonhadas."},{"verse":{"start":11,"end":11},"text":"Chorei até que não tivesse mais lágrimas;"},{"verse":{"start":0,"end":0},"text":"meu coração está aflito."},{"verse":{"start":0,"end":0},"text":"Meu espírito se derrama de angústia,"},{"verse":{"start":0,"end":0},"text":"quando vejo a calamidade de meu povo."},{"verse":{"start":0,"end":0},"text":"Crianças pequenas e bebês"},{"verse":{"start":0,"end":0},"text":"desfalecem e morrem nas ruas."},{"verse":{"start":12,"end":12},"text":"Clamam às mães:"},{"verse":{"start":0,"end":0},"text":"\"Estamos com fome e sede!\"."},{"verse":{"start":0,"end":0},"text":"Desfalecem nas ruas,"},{"verse":{"start":0,"end":0},"text":"como o guerreiro ferido na batalha."},{"verse":{"start":0,"end":0},"text":"Lutam para respirar"},{"verse":{"start":0,"end":0},"text":"e morrem lentamente nos braços maternos."},{"verse":{"start":13,"end":13},"text":"Que posso dizer a seu respeito?"},{"verse":{"start":0,"end":0},"text":"Quem alguma vez viu tamanha tristeza?"},{"verse":{"start":0,"end":0},"text":"Ó filha de Jerusalém, a que posso compará-la em sua angústia?"},{"verse":{"start":0,"end":0},"text":"Ó filha virgem de Sião, como posso consolá-la?"},{"verse":{"start":0,"end":0},"text":"Sua ferida é mais profunda que o mar;"},{"verse":{"start":0,"end":0},"text":"quem pode curá-la?"},{"verse":{"start":14,"end":14},"text":"Seus profetas anunciaram"},{"verse":{"start":0,"end":0},"text":"visões inúteis e mentiras."},{"verse":{"start":0,"end":0},"text":"Não lhe mostraram seus pecados"},{"verse":{"start":0,"end":0},"text":"para salvá-la do exílio."},{"verse":{"start":0,"end":0},"text":"Em vez disso, anunciaram mensagens enganosas"},{"verse":{"start":0,"end":0},"text":"e a encheram de falsa esperança."},{"verse":{"start":15,"end":15},"text":"Todos que passam caçoam de você;"},{"verse":{"start":0,"end":0},"text":"zombam da bela Jerusalém e a insultam:"},{"verse":{"start":0,"end":0},"text":"\"Esta é a cidade chamada de ‘A Mais Bela do Mundo’"},{"verse":{"start":0,"end":0},"text":"e ‘Alegria de Toda a Terra’?\"."},{"verse":{"start":16,"end":16},"text":"Todos os seus inimigos falam mal de você;"},{"verse":{"start":0,"end":0},"text":"zombam, rosnam e dizem:"},{"verse":{"start":0,"end":0},"text":"\"Finalmente a destruímos!"},{"verse":{"start":0,"end":0},"text":"Esperamos tanto por este dia,"},{"verse":{"start":0,"end":0},"text":"e enfim ele chegou!\"."},{"verse":{"start":17,"end":17},"text":"Mas foi o"},{"verse":{"start":0,"end":0},"text":"cumpriu as promessas de trazer calamidade"},{"verse":{"start":0,"end":0},"text":"feitas muito tempo atrás."},{"verse":{"start":0,"end":0},"text":"Destruiu Jerusalém sem compaixão;"},{"verse":{"start":0,"end":0},"text":"fez seus inimigos se alegrarem com sua derrota"},{"verse":{"start":0,"end":0},"text":"e lhes deu poder sobre ela."},{"verse":{"start":18,"end":18},"text":"Chorem em alta voz diante do Senhor,"},{"verse":{"start":0,"end":0},"text":"ó muros da bela Sião!"},{"verse":{"start":0,"end":0},"text":"Que suas lágrimas corram"},{"verse":{"start":0,"end":0},"text":"dia e noite como um rio."},{"verse":{"start":0,"end":0},"text":"Não se permitam descanso algum,"},{"verse":{"start":0,"end":0},"text":"nem deem alívio a seus olhos."},{"verse":{"start":19,"end":19},"text":"Levantem-se no meio da noite e clamem,"},{"verse":{"start":0,"end":0},"text":"derramem como água o coração diante do Senhor."},{"verse":{"start":0,"end":0},"text":"Levantem as mãos em oração"},{"verse":{"start":0,"end":0},"text":"e supliquem por seus filhos,"},{"verse":{"start":0,"end":0},"text":"pois desfalecem de fome"},{"verse":{"start":0,"end":0},"text":"pelas ruas."},{"verse":{"start":20,"end":20},"text":"\"Ó"},{"verse":{"start":0,"end":0},"text":"Acaso deves tratar teu povo dessa maneira?"},{"verse":{"start":0,"end":0},"text":"Devem as mães comer os próprios filhos,"},{"verse":{"start":0,"end":0},"text":"que elas criaram com tanto carinho?"},{"verse":{"start":0,"end":0},"text":"Devem os sacerdotes e os profetas ser mortos"},{"verse":{"start":0,"end":0},"text":"dentro do templo do Senhor?"},{"verse":{"start":21,"end":21},"text":"\"Estão jogados nas ruas,"},{"verse":{"start":0,"end":0},"text":"jovens e velhos,"},{"verse":{"start":0,"end":0},"text":"rapazes e moças,"},{"verse":{"start":0,"end":0},"text":"mortos pelas espadas do inimigo."},{"verse":{"start":0,"end":0},"text":"Tu os mataste em tua ira"},{"verse":{"start":0,"end":0},"text":"e os massacraste sem piedade."},{"verse":{"start":22,"end":22},"text":"\"Convocaste terrores de todos os lados,"},{"verse":{"start":0,"end":0},"text":"como se os chamasses para uma ocasião solene."},{"verse":{"start":0,"end":0},"text":"No dia da ira do"},{"verse":{"start":0,"end":0},"text":"ninguém escapou nem sobreviveu."},{"verse":{"start":0,"end":0},"text":"Os filhos que levei em meus braços e criei"},{"verse":{"start":0,"end":0},"text":"o inimigo destruiu.\""}]},{"chapter":3,"verses":[{"verse":{"start":0,"end":0},"text":"Esperança na fidelidade do"},{"verse":{"start":1,"end":1},"text":"Eu sou aquele que viu as aflições"},{"verse":{"start":0,"end":0},"text":"trazidas pela vara da ira do"},{"verse":{"start":2,"end":2},"text":"Ele me conduziu para a escuridão"},{"verse":{"start":0,"end":0},"text":"e removeu toda a luz."},{"verse":{"start":3,"end":3},"text":"Voltou sua mão contra mim"},{"verse":{"start":0,"end":0},"text":"repetidamente, o dia todo."},{"verse":{"start":4,"end":4},"text":"Fez minha pele e minha carne envelhecerem"},{"verse":{"start":0,"end":0},"text":"e me quebrou os ossos."},{"verse":{"start":5,"end":5},"text":"Sitiou-me e cercou-me"},{"verse":{"start":0,"end":0},"text":"de angústia e aflição."},{"verse":{"start":6,"end":6},"text":"Enterrou-me num lugar escuro,"},{"verse":{"start":0,"end":0},"text":"como os que há muito morreram."},{"verse":{"start":7,"end":7},"text":"Cercou-me de muros, e não consigo escapar;"},{"verse":{"start":0,"end":0},"text":"prendeu-me com pesadas correntes."},{"verse":{"start":8,"end":8},"text":"E, ainda que eu clame e grite,"},{"verse":{"start":0,"end":0},"text":"ele fechou os ouvidos para minha oração."},{"verse":{"start":9,"end":9},"text":"Com um muro de pedra, impediu meu caminho;"},{"verse":{"start":0,"end":0},"text":"tornou minha estrada tortuosa."},{"verse":{"start":10,"end":10},"text":"Escondeu-se como um urso ou um leão"},{"verse":{"start":0,"end":0},"text":"que espera para atacar."},{"verse":{"start":11,"end":11},"text":"Arrastou-me para fora do caminho e despedaçou-me;"},{"verse":{"start":0,"end":0},"text":"deixou-me devastado."},{"verse":{"start":12,"end":12},"text":"Preparou seu arco"},{"verse":{"start":0,"end":0},"text":"e me fez alvo de suas flechas."},{"verse":{"start":13,"end":13},"text":"As flechas que ele atirou"},{"verse":{"start":0,"end":0},"text":"entraram fundo em meu coração."},{"verse":{"start":14,"end":14},"text":"Meu povo ri de mim;"},{"verse":{"start":0,"end":0},"text":"o dia inteiro entoam canções de zombaria."},{"verse":{"start":15,"end":15},"text":"De amargura ele me encheu"},{"verse":{"start":0,"end":0},"text":"e me fez beber um amargo cálice de dor."},{"verse":{"start":16,"end":16},"text":"Fez-me comer pedrinhas até quebrar os dentes"},{"verse":{"start":0,"end":0},"text":"e cobriu-me de pó."},{"verse":{"start":17,"end":17},"text":"Tirou-me a paz,"},{"verse":{"start":0,"end":0},"text":"e já não sei o que é prosperar."},{"verse":{"start":18,"end":18},"text":"Grito: \"Meu esplendor se foi!"},{"verse":{"start":0,"end":0},"text":"Tudo que eu esperava do"},{"verse":{"start":19,"end":19},"text":"Como é amargo recordar meu sofrimento"},{"verse":{"start":0,"end":0},"text":"e meu desamparo!"},{"verse":{"start":20,"end":20},"text":"Lembro-me sempre destes dias terríveis"},{"verse":{"start":0,"end":0},"text":"enquanto lamento minha perda."},{"verse":{"start":21,"end":21},"text":"Ainda ouso, porém, ter esperança"},{"verse":{"start":0,"end":0},"text":"quando me recordo disto:"},{"verse":{"start":22,"end":22},"text":"O amor do"},{"verse":{"start":0,"end":0},"text":"Suas misericórdias são inesgotáveis."},{"verse":{"start":23,"end":23},"text":"Grande é sua fidelidade;"},{"verse":{"start":0,"end":0},"text":"suas misericórdias se renovam cada manhã."},{"verse":{"start":24,"end":24},"text":"Digo a mim mesmo: \"O"},{"verse":{"start":0,"end":0},"text":"por isso, esperarei nele!\"."},{"verse":{"start":25,"end":25},"text":"O"},{"verse":{"start":0,"end":0},"text":"para os que o buscam."},{"verse":{"start":26,"end":26},"text":"Portanto, é bom esperar em silêncio"},{"verse":{"start":0,"end":0},"text":"pela salvação do"},{"verse":{"start":27,"end":27},"text":"É bom as pessoas se sujeitarem, ainda jovens,"},{"verse":{"start":0,"end":0},"text":"ao jugo de sua disciplina."},{"verse":{"start":28,"end":28},"text":"Que permaneçam sozinhas e em silêncio"},{"verse":{"start":0,"end":0},"text":"sob o jugo do"},{"verse":{"start":29,"end":29},"text":"Que se deitem com o rosto no pó,"},{"verse":{"start":0,"end":0},"text":"pois talvez ainda haja esperança."},{"verse":{"start":30,"end":30},"text":"Que deem a outra face para os que os ferem"},{"verse":{"start":0,"end":0},"text":"e aceitem os insultos de seus inimigos."},{"verse":{"start":31,"end":31},"text":"Pois o Senhor"},{"verse":{"start":0,"end":0},"text":"não abandona ninguém para sempre."},{"verse":{"start":32,"end":32},"text":"Embora traga tristeza, também mostra compaixão,"},{"verse":{"start":0,"end":0},"text":"por causa da grandeza de seu amor."},{"verse":{"start":33,"end":33},"text":"Pois não tem prazer em afligir as pessoas,"},{"verse":{"start":0,"end":0},"text":"nem em lhes causar tristeza."},{"verse":{"start":34,"end":34},"text":"Quando alguém esmaga sob os pés"},{"verse":{"start":0,"end":0},"text":"todos os prisioneiros da terra,"},{"verse":{"start":35,"end":35},"text":"quando nega a outros seus direitos"},{"verse":{"start":0,"end":0},"text":"em oposição ao Altíssimo,"},{"verse":{"start":36,"end":36},"text":"quando distorce a justiça nos tribunais,"},{"verse":{"start":0,"end":0},"text":"será que o Senhor não vê tudo isso?"},{"verse":{"start":37,"end":37},"text":"Quem pode ordenar que algo aconteça"},{"verse":{"start":0,"end":0},"text":"sem a permissão do Senhor?"},{"verse":{"start":38,"end":38},"text":"Acaso o Altíssimo"},{"verse":{"start":0,"end":0},"text":"não envia tanto a calamidade como o bem?"},{"verse":{"start":39,"end":39},"text":"Então por que nós, humanos, nos queixamos"},{"verse":{"start":0,"end":0},"text":"quando somos castigados por nossos pecados?"},{"verse":{"start":40,"end":40},"text":"Em vez disso, examinemos nossos caminhos"},{"verse":{"start":0,"end":0},"text":"e voltemos para o"},{"verse":{"start":41,"end":41},"text":"Levantemos o coração e as mãos"},{"verse":{"start":0,"end":0},"text":"para Deus nos céus e digamos:"},{"verse":{"start":42,"end":42},"text":"\"Pecamos e nos rebelamos,"},{"verse":{"start":0,"end":0},"text":"e tu não nos perdoaste."},{"verse":{"start":43,"end":43},"text":"\"Com tua ira nos envolveste, nos perseguiste"},{"verse":{"start":0,"end":0},"text":"e nos massacraste sem piedade."},{"verse":{"start":44,"end":44},"text":"Tu te escondeste numa nuvem,"},{"verse":{"start":0,"end":0},"text":"para que nossas orações não chegassem a ti."},{"verse":{"start":45,"end":45},"text":"Como refugo e lixo, nos lançaste fora,"},{"verse":{"start":0,"end":0},"text":"no meio das nações."},{"verse":{"start":46,"end":46},"text":"\"Todos os nossos inimigos"},{"verse":{"start":0,"end":0},"text":"falam contra nós."},{"verse":{"start":47,"end":47},"text":"Vivemos cheios de medo,"},{"verse":{"start":0,"end":0},"text":"pois estamos presos numa armadilha, devastados e arruinados\"."},{"verse":{"start":48,"end":48},"text":"Rios de lágrimas correm de meus olhos"},{"verse":{"start":0,"end":0},"text":"pela destruição de meu povo."},{"verse":{"start":49,"end":49},"text":"Minhas lágrimas correm sem parar;"},{"verse":{"start":0,"end":0},"text":"não cessarão"},{"verse":{"start":50,"end":50},"text":"até que o"},{"verse":{"start":0,"end":0},"text":"dos céus e veja."},{"verse":{"start":51,"end":51},"text":"Meu coração está aflito"},{"verse":{"start":0,"end":0},"text":"pelo destino das mulheres de Jerusalém."},{"verse":{"start":52,"end":52},"text":"Meus inimigos, a quem nunca fiz mal,"},{"verse":{"start":0,"end":0},"text":"caçaram-me como se eu fosse um pássaro."},{"verse":{"start":53,"end":53},"text":"Num poço me jogaram"},{"verse":{"start":0,"end":0},"text":"e atiraram pedras sobre mim."},{"verse":{"start":54,"end":54},"text":"A água subiu acima de minha cabeça"},{"verse":{"start":0,"end":0},"text":"e clamei: \"É o fim!\"."},{"verse":{"start":55,"end":55},"text":"Mas, lá do fundo do poço,"},{"verse":{"start":0,"end":0},"text":"invoquei teu nome,"},{"verse":{"start":56,"end":56},"text":"Tu me ouviste quando clamei: \"Ouve minha súplica!"},{"verse":{"start":0,"end":0},"text":"Escuta meu clamor por socorro!\"."},{"verse":{"start":57,"end":57},"text":"Sim, tu vieste quando clamei"},{"verse":{"start":0,"end":0},"text":"e disseste: \"Não tenha medo\"."},{"verse":{"start":58,"end":58},"text":"Senhor, defende minha causa,"},{"verse":{"start":0,"end":0},"text":"pois redimiste minha vida."},{"verse":{"start":59,"end":59},"text":"Viste a injustiça que me fizeram,"},{"verse":{"start":0,"end":0},"text":"demonstra tua justiça."},{"verse":{"start":60,"end":60},"text":"Viste os planos vingativos."},{"verse":{"start":0,"end":0},"text":"que meus inimigos tramaram contra mim."},{"verse":{"start":61,"end":61},"text":"Senhor"},{"verse":{"start":0,"end":0},"text":"sabes muito bem dos planos que tramaram."},{"verse":{"start":62,"end":62},"text":"Meus inimigos me acusam"},{"verse":{"start":0,"end":0},"text":"e conspiram contra mim o dia todo."},{"verse":{"start":63,"end":63},"text":"Olha para eles! Sentados ou em pé,"},{"verse":{"start":0,"end":0},"text":"zombam de mim com suas canções."},{"verse":{"start":64,"end":64},"text":"Senhor"},{"verse":{"start":0,"end":0},"text":"por todo o mal que fizeram."},{"verse":{"start":65,"end":65},"text":"Dá-lhes coração duro e teimoso,"},{"verse":{"start":0,"end":0},"text":"e que tuas maldições caiam sobre eles."},{"verse":{"start":66,"end":66},"text":"Persegue-os em tua ira"},{"verse":{"start":0,"end":0},"text":"e destrói-os sob os céus do"}]},{"chapter":4,"verses":[{"verse":{"start":0,"end":0},"text":"A ira do"},{"verse":{"start":1,"end":1},"text":"Como o ouro perdeu seu brilho!"},{"verse":{"start":0,"end":0},"text":"Até o ouro mais puro ficou embaçado."},{"verse":{"start":0,"end":0},"text":"As pedras sagradas"},{"verse":{"start":0,"end":0},"text":"estão espalhadas pelas ruas."},{"verse":{"start":2,"end":2},"text":"Vejam como os filhos preciosos de Sião,"},{"verse":{"start":0,"end":0},"text":"que valem seu peso em ouro puro,"},{"verse":{"start":0,"end":0},"text":"são tratados como vasos de barro"},{"verse":{"start":0,"end":0},"text":"feitos por um oleiro qualquer."},{"verse":{"start":3,"end":3},"text":"Até os chacais amamentam seus filhotes,"},{"verse":{"start":0,"end":0},"text":"mas meu povo não age assim."},{"verse":{"start":0,"end":0},"text":"Como as avestruzes no deserto,"},{"verse":{"start":0,"end":0},"text":"ignora cruelmente o clamor de seus filhos."},{"verse":{"start":4,"end":4},"text":"A língua seca dos bebês"},{"verse":{"start":0,"end":0},"text":"gruda no céu da boca, por causa da sede."},{"verse":{"start":0,"end":0},"text":"As crianças imploram por um pedaço de pão,"},{"verse":{"start":0,"end":0},"text":"mas ninguém as atende."},{"verse":{"start":5,"end":5},"text":"Os que antes comiam as comidas mais finas"},{"verse":{"start":0,"end":0},"text":"agora morrem de fome nas ruas."},{"verse":{"start":0,"end":0},"text":"Os que antes vestiam roupas da melhor qualidade"},{"verse":{"start":0,"end":0},"text":"agora reviram os montes de lixo."},{"verse":{"start":6,"end":6},"text":"A culpa de meu povo"},{"verse":{"start":0,"end":0},"text":"é maior que a de Sodoma,"},{"verse":{"start":0,"end":0},"text":"que foi destruída de repente,"},{"verse":{"start":0,"end":0},"text":"e ninguém ofereceu ajuda."},{"verse":{"start":7,"end":7},"text":"Nossos príncipes eram radiantes de saúde,"},{"verse":{"start":0,"end":0},"text":"mais brilhantes que a neve e mais brancos que o leite."},{"verse":{"start":0,"end":0},"text":"Seu rosto era rosado como rubis,"},{"verse":{"start":0,"end":0},"text":"e sua aparência, como safiras."},{"verse":{"start":8,"end":8},"text":"Agora, porém, seu rosto está mais escuro que fuligem;"},{"verse":{"start":0,"end":0},"text":"ninguém os reconhece nas ruas."},{"verse":{"start":0,"end":0},"text":"Sua pele está pegada aos ossos,"},{"verse":{"start":0,"end":0},"text":"seca como madeira."},{"verse":{"start":9,"end":9},"text":"Os que morreram pela espada foram mais felizes"},{"verse":{"start":0,"end":0},"text":"que os que morrem de inanição."},{"verse":{"start":0,"end":0},"text":"Famintos, definham"},{"verse":{"start":0,"end":0},"text":"por falta de alimento dos campos."},{"verse":{"start":10,"end":10},"text":"Mulheres de bom coração"},{"verse":{"start":0,"end":0},"text":"cozinharam os próprios filhos."},{"verse":{"start":0,"end":0},"text":"Elas os comeram"},{"verse":{"start":0,"end":0},"text":"para sobreviver ao cerco."},{"verse":{"start":11,"end":11},"text":"Agora, porém, a ira do"},{"verse":{"start":0,"end":0},"text":"sua ira ardente foi derramada."},{"verse":{"start":0,"end":0},"text":"Em Sião ele acendeu um fogo"},{"verse":{"start":0,"end":0},"text":"que queimou a cidade até seus alicerces."},{"verse":{"start":12,"end":12},"text":"Nenhum rei em toda a terra,"},{"verse":{"start":0,"end":0},"text":"ninguém no mundo inteiro,"},{"verse":{"start":0,"end":0},"text":"poderia imaginar que o inimigo"},{"verse":{"start":0,"end":0},"text":"entraria pelas portas de Jerusalém."},{"verse":{"start":13,"end":13},"text":"Mas foi o que aconteceu por causa do pecado de seus profetas"},{"verse":{"start":0,"end":0},"text":"e da maldade de seus sacerdotes,"},{"verse":{"start":0,"end":0},"text":"que profanaram a cidade"},{"verse":{"start":0,"end":0},"text":"ao derramar sangue inocente."},{"verse":{"start":14,"end":14},"text":"Andavam sem destino pelas ruas,"},{"verse":{"start":0,"end":0},"text":"como cegos,"},{"verse":{"start":0,"end":0},"text":"tão contaminados de sangue"},{"verse":{"start":0,"end":0},"text":"que ninguém se atrevia a tocar neles."},{"verse":{"start":15,"end":15},"text":"\"Afastem-se!\", gritavam para eles."},{"verse":{"start":0,"end":0},"text":"\"Estão contaminados! Não toquem em nós!\""},{"verse":{"start":0,"end":0},"text":"Fugiram para terras distantes"},{"verse":{"start":0,"end":0},"text":"e andaram sem rumo entre as nações,"},{"verse":{"start":0,"end":0},"text":"mas nenhuma permitiu que ficassem."},{"verse":{"start":16,"end":16},"text":"O"},{"verse":{"start":0,"end":0},"text":"e deixou de ajudá-los."},{"verse":{"start":0,"end":0},"text":"Ninguém mais respeita os sacerdotes"},{"verse":{"start":0,"end":0},"text":"nem honra os líderes."},{"verse":{"start":17,"end":17},"text":"Esperamos em vão que nossos aliados"},{"verse":{"start":0,"end":0},"text":"viessem nos socorrer."},{"verse":{"start":0,"end":0},"text":"Buscamos a ajuda de nações"},{"verse":{"start":0,"end":0},"text":"incapazes de nos livrar."},{"verse":{"start":18,"end":18},"text":"Não podíamos sair às ruas,"},{"verse":{"start":0,"end":0},"text":"pois nossos passos eram vigiados."},{"verse":{"start":0,"end":0},"text":"Nosso fim se aproximava, nossos dias estavam contados;"},{"verse":{"start":0,"end":0},"text":"estávamos condenados!"},{"verse":{"start":19,"end":19},"text":"Nossos inimigos eram mais rápidos que as águias no céu;"},{"verse":{"start":0,"end":0},"text":"fugimos para as montanhas, mas eles nos perseguiram."},{"verse":{"start":0,"end":0},"text":"No deserto nos escondemos,"},{"verse":{"start":0,"end":0},"text":"mas eles estavam ali, esperando por nós."},{"verse":{"start":20,"end":20},"text":"Nosso rei, o ungido do"},{"verse":{"start":0,"end":0},"text":"foi capturado nos laços deles."},{"verse":{"start":0,"end":0},"text":"E nós pensávamos que sua sombra"},{"verse":{"start":0,"end":0},"text":"nos protegeria de qualquer nação da terra!"},{"verse":{"start":21,"end":21},"text":"Ó povo de Edom,"},{"verse":{"start":0,"end":0},"text":"você se alegra e exulta na terra de Uz?"},{"verse":{"start":0,"end":0},"text":"Mas você também beberá do cálice da ira do"},{"verse":{"start":0,"end":0},"text":"também ficará embriagado e será despido."},{"verse":{"start":22,"end":22},"text":"Ó bela Sião, o castigo de sua maldade chegará ao fim;"},{"verse":{"start":0,"end":0},"text":"logo voltará do exílio."},{"verse":{"start":0,"end":0},"text":"Mas para você, Edom, o castigo está só começando;"},{"verse":{"start":0,"end":0},"text":"logo seus muitos pecados serão expostos."}]},{"chapter":5,"verses":[{"verse":{"start":0,"end":0},"text":"Súplica por restauração"},{"verse":{"start":1,"end":1},"text":"Lembra-te,"},{"verse":{"start":0,"end":0},"text":"e vê como fomos humilhados!"},{"verse":{"start":2,"end":2},"text":"Nossa herança foi entregue a estranhos,"},{"verse":{"start":0,"end":0},"text":"e nossas casas, a estrangeiros."},{"verse":{"start":3,"end":3},"text":"Somos órfãos e já não temos pai,"},{"verse":{"start":0,"end":0},"text":"e nossa mãe ficou viúva."},{"verse":{"start":4,"end":4},"text":"Temos de pagar pela água que bebemos,"},{"verse":{"start":0,"end":0},"text":"e até a lenha nos custa caro."},{"verse":{"start":5,"end":5},"text":"Os que nos perseguem estão bem perto;"},{"verse":{"start":0,"end":0},"text":"estamos exaustos, mas não nos deixam descansar."},{"verse":{"start":6,"end":6},"text":"Ao Egito e à Assíria nos sujeitamos,"},{"verse":{"start":0,"end":0},"text":"para conseguir alimento e sobreviver."},{"verse":{"start":7,"end":7},"text":"Nossos antepassados pecaram e já morreram,"},{"verse":{"start":0,"end":0},"text":"e nós recebemos o castigo que eles mereciam."},{"verse":{"start":8,"end":8},"text":"Escravos se tornaram nossos senhores;"},{"verse":{"start":0,"end":0},"text":"não restou ninguém para nos resgatar."},{"verse":{"start":9,"end":9},"text":"Arriscamos a vida à procura de alimento,"},{"verse":{"start":0,"end":0},"text":"pois a violência tomou conta do deserto."},{"verse":{"start":10,"end":10},"text":"A fome nos escureceu a pele,"},{"verse":{"start":0,"end":0},"text":"como se tivesse sido queimada no forno."},{"verse":{"start":11,"end":11},"text":"As mulheres de Sião e as moças das cidades de Judá"},{"verse":{"start":0,"end":0},"text":"são violentadas por nossos inimigos."},{"verse":{"start":12,"end":12},"text":"Os príncipes são pendurados pelas mãos,"},{"verse":{"start":0,"end":0},"text":"os idosos são tratados com desprezo."},{"verse":{"start":13,"end":13},"text":"Os rapazes são levados para trabalhar nos moinhos,"},{"verse":{"start":0,"end":0},"text":"os meninos cambaleiam sob os pesados fardos de lenha."},{"verse":{"start":14,"end":14},"text":"As autoridades não se sentam mais à porta das cidades,"},{"verse":{"start":0,"end":0},"text":"os rapazes não tocam mais música."},{"verse":{"start":15,"end":15},"text":"A alegria desapareceu de nosso coração,"},{"verse":{"start":0,"end":0},"text":"nossas danças se transformaram em pranto."},{"verse":{"start":16,"end":16},"text":"A coroa caiu de nossa cabeça;"},{"verse":{"start":0,"end":0},"text":"que aflição por causa de nosso pecado!"},{"verse":{"start":17,"end":17},"text":"Nosso coração desfalece,"},{"verse":{"start":0,"end":0},"text":"nossos olhos se embaçaram de lágrimas,"},{"verse":{"start":18,"end":18},"text":"pois o monte Sião está desolado;"},{"verse":{"start":0,"end":0},"text":"tornou-se morada de chacais."},{"verse":{"start":19,"end":19},"text":"Mas tu,"},{"verse":{"start":0,"end":0},"text":"Teu trono permanece de geração em geração."},{"verse":{"start":20,"end":20},"text":"Por que continuas a te esquecer de nós?"},{"verse":{"start":0,"end":0},"text":"Por que nos abandonaste por tanto tempo?"},{"verse":{"start":21,"end":21},"text":"Restaura-nos,"},{"verse":{"start":0,"end":0},"text":"Devolve-nos a alegria que tínhamos antes!"},{"verse":{"start":22,"end":22},"text":"Ou será que nos rejeitaste completamente?"},{"verse":{"start":0,"end":0},"text":"Ainda estás irado conosco?"}]}]}