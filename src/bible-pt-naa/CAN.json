text":"Esposo"},{"verse":49,"text":"Se você, a mais bela"},{"verse":50,"text":"das mulheres, não o sabe,"},{"verse":51,"text":"siga as pisadas dos rebanhos"},{"verse":52,"text":"e apascente os seus cabritos"},{"verse":53,"text":"junto às tendas dos pastores."},{"verse":54,"text":"Comparo você, minha querida,"},{"verse":55,"text":"com as éguas das carruagens"},{"verse":56,"text":"de Faraó."},{"verse":57,"text":"O seu rosto fica lindo"},{"verse":58,"text":"com os enfeites,"},{"verse":59,"text":"o seu pescoço, com os colares."},{"verse":60,"text":"Faremos para você"},{"verse":61,"text":"enfeites de ouro,"},{"verse":62,"text":"com incrustações de prata."},{"verse":63,"text":"Esposa"},{"verse":64,"text":"Enquanto o rei está assentado"},{"verse":65,"text":"à sua mesa,"},{"verse":66,"text":"o meu nardo exala o seu perfume."},{"verse":67,"text":"O meu amado é para mim"},{"verse":68,"text":"como um sachê de mirra,"},{"verse":69,"text":"posto entre os meus seios."},{"verse":70,"text":"O meu amado é para mim"},{"verse":71,"text":"como um ramalhete"},{"verse":72,"text":"de flores de hena"},{"verse":73,"text":"nas vinhas de En-Gedi."},{"verse":74,"text":"Esposo"},{"verse":75,"text":"Como você é bela,"},{"verse":76,"text":"minha querida!"},{"verse":77,"text":"Como você é bela!"},{"verse":78,"text":"Os seus olhos são como pombas."},{"verse":79,"text":"Esposa"},{"verse":80,"text":"Como você é belo, meu amado!"},{"verse":81,"text":"Como é encantador!"},{"verse":82,"text":"O nosso leito é de viçosa relva."},{"verse":83,"text":"As vigas da nossa casa"},{"verse":84,"text":"são os cedros,"},{"verse":85,"text":"e o nosso teto são os ciprestes."}]},{"chapter":2,"verses":[{"verse":1,"text":"Eu sou a rosa de Sarom,"},{"verse":2,"text":"o lírio dos vales."},{"verse":3,"text":"Esposo"},{"verse":4,"text":"Como um lírio entre os espinhos,"},{"verse":5,"text":"assim é a minha querida"},{"verse":6,"text":"entre as donzelas."},{"verse":7,"text":"Esposa"},{"verse":8,"text":"Como a macieira"},{"verse":9,"text":"entre as árvores do bosque,"},{"verse":10,"text":"assim é o meu amado"},{"verse":11,"text":"entre os jovens."},{"verse":12,"text":"Desejo muito a sua sombra"},{"verse":13,"text":"e debaixo dela me assento,"},{"verse":14,"text":"e o seu fruto é doce"},{"verse":15,"text":"ao meu paladar."},{"verse":16,"text":"Ele me levou à sala do banquete,"},{"verse":17,"text":"e o seu estandarte sobre mim"},{"verse":18,"text":"é o amor."},{"verse":19,"text":"Sustentem-me com passas,"},{"verse":20,"text":"confortem-me com maçãs,"},{"verse":21,"text":"pois estou morrendo de amor."},{"verse":22,"text":"A sua mão esquerda"},{"verse":23,"text":"está debaixo da minha cabeça,"},{"verse":24,"text":"e a direita me abraça."},{"verse":25,"text":"Filhas de Jerusalém,"},{"verse":26,"text":"jurem pelas gazelas"},{"verse":27,"text":"e pelas corças selvagens"},{"verse":28,"text":"que vocês não acordarão"},{"verse":29,"text":"nem despertarão o amor,"},{"verse":30,"text":"até que este o queira."},{"verse":31,"text":"Segundo cântico"},{"verse":32,"text":"Esposa"},{"verse":33,"text":"Ouço a voz do meu amado."},{"verse":34,"text":"Eis que ele vem,"},{"verse":35,"text":"saltando sobre os montes,"},{"verse":36,"text":"pulando sobre as colinas."},{"verse":37,"text":"O meu amado é semelhante"},{"verse":38,"text":"ao gamo"},{"verse":39,"text":"ou ao filho da gazela."},{"verse":40,"text":"Eis que ele está"},{"verse":41,"text":"detrás de nossa parede,"},{"verse":42,"text":"olhando pelas janelas,"},{"verse":43,"text":"espreitando pelas grades."},{"verse":44,"text":"O meu amado fala e me diz:"},{"verse":45,"text":"Esposo"},{"verse":46,"text":"Levante-se, minha querida,"},{"verse":47,"text":"minha linda, e venha comigo."},{"verse":48,"text":"Porque eis que passou o inverno,"},{"verse":49,"text":"a chuva cessou e se foi,"},{"verse":50,"text":"aparecem as flores na terra,"},{"verse":51,"text":"chegou o tempo"},{"verse":52,"text":"de cantarem as aves,"},{"verse":53,"text":"e já se ouve a voz"},{"verse"