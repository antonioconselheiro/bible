":14,"text":"Mal os deixei, encontrei logo"},{"verse":15,"text":"o amado da minha alma."},{"verse":16,"text":"Agarrei-me a ele"},{"verse":17,"text":"e não o deixei ir embora,"},{"verse":18,"text":"até que o fiz entrar"},{"verse":19,"text":"na casa de minha mãe"},{"verse":20,"text":"e no quarto daquela"},{"verse":21,"text":"que me concebeu."},{"verse":22,"text":"Filhas de Jerusalém,"},{"verse":23,"text":"jurem pelas gazelas"},{"verse":24,"text":"e pelas corças selvagens"},{"verse":25,"text":"que vocês não acordarão"},{"verse":26,"text":"nem despertarão o amor,"},{"verse":27,"text":"até que este o queira."},{"verse":28,"text":"Terceiro cântico"},{"verse":29,"text":"Coro"},{"verse":30,"text":"O que é aquilo que vem"},{"verse":31,"text":"subindo do deserto,"},{"verse":32,"text":"como colunas de fumaça,"},{"verse":33,"text":"perfumado de mirra, de incenso"},{"verse":34,"text":"e de todos os tipos"},{"verse":35,"text":"de pós aromáticos"},{"verse":36,"text":"do mercador?"},{"verse":37,"text":"É a liteira de Salomão."},{"verse":38,"text":"Vem escoltada"},{"verse":39,"text":"por sessenta valentes,"},{"verse":40,"text":"dos melhores valentes de Israel."},{"verse":41,"text":"Todos sabem manejar a espada"},{"verse":42,"text":"e são treinados para a guerra;"},{"verse":43,"text":"cada um leva a espada na cintura,"},{"verse":44,"text":"por causa dos temores noturnos."},{"verse":45,"text":"O rei Salomão mandou fazer"},{"verse":46,"text":"um palanquim"},{"verse":47,"text":"de madeira do Líbano."},{"verse":48,"text":"As colunas eram de prata,"},{"verse":49,"text":"o encosto de ouro,"},{"verse":50,"text":"o assento de púrpura,"},{"verse":51,"text":"e o interior foi enfeitado"},{"verse":52,"text":"com carinho pelas mulheres"},{"verse":53,"text":"de Jerusalém."},{"verse":54,"text":"Saiam, ó filhas de Sião,"},{"verse":55,"text":"e venham ver o rei Salomão"},{"verse":56,"text":"com a coroa"},{"verse":57,"text":"com que sua mãe o coroou"},{"verse":58,"text":"no dia do seu casamento,"},{"verse":59,"text":"no dia da alegria do seu coração."}]},{"chapter":4,"verses":[{"verse":0,"text":"Esposo"},{"verse":1,"text":"Como você é bela,"},{"verse":2,"text":"minha querida!"},{"verse":3,"text":"Como você é linda!"},{"verse":4,"text":"Os seus olhos são como pombas"},{"verse":5,"text":"e brilham através do véu."},{"verse":6,"text":"Os seus cabelos são como"},{"verse":7,"text":"um rebanho de cabras"},{"verse":8,"text":"que descem ondeantes"},{"verse":9,"text":"do monte de Gileade."},{"verse":10,"text":"Os seus dentes são como"},{"verse":11,"text":"um rebanho de ovelhas"},{"verse":12,"text":"recém-tosquiadas,"},{"verse":13,"text":"que sobem do lavadouro;"},{"verse":14,"text":"cada uma tem o seu par,"},{"verse":15,"text":"e nenhuma está faltando."},{"verse":16,"text":"Os seus lábios são como"},{"verse":17,"text":"um fio de escarlate,"},{"verse":18,"text":"e a sua boca é linda."},{"verse":19,"text":"As suas faces, como romã partida,"},{"verse":20,"text":"brilham através do véu."},{"verse":21,"text":"O seu pescoço é como"},{"verse":22,"text":"a torre de Davi,"},{"verse":23,"text":"edificada para arsenal;"},{"verse":24,"text":"mil escudos pendem dela,"},{"verse":25,"text":"todos escudos"},{"verse":26,"text":"de soldados valentes."},{"verse":27,"text":"Os seus seios são como"},{"verse":28,"text":"duas crias gêmeas"},{"verse":29,"text":"de uma gazela,"},{"verse":30,"text":"que pastam entre os lírios."},{"verse":31,"text":"Antes que rompa o dia,"},{"verse":32,"text":"e fujam as sombras,"},{"verse":33,"text":"irei ao monte da mirra"},{"verse":34,"text":"e à colina do incenso."},{"verse":35,"text":"Você é toda linda,"},{"verse":36,"text":"minha querida,"},{"verse":37,"text":"e em você não há defeito."},{"verse":38,"text":"Venha comigo do Líbano,"},{"verse":39,"text":"minha noiva,"},{"verse":40,"text":"venha comigo do Líbano."},{"verse":41,"text":"Desça do alto do monte Amana,"},{"verse":42,"text":"do alto do Senir e do Hermom,"},{"verse":43,"text":"dos covis dos leões,"},{"verse":44,"text":"dos montes dos leopardos."},{"verse":45,"text":"Você roubou meu coração,"},{"verse":46,"text":"meu amor, minha noiva;"},{"verse":47,"text":"roubou meu coração"},{"verse":48,"text":"com um só dos seus olhares,"},{"verse":49,"text":"com uma só pérola do seu colar."},{"verse":50,"text":"Como são agradáveis"},{"verse":51,"text":"as suas carícias,"},{"verse":52,"text":"meu amor, minha noiva!"},{"verse":53,"text":"O seu amor é melhor"},{"verse":54,"text":"do que o vinho,"},{"verse":55,"text":"e o aroma do seu perfume"},{"verse":56,"text":"é mais suave do que"},{"verse":57,"text":"todas as especiarias!"},{"verse":58,"text":"Os seus lábios destilam mel,"},{"verse":59,"text":"minha noiva."},{"verse":60,"text":"Mel e leite se acham"},{"verse":61,"text":"debaixo da sua língua,"},{"verse":62,"text":"e o cheiro dos seus vestidos"},{"verse":63,"text":"é como o cheiro do Líbano."},{"verse":64,"text":"Meu amor, minha noiva,"},{"verse":65,"text":"você é um jardim fechado,"},{"verse":66,"text":"um manancial recluso,"},{"verse":67,"text":"uma fonte selada."},{"verse":68,"text":"Os seus renovos são"},{"verse":69,"text":"um pomar de romãs"},{"verse":70,"text":"com frutos excelentes:"},{"verse":71,"text":"henas com nardos,"},{"verse":72,"text":"nardo e açafrão,"},{"verse":73,"text":"cálamo e cinamomo,"},{"verse":74,"text":"com todo tipo"},{"verse":75,"text":"de árvores de incenso,"},{"verse":76,"text":"mirra e aloés, com todas"},{"verse":77,"text":"as principais especiarias."},{"verse":78,"text":"Você é fonte dos jardins,"},{"verse":79,"text":"poço de águas vivas"},{"verse":80,"text":"que correm do Líbano!"},{"verse":81,"text":"Esposa"},{"verse":82,"text":"Desperte, vento norte,"},{"verse":83,"text":"e venha, vento sul!"},{"verse":84,"text":"Soprem no meu jardim,"},{"verse":85,"text":"para que se derramem"},{"verse":86,"text":"os seus aromas."},{"verse":87,"text":"Que o meu amado venha"},{"verse":88,"text":"ao seu jardim"},{"verse":89,"text":"e coma os seus frutos excelentes!"}]},{"chapter":5,"verses":[{"verse":0,"text":"Esposo"},{"verse":1,"text":"Já entrei no meu jardim,"},{"verse":2,"text":"meu amor, minha noiva."},{"verse":3,"text":"Colhi a minha mirra"},{"verse":4,"text":"com as especiarias,"},{"verse":5,"text":"comi o meu favo com o mel,"},{"verse":6,"text":"bebi o meu vinho com o leite."},{"verse":7,"text":"Coro"},{"verse":8,"text":"Comam e bebam, meus amigos;"},{"verse":9,"text":"até ficarem embriagados de amor."},{"verse":10,"text":"Quarto cântico"},{"verse":11,"text":"Esposa"},{"verse":12,"text":"Eu dormia, mas o meu coração"},{"verse":13,"text":"estava acordado."},{"verse":14,"text":"Eis a voz do meu amado,"},{"verse":15,"text":"que está batendo:"},{"verse":16,"text":"Esposo"},{"verse":17,"text":"Deixe-me entrar,"},{"verse":18,"text":"meu amor, minha querida,"},{"verse":19,"text":"minha pombinha sem defeito,"},{"verse":20,"text":"porque a minha cabeça"},{"verse":21,"text":"está cheia de orvalho,"},{"verse":22,"text":"e os meus cabelos,"},{"verse":23,"text":"das gotas da noite."},{"verse":24,"text":"Esposa"},{"verse":25,"text":"Já tirei a minha túnica!"},{"verse":26,"text":"Como posso vesti-la outra vez?"},{"verse":27,"text":"Já lavei os pés!"},{"verse":28,"text":"Como voltar a sujá-los?"},{"verse":29,"text":"O meu amado meteu a mão"},{"verse":30,"text":"pela fresta,"},{"verse":31,"text":"e o meu coração estremeceu."},{"verse":32,"text":"Eu me levantei para abrir a porta"},{"verse":33,"text":"ao meu amado."},{"verse":34,"text":"As minhas mãos destilavam mirra,"},{"verse":35,"text":"e os meus dedos deixavam"},{"verse":36,"text":"escorrer mirra preciosa"},{"verse":37,"text":"sobre a tranca da porta."},{"verse":38,"text":"Abri a porta ao meu amado,"},{"verse":39,"text":"mas ele já tinha se afastado"},{"verse":40,"text":"e ido embora."},{"verse":41,"text":"Eu tinha estremecido,"},{"verse":42,"text":"quando ele me falou."},{"verse":43,"text":"Busquei-o, mas não o achei;"},{"verse":44,"text":"chamei-o, mas ele não respondeu."},{"verse":45,"text":"Os guardas, que rondavam"},{"verse":46,"text":"a cidade, me encontraram;"},{"verse":47,"text":"eles me espancaram e me feriram;"},{"verse":48,"text":"os guardas das muralhas"},{"verse":49,"text":"tomaram o meu manto."},{"verse":50,"text":"Filhas de Jerusalém, jurem:"},{"verse":51,"text":"se encontrarem o meu amado,"},{"verse":52,"text":"digam que estou"},{"verse":53,"text":"morrendo de amor."},{"verse":54,"text":"Coro"},{"verse":55,"text":"O que é que o seu amado tem"},{"verse":56,"text":"que os outros não tenham,"},{"verse":57,"text":"ó mais bela das mulheres?"},{"verse":58,"text":"O que é que o seu amado tem"},{"verse":59,"text":"que os outros não tenham,"},{"verse":60,"text":"para que você nos faça jurar?"},{"verse":61,"text":"Esposa"},{"verse":62,"text":"O meu amado é alvo e rosado,"},{"verse":63,"text":"o mais destacado entre dez mil."},{"verse":64,"text":"A sua cabeça é como o ouro"},{"verse":65,"text":"mais depurado,"},{"verse":66,"text":"os seus cabelos ondulados"},{"verse":67,"text":"são pretos como o corvo."},{"verse":68,"text":"Os seus olhos são como pombas"},{"verse":69,"text":"junto ao ribeiro,"},{"verse":70,"text":"brancas como leite,"},{"verse":71,"text":"banhando-se junto"},{"verse":72,"text":"às correntes das águas."},{"verse":73,"text":"As suas faces são como"},{"verse":74,"text":"canteiros de bálsamo,"},{"verse":75,"text":"como colinas de ervas aromáticas."},{"verse":76,"text":"Os seus lábios são como lírios"},{"verse":77,"text":"que gotejam mirra preciosa."},{"verse":78,"text":"As suas mãos são"},{"verse":79,"text":"cilindros de ouro"},{"verse":80,"text":"enfeitados de turquesas."},{"verse":81,"text":"O seu ventre é como alvo marfim,"},{"verse":82,"text":"coberto de safiras."},{"verse":83,"text":"As suas pernas são"},{"verse":84,"text":"colunas de mármore,"},{"verse":85,"text":"assentadas sobre"},{"verse":86,"text":"bases de ouro puro."},{"verse":87,"text":"O aspecto do meu amado"},{"verse":88,"text":"é como o do Líbano;"},{"verse":89,"text":"ele é elegante como os cedros."},{"verse":90,"text":"O seu falar é muito suave;"},{"verse":91,"text":"sim, ele é totalmente desejável."},{"verse":92,"text":"Assim é o meu amado,"},{"verse":93,"text":"assim é o meu esposo,"},{"verse":94,"text":"ó filhas de Jerusalém."}]},{"chapter":6,"verses":[{"verse":0,"text":"Coro"},{"verse":1,"text":"Para onde foi o seu amado,"},{"verse":2,"text":"ó mais bela das mulheres?"},{"verse":3,"text":"Que rumo tomou o seu amado,"},{"verse":4,"text":"para que a ajudemos"},{"verse":5,"text":"a encontrá-lo?"},{"verse":6,"text":"Esposa"},{"verse":7,"text":"O meu amado desceu"},{"verse":8,"text":"ao seu jardim,"},{"verse":9,"text":"aos canteiros de bálsamo,"},{"verse":10,"text":"para pastorear nos jardins"},{"verse":11,"text":"e para colher os lírios."},{"verse":12,"text":"Eu sou do meu amado,"},{"verse":13,"text":"e o meu amado é meu;"},{"verse":14,"text":"ele apascenta o seu rebanho"},{"verse":15,"text":"entre os lírios."},{"verse":16,"text":"Quinto cântico"},{"verse":17,"text":"Esposo"},{"verse":18,"text":"Minha querida,"},{"verse":19,"text":"você é bonita como Tirza,"},{"verse":20,"text":"encantadora como Jerusalém,"},{"verse":21,"text":"impressionante como"},{"verse":22,"text":"um exército com bandeiras."},{"verse":23,"text":"Desvie de mim os seus olhos,"},{"verse":24,"text":"porque eles me perturbam."},{"verse":25,"text":"Os seus cabelos são como"},{"verse":26,"text":"um rebanho de cabras"},{"verse":27,"text":"que descem ondeantes"},{"verse":28,"text":"de Gileade."},{"verse":29,"text":"Os seus dentes são como"},{"verse":30,"text":"um rebanho de ovelhas"},{"verse":31,"text":"que sobem do lavadouro;"},{"verse":32,"text":"cada uma tem o seu par,"},{"verse":33,"text":"e nenhuma está faltando."},{"verse":34,"text":"As suas faces, como romã partida,"},{"verse":35,"text":"brilham através do véu."},{"verse":36,"text":"Sessenta são as rainhas,"},{"verse":37,"text":"oitenta, as concubinas,"},{"verse":38,"text":"e as virgens, sem número;"},{"verse":39,"text":"mas uma só é a minha pombinha"},{"verse":40,"text":"sem defeito,"},{"verse":41,"text":"a mais querida da sua mãe,"},{"verse":42,"text":"a predileta daquela"},{"verse":43,"text":"que a deu à luz."},{"verse":44,"text":"As outras mulheres a veem"},{"verse":45,"text":"e dizem que ela é feliz;"},{"verse":46,"text":"as rainhas e as concubinas"},{"verse":47,"text":"a louvam."},{"verse":48,"text":"Coro"},{"verse":49,"text":"Quem é esta que aparece"},{"verse":50,"text":"como a alva do dia,"},{"verse":51,"text":"bonita como a lua,"},{"verse":52,"text":"pura como o sol,"},{"verse":53,"text":"impressionante como um exército"},{"verse":54,"text":"com bandeiras?"},{"verse":55,"text":"Esposa"},{"verse":56,"text":"Desci ao jardim das nogueiras,"},{"verse":57,"text":"para ver os renovos do vale,"},{"verse":58,"text":"para ver se brotavam as videiras,"},{"verse":59,"text":"se as romãzeiras estavam em flor."},{"verse":60,"text":"Não sei como,"},{"verse":61,"text":"imaginei-me no carro"},{"verse":62,"text":"do meu nobre povo!"},{"verse":63,"text":"Coro"},{"verse":64,"text":"Volte, volte, sulamita!"},{"verse":65,"text":"Volte, volte, para que nós"},{"verse":66,"text":"a contemplemos."},{"verse":67,"text":"Esposa"},{"verse":68,"text":"Por que vocês querem"},{"verse":69,"text":"contemplar a sulamita"},{"verse":70,"text":"na dança de Maanaim?"}]},{"chapter":7,"verses":[{"verse":0,"text":"Esposo"},{"verse":1,"text":"Como são bonitos os seus pés"},{"verse":2,"text":"nas sandálias,"},{"verse":3,"text":"ó filha do príncipe!"},{"verse":4,"text":"As curvas dos seus quadris"},{"verse":5,"text":"são como colares trabalhados"},{"verse":6,"text":"por mãos de artista."},{"verse":7,"text":"O seu umbigo"},{"verse":8,"text":"é uma taça redonda"},{"verse":9,"text":"onde nunca falta bebida;"},{"verse":10,"text":"o seu ventre é um monte de trigo,"},{"verse":11,"text":"cercado de lírios."},{"verse":12,"text":"Os seus seios são como"},{"verse":13,"text":"duas crias gêmeas"},{"verse":14,"text":"de uma gazela."},{"verse":15,"text":"O seu pescoço é como"},{"verse":16,"text":"uma torre de marfim."},{"verse":17,"text":"Os seus olhos são como"},{"verse":18,"text":"as piscinas de Hesbom,"},{"verse":19,"text":"junto ao portão de Bate-Rabim."},{"verse":20,"text":"O seu nariz é como"},{"verse":21,"text":"a torre do Líbano,"},{"verse":22,"text":"voltada para Damasco."},{"verse":23,"text":"A sua cabeça é como"},{"verse":24,"text":"o monte Carmelo;"},{"verse":25,"text":"os seus cabelos são como"},{"verse":26,"text":"a púrpura;"},{"verse":27,"text":"um rei está preso nas suas tranças."},{"verse":28,"text":"Como você é linda!"},{"verse":29,"text":"Como você é atraente, meu amor,"},{"verse":30,"text":"com as suas delícias!"},{"verse":31,"text":"Esse seu porte"},{"verse":32,"text":"é semelhante à palmeira,"},{"verse":33,"text":"e os seus seios"},{"verse":34,"text":"se parecem com os cachos."},{"verse":35,"text":"Eu disse: \"Vou subir na palmeira"},{"verse":36,"text":"e colher os seus frutos.\""},{"verse":37,"text":"Sejam os seus seios"},{"verse":38,"text":"como os cachos de uvas,"},{"verse":39,"text":"e o aroma da sua respiração,"},{"verse":40,"text":"como o das maçãs."},{"verse":41,"text":"Os seus beijos são"},{"verse":42,"text":"como o bom vinho…"},{"verse":43,"text":"Esposa"},{"verse":44,"text":"… vinho que se escoa suavemente"},{"verse":45,"text":"para o meu amado,"},{"verse":46,"text":"deslizando entre os seus lábios"},{"verse":47,"text":"e dentes."},{"verse":48,"text":"Eu sou do meu amado,"},{"verse":49,"text":"e ele tem saudades de mim."},{"verse":50,"text":"Venha, meu amado,"},{"verse":51,"text":"vamos para o campo,"},{"verse":52,"text":"passemos a noite nas aldeias."},{"verse":53,"text":"Vamos levantar cedo"},{"verse":54,"text":"e olhar as parreiras,"},{"verse":55,"text":"para ver se já começaram a brotar,"},{"verse":56,"text":"se as flores estão se abrindo,"},{"verse":57,"text":"se as romãzeiras já estão em flor."},{"verse":58,"text":"Ali eu lhe darei o meu amor."},{"verse":59,"text":"As mandrágoras exalam"},{"verse":60,"text":"o seu perfume,"},{"verse":61,"text":"e às nossas portas há todo tipo"},{"verse":62,"text":"de frutos excelentes,"},{"verse":63,"text":"frescos e secos,"},{"verse":64,"text":"que reservei para você,"},{"verse":65,"text":"meu amado."}]},{"chapter":8,"verses":[{"verse":1,"text":"Quem dera que você"},{"verse":2,"text":"fosse meu irmão,"},{"verse":3,"text":"amamentado aos seios"},{"verse":4,"text":"de minha mãe!"},{"verse":5,"text":"Se eu o encontrasse na rua,"},{"verse":6,"text":"poderia beijá-lo,"},{"verse":7,"text":"e não me desprezariam!"},{"verse":8,"text":"Eu o levaria para a casa"},{"verse":9,"text":"da minha mãe,"},{"verse":10,"text":"e você me ensinaria;"},{"verse":11,"text":"eu lhe daria de beber"},{"verse":12,"text":"vinho aromático"},{"verse":13,"text":"e o suco das minhas romãs."},{"verse":14,"text":"A sua mão esquerda estaria"},{"verse":15,"text":"debaixo da minha cabeça,"},{"verse":16,"text":"e a sua direita me abraçaria."},{"verse":17,"text":"Filhas de Jerusalém,"},{"verse":18,"text":"jurem pelas gazelas"},{"verse":19,"text":"e pelas corças selvagens"},{"verse":20,"text":"que vocês não acordarão"},{"verse":21,"text":"nem despertarão o amor,"},{"verse":22,"text":"até que este o queira."},{"verse":23,"text":"Sexto cântico"},{"verse":24,"text":"Coro"},{"verse":25,"text":"Quem é esta que vem"},{"verse":26,"text":"subindo do deserto,"},{"verse":27,"text":"apoiada em seu amado?"},{"verse":28,"text":"Esposa"},{"verse":29,"text":"Debaixo da macieira"},{"verse":30,"text":"eu o despertei;"},{"verse":31,"text":"ali a sua mãe teve dores de parto,"},{"verse":32,"text":"ali esteve com dores"},{"verse":33,"text":"aquela que o deu à luz."},{"verse":34,"text":"Ponha-me como selo"},{"verse":35,"text":"sobre o seu coração,"},{"verse":36,"text":"como selo sobre o seu braço,"},{"verse":37,"text":"porque o amor é tão forte"},{"verse":38,"text":"como a morte,"},{"verse":39,"text":"e o ciúme é tão duro"},{"verse":40,"text":"como a sepultura."},{"verse":41,"text":"As suas chamas"},{"verse":42,"text":"são chamas de fogo,"},{"verse":43,"text":"são labaredas enormes."},{"verse":44,"text":"As muitas águas não poderiam"},{"verse":45,"text":"apagar o amor,"},{"verse":46,"text":"nem os rios, afogá-lo."},{"verse":47,"text":"Ainda que alguém oferecesse"},{"verse":48,"text":"todos os bens da sua casa"},{"verse":49,"text":"para comprar o amor,"},{"verse":50,"text":"receberia em troca"},{"verse":51,"text":"apenas desprezo."},{"verse":52,"text":"Os irmãos"},{"verse":53,"text":"Temos uma irmãzinha"},{"verse":54,"text":"que ainda não tem seios."},{"verse":55,"text":"Que faremos por esta nossa irmã,"},{"verse":56,"text":"no dia em que for pedida"},{"verse":57,"text":"em casamento?"},{"verse":58,"text":"Se ela fosse uma muralha,"},{"verse":59,"text":"edificaríamos sobre ela"},{"verse":60,"text":"uma torre de prata;"},{"verse":61,"text":"se ela fosse uma porta,"},{"verse":62,"text":"nós a reforçaríamos"},{"verse":63,"text":"com tábuas de cedro."},{"verse":64,"text":"Esposa"},{"verse":65,"text":"Eu sou uma muralha,"},{"verse":66,"text":"e os meus seios,"},{"verse":67,"text":"como as suas torres."},{"verse":68,"text":"Por isso, sou para ele"},{"verse":69,"text":"como aquela que encontra a paz."},{"verse":70,"text":"Coro"},{"verse":71,"text":"Salomão teve uma vinha"},{"verse":72,"text":"em Baal-Hamom."},{"verse":73,"text":"Ele a entregou a uns lavradores,"},{"verse":74,"text":"e cada um lhe trazia pelo seu fruto"},{"verse":75,"text":"mil moedas de prata."},{"verse":76,"text":"Esposa"},{"verse":77,"text":"A minha vinha,"},{"verse":78,"text":"que me pertence,"},{"verse":79,"text":"dessa cuido eu!"},{"verse":80,"text":"Você, Salomão,"},{"verse":81,"text":"terá as suas mil moedas,"},{"verse":82,"text":"e os que guardam o fruto dela,"},{"verse":83,"text":"as suas duzentas."},{"verse":84,"text":"Esposo"},{"verse":85,"text":"Você, que habita nos jardins,"},{"verse":86,"text":"os meus companheiros"},{"verse":87,"text":"querem ouvir a sua voz!"},{"verse":88,"text":"Eu também quero ouvi-la."},{"verse":89,"text":"Esposa"},{"verse":90,"text":"Venha depressa, meu amado,"},{"verse":91,"text":"correndo como um gamo"},{"verse":92,"text":"ou um filho da gazela"},{"verse":93,"text":"sobre os montes perfumados."}]}]}