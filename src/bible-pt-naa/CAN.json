{"chapters":[{"chapter":1,"verses":[{"verse":"1","text":"Cântico dos cânticos de Salomão."},{"verse":"","text":"Primeiro cântico"},{"verse":"","text":"Esposa"},{"verse":"2","text":"Beije-me com os beijos"},{"verse":"","text":"de sua boca!"},{"verse":"","text":"Porque o seu amor"},{"verse":"","text":"é melhor do que o vinho."},{"verse":"3","text":"Suave é o aroma"},{"verse":"","text":"dos seus perfumes;"},{"verse":"","text":"como perfume derramado"},{"verse":"","text":"é o seu nome."},{"verse":"","text":"Por isso, as donzelas o amam."},{"verse":"4","text":"Leve-me com você!"},{"verse":"","text":"Vamos depressa!"},{"verse":"","text":"O rei me introduziu"},{"verse":"","text":"nos seus aposentos."},{"verse":"","text":"Coro"},{"verse":"","text":"Exultaremos e nos alegraremos"},{"verse":"","text":"por sua causa;"},{"verse":"","text":"do seu amor nos lembraremos,"},{"verse":"","text":"mais do que do vinho."},{"verse":"","text":"Não é sem razão que o amam."},{"verse":"","text":"Esposa"},{"verse":"5","text":"Eu sou morena e bonita,"},{"verse":"","text":"ó filhas de Jerusalém,"},{"verse":"","text":"como as tendas de Quedar,"},{"verse":"","text":"como as cortinas de Salomão."},{"verse":"6","text":"Não olhem para a minha"},{"verse":"","text":"pele morena,"},{"verse":"","text":"porque o sol me queimou."},{"verse":"","text":"Os filhos de minha mãe"},{"verse":"","text":"se indignaram contra mim"},{"verse":"","text":"e me puseram por guarda"},{"verse":"","text":"das vinhas;"},{"verse":"","text":"mas a minha vinha,"},{"verse":"","text":"que me pertence,"},{"verse":"","text":"não a guardei."},{"verse":"7","text":"Diga-me, ó amado"},{"verse":"","text":"de minha alma:"},{"verse":"","text":"Onde você apascenta"},{"verse":"","text":"o seu rebanho?"},{"verse":"","text":"Onde você o faz repousar"},{"verse":"","text":"ao meio-dia?"},{"verse":"","text":"Diga, para que eu"},{"verse":"","text":"não ande vagando"},{"verse":"","text":"junto ao rebanho"},{"verse":"","text":"dos seus companheiros."},{"verse":"","text":"Esposo"},{"verse":"8","text":"Se você, a mais bela"},{"verse":"","text":"das mulheres, não o sabe,"},{"verse":"","text":"siga as pisadas dos rebanhos"},{"verse":"","text":"e apascente os seus cabritos"},{"verse":"","text":"junto às tendas dos pastores."},{"verse":"9","text":"Comparo você, minha querida,"},{"verse":"","text":"com as éguas das carruagens"},{"verse":"","text":"de Faraó."},{"verse":"10","text":"O seu rosto fica lindo"},{"verse":"","text":"com os enfeites,"},{"verse":"","text":"o seu pescoço, com os colares."},{"verse":"11","text":"Faremos para você"},{"verse":"","text":"enfeites de ouro,"},{"verse":"","text":"com incrustações de prata."},{"verse":"","text":"Esposa"},{"verse":"12","text":"Enquanto o rei está assentado"},{"verse":"","text":"à sua mesa,"},{"verse":"","text":"o meu nardo exala o seu perfume."},{"verse":"13","text":"O meu amado é para mim"},{"verse":"","text":"como um sachê de mirra,"},{"verse":"","text":"posto entre os meus seios."},{"verse":"14","text":"O meu amado é para mim"},{"verse":"","text":"como um ramalhete"},{"verse":"","text":"de flores de hena"},{"verse":"","text":"nas vinhas de En-Gedi."},{"verse":"","text":"Esposo"},{"verse":"15","text":"Como você é bela,"},{"verse":"","text":"minha querida!"},{"verse":"","text":"Como você é bela!"},{"verse":"","text":"Os seus olhos são como pombas."},{"verse":"","text":"Esposa"},{"verse":"16","text":"Como você é belo, meu amado!"},{"verse":"","text":"Como é encantador!"},{"verse":"","text":"O nosso leito é de viçosa relva."},{"verse":"17","text":"As vigas da nossa casa"},{"verse":"","text":"são os cedros,"},{"verse":"","text":"e o nosso teto são os ciprestes."}]},{"chapter":2,"verses":[{"verse":"1","text":"Eu sou a rosa de Sarom,"},{"verse":"","text":"o lírio dos vales."},{"verse":"","text":"Esposo"},{"verse":"2","text":"Como um lírio entre os espinhos,"},{"verse":"","text":"assim é a minha querida"},{"verse":"","text":"entre as donzelas."},{"verse":"","text":"Esposa"},{"verse":"3","text":"Como a macieira"},{"verse":"","text":"entre as árvores do bosque,"},{"verse":"","text":"assim é o meu amado"},{"verse":"","text":"entre os jovens."},{"verse":"","text":"Desejo muito a sua sombra"},{"verse":"","text":"e debaixo dela me assento,"},{"verse":"","text":"e o seu fruto é doce"},{"verse":"","text":"ao meu paladar."},{"verse":"4","text":"Ele me levou à sala do banquete,"},{"verse":"","text":"e o seu estandarte sobre mim"},{"verse":"","text":"é o amor."},{"verse":"5","text":"Sustentem-me com passas,"},{"verse":"","text":"confortem-me com maçãs,"},{"verse":"","text":"pois estou morrendo de amor."},{"verse":"6","text":"A sua mão esquerda"},{"verse":"","text":"está debaixo da minha cabeça,"},{"verse":"","text":"e a direita me abraça."},{"verse":"7","text":"Filhas de Jerusalém,"},{"verse":"","text":"jurem pelas gazelas"},{"verse":"","text":"e pelas corças selvagens"},{"verse":"","text":"que vocês não acordarão"},{"verse":"","text":"nem despertarão o amor,"},{"verse":"","text":"até que este o queira."},{"verse":"","text":"Segundo cântico"},{"verse":"","text":"Esposa"},{"verse":"8","text":"Ouço a voz do meu amado."},{"verse":"","text":"Eis que ele vem,"},{"verse":"","text":"saltando sobre os montes,"},{"verse":"","text":"pulando sobre as colinas."},{"verse":"9","text":"O meu amado é semelhante"},{"verse":"","text":"ao gamo"},{"verse":"","text":"ou ao filho da gazela."},{"verse":"","text":"Eis que ele está"},{"verse":"","text":"detrás de nossa parede,"},{"verse":"","text":"olhando pelas janelas,"},{"verse":"","text":"espreitando pelas grades."},{"verse":"10","text":"O meu amado fala e me diz:"},{"verse":"","text":"Esposo"},{"verse":"","text":"Levante-se, minha querida,"},{"verse":"","text":"minha linda, e venha comigo."},{"verse":"11","text":"Porque eis que passou o inverno,"},{"verse":"","text":"a chuva cessou e se foi,"},{"verse":"12","text":"aparecem as flores na terra,"},{"verse":"","text":"chegou o tempo"},{"verse":"","text":"de cantarem as aves,"},{"verse":"","text":"e já se ouve a voz"},{"verse":"","text":"da rolinha em nossa terra."},{"verse":"13","text":"A figueira começou"},{"verse":"","text":"a dar seus figos,"},{"verse":"","text":"e as vinhas em flor"},{"verse":"","text":"exalam o seu aroma."},{"verse":"","text":"Levante-se, minha querida,"},{"verse":"","text":"minha linda, e venha comigo."},{"verse":"14","text":"Minha pombinha,"},{"verse":"","text":"escondida nas fendas"},{"verse":"","text":"dos penhascos,"},{"verse":"","text":"no esconderijo"},{"verse":"","text":"das rochas escarpadas,"},{"verse":"","text":"mostre-me o seu rosto,"},{"verse":"","text":"deixe-me ouvir a sua voz;"},{"verse":"","text":"porque a sua voz é doce,"},{"verse":"","text":"e o seu rosto é lindo."},{"verse":"","text":"Esposa"},{"verse":"15","text":"Peguem as raposas,"},{"verse":"","text":"as raposinhas,"},{"verse":"","text":"que devastam os vinhedos,"},{"verse":"","text":"porque as nossas vinhas"},{"verse":"","text":"estão em flor."},{"verse":"16","text":"O meu amado é meu,"},{"verse":"","text":"e eu sou dele;"},{"verse":"","text":"ele apascenta o seu rebanho"},{"verse":"","text":"entre os lírios."},{"verse":"17","text":"Antes que rompa o dia"},{"verse":"","text":"e fujam as sombras,"},{"verse":"","text":"volte, meu amado."},{"verse":"","text":"Venha correndo como o gamo"},{"verse":"","text":"ou o filho das gazelas"},{"verse":"","text":"sobre os montes de Beter."}]},{"chapter":3,"verses":[{"verse":"1","text":"De noite, na minha cama,"},{"verse":"","text":"busquei o amado de minha alma;"},{"verse":"","text":"busquei-o, mas não o achei."},{"verse":"2","text":"Eu me levantarei agora"},{"verse":"","text":"e rodearei a cidade,"},{"verse":"","text":"pelas ruas e pelas praças;"},{"verse":"","text":"buscarei o amado da minha alma."},{"verse":"","text":"Busquei-o, mas não o achei."},{"verse":"3","text":"Os guardas, que rondavam"},{"verse":"","text":"a cidade, me encontraram."},{"verse":"","text":"Então lhes perguntei:"},{"verse":"","text":"\"Vocês viram o amado"},{"verse":"","text":"da minha alma?\""},{"verse":"4","text":"Mal os deixei, encontrei logo"},{"verse":"","text":"o amado da minha alma."},{"verse":"","text":"Agarrei-me a ele"},{"verse":"","text":"e não o deixei ir embora,"},{"verse":"","text":"até que o fiz entrar"},{"verse":"","text":"na casa de minha mãe"},{"verse":"","text":"e no quarto daquela"},{"verse":"","text":"que me concebeu."},{"verse":"5","text":"Filhas de Jerusalém,"},{"verse":"","text":"jurem pelas gazelas"},{"verse":"","text":"e pelas corças selvagens"},{"verse":"","text":"que vocês não acordarão"},{"verse":"","text":"nem despertarão o amor,"},{"verse":"","text":"até que este o queira."},{"verse":"","text":"Terceiro cântico"},{"verse":"","text":"Coro"},{"verse":"6","text":"O que é aquilo que vem"},{"verse":"","text":"subindo do deserto,"},{"verse":"","text":"como colunas de fumaça,"},{"verse":"","text":"perfumado de mirra, de incenso"},{"verse":"","text":"e de todos os tipos"},{"verse":"","text":"de pós aromáticos"},{"verse":"","text":"do mercador?"},{"verse":"7","text":"É a liteira de Salomão."},{"verse":"","text":"Vem escoltada"},{"verse":"","text":"por sessenta valentes,"},{"verse":"","text":"dos melhores valentes de Israel."},{"verse":"8","text":"Todos sabem manejar a espada"},{"verse":"","text":"e são treinados para a guerra;"},{"verse":"","text":"cada um leva a espada na cintura,"},{"verse":"","text":"por causa dos temores noturnos."},{"verse":"9","text":"O rei Salomão mandou fazer"},{"verse":"","text":"um palanquim"},{"verse":"","text":"de madeira do Líbano."},{"verse":"10","text":"As colunas eram de prata,"},{"verse":"","text":"o encosto de ouro,"},{"verse":"","text":"o assento de púrpura,"},{"verse":"","text":"e o interior foi enfeitado"},{"verse":"","text":"com carinho pelas mulheres"},{"verse":"","text":"de Jerusalém."},{"verse":"11","text":"Saiam, ó filhas de Sião,"},{"verse":"","text":"e venham ver o rei Salomão"},{"verse":"","text":"com a coroa"},{"verse":"","text":"com que sua mãe o coroou"},{"verse":"","text":"no dia do seu casamento,"},{"verse":"","text":"no dia da alegria do seu coração."}]},{"chapter":4,"verses":[{"verse":"","text":"Esposo"},{"verse":"1","text":"Como você é bela,"},{"verse":"","text":"minha querida!"},{"verse":"","text":"Como você é linda!"},{"verse":"","text":"Os seus olhos são como pombas"},{"verse":"","text":"e brilham através do véu."},{"verse":"","text":"Os seus cabelos são como"},{"verse":"","text":"um rebanho de cabras"},{"verse":"","text":"que descem ondeantes"},{"verse":"","text":"do monte de Gileade."},{"verse":"2","text":"Os seus dentes são como"},{"verse":"","text":"um rebanho de ovelhas"},{"verse":"","text":"recém-tosquiadas,"},{"verse":"","text":"que sobem do lavadouro;"},{"verse":"","text":"cada uma tem o seu par,"},{"verse":"","text":"e nenhuma está faltando."},{"verse":"3","text":"Os seus lábios são como"},{"verse":"","text":"um fio de escarlate,"},{"verse":"","text":"e a sua boca é linda."},{"verse":"","text":"As suas faces, como romã partida,"},{"verse":"","text":"brilham através do véu."},{"verse":"4","text":"O seu pescoço é como"},{"verse":"","text":"a torre de Davi,"},{"verse":"","text":"edificada para arsenal;"},{"verse":"","text":"mil escudos pendem dela,"},{"verse":"","text":"todos escudos"},{"verse":"","text":"de soldados valentes."},{"verse":"5","text":"Os seus seios são como"},{"verse":"","text":"duas crias gêmeas"},{"verse":"","text":"de uma gazela,"},{"verse":"","text":"que pastam entre os lírios."},{"verse":"6","text":"Antes que rompa o dia,"},{"verse":"","text":"e fujam as sombras,"},{"verse":"","text":"irei ao monte da mirra"},{"verse":"","text":"e à colina do incenso."},{"verse":"7","text":"Você é toda linda,"},{"verse":"","text":"minha querida,"},{"verse":"","text":"e em você não há defeito."},{"verse":"8","text":"Venha comigo do Líbano,"},{"verse":"","text":"minha noiva,"},{"verse":"","text":"venha comigo do Líbano."},{"verse":"","text":"Desça do alto do monte Amana,"},{"verse":"","text":"do alto do Senir e do Hermom,"},{"verse":"","text":"dos covis dos leões,"},{"verse":"","text":"dos montes dos leopardos."},{"verse":"9","text":"Você roubou meu coração,"},{"verse":"","text":"meu amor, minha noiva;"},{"verse":"","text":"roubou meu coração"},{"verse":"","text":"com um só dos seus olhares,"},{"verse":"","text":"com uma só pérola do seu colar."},{"verse":"10","text":"Como são agradáveis"},{"verse":"","text":"as suas carícias,"},{"verse":"","text":"meu amor, minha noiva!"},{"verse":"","text":"O seu amor é melhor"},{"verse":"","text":"do que o vinho,"},{"verse":"","text":"e o aroma do seu perfume"},{"verse":"","text":"é mais suave do que"},{"verse":"","text":"todas as especiarias!"},{"verse":"11","text":"Os seus lábios destilam mel,"},{"verse":"","text":"minha noiva."},{"verse":"","text":"Mel e leite se acham"},{"verse":"","text":"debaixo da sua língua,"},{"verse":"","text":"e o cheiro dos seus vestidos"},{"verse":"","text":"é como o cheiro do Líbano."},{"verse":"12","text":"Meu amor, minha noiva,"},{"verse":"","text":"você é um jardim fechado,"},{"verse":"","text":"um manancial recluso,"},{"verse":"","text":"uma fonte selada."},{"verse":"13","text":"Os seus renovos são"},{"verse":"","text":"um pomar de romãs"},{"verse":"","text":"com frutos excelentes:"},{"verse":"","text":"henas com nardos,"},{"verse":"14","text":"nardo e açafrão,"},{"verse":"","text":"cálamo e cinamomo,"},{"verse":"","text":"com todo tipo"},{"verse":"","text":"de árvores de incenso,"},{"verse":"","text":"mirra e aloés, com todas"},{"verse":"","text":"as principais especiarias."},{"verse":"15","text":"Você é fonte dos jardins,"},{"verse":"","text":"poço de águas vivas"},{"verse":"","text":"que correm do Líbano!"},{"verse":"","text":"Esposa"},{"verse":"16","text":"Desperte, vento norte,"},{"verse":"","text":"e venha, vento sul!"},{"verse":"","text":"Soprem no meu jardim,"},{"verse":"","text":"para que se derramem"},{"verse":"","text":"os seus aromas."},{"verse":"","text":"Que o meu amado venha"},{"verse":"","text":"ao seu jardim"},{"verse":"","text":"e coma os seus frutos excelentes!"}]},{"chapter":5,"verses":[{"verse":"","text":"Esposo"},{"verse":"1","text":"Já entrei no meu jardim,"},{"verse":"","text":"meu amor, minha noiva."},{"verse":"","text":"Colhi a minha mirra"},{"verse":"","text":"com as especiarias,"},{"verse":"","text":"comi o meu favo com o mel,"},{"verse":"","text":"bebi o meu vinho com o leite."},{"verse":"","text":"Coro"},{"verse":"","text":"Comam e bebam, meus amigos;"},{"verse":"","text":"até ficarem embriagados de amor."},{"verse":"","text":"Quarto cântico"},{"verse":"","text":"Esposa"},{"verse":"2","text":"Eu dormia, mas o meu coração"},{"verse":"","text":"estava acordado."},{"verse":"","text":"Eis a voz do meu amado,"},{"verse":"","text":"que está batendo:"},{"verse":"","text":"Esposo"},{"verse":"","text":"Deixe-me entrar,"},{"verse":"","text":"meu amor, minha querida,"},{"verse":"","text":"minha pombinha sem defeito,"},{"verse":"","text":"porque a minha cabeça"},{"verse":"","text":"está cheia de orvalho,"},{"verse":"","text":"e os meus cabelos,"},{"verse":"","text":"das gotas da noite."},{"verse":"","text":"Esposa"},{"verse":"3","text":"Já tirei a minha túnica!"},{"verse":"","text":"Como posso vesti-la outra vez?"},{"verse":"","text":"Já lavei os pés!"},{"verse":"","text":"Como voltar a sujá-los?"},{"verse":"4","text":"O meu amado meteu a mão"},{"verse":"","text":"pela fresta,"},{"verse":"","text":"e o meu coração estremeceu."},{"verse":"5","text":"Eu me levantei para abrir a porta"},{"verse":"","text":"ao meu amado."},{"verse":"","text":"As minhas mãos destilavam mirra,"},{"verse":"","text":"e os meus dedos deixavam"},{"verse":"","text":"escorrer mirra preciosa"},{"verse":"","text":"sobre a tranca da porta."},{"verse":"6","text":"Abri a porta ao meu amado,"},{"verse":"","text":"mas ele já tinha se afastado"},{"verse":"","text":"e ido embora."},{"verse":"","text":"Eu tinha estremecido,"},{"verse":"","text":"quando ele me falou."},{"verse":"","text":"Busquei-o, mas não o achei;"},{"verse":"","text":"chamei-o, mas ele não respondeu."},{"verse":"7","text":"Os guardas, que rondavam"},{"verse":"","text":"a cidade, me encontraram;"},{"verse":"","text":"eles me espancaram e me feriram;"},{"verse":"","text":"os guardas das muralhas"},{"verse":"","text":"tomaram o meu manto."},{"verse":"8","text":"Filhas de Jerusalém, jurem:"},{"verse":"","text":"se encontrarem o meu amado,"},{"verse":"","text":"digam que estou"},{"verse":"","text":"morrendo de amor."},{"verse":"","text":"Coro"},{"verse":"9","text":"O que é que o seu amado tem"},{"verse":"","text":"que os outros não tenham,"},{"verse":"","text":"ó mais bela das mulheres?"},{"verse":"","text":"O que é que o seu amado tem"},{"verse":"","text":"que os outros não tenham,"},{"verse":"","text":"para que você nos faça jurar?"},{"verse":"","text":"Esposa"},{"verse":"10","text":"O meu amado é alvo e rosado,"},{"verse":"","text":"o mais destacado entre dez mil."},{"verse":"11","text":"A sua cabeça é como o ouro"},{"verse":"","text":"mais depurado,"},{"verse":"","text":"os seus cabelos ondulados"},{"verse":"","text":"são pretos como o corvo."},{"verse":"12","text":"Os seus olhos são como pombas"},{"verse":"","text":"junto ao ribeiro,"},{"verse":"","text":"brancas como leite,"},{"verse":"","text":"banhando-se junto"},{"verse":"","text":"às correntes das águas."},{"verse":"13","text":"As suas faces são como"},{"verse":"","text":"canteiros de bálsamo,"},{"verse":"","text":"como colinas de ervas aromáticas."},{"verse":"","text":"Os seus lábios são como lírios"},{"verse":"","text":"que gotejam mirra preciosa."},{"verse":"14","text":"As suas mãos são"},{"verse":"","text":"cilindros de ouro"},{"verse":"","text":"enfeitados de turquesas."},{"verse":"","text":"O seu ventre é como alvo marfim,"},{"verse":"","text":"coberto de safiras."},{"verse":"15","text":"As suas pernas são"},{"verse":"","text":"colunas de mármore,"},{"verse":"","text":"assentadas sobre"},{"verse":"","text":"bases de ouro puro."},{"verse":"","text":"O aspecto do meu amado"},{"verse":"","text":"é como o do Líbano;"},{"verse":"","text":"ele é elegante como os cedros."},{"verse":"16","text":"O seu falar é muito suave;"},{"verse":"","text":"sim, ele é totalmente desejável."},{"verse":"","text":"Assim é o meu amado,"},{"verse":"","text":"assim é o meu esposo,"},{"verse":"","text":"ó filhas de Jerusalém."}]},{"chapter":6,"verses":[{"verse":"","text":"Coro"},{"verse":"1","text":"Para onde foi o seu amado,"},{"verse":"","text":"ó mais bela das mulheres?"},{"verse":"","text":"Que rumo tomou o seu amado,"},{"verse":"","text":"para que a ajudemos"},{"verse":"","text":"a encontrá-lo?"},{"verse":"","text":"Esposa"},{"verse":"2","text":"O meu amado desceu"},{"verse":"","text":"ao seu jardim,"},{"verse":"","text":"aos canteiros de bálsamo,"},{"verse":"","text":"para pastorear nos jardins"},{"verse":"","text":"e para colher os lírios."},{"verse":"3","text":"Eu sou do meu amado,"},{"verse":"","text":"e o meu amado é meu;"},{"verse":"","text":"ele apascenta o seu rebanho"},{"verse":"","text":"entre os lírios."},{"verse":"","text":"Quinto cântico"},{"verse":"","text":"Esposo"},{"verse":"4","text":"Minha querida,"},{"verse":"","text":"você é bonita como Tirza,"},{"verse":"","text":"encantadora como Jerusalém,"},{"verse":"","text":"impressionante como"},{"verse":"","text":"um exército com bandeiras."},{"verse":"5","text":"Desvie de mim os seus olhos,"},{"verse":"","text":"porque eles me perturbam."},{"verse":"","text":"Os seus cabelos são como"},{"verse":"","text":"um rebanho de cabras"},{"verse":"","text":"que descem ondeantes"},{"verse":"","text":"de Gileade."},{"verse":"6","text":"Os seus dentes são como"},{"verse":"","text":"um rebanho de ovelhas"},{"verse":"","text":"que sobem do lavadouro;"},{"verse":"","text":"cada uma tem o seu par,"},{"verse":"","text":"e nenhuma está faltando."},{"verse":"7","text":"As suas faces, como romã partida,"},{"verse":"","text":"brilham através do véu."},{"verse":"8","text":"Sessenta são as rainhas,"},{"verse":"","text":"oitenta, as concubinas,"},{"verse":"","text":"e as virgens, sem número;"},{"verse":"9","text":"mas uma só é a minha pombinha"},{"verse":"","text":"sem defeito,"},{"verse":"","text":"a mais querida da sua mãe,"},{"verse":"","text":"a predileta daquela"},{"verse":"","text":"que a deu à luz."},{"verse":"","text":"As outras mulheres a veem"},{"verse":"","text":"e dizem que ela é feliz;"},{"verse":"","text":"as rainhas e as concubinas"},{"verse":"","text":"a louvam."},{"verse":"","text":"Coro"},{"verse":"10","text":"Quem é esta que aparece"},{"verse":"","text":"como a alva do dia,"},{"verse":"","text":"bonita como a lua,"},{"verse":"","text":"pura como o sol,"},{"verse":"","text":"impressionante como um exército"},{"verse":"","text":"com bandeiras?"},{"verse":"","text":"Esposa"},{"verse":"11","text":"Desci ao jardim das nogueiras,"},{"verse":"","text":"para ver os renovos do vale,"},{"verse":"","text":"para ver se brotavam as videiras,"},{"verse":"","text":"se as romãzeiras estavam em flor."},{"verse":"12","text":"Não sei como,"},{"verse":"","text":"imaginei-me no carro"},{"verse":"","text":"do meu nobre povo!"},{"verse":"","text":"Coro"},{"verse":"13","text":"Volte, volte, sulamita!"},{"verse":"","text":"Volte, volte, para que nós"},{"verse":"","text":"a contemplemos."},{"verse":"","text":"Esposa"},{"verse":"","text":"Por que vocês querem"},{"verse":"","text":"contemplar a sulamita"},{"verse":"","text":"na dança de Maanaim?"}]},{"chapter":7,"verses":[{"verse":"","text":"Esposo"},{"verse":"1","text":"Como são bonitos os seus pés"},{"verse":"","text":"nas sandálias,"},{"verse":"","text":"ó filha do príncipe!"},{"verse":"","text":"As curvas dos seus quadris"},{"verse":"","text":"são como colares trabalhados"},{"verse":"","text":"por mãos de artista."},{"verse":"2","text":"O seu umbigo"},{"verse":"","text":"é uma taça redonda"},{"verse":"","text":"onde nunca falta bebida;"},{"verse":"","text":"o seu ventre é um monte de trigo,"},{"verse":"","text":"cercado de lírios."},{"verse":"3","text":"Os seus seios são como"},{"verse":"","text":"duas crias gêmeas"},{"verse":"","text":"de uma gazela."},{"verse":"4","text":"O seu pescoço é como"},{"verse":"","text":"uma torre de marfim."},{"verse":"","text":"Os seus olhos são como"},{"verse":"","text":"as piscinas de Hesbom,"},{"verse":"","text":"junto ao portão de Bate-Rabim."},{"verse":"","text":"O seu nariz é como"},{"verse":"","text":"a torre do Líbano,"},{"verse":"","text":"voltada para Damasco."},{"verse":"5","text":"A sua cabeça é como"},{"verse":"","text":"o monte Carmelo;"},{"verse":"","text":"os seus cabelos são como"},{"verse":"","text":"a púrpura;"},{"verse":"","text":"um rei está preso nas suas tranças."},{"verse":"6","text":"Como você é linda!"},{"verse":"","text":"Como você é atraente, meu amor,"},{"verse":"","text":"com as suas delícias!"},{"verse":"7","text":"Esse seu porte"},{"verse":"","text":"é semelhante à palmeira,"},{"verse":"","text":"e os seus seios"},{"verse":"","text":"se parecem com os cachos."},{"verse":"8","text":"Eu disse: \"Vou subir na palmeira"},{"verse":"","text":"e colher os seus frutos.\""},{"verse":"","text":"Sejam os seus seios"},{"verse":"","text":"como os cachos de uvas,"},{"verse":"","text":"e o aroma da sua respiração,"},{"verse":"","text":"como o das maçãs."},{"verse":"9","text":"Os seus beijos são"},{"verse":"","text":"como o bom vinho…"},{"verse":"","text":"Esposa"},{"verse":"","text":"… vinho que se escoa suavemente"},{"verse":"","text":"para o meu amado,"},{"verse":"","text":"deslizando entre os seus lábios"},{"verse":"","text":"e dentes."},{"verse":"10","text":"Eu sou do meu amado,"},{"verse":"","text":"e ele tem saudades de mim."},{"verse":"11","text":"Venha, meu amado,"},{"verse":"","text":"vamos para o campo,"},{"verse":"","text":"passemos a noite nas aldeias."},{"verse":"12","text":"Vamos levantar cedo"},{"verse":"","text":"e olhar as parreiras,"},{"verse":"","text":"para ver se já começaram a brotar,"},{"verse":"","text":"se as flores estão se abrindo,"},{"verse":"","text":"se as romãzeiras já estão em flor."},{"verse":"","text":"Ali eu lhe darei o meu amor."},{"verse":"13","text":"As mandrágoras exalam"},{"verse":"","text":"o seu perfume,"},{"verse":"","text":"e às nossas portas há todo tipo"},{"verse":"","text":"de frutos excelentes,"},{"verse":"","text":"frescos e secos,"},{"verse":"","text":"que reservei para você,"},{"verse":"","text":"meu amado."}]},{"chapter":8,"verses":[{"verse":"1","text":"Quem dera que você"},{"verse":"","text":"fosse meu irmão,"},{"verse":"","text":"amamentado aos seios"},{"verse":"","text":"de minha mãe!"},{"verse":"","text":"Se eu o encontrasse na rua,"},{"verse":"","text":"poderia beijá-lo,"},{"verse":"","text":"e não me desprezariam!"},{"verse":"2","text":"Eu o levaria para a casa"},{"verse":"","text":"da minha mãe,"},{"verse":"","text":"e você me ensinaria;"},{"verse":"","text":"eu lhe daria de beber"},{"verse":"","text":"vinho aromático"},{"verse":"","text":"e o suco das minhas romãs."},{"verse":"3","text":"A sua mão esquerda estaria"},{"verse":"","text":"debaixo da minha cabeça,"},{"verse":"","text":"e a sua direita me abraçaria."},{"verse":"4","text":"Filhas de Jerusalém,"},{"verse":"","text":"jurem pelas gazelas"},{"verse":"","text":"e pelas corças selvagens"},{"verse":"","text":"que vocês não acordarão"},{"verse":"","text":"nem despertarão o amor,"},{"verse":"","text":"até que este o queira."},{"verse":"","text":"Sexto cântico"},{"verse":"","text":"Coro"},{"verse":"5","text":"Quem é esta que vem"},{"verse":"","text":"subindo do deserto,"},{"verse":"","text":"apoiada em seu amado?"},{"verse":"","text":"Esposa"},{"verse":"","text":"Debaixo da macieira"},{"verse":"","text":"eu o despertei;"},{"verse":"","text":"ali a sua mãe teve dores de parto,"},{"verse":"","text":"ali esteve com dores"},{"verse":"","text":"aquela que o deu à luz."},{"verse":"6","text":"Ponha-me como selo"},{"verse":"","text":"sobre o seu coração,"},{"verse":"","text":"como selo sobre o seu braço,"},{"verse":"","text":"porque o amor é tão forte"},{"verse":"","text":"como a morte,"},{"verse":"","text":"e o ciúme é tão duro"},{"verse":"","text":"como a sepultura."},{"verse":"","text":"As suas chamas"},{"verse":"","text":"são chamas de fogo,"},{"verse":"","text":"são labaredas enormes."},{"verse":"7","text":"As muitas águas não poderiam"},{"verse":"","text":"apagar o amor,"},{"verse":"","text":"nem os rios, afogá-lo."},{"verse":"","text":"Ainda que alguém oferecesse"},{"verse":"","text":"todos os bens da sua casa"},{"verse":"","text":"para comprar o amor,"},{"verse":"","text":"receberia em troca"},{"verse":"","text":"apenas desprezo."},{"verse":"","text":"Os irmãos"},{"verse":"8","text":"Temos uma irmãzinha"},{"verse":"","text":"que ainda não tem seios."},{"verse":"","text":"Que faremos por esta nossa irmã,"},{"verse":"","text":"no dia em que for pedida"},{"verse":"","text":"em casamento?"},{"verse":"9","text":"Se ela fosse uma muralha,"},{"verse":"","text":"edificaríamos sobre ela"},{"verse":"","text":"uma torre de prata;"},{"verse":"","text":"se ela fosse uma porta,"},{"verse":"","text":"nós a reforçaríamos"},{"verse":"","text":"com tábuas de cedro."},{"verse":"","text":"Esposa"},{"verse":"10","text":"Eu sou uma muralha,"},{"verse":"","text":"e os meus seios,"},{"verse":"","text":"como as suas torres."},{"verse":"","text":"Por isso, sou para ele"},{"verse":"","text":"como aquela que encontra a paz."},{"verse":"","text":"Coro"},{"verse":"11","text":"Salomão teve uma vinha"},{"verse":"","text":"em Baal-Hamom."},{"verse":"","text":"Ele a entregou a uns lavradores,"},{"verse":"","text":"e cada um lhe trazia pelo seu fruto"},{"verse":"","text":"mil moedas de prata."},{"verse":"","text":"Esposa"},{"verse":"12","text":"A minha vinha,"},{"verse":"","text":"que me pertence,"},{"verse":"","text":"dessa cuido eu!"},{"verse":"","text":"Você, Salomão,"},{"verse":"","text":"terá as suas mil moedas,"},{"verse":"","text":"e os que guardam o fruto dela,"},{"verse":"","text":"as suas duzentas."},{"verse":"","text":"Esposo"},{"verse":"13","text":"Você, que habita nos jardins,"},{"verse":"","text":"os meus companheiros"},{"verse":"","text":"querem ouvir a sua voz!"},{"verse":"","text":"Eu também quero ouvi-la."},{"verse":"","text":"Esposa"},{"verse":"14","text":"Venha depressa, meu amado,"},{"verse":"","text":"correndo como um gamo"},{"verse":"","text":"ou um filho da gazela"},{"verse":"","text":"sobre os montes perfumados."}]}]}