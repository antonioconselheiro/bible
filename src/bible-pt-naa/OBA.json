{"chapters":[{"chapter":1,"verses":[{"verse":1,"text":"Visão de Obadias."},{"verse":2,"text":"Deus castigará Edom"},{"verse":3,"text":"Assim diz o"},{"verse":4,"text":"\"Ouvimos uma notícia"},{"verse":5,"text":"vinda do"},{"verse":6,"text":"e um mensageiro foi enviado"},{"verse":7,"text":"às nações para dizer:"},{"verse":8,"text":"‘Preparem-se! Preparem-se"},{"verse":9,"text":"para a guerra contra Edom!’"},{"verse":10,"text":"Eis que fiz de você uma nação"},{"verse":11,"text":"pequena entre as outras,"},{"verse":12,"text":"muito desprezada."},{"verse":13,"text":"O orgulho do seu coração"},{"verse":14,"text":"o enganou."},{"verse":15,"text":"Você vive nas fendas das rochas,"},{"verse":16,"text":"num lugar elevado,"},{"verse":17,"text":"e diz em seu íntimo:"},{"verse":18,"text":"‘Quem poderá me jogar"},{"verse":19,"text":"lá para baixo?’"},{"verse":20,"text":"Ainda que você suba"},{"verse":21,"text":"como a águia"},{"verse":22,"text":"e faça o seu ninho"},{"verse":23,"text":"entre as estrelas,"},{"verse":24,"text":"de lá eu o derrubarei\","},{"verse":25,"text":"diz o"},{"verse":26,"text":"\"Se ladrões o atacassem"},{"verse":27,"text":"ou assaltantes viessem de noite"},{"verse":28,"text":"— como você está destruído! —"},{"verse":29,"text":"não levariam só"},{"verse":30,"text":"o que lhes bastasse?"},{"verse":31,"text":"Se fossem até você"},{"verse":32,"text":"os que colhem uvas,"},{"verse":33,"text":"não deixariam"},{"verse":34,"text":"pelo menos alguns cachos?"},{"verse":35,"text":"Como foram saqueados"},{"verse":36,"text":"os bens de Esaú!"},{"verse":37,"text":"Como foram vasculhados"},{"verse":38,"text":"os seus tesouros escondidos!"},{"verse":39,"text":"Todos os seus aliados, ó Edom,"},{"verse":40,"text":"o empurraram para fora"},{"verse":41,"text":"do seu território."},{"verse":42,"text":"Aqueles que estavam em paz"},{"verse":43,"text":"com você"},{"verse":44,"text":"o enganaram e prevaleceram"},{"verse":45,"text":"contra você."},{"verse":46,"text":"Aqueles que sentam à sua mesa"},{"verse":47,"text":"prepararam uma armadilha"},{"verse":48,"text":"para os seus pés."},{"verse":49,"text":"E não há em Edom entendimento.\""},{"verse":50,"text":"\"Naquele dia\","},{"verse":51,"text":"diz o"},{"verse":52,"text":"\"destruirei os sábios de Edom"},{"verse":53,"text":"e o entendimento"},{"verse":54,"text":"do monte de Esaú."},{"verse":55,"text":"Os seus valentes, ó Temã,"},{"verse":56,"text":"ficarão apavorados,"},{"verse":57,"text":"para que, do monte de Esaú,"},{"verse":58,"text":"todos sejam exterminados"},{"verse":59,"text":"pela matança.\""},{"verse":60,"text":"A violência de Edom contra Jacó"},{"verse":61,"text":"\"Por causa da violência feita"},{"verse":62,"text":"ao seu irmão Jacó,"},{"verse":63,"text":"você ficará coberto de vergonha"},{"verse":64,"text":"e será exterminado para sempre."},{"verse":65,"text":"No dia em que estranhos"},{"verse":66,"text":"levaram os bens"},{"verse":67,"text":"de seu irmão Jacó,"},{"verse":68,"text":"você estava presente;"},{"verse":69,"text":"quando estrangeiros entraram"},{"verse":70,"text":"pelos portões"},{"verse":71,"text":"e lançaram sortes sobre Jerusalém,"},{"verse":72,"text":"você mesmo era um deles."},{"verse":73,"text":"Você não devia ter olhado"},{"verse":74,"text":"com prazer"},{"verse":75,"text":"para o dia do seu irmão,"},{"verse":76,"text":"o dia da sua calamidade."},{"verse":77,"text":"Você não devia ter-se alegrado"},{"verse":78,"text":"pelo que aconteceu"},{"verse":79,"text":"com os filhos de Judá,"},{"verse":80,"text":"no dia da sua ruína."},{"verse":81,"text":"Você não devia ter falado"},{"verse":82,"text":"de boca cheia,"},{"verse":83,"text":"no dia da angústia."},{"verse":84,"text":"Você não devia ter entrado"},{"verse":85,"text":"pelo portão do meu povo,"},{"verse":86,"text":"no dia da sua calamidade."},{"verse":87,"text":"Você não devia ter olhado"},{"verse":88,"text":"com prazer para o seu mal,"},{"verse":89,"text":"no dia da sua calamidade."},{"verse":90,"text":"Você não devia ter posto as mãos"},{"verse":91,"text":"sobre os seus bens,"},{"verse":92,"text":"no dia da sua calamidade."},{"verse":93,"text":"Você não devia ter parado"},{"verse":94,"text":"nas encruzilhadas,"},{"verse":95,"text":"para exterminar"},{"verse":96,"text":"os que escapassem."},{"verse":97,"text":"Você não devia ter entregado"},{"verse":98,"text":"ao inimigo"},{"verse":99,"text":"os que escaparam com vida,"},{"verse":100,"text":"no dia da angústia.\""},{"verse":101,"text":"A restauração e a felicidade de Israel"},{"verse":102,"text":"\"Porque o Dia do"},{"verse":103,"text":"está prestes a vir"},{"verse":104,"text":"sobre todas as nações."},{"verse":105,"text":"Você será tratado da mesma forma"},{"verse":106,"text":"como tratou os outros;"},{"verse":107,"text":"o mal que você fez"},{"verse":108,"text":"cairá sobre a sua cabeça."},{"verse":109,"text":"Porque, assim como vocês"},{"verse":110,"text":"beberam no meu santo monte,"},{"verse":111,"text":"assim todas as nações"},{"verse":112,"text":"beberão sem parar;"},{"verse":113,"text":"irão beber, engolir,"},{"verse":114,"text":"e serão como se"},{"verse":115,"text":"nunca tivessem existido.\""},{"verse":116,"text":"\"Mas, no monte Sião,"},{"verse":117,"text":"haverá livramento."},{"verse":118,"text":"O monte será santo,"},{"verse":119,"text":"e os da casa de Jacó tomarão posse"},{"verse":120,"text":"de sua herança."},{"verse":121,"text":"A casa de Jacó será fogo"},{"verse":122,"text":"e a casa de José será chama,"},{"verse":123,"text":"mas a casa de Esaú será a palha."},{"verse":124,"text":"O fogo e a chama incendiarão"},{"verse":125,"text":"a palha"},{"verse":126,"text":"e a consumirão;"},{"verse":127,"text":"e ninguém mais restará"},{"verse":128,"text":"da casa de Esaú,"},{"verse":129,"text":"porque o"},{"verse":130,"text":"\"Os de Neguebe tomarão posse"},{"verse":131,"text":"do monte de Esaú,"},{"verse":132,"text":"e os da Sefelá ocuparão"},{"verse":133,"text":"o território dos filisteus;"},{"verse":134,"text":"tomarão posse também"},{"verse":135,"text":"dos campos de Efraim"},{"verse":136,"text":"e dos campos de Samaria;"},{"verse":137,"text":"e Benjamim tomará posse"},{"verse":138,"text":"de Gileade."},{"verse":139,"text":"Os cativos do exército"},{"verse":140,"text":"dos filhos de Israel"},{"verse":141,"text":"tomarão posse do território"},{"verse":142,"text":"dos cananeus até Sarepta,"},{"verse":143,"text":"e os cativos de Jerusalém,"},{"verse":144,"text":"que estão em Sefarade,"},{"verse":145,"text":"tomarão posse das cidades do Sul."},{"verse":146,"text":"Salvadores hão de subir"},{"verse":147,"text":"ao monte Sião,"},{"verse":148,"text":"para julgarem o monte de Esaú;"},{"verse":149,"text":"e o reino será do"}]}]}