{"chapters":[{"chapter":1,"verses":[{"verse":1,"text":"Palavra do"},{"verse":2,"text":"Ameaças contra Judá e Jerusalém"},{"verse":3,"text":"\"Certamente consumirei"},{"verse":4,"text":"todas as coisas"},{"verse":5,"text":"sobre a face da terra\","},{"verse":6,"text":"diz o"},{"verse":7,"text":"\"Consumirei as pessoas"},{"verse":8,"text":"e os animais,"},{"verse":9,"text":"consumirei as aves do céu,"},{"verse":10,"text":"os peixes do mar,"},{"verse":11,"text":"e as ofensas com os ímpios."},{"verse":12,"text":"E exterminarei os seres humanos"},{"verse":13,"text":"da face da terra\","},{"verse":14,"text":"diz o"},{"verse":15,"text":"\"Estenderei a mão contra Judá"},{"verse":16,"text":"e contra todos os moradores"},{"verse":17,"text":"de Jerusalém."},{"verse":18,"text":"Exterminarei deste lugar"},{"verse":19,"text":"o resto de Baal"},{"verse":20,"text":"e a lembrança"},{"verse":21,"text":"dos ministros dos ídolos"},{"verse":22,"text":"e seus sacerdotes."},{"verse":23,"text":"Exterminarei os que"},{"verse":24,"text":"sobre os terraços adoram"},{"verse":25,"text":"o exército do céu"},{"verse":26,"text":"e os que adoram o"},{"verse":27,"text":"e juram por ele"},{"verse":28,"text":"e também por Milcom."},{"verse":29,"text":"Farei desaparecer também"},{"verse":30,"text":"os que deixam de seguir o"},{"verse":31,"text":"e os que não buscam o"},{"verse":32,"text":"nem perguntam por ele.\""},{"verse":33,"text":"O dia da ira do Senhor"},{"verse":34,"text":"\"Calem-se diante"},{"verse":35,"text":"do"},{"verse":36,"text":"porque o Dia do"},{"verse":37,"text":"O"},{"verse":38,"text":"e santificou os seus convidados."},{"verse":39,"text":"No dia do sacrifício do"},{"verse":40,"text":"hei de castigar as autoridades,"},{"verse":41,"text":"e os filhos do rei,"},{"verse":42,"text":"e todos os que se vestem"},{"verse":43,"text":"como estrangeiros."},{"verse":44,"text":"Castigarei também, naquele dia,"},{"verse":45,"text":"todos aqueles que sobem"},{"verse":46,"text":"o pedestal dos ídolos"},{"verse":47,"text":"e enchem de violência e engano"},{"verse":48,"text":"a casa dos seus senhores.\""},{"verse":49,"text":"\"Naquele dia\","},{"verse":50,"text":"diz o"},{"verse":51,"text":"\"se ouvirá um grito"},{"verse":52,"text":"desde o Portão dos Peixes,"},{"verse":53,"text":"e um uivo desde a parte nova da cidade,"},{"verse":54,"text":"e grande lamento desde as colinas."},{"verse":55,"text":"Lamentem, moradores"},{"verse":56,"text":"da cidade baixa,"},{"verse":57,"text":"porque todos os comerciantes"},{"verse":58,"text":"serão mortos"},{"verse":59,"text":"e todos os que pesam prata"},{"verse":60,"text":"serão destruídos."},{"verse":61,"text":"Naquele tempo, vasculharei"},{"verse":62,"text":"Jerusalém com lanternas"},{"verse":63,"text":"e castigarei aqueles"},{"verse":64,"text":"que estão apegados"},{"verse":65,"text":"à borra do vinho"},{"verse":66,"text":"e dizem no seu coração:"},{"verse":67,"text":"‘O"},{"verse":68,"text":"nem faz mal.’"},{"verse":69,"text":"Por isso, os bens deles"},{"verse":70,"text":"serão saqueados,"},{"verse":71,"text":"e as suas casas serão destruídas."},{"verse":72,"text":"Eles construirão casas,"},{"verse":73,"text":"mas não habitarão nelas;"},{"verse":74,"text":"plantarão vinhas,"},{"verse":75,"text":"mas não beberão o vinho.\""},{"verse":76,"text":"\"Está perto"},{"verse":77,"text":"o grande Dia do"},{"verse":78,"text":"está perto"},{"verse":79,"text":"e vem chegando depressa."},{"verse":80,"text":"Atenção!"},{"verse":81,"text":"O Dia do"},{"verse":82,"text":"e nele clamarão até os poderosos."},{"verse":83,"text":"Aquele dia será um dia de ira,"},{"verse":84,"text":"dia de angústia e tribulação,"},{"verse":85,"text":"dia de ruína e destruição,"},{"verse":86,"text":"dia de trevas e escuridão,"},{"verse":87,"text":"dia de nuvens e densas trevas,"},{"verse":88,"text":"dia de toque de trombeta"},{"verse":89,"text":"e gritos de guerra"},{"verse":90,"text":"contra as cidades fortificadas"},{"verse":91,"text":"e contra as torres altas."},{"verse":92,"text":"Trarei angústia"},{"verse":93,"text":"sobre as pessoas,"},{"verse":94,"text":"e elas andarão como se estivessem cegas,"},{"verse":95,"text":"porque pecaram contra o"},{"verse":96,"text":"O sangue dessas pessoas"},{"verse":97,"text":"será derramado como pó,"},{"verse":98,"text":"e a sua carne será espalhada"},{"verse":99,"text":"como esterco."},{"verse":100,"text":"Nem a prata nem o ouro"},{"verse":101,"text":"poderão livrá-las"},{"verse":102,"text":"no dia da ira do"},{"verse":103,"text":"mas, pelo fogo do seu zelo,"},{"verse":104,"text":"a terra será consumida."},{"verse":105,"text":"Porque ele certamente fará"},{"verse":106,"text":"destruição total e repentina"},{"verse":107,"text":"de todos os moradores da terra.\""}]},{"chapter":2,"verses":[{"verse":0,"text":"Convite ao arrependimento"},{"verse":1,"text":"Reúna-se e concentre-se,"},{"verse":2,"text":"ó nação sem pudor,"},{"verse":3,"text":"antes que saia o decreto"},{"verse":4,"text":"e o dia se vá como a palha,"},{"verse":5,"text":"antes que venha sobre você"},{"verse":6,"text":"o furor da ira do"},{"verse":7,"text":"sim, antes que venha sobre você"},{"verse":8,"text":"o dia da ira do"},{"verse":9,"text":"Busquem o"},{"verse":10,"text":"todos vocês,"},{"verse":11,"text":"os humildes da terra,"},{"verse":12,"text":"que cumprem"},{"verse":13,"text":"os seus mandamentos."},{"verse":14,"text":"Busquem a justiça,"},{"verse":15,"text":"busquem a humildade."},{"verse":16,"text":"Talvez assim vocês sejam poupados"},{"verse":17,"text":"no dia da ira do"},{"verse":18,"text":"Ameaças contra os filisteus"},{"verse":19,"text":"Porque Gaza será abandonada,"},{"verse":20,"text":"e Asquelom ficará deserta;"},{"verse":21,"text":"Asdode, ao meio-dia, será expulsa,"},{"verse":22,"text":"e Ecrom será desarraigada."},{"verse":23,"text":"Ai dos que habitam no litoral,"},{"verse":24,"text":"do povo dos queretitas!"},{"verse":25,"text":"A palavra do"},{"verse":26,"text":"será contra você,"},{"verse":27,"text":"Canaã, terra dos filisteus."},{"verse":28,"text":"\"Farei com que"},{"verse":29,"text":"você seja destruída,"},{"verse":30,"text":"até que não reste"},{"verse":31,"text":"um morador sequer.\""},{"verse":32,"text":"O litoral será de pastagens,"},{"verse":33,"text":"com refúgios para os pastores"},{"verse":34,"text":"e currais para os rebanhos."},{"verse":35,"text":"O litoral pertencerá"},{"verse":36,"text":"ao remanescente"},{"verse":37,"text":"da casa de Judá."},{"verse":38,"text":"Ali apascentarão os seus rebanhos"},{"verse":39,"text":"e, ao anoitecer, se deitarão"},{"verse":40,"text":"nas casas de Asquelom;"},{"verse":41,"text":"porque o"},{"verse":42,"text":"os visitará"},{"verse":43,"text":"e mudará a sorte deles."},{"verse":44,"text":"Ameaças contra Moabe e Amom"},{"verse":45,"text":"\"Ouvi a zombaria de Moabe"},{"verse":46,"text":"e as palavras injuriosas"},{"verse":47,"text":"dos filhos de Amom,"},{"verse":48,"text":"que zombaram do meu povo"},{"verse":49,"text":"e se gabaram"},{"verse":50,"text":"contra o seu território."},{"verse":51,"text":"Portanto, tão certo como eu vivo\","},{"verse":52,"text":"diz o"},{"verse":53,"text":"o Deus de Israel,"},{"verse":54,"text":"\"Moabe será como Sodoma,"},{"verse":55,"text":"e os filhos de Amom,"},{"verse":56,"text":"como Gomorra,"},{"verse":57,"text":"campo de urtigas, poços de sal"},{"verse":58,"text":"e desolação perpétua."},{"verse":59,"text":"O remanescente do meu povo"},{"verse":60,"text":"os saqueará,"},{"verse":61,"text":"e os sobreviventes da minha nação"},{"verse":62,"text":"tomarão posse"},{"verse":63,"text":"dos seus territórios.\""},{"verse":64,"text":"Isso lhes sobrevirá"},{"verse":65,"text":"por causa do seu orgulho,"},{"verse":66,"text":"porque zombaram e se gabaram"},{"verse":67,"text":"contra o povo"},{"verse":68,"text":"do"},{"verse":69,"text":"O"},{"verse":70,"text":"contra eles,"},{"verse":71,"text":"porque aniquilará"},{"verse":72,"text":"todos os deuses da terra."},{"verse":73,"text":"E todos os povos das nações,"},{"verse":74,"text":"cada um do seu lugar, o adorarão."},{"verse":75,"text":"Ameaças contra a Etiópia e a Assíria"},{"verse":76,"text":"Também vocês, ó etíopes,"},{"verse":77,"text":"serão mortos pela"},{"verse":78,"text":"espada do"},{"verse":79,"text":"Ele estenderá também"},{"verse":80,"text":"a mão contra o Norte"},{"verse":81,"text":"e destruirá a Assíria;"},{"verse":82,"text":"e fará de Nínive uma desolação"},{"verse":83,"text":"e terra seca como o deserto."},{"verse":84,"text":"No meio dessa cidade,"},{"verse":85,"text":"repousarão os rebanhos"},{"verse":86,"text":"e todo tipo de animais."},{"verse":87,"text":"Nos capitéis das colunas"},{"verse":88,"text":"se alojarão"},{"verse":89,"text":"tanto o pelicano como o ouriço."},{"verse":90,"text":"A voz das aves ressoará nas janelas."},{"verse":91,"text":"Haverá escombros"},{"verse":92,"text":"nos umbrais das portas,"},{"verse":93,"text":"porque o madeiramento de cedro"},{"verse":94,"text":"será arrancado."},{"verse":95,"text":"Esta é a cidade"},{"verse":96,"text":"alegre e confiante,"},{"verse":97,"text":"que dizia consigo mesma:"},{"verse":98,"text":"\"Eu sou a única,"},{"verse":99,"text":"e não há outra além de mim.\""},{"verse":100,"text":"Como se tornou em desolação,"},{"verse":101,"text":"em pousada de animais!"},{"verse":102,"text":"Todos os que passarem por ela"},{"verse":103,"text":"hão de vaiar"},{"verse":104,"text":"e farão gestos de desprezo."}]},{"chapter":3,"verses":[{"verse":0,"text":"Ameaças contra Jerusalém"},{"verse":1,"text":"Ai da cidade opressora,"},{"verse":2,"text":"rebelde e manchada!"},{"verse":3,"text":"Não atende ninguém,"},{"verse":4,"text":"não aceita disciplina,"},{"verse":5,"text":"não confia no"},{"verse":6,"text":"nem se aproxima do seu Deus."},{"verse":7,"text":"Os seus príncipes"},{"verse":8,"text":"são leões rugidores"},{"verse":9,"text":"no meio dela,"},{"verse":10,"text":"os seus juízes"},{"verse":11,"text":"são lobos do anoitecer,"},{"verse":12,"text":"que não deixam os ossos"},{"verse":13,"text":"para serem roídos no dia seguinte."},{"verse":14,"text":"Os seus profetas"},{"verse":15,"text":"são levianos e falsos."},{"verse":16,"text":"Os seus sacerdotes"},{"verse":17,"text":"profanam o santuário"},{"verse":18,"text":"e fazem violência à lei."},{"verse":19,"text":"O"},{"verse":20,"text":"no meio da cidade;"},{"verse":21,"text":"ele não comete injustiça."},{"verse":22,"text":"Manhã após manhã,"},{"verse":23,"text":"ele traz o seu juízo à luz;"},{"verse":24,"text":"não falha."},{"verse":25,"text":"Mas o injusto não sabe"},{"verse":26,"text":"o que é vergonha."},{"verse":27,"text":"\"Exterminei nações."},{"verse":28,"text":"As suas torres estão destruídas."},{"verse":29,"text":"Tornei desertas as suas praças,"},{"verse":30,"text":"a ponto de não haver"},{"verse":31,"text":"quem passe por elas."},{"verse":32,"text":"As suas cidades foram destruídas,"},{"verse":33,"text":"de maneira que não há ninguém,"},{"verse":34,"text":"ninguém que as habite."},{"verse":35,"text":"Eu dizia:"},{"verse":36,"text":"‘Certamente você, Jerusalém,"},{"verse":37,"text":"viverá em temor diante de mim"},{"verse":38,"text":"e aceitará a disciplina,"},{"verse":39,"text":"e, assim, a sua morada"},{"verse":40,"text":"não seria destruída,"},{"verse":41,"text":"segundo o que eu"},{"verse":42,"text":"havia determinado.’"},{"verse":43,"text":"Mas eles se tornaram"},{"verse":44,"text":"cada vez mais corruptos"},{"verse":45,"text":"em todos os seus atos.\""},{"verse":46,"text":"A salvação da filha de Jerusalém"},{"verse":47,"text":"\"Portanto, esperem por mim\","},{"verse":48,"text":"diz o"},{"verse":49,"text":"\"esperem pelo dia"},{"verse":50,"text":"em que eu me levantar"},{"verse":51,"text":"para tomar o despojo."},{"verse":52,"text":"Porque a minha resolução"},{"verse":53,"text":"é ajuntar as nações"},{"verse":54,"text":"e congregar os reinos,"},{"verse":55,"text":"para fazer cair sobre eles"},{"verse":56,"text":"a minha indignação"},{"verse":57,"text":"e todo o furor da minha ira."},{"verse":58,"text":"Porque toda esta terra"},{"verse":59,"text":"será consumida"},{"verse":60,"text":"pelo fogo do meu zelo.\""},{"verse":61,"text":"\"Então darei lábios puros"},{"verse":62,"text":"aos povos,"},{"verse":63,"text":"para que todos invoquem"},{"verse":64,"text":"o nome do"},{"verse":65,"text":"e o sirvam de comum acordo."},{"verse":66,"text":"Dalém dos rios da Etiópia,"},{"verse":67,"text":"os meus adoradores,"},{"verse":68,"text":"que constituem"},{"verse":69,"text":"a filha da minha dispersão,"},{"verse":70,"text":"me trarão sacrifícios."},{"verse":71,"text":"Naquele dia, você não terá"},{"verse":72,"text":"de se envergonhar"},{"verse":73,"text":"de nenhuma das suas rebeliões"},{"verse":74,"text":"contra mim,"},{"verse":75,"text":"porque tirarei do meio de você,"},{"verse":76,"text":"Jerusalém,"},{"verse":77,"text":"os que exultam no seu orgulho,"},{"verse":78,"text":"e você nunca mais se orgulhará"},{"verse":79,"text":"no meu santo monte."},{"verse":80,"text":"Mas deixarei no meio de você"},{"verse":81,"text":"um povo modesto e humilde,"},{"verse":82,"text":"que confia no nome do"},{"verse":83,"text":"O remanescente de Israel"},{"verse":84,"text":"não cometerá injustiça."},{"verse":85,"text":"Eles não proferirão mentira,"},{"verse":86,"text":"e da sua boca não sairão palavras"},{"verse":87,"text":"enganosas,"},{"verse":88,"text":"porque serão apascentados,"},{"verse":89,"text":"se deitarão,"},{"verse":90,"text":"e não haverá quem os atemorize.\""},{"verse":91,"text":"Cante, ó filha de Sião!"},{"verse":92,"text":"Grite de alegria, ó Israel!"},{"verse":93,"text":"Alegre-se e exulte"},{"verse":94,"text":"de todo o coração,"},{"verse":95,"text":"ó filha de Jerusalém."},{"verse":96,"text":"O"},{"verse":97,"text":"que eram contra você"},{"verse":98,"text":"e afastou os seus inimigos."},{"verse":99,"text":"O Rei de Israel, o"},{"verse":100,"text":"está no meio de você;"},{"verse":101,"text":"você não precisa mais temer"},{"verse":102,"text":"nenhum mal."},{"verse":103,"text":"Naquele dia, se dirá a Jerusalém:"},{"verse":104,"text":"\"Não tenha medo, ó Sião,"},{"verse":105,"text":"não desfaleçam as suas mãos.\""},{"verse":106,"text":"O"},{"verse":107,"text":"está no meio de você,"},{"verse":108,"text":"poderoso para salvar."},{"verse":109,"text":"Ele ficará muito contente"},{"verse":110,"text":"com você."},{"verse":111,"text":"Ele a renovará no seu amor,"},{"verse":112,"text":"e se encherá de júbilo"},{"verse":113,"text":"por causa de você."},{"verse":114,"text":"\"Congregarei"},{"verse":115,"text":"os que estão entristecidos"},{"verse":116,"text":"por se acharem afastados"},{"verse":117,"text":"das festas solenes,"},{"verse":118,"text":"estes que são do seu meio"},{"verse":119,"text":"e sobre os quais pesam afrontas."},{"verse":120,"text":"Eis que, naquele tempo,"},{"verse":121,"text":"agirei contra todos"},{"verse":122,"text":"os que a afligem."},{"verse":123,"text":"Salvarei os que coxeiam"},{"verse":124,"text":"e recolherei os que foram expulsos."},{"verse":125,"text":"Farei deles um louvor e um nome"},{"verse":126,"text":"em toda a terra"},{"verse":127,"text":"em que foram envergonhados."},{"verse":128,"text":"Naquele tempo,"},{"verse":129,"text":"farei com que vocês voltem"},{"verse":130,"text":"e os recolherei."},{"verse":131,"text":"Certamente farei de vocês"},{"verse":132,"text":"um nome e um louvor"},{"verse":133,"text":"entre todos os povos"},{"verse":134,"text":"da terra,"},{"verse":135,"text":"quando eu restaurar"},{"verse":136,"text":"a sorte de vocês"},{"verse":137,"text":"diante dos seus próprios olhos\","},{"verse":138,"text":"diz o"}]}]}