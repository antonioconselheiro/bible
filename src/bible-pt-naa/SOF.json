{"chapters":[[{"verse":"1","text":"Palavra do"},{"verse":"","text":"Ameaças contra Judá e Jerusalém"},{"verse":"2","text":"\"Certamente consumirei"},{"verse":"","text":"todas as coisas"},{"verse":"","text":"sobre a face da terra\","},{"verse":"","text":"diz o"},{"verse":"3","text":"\"Consumirei as pessoas"},{"verse":"","text":"e os animais,"},{"verse":"","text":"consumirei as aves do céu,"},{"verse":"","text":"os peixes do mar,"},{"verse":"","text":"e as ofensas com os ímpios."},{"verse":"","text":"E exterminarei os seres humanos"},{"verse":"","text":"da face da terra\","},{"verse":"","text":"diz o"},{"verse":"4","text":"\"Estenderei a mão contra Judá"},{"verse":"","text":"e contra todos os moradores"},{"verse":"","text":"de Jerusalém."},{"verse":"","text":"Exterminarei deste lugar"},{"verse":"","text":"o resto de Baal"},{"verse":"","text":"e a lembrança"},{"verse":"","text":"dos ministros dos ídolos"},{"verse":"","text":"e seus sacerdotes."},{"verse":"5","text":"Exterminarei os que"},{"verse":"","text":"sobre os terraços adoram"},{"verse":"","text":"o exército do céu"},{"verse":"","text":"e os que adoram o"},{"verse":"","text":"e juram por ele"},{"verse":"","text":"e também por Milcom."},{"verse":"6","text":"Farei desaparecer também"},{"verse":"","text":"os que deixam de seguir o"},{"verse":"","text":"e os que não buscam o"},{"verse":"","text":"nem perguntam por ele.\""},{"verse":"","text":"O dia da ira do Senhor"},{"verse":"7","text":"\"Calem-se diante"},{"verse":"","text":"do"},{"verse":"","text":"porque o Dia do"},{"verse":"","text":"O"},{"verse":"","text":"e santificou os seus convidados."},{"verse":"8","text":"No dia do sacrifício do"},{"verse":"","text":"hei de castigar as autoridades,"},{"verse":"","text":"e os filhos do rei,"},{"verse":"","text":"e todos os que se vestem"},{"verse":"","text":"como estrangeiros."},{"verse":"9","text":"Castigarei também, naquele dia,"},{"verse":"","text":"todos aqueles que sobem"},{"verse":"","text":"o pedestal dos ídolos"},{"verse":"","text":"e enchem de violência e engano"},{"verse":"","text":"a casa dos seus senhores.\""},{"verse":"10","text":"\"Naquele dia\","},{"verse":"","text":"diz o"},{"verse":"","text":"\"se ouvirá um grito"},{"verse":"","text":"desde o Portão dos Peixes,"},{"verse":"","text":"e um uivo desde a parte nova da cidade,"},{"verse":"","text":"e grande lamento desde as colinas."},{"verse":"11","text":"Lamentem, moradores"},{"verse":"","text":"da cidade baixa,"},{"verse":"","text":"porque todos os comerciantes"},{"verse":"","text":"serão mortos"},{"verse":"","text":"e todos os que pesam prata"},{"verse":"","text":"serão destruídos."},{"verse":"12","text":"Naquele tempo, vasculharei"},{"verse":"","text":"Jerusalém com lanternas"},{"verse":"","text":"e castigarei aqueles"},{"verse":"","text":"que estão apegados"},{"verse":"","text":"à borra do vinho"},{"verse":"","text":"e dizem no seu coração:"},{"verse":"","text":"‘O"},{"verse":"","text":"nem faz mal.’"},{"verse":"13","text":"Por isso, os bens deles"},{"verse":"","text":"serão saqueados,"},{"verse":"","text":"e as suas casas serão destruídas."},{"verse":"","text":"Eles construirão casas,"},{"verse":"","text":"mas não habitarão nelas;"},{"verse":"","text":"plantarão vinhas,"},{"verse":"","text":"mas não beberão o vinho.\""},{"verse":"14","text":"\"Está perto"},{"verse":"","text":"o grande Dia do"},{"verse":"","text":"está perto"},{"verse":"","text":"e vem chegando depressa."},{"verse":"","text":"Atenção!"},{"verse":"","text":"O Dia do"},{"verse":"","text":"e nele clamarão até os poderosos."},{"verse":"15","text":"Aquele dia será um dia de ira,"},{"verse":"","text":"dia de angústia e tribulação,"},{"verse":"","text":"dia de ruína e destruição,"},{"verse":"","text":"dia de trevas e escuridão,"},{"verse":"","text":"dia de nuvens e densas trevas,"},{"verse":"16","text":"dia de toque de trombeta"},{"verse":"","text":"e gritos de guerra"},{"verse":"","text":"contra as cidades fortificadas"},{"verse":"","text":"e contra as torres altas."},{"verse":"17","text":"Trarei angústia"},{"verse":"","text":"sobre as pessoas,"},{"verse":"","text":"e elas andarão como se estivessem cegas,"},{"verse":"","text":"porque pecaram contra o"},{"verse":"","text":"O sangue dessas pessoas"},{"verse":"","text":"será derramado como pó,"},{"verse":"","text":"e a sua carne será espalhada"},{"verse":"","text":"como esterco."},{"verse":"18","text":"Nem a prata nem o ouro"},{"verse":"","text":"poderão livrá-las"},{"verse":"","text":"no dia da ira do"},{"verse":"","text":"mas, pelo fogo do seu zelo,"},{"verse":"","text":"a terra será consumida."},{"verse":"","text":"Porque ele certamente fará"},{"verse":"","text":"destruição total e repentina"},{"verse":"","text":"de todos os moradores da terra.\""}],[{"verse":"","text":"Convite ao arrependimento"},{"verse":"1","text":"Reúna-se e concentre-se,"},{"verse":"","text":"ó nação sem pudor,"},{"verse":"2","text":"antes que saia o decreto"},{"verse":"","text":"e o dia se vá como a palha,"},{"verse":"","text":"antes que venha sobre você"},{"verse":"","text":"o furor da ira do"},{"verse":"","text":"sim, antes que venha sobre você"},{"verse":"","text":"o dia da ira do"},{"verse":"3","text":"Busquem o"},{"verse":"","text":"todos vocês,"},{"verse":"","text":"os humildes da terra,"},{"verse":"","text":"que cumprem"},{"verse":"","text":"os seus mandamentos."},{"verse":"","text":"Busquem a justiça,"},{"verse":"","text":"busquem a humildade."},{"verse":"","text":"Talvez assim vocês sejam poupados"},{"verse":"","text":"no dia da ira do"},{"verse":"","text":"Ameaças contra os filisteus"},{"verse":"4","text":"Porque Gaza será abandonada,"},{"verse":"","text":"e Asquelom ficará deserta;"},{"verse":"","text":"Asdode, ao meio-dia, será expulsa,"},{"verse":"","text":"e Ecrom será desarraigada."},{"verse":"5","text":"Ai dos que habitam no litoral,"},{"verse":"","text":"do povo dos queretitas!"},{"verse":"","text":"A palavra do"},{"verse":"","text":"será contra você,"},{"verse":"","text":"Canaã, terra dos filisteus."},{"verse":"","text":"\"Farei com que"},{"verse":"","text":"você seja destruída,"},{"verse":"","text":"até que não reste"},{"verse":"","text":"um morador sequer.\""},{"verse":"6","text":"O litoral será de pastagens,"},{"verse":"","text":"com refúgios para os pastores"},{"verse":"","text":"e currais para os rebanhos."},{"verse":"7","text":"O litoral pertencerá"},{"verse":"","text":"ao remanescente"},{"verse":"","text":"da casa de Judá."},{"verse":"","text":"Ali apascentarão os seus rebanhos"},{"verse":"","text":"e, ao anoitecer, se deitarão"},{"verse":"","text":"nas casas de Asquelom;"},{"verse":"","text":"porque o"},{"verse":"","text":"os visitará"},{"verse":"","text":"e mudará a sorte deles."},{"verse":"","text":"Ameaças contra Moabe e Amom"},{"verse":"8","text":"\"Ouvi a zombaria de Moabe"},{"verse":"","text":"e as palavras injuriosas"},{"verse":"","text":"dos filhos de Amom,"},{"verse":"","text":"que zombaram do meu povo"},{"verse":"","text":"e se gabaram"},{"verse":"","text":"contra o seu território."},{"verse":"9","text":"Portanto, tão certo como eu vivo\","},{"verse":"","text":"diz o"},{"verse":"","text":"o Deus de Israel,"},{"verse":"","text":"\"Moabe será como Sodoma,"},{"verse":"","text":"e os filhos de Amom,"},{"verse":"","text":"como Gomorra,"},{"verse":"","text":"campo de urtigas, poços de sal"},{"verse":"","text":"e desolação perpétua."},{"verse":"","text":"O remanescente do meu povo"},{"verse":"","text":"os saqueará,"},{"verse":"","text":"e os sobreviventes da minha nação"},{"verse":"","text":"tomarão posse"},{"verse":"","text":"dos seus territórios.\""},{"verse":"10","text":"Isso lhes sobrevirá"},{"verse":"","text":"por causa do seu orgulho,"},{"verse":"","text":"porque zombaram e se gabaram"},{"verse":"","text":"contra o povo"},{"verse":"","text":"do"},{"verse":"11","text":"O"},{"verse":"","text":"contra eles,"},{"verse":"","text":"porque aniquilará"},{"verse":"","text":"todos os deuses da terra."},{"verse":"","text":"E todos os povos das nações,"},{"verse":"","text":"cada um do seu lugar, o adorarão."},{"verse":"","text":"Ameaças contra a Etiópia e a Assíria"},{"verse":"12","text":"Também vocês, ó etíopes,"},{"verse":"","text":"serão mortos pela"},{"verse":"","text":"espada do"},{"verse":"13","text":"Ele estenderá também"},{"verse":"","text":"a mão contra o Norte"},{"verse":"","text":"e destruirá a Assíria;"},{"verse":"","text":"e fará de Nínive uma desolação"},{"verse":"","text":"e terra seca como o deserto."},{"verse":"14","text":"No meio dessa cidade,"},{"verse":"","text":"repousarão os rebanhos"},{"verse":"","text":"e todo tipo de animais."},{"verse":"","text":"Nos capitéis das colunas"},{"verse":"","text":"se alojarão"},{"verse":"","text":"tanto o pelicano como o ouriço."},{"verse":"","text":"A voz das aves ressoará nas janelas."},{"verse":"","text":"Haverá escombros"},{"verse":"","text":"nos umbrais das portas,"},{"verse":"","text":"porque o madeiramento de cedro"},{"verse":"","text":"será arrancado."},{"verse":"15","text":"Esta é a cidade"},{"verse":"","text":"alegre e confiante,"},{"verse":"","text":"que dizia consigo mesma:"},{"verse":"","text":"\"Eu sou a única,"},{"verse":"","text":"e não há outra além de mim.\""},{"verse":"","text":"Como se tornou em desolação,"},{"verse":"","text":"em pousada de animais!"},{"verse":"","text":"Todos os que passarem por ela"},{"verse":"","text":"hão de vaiar"},{"verse":"","text":"e farão gestos de desprezo."}],[{"verse":"","text":"Ameaças contra Jerusalém"},{"verse":"1","text":"Ai da cidade opressora,"},{"verse":"","text":"rebelde e manchada!"},{"verse":"2","text":"Não atende ninguém,"},{"verse":"","text":"não aceita disciplina,"},{"verse":"","text":"não confia no"},{"verse":"","text":"nem se aproxima do seu Deus."},{"verse":"3","text":"Os seus príncipes"},{"verse":"","text":"são leões rugidores"},{"verse":"","text":"no meio dela,"},{"verse":"","text":"os seus juízes"},{"verse":"","text":"são lobos do anoitecer,"},{"verse":"","text":"que não deixam os ossos"},{"verse":"","text":"para serem roídos no dia seguinte."},{"verse":"4","text":"Os seus profetas"},{"verse":"","text":"são levianos e falsos."},{"verse":"","text":"Os seus sacerdotes"},{"verse":"","text":"profanam o santuário"},{"verse":"","text":"e fazem violência à lei."},{"verse":"5","text":"O"},{"verse":"","text":"no meio da cidade;"},{"verse":"","text":"ele não comete injustiça."},{"verse":"","text":"Manhã após manhã,"},{"verse":"","text":"ele traz o seu juízo à luz;"},{"verse":"","text":"não falha."},{"verse":"","text":"Mas o injusto não sabe"},{"verse":"","text":"o que é vergonha."},{"verse":"6","text":"\"Exterminei nações."},{"verse":"","text":"As suas torres estão destruídas."},{"verse":"","text":"Tornei desertas as suas praças,"},{"verse":"","text":"a ponto de não haver"},{"verse":"","text":"quem passe por elas."},{"verse":"","text":"As suas cidades foram destruídas,"},{"verse":"","text":"de maneira que não há ninguém,"},{"verse":"","text":"ninguém que as habite."},{"verse":"7","text":"Eu dizia:"},{"verse":"","text":"‘Certamente você, Jerusalém,"},{"verse":"","text":"viverá em temor diante de mim"},{"verse":"","text":"e aceitará a disciplina,"},{"verse":"","text":"e, assim, a sua morada"},{"verse":"","text":"não seria destruída,"},{"verse":"","text":"segundo o que eu"},{"verse":"","text":"havia determinado.’"},{"verse":"","text":"Mas eles se tornaram"},{"verse":"","text":"cada vez mais corruptos"},{"verse":"","text":"em todos os seus atos.\""},{"verse":"","text":"A salvação da filha de Jerusalém"},{"verse":"8","text":"\"Portanto, esperem por mim\","},{"verse":"","text":"diz o"},{"verse":"","text":"\"esperem pelo dia"},{"verse":"","text":"em que eu me levantar"},{"verse":"","text":"para tomar o despojo."},{"verse":"","text":"Porque a minha resolução"},{"verse":"","text":"é ajuntar as nações"},{"verse":"","text":"e congregar os reinos,"},{"verse":"","text":"para fazer cair sobre eles"},{"verse":"","text":"a minha indignação"},{"verse":"","text":"e todo o furor da minha ira."},{"verse":"","text":"Porque toda esta terra"},{"verse":"","text":"será consumida"},{"verse":"","text":"pelo fogo do meu zelo.\""},{"verse":"9","text":"\"Então darei lábios puros"},{"verse":"","text":"aos povos,"},{"verse":"","text":"para que todos invoquem"},{"verse":"","text":"o nome do"},{"verse":"","text":"e o sirvam de comum acordo."},{"verse":"10","text":"Dalém dos rios da Etiópia,"},{"verse":"","text":"os meus adoradores,"},{"verse":"","text":"que constituem"},{"verse":"","text":"a filha da minha dispersão,"},{"verse":"","text":"me trarão sacrifícios."},{"verse":"11","text":"Naquele dia, você não terá"},{"verse":"","text":"de se envergonhar"},{"verse":"","text":"de nenhuma das suas rebeliões"},{"verse":"","text":"contra mim,"},{"verse":"","text":"porque tirarei do meio de você,"},{"verse":"","text":"Jerusalém,"},{"verse":"","text":"os que exultam no seu orgulho,"},{"verse":"","text":"e você nunca mais se orgulhará"},{"verse":"","text":"no meu santo monte."},{"verse":"12","text":"Mas deixarei no meio de você"},{"verse":"","text":"um povo modesto e humilde,"},{"verse":"","text":"que confia no nome do"},{"verse":"13","text":"O remanescente de Israel"},{"verse":"","text":"não cometerá injustiça."},{"verse":"","text":"Eles não proferirão mentira,"},{"verse":"","text":"e da sua boca não sairão palavras"},{"verse":"","text":"enganosas,"},{"verse":"","text":"porque serão apascentados,"},{"verse":"","text":"se deitarão,"},{"verse":"","text":"e não haverá quem os atemorize.\""},{"verse":"14","text":"Cante, ó filha de Sião!"},{"verse":"","text":"Grite de alegria, ó Israel!"},{"verse":"","text":"Alegre-se e exulte"},{"verse":"","text":"de todo o coração,"},{"verse":"","text":"ó filha de Jerusalém."},{"verse":"15","text":"O"},{"verse":"","text":"que eram contra você"},{"verse":"","text":"e afastou os seus inimigos."},{"verse":"","text":"O Rei de Israel, o"},{"verse":"","text":"está no meio de você;"},{"verse":"","text":"você não precisa mais temer"},{"verse":"","text":"nenhum mal."},{"verse":"16","text":"Naquele dia, se dirá a Jerusalém:"},{"verse":"","text":"\"Não tenha medo, ó Sião,"},{"verse":"","text":"não desfaleçam as suas mãos.\""},{"verse":"17","text":"O"},{"verse":"","text":"está no meio de você,"},{"verse":"","text":"poderoso para salvar."},{"verse":"","text":"Ele ficará muito contente"},{"verse":"","text":"com você."},{"verse":"","text":"Ele a renovará no seu amor,"},{"verse":"","text":"e se encherá de júbilo"},{"verse":"","text":"por causa de você."},{"verse":"18","text":"\"Congregarei"},{"verse":"","text":"os que estão entristecidos"},{"verse":"","text":"por se acharem afastados"},{"verse":"","text":"das festas solenes,"},{"verse":"","text":"estes que são do seu meio"},{"verse":"","text":"e sobre os quais pesam afrontas."},{"verse":"19","text":"Eis que, naquele tempo,"},{"verse":"","text":"agirei contra todos"},{"verse":"","text":"os que a afligem."},{"verse":"","text":"Salvarei os que coxeiam"},{"verse":"","text":"e recolherei os que foram expulsos."},{"verse":"","text":"Farei deles um louvor e um nome"},{"verse":"","text":"em toda a terra"},{"verse":"","text":"em que foram envergonhados."},{"verse":"20","text":"Naquele tempo,"},{"verse":"","text":"farei com que vocês voltem"},{"verse":"","text":"e os recolherei."},{"verse":"","text":"Certamente farei de vocês"},{"verse":"","text":"um nome e um louvor"},{"verse":"","text":"entre todos os povos"},{"verse":"","text":"da terra,"},{"verse":"","text":"quando eu restaurar"},{"verse":"","text":"a sorte de vocês"},{"verse":"","text":"diante dos seus próprios olhos\","},{"verse":"","text":"diz o"}]]}