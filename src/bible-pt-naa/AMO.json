{"chapters":[[{"verse":"1","text":"Palavras que, em visão, vieram a Amós, um pastor da cidade de Tecoa, a respeito de Israel. Isso aconteceu nos dias de Uzias, rei de Judá, e nos dias de Jeroboão, filho de Joás, rei de Israel, dois anos antes do terremoto."},{"verse":"","text":"\"O"},{"verse":"","text":"e de Jerusalém fará ouvir a sua voz."},{"verse":"","text":"Os campos dos pastores"},{"verse":"","text":"estarão de luto,"},{"verse":"","text":"e o alto do Carmelo secará.\""},{"verse":"","text":"Ameaças contra diversas nações"},{"verse":"","text":"Síria"},{"verse":"3","text":"Assim diz o"},{"verse":"","text":"\"Por três transgressões"},{"verse":"","text":"de Damasco,"},{"verse":"","text":"sim, por causa de quatro,"},{"verse":"","text":"não suspenderei o castigo."},{"verse":"","text":"Porque passaram"},{"verse":"","text":"um instrumento de trilhar"},{"verse":"","text":"com pontas de ferro sobre Gileade."},{"verse":"4","text":"Por isso, porei fogo"},{"verse":"","text":"à casa de Hazael,"},{"verse":"","text":"fogo que consumirá"},{"verse":"","text":"as fortalezas de Ben-Hadade."},{"verse":"5","text":"Quebrarei os ferrolhos"},{"verse":"","text":"de Damasco"},{"verse":"","text":"e eliminarei o morador"},{"verse":"","text":"de Biqueate-Áven"},{"verse":"","text":"e o que tem o cetro de Bete-Éden."},{"verse":"","text":"O povo da Síria será levado"},{"verse":"","text":"em cativeiro a Quir\","},{"verse":"","text":"diz o"},{"verse":"","text":"Filístia"},{"verse":"6","text":"Assim diz o"},{"verse":"","text":"\"Por três transgressões de Gaza,"},{"verse":"","text":"sim, por causa de quatro,"},{"verse":"","text":"não suspenderei o castigo."},{"verse":"","text":"Porque levaram em cativeiro"},{"verse":"","text":"todo um povo,"},{"verse":"","text":"para entregá-lo a Edom."},{"verse":"7","text":"Por isso, porei fogo"},{"verse":"","text":"nas muralhas de Gaza,"},{"verse":"","text":"fogo que consumirá"},{"verse":"","text":"as suas fortalezas."},{"verse":"8","text":"Eliminarei o morador de Asdode"},{"verse":"","text":"e o que tem o cetro de Asquelom."},{"verse":"","text":"Voltarei a minha mão"},{"verse":"","text":"contra Ecrom,"},{"verse":"","text":"e o resto dos filisteus perecerá\","},{"verse":"","text":"diz o"},{"verse":"","text":"Tiro"},{"verse":"9","text":"Assim diz o"},{"verse":"","text":"\"Por três transgressões de Tiro,"},{"verse":"","text":"sim, por causa de quatro,"},{"verse":"","text":"não suspenderei o castigo."},{"verse":"","text":"Porque levaram em cativeiro"},{"verse":"","text":"todo um povo,"},{"verse":"","text":"para entregá-lo a Edom"},{"verse":"","text":"e não se lembraram"},{"verse":"","text":"da aliança de irmãos."},{"verse":"10","text":"Por isso, porei fogo"},{"verse":"","text":"nas muralhas de Tiro,"},{"verse":"","text":"fogo que consumirá"},{"verse":"","text":"as suas fortalezas.\""},{"verse":"","text":"Edom"},{"verse":"11","text":"Assim diz o"},{"verse":"","text":"\"Por três transgressões de Edom,"},{"verse":"","text":"sim, por causa de quatro,"},{"verse":"","text":"não suspenderei o castigo."},{"verse":"","text":"Porque perseguiu o seu irmão"},{"verse":"","text":"com a espada"},{"verse":"","text":"e não teve nenhuma compaixão dele."},{"verse":"","text":"A sua ira não cessou"},{"verse":"","text":"de despedaçar,"},{"verse":"","text":"e conservou a sua indignação"},{"verse":"","text":"para sempre."},{"verse":"12","text":"Por isso, porei fogo em Temã,"},{"verse":"","text":"fogo que consumirá"},{"verse":"","text":"as fortalezas de Bozra.\""},{"verse":"","text":"Amom"},{"verse":"13","text":"Assim diz o"},{"verse":"","text":"\"Por três transgressões"},{"verse":"","text":"dos filhos de Amom,"},{"verse":"","text":"sim, por causa de quatro,"},{"verse":"","text":"não suspenderei o castigo."},{"verse":"","text":"Porque rasgaram o ventre"},{"verse":"","text":"das grávidas"},{"verse":"","text":"da região de Gileade,"},{"verse":"","text":"para ampliarem as suas fronteiras."},{"verse":"14","text":"Por isso, porei fogo"},{"verse":"","text":"nas muralhas de Rabá,"},{"verse":"","text":"fogo que consumirá"},{"verse":"","text":"as suas fortalezas,"},{"verse":"","text":"com alarido no dia da batalha,"},{"verse":"","text":"com turbilhão"},{"verse":"","text":"no dia da tempestade."},{"verse":"15","text":"O seu rei irá para o cativeiro,"},{"verse":"","text":"ele e os seus príncipes com ele\","},{"verse":"","text":"diz o"}],[{"verse":"","text":"Moabe"},{"verse":"1","text":"Assim diz o"},{"verse":"","text":"\"Por três transgressões de Moabe,"},{"verse":"","text":"sim, por causa de quatro,"},{"verse":"","text":"não suspenderei o castigo."},{"verse":"","text":"Porque queimou os ossos"},{"verse":"","text":"do rei de Edom,"},{"verse":"","text":"até reduzi-los a cinza."},{"verse":"2","text":"Por isso, porei fogo em Moabe,"},{"verse":"","text":"fogo que consumirá"},{"verse":"","text":"as fortalezas de Queriote."},{"verse":"","text":"Moabe morrerá"},{"verse":"","text":"entre grande estrondo,"},{"verse":"","text":"alarido e som de trombeta."},{"verse":"3","text":"Eliminarei do meio dele o juiz,"},{"verse":"","text":"e juntamente com ele"},{"verse":"","text":"matarei todos os seus príncipes\","},{"verse":"","text":"diz o"},{"verse":"","text":"Judá"},{"verse":"4","text":"Assim diz o"},{"verse":"","text":"\"Por três transgressões de Judá,"},{"verse":"","text":"sim, por causa de quatro,"},{"verse":"","text":"não suspenderei o castigo."},{"verse":"","text":"Porque rejeitaram a lei do"},{"verse":"","text":"e não guardaram os seus estatutos."},{"verse":"","text":"Os falsos deuses os enganaram,"},{"verse":"","text":"deuses que os pais deles"},{"verse":"","text":"haviam seguido."},{"verse":"5","text":"Por isso, porei fogo em Judá,"},{"verse":"","text":"fogo que consumirá"},{"verse":"","text":"as fortalezas de Jerusalém.\""},{"verse":"","text":"Israel"},{"verse":"6","text":"Assim diz o"},{"verse":"","text":"\"Por três transgressões de Israel,"},{"verse":"","text":"sim, por causa de quatro,"},{"verse":"","text":"não suspenderei o castigo."},{"verse":"","text":"Porque vendem o justo"},{"verse":"","text":"por dinheiro"},{"verse":"","text":"e condenam o necessitado"},{"verse":"","text":"por causa de"},{"verse":"","text":"um par de sandálias."},{"verse":"7","text":"Esmagam no pó da terra"},{"verse":"","text":"a cabeça dos pobres"},{"verse":"","text":"e pervertem o caminho"},{"verse":"","text":"dos necessitados."},{"verse":"","text":"Um homem e seu pai têm relações"},{"verse":"","text":"com a mesma jovem"},{"verse":"","text":"e, assim, profanam"},{"verse":"","text":"o meu santo nome."},{"verse":"8","text":"Eles se deitam ao lado"},{"verse":"","text":"de qualquer altar"},{"verse":"","text":"sobre roupas"},{"verse":"","text":"recebidas como penhor"},{"verse":"","text":"e, no templo do seu deus,"},{"verse":"","text":"bebem o vinho"},{"verse":"","text":"dos que foram multados.\""},{"verse":"9","text":"\"Todavia, fui eu que destruí"},{"verse":"","text":"diante deles os amorreus,"},{"verse":"","text":"que eram tão altos como os cedros"},{"verse":"","text":"e tão fortes como os carvalhos;"},{"verse":"","text":"destruí os seus frutos por cima"},{"verse":"","text":"e as suas raízes por baixo."},{"verse":"10","text":"Também fui eu que tirei vocês"},{"verse":"","text":"da terra do Egito"},{"verse":"","text":"e durante quarenta anos"},{"verse":"","text":"os conduzi pelo deserto,"},{"verse":"","text":"para que vocês pudessem tomar"},{"verse":"","text":"posse da terra dos amorreus."},{"verse":"11","text":"Escolhi alguns dos seus filhos"},{"verse":"","text":"para serem profetas"},{"verse":"","text":"e alguns dos seus jovens"},{"verse":"","text":"para serem nazireus."},{"verse":"","text":"Não é isto assim, filhos de Israel?\" —"},{"verse":"","text":"diz o"},{"verse":"12","text":"\"Mas vocês deram"},{"verse":"","text":"vinho aos nazireus"},{"verse":"","text":"e ordenaram aos profetas"},{"verse":"","text":"que não profetizassem.\""},{"verse":"13","text":"\"Como faz um carro"},{"verse":"","text":"carregado de feixes,"},{"verse":"","text":"eu os esmagarei ali"},{"verse":"","text":"onde vocês se encontram."},{"verse":"14","text":"Os mais ágeis não encontrarão"},{"verse":"","text":"refúgio,"},{"verse":"","text":"os fortes não poderão usar"},{"verse":"","text":"a sua força,"},{"verse":"","text":"e os valentes não conseguirão"},{"verse":"","text":"salvar a sua vida."},{"verse":"15","text":"Os que manejam o arco"},{"verse":"","text":"não resistirão,"},{"verse":"","text":"os mais velozes"},{"verse":"","text":"não conseguirão fugir,"},{"verse":"","text":"e os que vão montados a cavalo"},{"verse":"","text":"não conseguirão"},{"verse":"","text":"salvar a sua vida."},{"verse":"16","text":"Até mesmo os mais corajosos"},{"verse":"","text":"entre os valentes"},{"verse":"","text":"fugirão nus naquele dia\","},{"verse":"","text":"diz o"}],[{"verse":"","text":"O castigo contra a maldade de Israel"},{"verse":"1","text":"Ouçam a palavra que o"},{"verse":"2","text":"\"De todas as famílias da terra,"},{"verse":"","text":"somente a vocês eu escolhi;"},{"verse":"","text":"portanto, eu os punirei"},{"verse":"","text":"por todas as suas iniquidades."},{"verse":"3","text":"Será que dois andarão juntos,"},{"verse":"","text":"se não estiverem de acordo?"},{"verse":"4","text":"Será que o leão"},{"verse":"","text":"vai rugir na floresta,"},{"verse":"","text":"sem que tenha encontrado presa?"},{"verse":"","text":"Será que o leãozinho"},{"verse":"","text":"fará ouvir a sua voz no covil,"},{"verse":"","text":"se não tiver apanhado nada?"},{"verse":"5","text":"Será que a ave"},{"verse":"","text":"cairá na armadilha,"},{"verse":"","text":"se o laço não estiver armado?"},{"verse":"","text":"Será que o laço se levanta do chão,"},{"verse":"","text":"sem que tenha apanhado"},{"verse":"","text":"alguma coisa?"},{"verse":"6","text":"Será possível tocar a trombeta"},{"verse":"","text":"na cidade,"},{"verse":"","text":"sem que o povo comece a tremer?"},{"verse":"","text":"Será que sobrevirá algum mal"},{"verse":"","text":"à cidade,"},{"verse":"","text":"sem que o"},{"verse":"7","text":"\"Certamente o"},{"verse":"","text":"não fará coisa alguma,"},{"verse":"","text":"sem primeiro revelar o seu segredo"},{"verse":"","text":"aos seus servos, os profetas."},{"verse":"8","text":"O leão rugiu,"},{"verse":"","text":"quem não ficará com medo?"},{"verse":"","text":"O"},{"verse":"","text":"quem não profetizará?\""},{"verse":"9","text":"\"Proclamem nas fortalezas"},{"verse":"","text":"de Asdode"},{"verse":"","text":"e nos palácios"},{"verse":"","text":"da terra do Egito o seguinte:"},{"verse":"","text":"‘Reúnam-se nos montes"},{"verse":"","text":"de Samaria"},{"verse":"","text":"e vejam que grandes tumultos"},{"verse":"","text":"lá existem"},{"verse":"","text":"e que opressões há no meio dela.’"},{"verse":"10","text":"Porque o povo de Samaria"},{"verse":"","text":"não sabe fazer o que é reto\","},{"verse":"","text":"diz o"},{"verse":"","text":"\"e entesoura nos seus palácios"},{"verse":"","text":"a violência e a devastação.\""},{"verse":"11","text":"Portanto, assim diz o"},{"verse":"","text":"\"Um inimigo cercará a sua terra,"},{"verse":"","text":"destruirá o seu poder,"},{"verse":"","text":"e os seus palácios"},{"verse":"","text":"serão saqueados.\""},{"verse":"12","text":"Assim diz o"},{"verse":"","text":"— Como o pastor livra da boca do leão as duas pernas ou um pedacinho da orelha de um animal, assim serão salvos os filhos de Israel que vivem em Samaria com apenas o canto da cama e parte do leito."},{"verse":"13","text":"\"Ouçam e deem testemunho"},{"verse":"","text":"contra a casa de Jacó\","},{"verse":"","text":"diz o"},{"verse":"","text":"o Deus dos Exércitos:"},{"verse":"14","text":"\"No dia em que eu punir Israel,"},{"verse":"","text":"por causa das suas transgressões,"},{"verse":"","text":"visitarei também"},{"verse":"","text":"os altares de Betel;"},{"verse":"","text":"e as pontas do altar serão cortadas"},{"verse":"","text":"e cairão por terra."},{"verse":"15","text":"Derrubarei a casa de inverno"},{"verse":"","text":"com a casa de verão;"},{"verse":"","text":"as casas de marfim"},{"verse":"","text":"ficarão em ruínas,"},{"verse":"","text":"e as grandes casas"},{"verse":"","text":"serão destruídas\","},{"verse":"","text":"diz o"}],[{"verse":"","text":"Ameaças contra as mulheres de Samaria"},{"verse":"1","text":"\"Ouçam esta palavra,"},{"verse":"","text":"vacas de Basã,"},{"verse":"","text":"vocês que estão"},{"verse":"","text":"no monte de Samaria,"},{"verse":"","text":"que oprimem os pobres,"},{"verse":"","text":"esmagam os necessitados"},{"verse":"","text":"e dizem aos maridos:"},{"verse":"","text":"‘Tragam vinho, e vamos beber!’"},{"verse":"2","text":"O"},{"verse":"","text":"pela sua santidade"},{"verse":"","text":"que virão dias em que vocês"},{"verse":"","text":"serão arrastadas com ganchos;"},{"verse":"","text":"até as últimas de vocês"},{"verse":"","text":"serão levadas"},{"verse":"","text":"com anzóis de pesca."},{"verse":"3","text":"Vocês sairão em fila pelas brechas"},{"verse":"","text":"e serão lançadas"},{"verse":"","text":"na direção do monte Hermom\","},{"verse":"","text":"diz o"},{"verse":"","text":"A cegueira espiritual de Israel"},{"verse":"4","text":"\"Venham a Betel e pequem!"},{"verse":"","text":"Venham a Gilgal"},{"verse":"","text":"e pequem ainda mais!"},{"verse":"","text":"Cada manhã,"},{"verse":"","text":"tragam os seus sacrifícios"},{"verse":"","text":"e, de três em três dias,"},{"verse":"","text":"os seus dízimos!"},{"verse":"5","text":"Ofereçam sacrifícios de louvor"},{"verse":"","text":"com pão levedado"},{"verse":"","text":"e proclamem ofertas voluntárias!"},{"verse":"","text":"Tornem isso público,"},{"verse":"","text":"porque é disso que vocês gostam,"},{"verse":"","text":"ó filhos de Israel\","},{"verse":"","text":"diz o"},{"verse":"6","text":"\"Também deixei"},{"verse":"","text":"que vocês ficassem"},{"verse":"","text":"sem ter o que mastigar"},{"verse":"","text":"em todas as suas cidades"},{"verse":"","text":"e com falta de pão"},{"verse":"","text":"em todos os lugares,"},{"verse":"","text":"mas vocês não se converteram"},{"verse":"","text":"a mim\","},{"verse":"","text":"diz o"},{"verse":"7","text":"\"Além disso, retive a chuva,"},{"verse":"","text":"faltando ainda três meses"},{"verse":"","text":"para a colheita."},{"verse":"","text":"Fiz chover sobre uma cidade"},{"verse":"","text":"e sobre a outra, não;"},{"verse":"","text":"um campo teve chuva,"},{"verse":"","text":"mas o outro, que ficou sem chuva,"},{"verse":"","text":"secou."},{"verse":"8","text":"Pessoas de duas ou três cidades"},{"verse":"","text":"se dirigiram a outra cidade"},{"verse":"","text":"para beber água,"},{"verse":"","text":"sem conseguirem matar a sede,"},{"verse":"","text":"mas vocês não se converteram"},{"verse":"","text":"a mim\","},{"verse":"","text":"diz o"},{"verse":"9","text":"\"Eu os castiguei"},{"verse":"","text":"com o crestamento"},{"verse":"","text":"e a ferrugem."},{"verse":"","text":"Os gafanhotos devoraram"},{"verse":"","text":"as hortas e as vinhas,"},{"verse":"","text":"as figueiras e as oliveiras,"},{"verse":"","text":"mas vocês não se converteram"},{"verse":"","text":"a mim\","},{"verse":"","text":"diz o"},{"verse":"10","text":"\"Enviei a peste contra vocês,"},{"verse":"","text":"assim como havia feito no Egito."},{"verse":"","text":"Matei os seus jovens à espada,"},{"verse":"","text":"deixei que os seus cavalos"},{"verse":"","text":"fossem capturados,"},{"verse":"","text":"e fiz com que o mau cheiro"},{"verse":"","text":"dos acampamentos"},{"verse":"","text":"chegasse aos seus narizes,"},{"verse":"","text":"mas vocês não se converteram"},{"verse":"","text":"a mim\","},{"verse":"","text":"diz o"},{"verse":"11","text":"\"Destruí alguns de vocês,"},{"verse":"","text":"como Deus destruiu Sodoma"},{"verse":"","text":"e Gomorra."},{"verse":"","text":"Vocês foram como um toco de lenha"},{"verse":"","text":"tirado do fogo,"},{"verse":"","text":"mas não se converteram a mim\","},{"verse":"","text":"diz o"},{"verse":"12","text":"\"Portanto, assim farei"},{"verse":"","text":"com você, Israel!"},{"verse":"","text":"E, porque farei isso com você,"},{"verse":"","text":"prepare-se, ó Israel,"},{"verse":"","text":"para se encontrar com o seu Deus!"},{"verse":"13","text":"Porque é ele"},{"verse":"","text":"quem forma os montes,"},{"verse":"","text":"cria o vento"},{"verse":"","text":"e declara aos seres humanos"},{"verse":"","text":"qual é o seu pensamento;"},{"verse":"","text":"ele faz da manhã trevas"},{"verse":"","text":"e anda sobre os altos da terra;"},{"verse":"","text":"Senhor"},{"verse":"","text":"é o seu nome.\""}],[{"verse":"","text":"Busquem o Senhor e vocês viverão"},{"verse":"1","text":"Ouçam esta palavra que falo contra vocês, ó casa de Israel. É uma lamentação."},{"verse":"2","text":"\"Caiu a virgem de Israel,"},{"verse":"","text":"para nunca mais se levantar!"},{"verse":"","text":"Está estendida na sua própria terra,"},{"verse":"","text":"e não há quem a levante.\""},{"verse":"3","text":"Porque assim diz o"},{"verse":"","text":"\"A cidade da qual saem mil"},{"verse":"","text":"conservará apenas cem,"},{"verse":"","text":"e aquela da qual saem cem"},{"verse":"","text":"conservará apenas dez"},{"verse":"","text":"para a casa de Israel.\""},{"verse":"4","text":"Pois assim diz o"},{"verse":"","text":"\"Busquem a mim e vocês viverão."},{"verse":"5","text":"Porém não busquem Betel,"},{"verse":"","text":"nem venham a Gilgal,"},{"verse":"","text":"nem passem a Berseba."},{"verse":"","text":"Porque Gilgal certamente"},{"verse":"","text":"será levada cativa,"},{"verse":"","text":"e Betel será reduzida a nada."},{"verse":"6","text":"Busquem o"},{"verse":"","text":"e vocês viverão."},{"verse":"","text":"Do contrário, ele irromperá"},{"verse":"","text":"na casa de José"},{"verse":"","text":"como um fogo que a consome,"},{"verse":"","text":"e não haverá em Betel"},{"verse":"","text":"quem consiga apagá-lo."},{"verse":"7","text":"Vocês que transformam"},{"verse":"","text":"o juízo em veneno"},{"verse":"","text":"e lançam por terra a justiça,"},{"verse":"8","text":"busquem aquele que fez"},{"verse":"","text":"o Sete-estrelo e o Órion;"},{"verse":"","text":"aquele que torna"},{"verse":"","text":"as densas trevas em manhã"},{"verse":"","text":"e muda o dia em noite;"},{"verse":"","text":"aquele que chama as águas do mar"},{"verse":"","text":"e as derrama sobre a terra;"},{"verse":"","text":"Senhor"},{"verse":"9","text":"É ele que faz vir"},{"verse":"","text":"súbita destruição sobre o forte"},{"verse":"","text":"e ruína contra a fortaleza.\""},{"verse":"10","text":"\"Vocês odeiam"},{"verse":"","text":"quem os repreende no tribunal"},{"verse":"","text":"e detestam quem fala"},{"verse":"","text":"com sinceridade."},{"verse":"11","text":"Portanto, visto que pisam"},{"verse":"","text":"os pobres"},{"verse":"","text":"e deles exigem tributo de trigo,"},{"verse":"","text":"vocês não habitarão nas casas"},{"verse":"","text":"de pedras lavradas"},{"verse":"","text":"que construíram,"},{"verse":"","text":"nem beberão o vinho"},{"verse":"","text":"das belas videiras"},{"verse":"","text":"que plantaram."},{"verse":"12","text":"Porque sei que são muitas"},{"verse":"","text":"as suas transgressões"},{"verse":"","text":"e que são graves os pecados"},{"verse":"","text":"que vocês cometem."},{"verse":"","text":"Vocês afligem os justos,"},{"verse":"","text":"aceitam suborno"},{"verse":"","text":"e rejeitam as causas"},{"verse":"","text":"dos necessitados no tribunal."},{"verse":"13","text":"Por isso, numa época"},{"verse":"","text":"de tanta corrupção,"},{"verse":"","text":"quem é prudente"},{"verse":"","text":"prefere ficar calado.\""},{"verse":"14","text":"\"Busquem o bem e não o mal,"},{"verse":"","text":"para que vocês vivam."},{"verse":"","text":"E assim o"},{"verse":"","text":"o Deus dos Exércitos,"},{"verse":"","text":"estará com vocês,"},{"verse":"","text":"como vocês dizem."},{"verse":"15","text":"Odeiem o mal e amem o bem."},{"verse":"","text":"Promovam a justiça nos tribunais."},{"verse":"","text":"Talvez o"},{"verse":"","text":"o Deus dos Exércitos,"},{"verse":"","text":"se compadeça do remanescente"},{"verse":"","text":"de José.\""},{"verse":"16","text":"Portanto, assim diz o Senhor, o"},{"verse":"","text":"\"Em todas as praças haverá pranto,"},{"verse":"","text":"e em todas as ruas dirão: ‘Ai! Ai!’"},{"verse":"","text":"Chamarão os lavradores"},{"verse":"","text":"para o pranto"},{"verse":"","text":"e, para o choro,"},{"verse":"","text":"os que sabem prantear."},{"verse":"17","text":"Em todas as vinhas"},{"verse":"","text":"haverá pranto,"},{"verse":"","text":"porque passarei"},{"verse":"","text":"pelo meio de vocês\","},{"verse":"","text":"diz o"},{"verse":"","text":"O Dia do Senhor"},{"verse":"18","text":"\"Ai dos que desejam"},{"verse":"","text":"o Dia do"},{"verse":"","text":"Para que vocês desejam"},{"verse":"","text":"o Dia do"},{"verse":"","text":"Será um dia de trevas"},{"verse":"","text":"e não de luz."},{"verse":"19","text":"Será como se um homem"},{"verse":"","text":"fugisse de um leão"},{"verse":"","text":"e lhe saísse ao encontro um urso;"},{"verse":"","text":"ou como se, entrando em casa"},{"verse":"","text":"e encostando a mão na parede,"},{"verse":"","text":"fosse mordido por uma cobra."},{"verse":"20","text":"O dia do"},{"verse":"","text":"um dia de trevas e não de luz!"},{"verse":"","text":"Será um dia"},{"verse":"","text":"de completa escuridão,"},{"verse":"","text":"sem nenhuma claridade!\""},{"verse":"","text":"Deus exige justiça e não sacrifícios"},{"verse":"21","text":"\"Eu odeio e desprezo"},{"verse":"","text":"as suas festas"},{"verse":"","text":"e com as suas reuniões solenes"},{"verse":"","text":"não tenho nenhum prazer."},{"verse":"22","text":"Mesmo que vocês me ofereçam"},{"verse":"","text":"holocaustos e ofertas de cereais,"},{"verse":"","text":"não me agradarei deles."},{"verse":"","text":"Quanto às suas ofertas pacíficas"},{"verse":"","text":"de animais gordos,"},{"verse":"","text":"nem sequer olharei para elas."},{"verse":"23","text":"Afastem de mim"},{"verse":"","text":"o barulho dos seus cânticos,"},{"verse":"","text":"porque não ouvirei"},{"verse":"","text":"as melodias das suas liras."},{"verse":"24","text":"Em vez disso,"},{"verse":"","text":"corra o juízo como as águas,"},{"verse":"","text":"e a justiça,"},{"verse":"","text":"como um ribeiro perene.\""},{"verse":"25","text":"— Casa de Israel, por acaso vocês me apresentaram sacrifícios e ofertas de cereais durante os quarenta anos no deserto?"}],[{"verse":"","text":"A corrupção e a destruição de Israel"},{"verse":"1","text":"\"Ai dos que andam"},{"verse":"","text":"à vontade em Sião"},{"verse":"","text":"e dos que vivem sem receio"},{"verse":"","text":"no monte de Samaria,"},{"verse":"","text":"homens notáveis"},{"verse":"","text":"da principal das nações,"},{"verse":"","text":"aos quais se dirige a casa de Israel!"},{"verse":"2","text":"Vão à cidade de Calné e olhem."},{"verse":"","text":"Dali, vão à grande cidade"},{"verse":"","text":"de Hamate"},{"verse":"","text":"e, depois, desçam até"},{"verse":"","text":"Gate dos filisteus."},{"verse":"","text":"Será que eles são melhores"},{"verse":"","text":"do que os reinos de vocês?"},{"verse":"","text":"Ou será que o território deles"},{"verse":"","text":"é maior do que o de vocês?"},{"verse":"3","text":"Vocês imaginam que o dia mau"},{"verse":"","text":"está longe,"},{"verse":"","text":"mas estão fazendo com que"},{"verse":"","text":"o trono da violência"},{"verse":"","text":"se aproxime."},{"verse":"4","text":"Vocês dormem"},{"verse":"","text":"em camas de marfim"},{"verse":"","text":"e se espreguiçam"},{"verse":"","text":"sobre os seus leitos."},{"verse":"","text":"Comem os cordeiros do rebanho"},{"verse":"","text":"e os bezerros"},{"verse":"","text":"que estão na engorda."},{"verse":"5","text":"Ficam cantando à toa"},{"verse":"","text":"ao som da lira"},{"verse":"","text":"e, como Davi, inventam"},{"verse":"","text":"instrumentos musicais."},{"verse":"6","text":"Bebem vinho em taças"},{"verse":"","text":"e se ungem"},{"verse":"","text":"com o mais excelente óleo,"},{"verse":"","text":"mas não se afligem"},{"verse":"","text":"com a ruína de José."},{"verse":"7","text":"Portanto, vocês estarão"},{"verse":"","text":"entre os primeiros que serão"},{"verse":"","text":"levados para o cativeiro,"},{"verse":"","text":"e cessarão as festanças"},{"verse":"","text":"dos que gostam"},{"verse":"","text":"de se espreguiçar.\""},{"verse":"8","text":"O"},{"verse":"","text":"\"Eu detesto o orgulho de Jacó"},{"verse":"","text":"e odeio os seus palácios."},{"verse":"","text":"Abandonarei a cidade"},{"verse":"","text":"e tudo o que nela há.\""},{"verse":"9","text":"Se numa casa ficarem dez homens, também esses morrerão."},{"verse":"11","text":"Pois eis que o"},{"verse":"","text":"e será destroçada"},{"verse":"","text":"a casa grande,"},{"verse":"","text":"e a pequena será feita"},{"verse":"","text":"em pedaços."},{"verse":"12","text":"\"Será que os cavalos podem"},{"verse":"","text":"correr sobre as rochas?"},{"verse":"","text":"Será que é possível lavrá-las"},{"verse":"","text":"com bois?"},{"verse":"","text":"No entanto, vocês transformaram"},{"verse":"","text":"o juízo em veneno"},{"verse":"","text":"e o fruto da justiça, em alosna."},{"verse":"13","text":"Vocês se alegram por terem"},{"verse":"","text":"conquistado Lo-Debar, e dizem:"},{"verse":"","text":"‘Não é fato que,"},{"verse":"","text":"com as nossas próprias forças,"},{"verse":"","text":"nos apoderamos de Carnaim?’"},{"verse":"14","text":"Pois eis que trarei contra vocês,"},{"verse":"","text":"ó casa de Israel, uma nação"},{"verse":"","text":"que os oprimirá,"},{"verse":"","text":"desde a entrada de Hamate"},{"verse":"","text":"até o ribeiro da Arabá\","},{"verse":"","text":"diz o"},{"verse":"","text":"o Deus dos Exércitos."}],[{"verse":"","text":"A visão do gafanhoto, do fogo e do prumo"},{"verse":"1","text":"O"},{"verse":"","text":"—"},{"verse":"3","text":"Então o"},{"verse":"","text":"— Isso não vai acontecer."},{"verse":"4","text":"Depois, o"},{"verse":"","text":"—"},{"verse":"6","text":"E o"},{"verse":"","text":"— Também isso não vai acontecer."},{"verse":"7","text":"Mostrou-me também isto: eis que o Senhor estava sobre um muro levantado a prumo, e tinha um prumo na mão."},{"verse":"","text":"— O que você está vendo, Amós?"},{"verse":"","text":"Respondi:"},{"verse":"","text":"— Um prumo."},{"verse":"","text":"Então o Senhor disse:"},{"verse":"9","text":"— Eis que eu porei o prumo no meio do meu povo de Israel; não posso mais ignorar o que fazem."},{"verse":"","text":"Amós e o sacerdote Amazias"},{"verse":"10","text":"Então Amazias, o sacerdote de Betel, mandou dizer a Jeroboão, rei de Israel:"},{"verse":"11","text":"— Amós está conspirando contra o rei no meio da casa de Israel. A terra não pode suportar todas as suas palavras."},{"verse":"12","text":"Depois Amazias disse a Amós:"},{"verse":"13","text":"— Saia daqui, vidente! Fuja para a terra de Judá e vá ganhar a vida por lá. Em Judá você pode profetizar."},{"verse":"14","text":"Amós respondeu e disse a Amazias:"},{"verse":"15","text":"— Eu não sou profeta nem discípulo de profeta. Eu cuido de gado e colho sicômoros."},{"verse":"","text":"\"A sua mulher se prostituirá"},{"verse":"","text":"na cidade,"},{"verse":"","text":"e os seus filhos e as suas filhas"},{"verse":"","text":"cairão à espada."},{"verse":"","text":"A sua terra será repartida a cordel,"},{"verse":"","text":"e você morrerá numa terra impura."},{"verse":"","text":"E Israel certamente"},{"verse":"","text":"será levado cativo"},{"verse":"","text":"para fora da sua terra.\""}],[{"verse":"","text":"A visão de um cesto de frutos"},{"verse":"1","text":"O"},{"verse":"","text":"— O que você está vendo, Amós?"},{"verse":"","text":"E eu respondi:"},{"verse":"","text":"— Um cesto de frutos de verão."},{"verse":"","text":"Então o"},{"verse":"","text":"\"Chegou o fim para o meu povo"},{"verse":"","text":"de Israel;"},{"verse":"","text":"não posso mais ignorar"},{"verse":"","text":"o que fazem."},{"verse":"3","text":"Naquele dia\","},{"verse":"","text":"diz o"},{"verse":"","text":"\"os cânticos do templo"},{"verse":"","text":"serão gritos de dor."},{"verse":"","text":"Muitos cadáveres!"},{"verse":"","text":"Cadáveres jogados por toda parte!"},{"verse":"","text":"Silêncio!\""},{"verse":"","text":"A ruína de Israel está perto"},{"verse":"4","text":"Ouçam isto, vocês que pisam"},{"verse":"","text":"os necessitados"},{"verse":"","text":"e destroem os miseráveis da terra,"},{"verse":"5","text":"dizendo: \"Quando passará"},{"verse":"","text":"a Festa da Lua Nova,"},{"verse":"","text":"para vendermos os cereais?"},{"verse":"","text":"E o sábado, para abrirmos"},{"verse":"","text":"os celeiros de trigo,"},{"verse":"","text":"diminuindo a quantidade,"},{"verse":"","text":"aumentando o peso"},{"verse":"","text":"e enganando com balanças"},{"verse":"","text":"desonestas,"},{"verse":"6","text":"para comprarmos os pobres"},{"verse":"","text":"por dinheiro"},{"verse":"","text":"e os necessitados"},{"verse":"","text":"por um par de sandálias"},{"verse":"","text":"e vendermos o refugo do trigo?\""},{"verse":"7","text":"O"},{"verse":"","text":"pela glória de Jacó, dizendo:"},{"verse":"","text":"\"Nunca me esquecerei"},{"verse":"","text":"de nenhuma das suas obras!"},{"verse":"8","text":"Por causa disto, será que"},{"verse":"","text":"a terra não vai tremer?"},{"verse":"","text":"E não estarão enlutados"},{"verse":"","text":"todos os seus moradores?"},{"verse":"","text":"Toda a terra se levantará"},{"verse":"","text":"como o Nilo,"},{"verse":"","text":"será agitada e abaixará"},{"verse":"","text":"como o rio do Egito.\""},{"verse":"9","text":"\"Naquele dia\","},{"verse":"","text":"diz o"},{"verse":"","text":"\"farei com que o sol"},{"verse":"","text":"se ponha ao meio-dia"},{"verse":"","text":"e com que a terra se cubra"},{"verse":"","text":"de trevas em pleno dia."},{"verse":"10","text":"Transformarei as suas festas"},{"verse":"","text":"em luto"},{"verse":"","text":"e todos os seus cânticos"},{"verse":"","text":"em lamentações."},{"verse":"","text":"Vou fazer com que todos vistam"},{"verse":"","text":"roupas feitas de pano de saco"},{"verse":"","text":"e rapem a cabeça."},{"verse":"","text":"Farei com que isso seja"},{"verse":"","text":"como luto por um filho único,"},{"verse":"","text":"luto cujo fim será"},{"verse":"","text":"como dia de amargura.\""},{"verse":"11","text":"\"Eis que vêm dias\","},{"verse":"","text":"diz o"},{"verse":"","text":"\"em que enviarei sobre a terra"},{"verse":"","text":"fome — não de pão,"},{"verse":"","text":"e sede — não de água,"},{"verse":"","text":"mas de ouvir as palavras"},{"verse":"","text":"do"},{"verse":"12","text":"Andarão de mar a mar"},{"verse":"","text":"e do Norte até o Oriente;"},{"verse":"","text":"correrão por toda parte,"},{"verse":"","text":"procurando a palavra do"},{"verse":"","text":"mas não a acharão."},{"verse":"13","text":"Naquele dia, as moças bonitas"},{"verse":"","text":"e os jovens desmaiarão de sede,"},{"verse":"14","text":"os que agora juram"},{"verse":"","text":"pelo ídolo de Samaria"},{"verse":"","text":"e dizem: ‘Tão certo como vive"},{"verse":"","text":"o seu deus, ó Dã!’"},{"verse":"","text":"E: ‘Tão certo como vive"},{"verse":"","text":"o culto de Berseba!’"},{"verse":"","text":"Esses mesmos cairão"},{"verse":"","text":"e nunca mais se levantarão.\""}],[{"verse":"","text":"Os juízos de Deus são inevitáveis"},{"verse":"1","text":"Vi o Senhor, que estava em pé junto ao altar. Ele me disse:"},{"verse":"","text":"\"Bata nos capitéis das colunas,"},{"verse":"","text":"para que os umbrais"},{"verse":"","text":"comecem a tremer"},{"verse":"","text":"e os pedaços caiam"},{"verse":"","text":"sobre a cabeça de todos eles."},{"verse":"","text":"Matarei à espada os que restarem."},{"verse":"","text":"Nenhum deles fugirá,"},{"verse":"","text":"e nenhum escapará."},{"verse":"2","text":"Ainda que cavem para chegar"},{"verse":"","text":"ao mais profundo abismo,"},{"verse":"","text":"a minha mão os tirará de lá."},{"verse":"","text":"Se subirem ao céu,"},{"verse":"","text":"de lá os farei descer."},{"verse":"3","text":"Se eles se esconderem"},{"verse":"","text":"no alto do Carmelo,"},{"verse":"","text":"irei atrás deles e de lá os tirarei."},{"verse":"","text":"E, caso se ocultarem"},{"verse":"","text":"dos meus olhos"},{"verse":"","text":"no fundo do mar,"},{"verse":"","text":"ali darei ordem à serpente,"},{"verse":"","text":"e ela os morderá."},{"verse":"4","text":"Se forem levados para o cativeiro"},{"verse":"","text":"pelos seus inimigos,"},{"verse":"","text":"ali darei ordem à espada,"},{"verse":"","text":"e ela os matará;"},{"verse":"","text":"porei os meus olhos sobre eles"},{"verse":"","text":"para o mal e não para o bem.\""},{"verse":"5","text":"Porque o Senhor,"},{"verse":"","text":"o"},{"verse":"","text":"é o que toca na terra,"},{"verse":"","text":"e ela se derrete,"},{"verse":"","text":"e todos os seus moradores"},{"verse":"","text":"estarão de luto."},{"verse":"","text":"Toda a terra subirá como o Nilo"},{"verse":"","text":"e abaixará como o rio do Egito."},{"verse":"6","text":"Deus é o que edifica"},{"verse":"","text":"as suas câmaras no céu"},{"verse":"","text":"e firmou a sua abóbada"},{"verse":"","text":"sobre a terra."},{"verse":"","text":"Ele é o que chama as águas do mar"},{"verse":"","text":"e as derrama sobre a terra;"},{"verse":"","text":"Senhor"},{"verse":"7","text":"\"Filhos de Israel,"},{"verse":"","text":"não é verdade que vocês"},{"verse":"","text":"são para mim"},{"verse":"","text":"como os filhos dos etíopes?\" —"},{"verse":"","text":"diz o"},{"verse":"","text":"\"Não é fato que eu tirei Israel"},{"verse":"","text":"da terra do Egito,"},{"verse":"","text":"os filisteus de Caftor,"},{"verse":"","text":"e os sírios de Quir?"},{"verse":"8","text":"Eis que os olhos do"},{"verse":"","text":"estão contra este reino pecador,"},{"verse":"","text":"e eu o destruirei da face da terra."},{"verse":"","text":"Mas não destruirei por completo"},{"verse":"","text":"a casa de Jacó\","},{"verse":"","text":"diz o"},{"verse":"9","text":"\"Porque eis que darei ordens"},{"verse":"","text":"e sacudirei a casa de Israel"},{"verse":"","text":"entre todas as nações,"},{"verse":"","text":"assim como se sacode trigo"},{"verse":"","text":"na peneira,"},{"verse":"","text":"sem que um só grão caia na terra."},{"verse":"10","text":"Todos os pecadores"},{"verse":"","text":"do meu povo"},{"verse":"","text":"morrerão à espada,"},{"verse":"","text":"os que dizem:"},{"verse":"","text":"‘O mal não nos alcançará"},{"verse":"","text":"nem nos encontrará.’\""},{"verse":"","text":"Restauração do Israel espiritual"},{"verse":"11","text":"\"Naquele dia, levantarei"},{"verse":"","text":"o tabernáculo caído de Davi."},{"verse":"","text":"Vou reparar as suas brechas"},{"verse":"","text":"e levantá-lo das suas ruínas."},{"verse":"","text":"Vou restaurá-lo,"},{"verse":"","text":"para que volte a ser como era"},{"verse":"","text":"nos dias da antiguidade,"},{"verse":"12","text":"para que o meu povo tome posse"},{"verse":"","text":"do restante de Edom"},{"verse":"","text":"e de todas as nações"},{"verse":"","text":"que são chamadas pelo meu nome\","},{"verse":"","text":"diz o"},{"verse":"","text":"que faz estas coisas."},{"verse":"13","text":"\"Eis que vêm dias\","},{"verse":"","text":"diz o"},{"verse":"","text":"\"em que o que lavra"},{"verse":"","text":"virá logo após o que colhe,"},{"verse":"","text":"e o que pisa as uvas"},{"verse":"","text":"virá logo após"},{"verse":"","text":"o que lança semente."},{"verse":"","text":"Os montes destilarão vinho,"},{"verse":"","text":"e todas as colinas se derreterão."},{"verse":"14","text":"Mudarei a sorte"},{"verse":"","text":"do meu povo de Israel."},{"verse":"","text":"Eles reedificarão as cidades destruídas"},{"verse":"","text":"e nelas habitarão."},{"verse":"","text":"Plantarão vinhas"},{"verse":"","text":"e beberão o seu vinho;"},{"verse":"","text":"farão pomares"},{"verse":"","text":"e comerão dos seus frutos."},{"verse":"15","text":"Eu os plantarei na sua terra,"},{"verse":"","text":"e, dessa terra que lhes dei,"},{"verse":"","text":"nunca mais serão arrancados\","},{"verse":"","text":"diz o"}]]}