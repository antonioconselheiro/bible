{"chapters":[{"chapter":1,"verses":[{"verse":1,"text":"Palavras que, em visão, vieram a Amós, um pastor da cidade de Tecoa, a respeito de Israel. Isso aconteceu nos dias de Uzias, rei de Judá, e nos dias de Jeroboão, filho de Joás, rei de Israel, dois anos antes do terremoto."},{"verse":2,"text":"\"O"},{"verse":3,"text":"e de Jerusalém fará ouvir a sua voz."},{"verse":4,"text":"Os campos dos pastores"},{"verse":5,"text":"estarão de luto,"},{"verse":6,"text":"e o alto do Carmelo secará.\""},{"verse":7,"text":"Ameaças contra diversas nações"},{"verse":8,"text":"Síria"},{"verse":9,"text":"Assim diz o"},{"verse":10,"text":"\"Por três transgressões"},{"verse":11,"text":"de Damasco,"},{"verse":12,"text":"sim, por causa de quatro,"},{"verse":13,"text":"não suspenderei o castigo."},{"verse":14,"text":"Porque passaram"},{"verse":15,"text":"um instrumento de trilhar"},{"verse":16,"text":"com pontas de ferro sobre Gileade."},{"verse":17,"text":"Por isso, porei fogo"},{"verse":18,"text":"à casa de Hazael,"},{"verse":19,"text":"fogo que consumirá"},{"verse":20,"text":"as fortalezas de Ben-Hadade."},{"verse":21,"text":"Quebrarei os ferrolhos"},{"verse":22,"text":"de Damasco"},{"verse":23,"text":"e eliminarei o morador"},{"verse":24,"text":"de Biqueate-Áven"},{"verse":25,"text":"e o que tem o cetro de Bete-Éden."},{"verse":26,"text":"O povo da Síria será levado"},{"verse":27,"text":"em cativeiro a Quir\","},{"verse":28,"text":"diz o"},{"verse":29,"text":"Filístia"},{"verse":30,"text":"Assim diz o"},{"verse":31,"text":"\"Por três transgressões de Gaza,"},{"verse":32,"text":"sim, por causa de quatro,"},{"verse":33,"text":"não suspenderei o castigo."},{"verse":34,"text":"Porque levaram em cativeiro"},{"verse":35,"text":"todo um povo,"},{"verse":36,"text":"para entregá-lo a Edom."},{"verse":37,"text":"Por isso, porei fogo"},{"verse":38,"text":"nas muralhas de Gaza,"},{"verse":39,"text":"fogo que consumirá"},{"verse":40,"text":"as suas fortalezas."},{"verse":41,"text":"Eliminarei o morador de Asdode"},{"verse":42,"text":"e o que tem o cetro de Asquelom."},{"verse":43,"text":"Voltarei a minha mão"},{"verse":44,"text":"contra Ecrom,"},{"verse":45,"text":"e o resto dos filisteus perecerá\","},{"verse":46,"text":"diz o"},{"verse":47,"text":"Tiro"},{"verse":48,"text":"Assim diz o"},{"verse":49,"text":"\"Por três transgressões de Tiro,"},{"verse":50,"text":"sim, por causa de quatro,"},{"verse":51,"text":"não suspenderei o castigo."},{"verse":52,"text":"Porque levaram em cativeiro"},{"verse":53,"text":"todo um povo,"},{"verse":54,"text":"para entregá-lo a Edom"},{"verse":55,"text":"e não se lembraram"},{"verse":56,"text":"da aliança de irmãos."},{"verse":57,"text":"Por isso, porei fogo"},{"verse":58,"text":"nas muralhas de Tiro,"},{"verse":59,"text":"fogo que consumirá"},{"verse":60,"text":"as suas fortalezas.\""},{"verse":61,"text":"Edom"},{"verse":62,"text":"Assim diz o"},{"verse":63,"text":"\"Por três transgressões de Edom,"},{"verse":64,"text":"sim, por causa de quatro,"},{"verse":65,"text":"não suspenderei o castigo."},{"verse":66,"text":"Porque perseguiu o seu irmão"},{"verse":67,"text":"com a espada"},{"verse":68,"text":"e não teve nenhuma compaixão dele."},{"verse":69,"text":"A sua ira não cessou"},{"verse":70,"text":"de despedaçar,"},{"verse":71,"text":"e conservou a sua indignação"},{"verse":72,"text":"para sempre."},{"verse":73,"text":"Por isso, porei fogo em Temã,"},{"verse":74,"text":"fogo que consumirá"},{"verse":75,"text":"as fortalezas de Bozra.\""},{"verse":76,"text":"Amom"},{"verse":77,"text":"Assim diz o"},{"verse":78,"text":"\"Por três transgressões"},{"verse":79,"text":"dos filhos de Amom,"},{"verse":80,"text":"sim, por causa de quatro,"},{"verse":81,"text":"não suspenderei o castigo."},{"verse":82,"text":"Porque rasgaram o ventre"},{"verse":83,"text":"das grávidas"},{"verse":84,"text":"da região de Gileade,"},{"verse":85,"text":"para ampliarem as suas fronteiras."},{"verse":86,"text":"Por isso, porei fogo"},{"verse":87,"text":"nas muralhas de Rabá,"},{"verse":88,"text":"fogo que consumirá"},{"verse":89,"text":"as suas fortalezas,"},{"verse":90,"text":"com alarido no dia da batalha,"},{"verse":91,"text":"com turbilhão"},{"verse":92,"text":"no dia da tempestade."},{"verse":93,"text":"O seu rei irá para o cativeiro,"},{"verse":94,"text":"ele e os seus príncipes com ele\","},{"verse":95,"text":"diz o"}]},{"chapter":2,"verses":[{"verse":0,"text":"Moabe"},{"verse":1,"text":"Assim diz o"},{"verse":2,"text":"\"Por três transgressões de Moabe,"},{"verse":3,"text":"sim, por causa de quatro,"},{"verse":4,"text":"não suspenderei o castigo."},{"verse":5,"text":"Porque queimou os ossos"},{"verse":6,"text":"do rei de Edom,"},{"verse":7,"text":"até reduzi-los a cinza."},{"verse":8,"text":"Por isso, porei fogo em Moabe,"},{"verse":9,"text":"fogo que consumirá"},{"verse":10,"text":"as fortalezas de Queriote."},{"verse":11,"text":"Moabe morrerá"},{"verse":12,"text":"entre grande estrondo,"},{"verse":13,"text":"alarido e som de trombeta."},{"verse":14,"text":"Eliminarei do meio dele o juiz,"},{"verse":15,"text":"e juntamente com ele"},{"verse":16,"text":"matarei todos os seus príncipes\","},{"verse":17,"text":"diz o"},{"verse":18,"text":"Judá"},{"verse":19,"text":"Assim diz o"},{"verse":20,"text":"\"Por três transgressões de Judá,"},{"verse":21,"text":"sim, por causa de quatro,"},{"verse":22,"text":"não suspenderei o castigo."},{"verse":23,"text":"Porque rejeitaram a lei do"},{"verse":24,"text":"e não guardaram os seus estatutos."},{"verse":25,"text":"Os falsos deuses os enganaram,"},{"verse":26,"text":"deuses que os pais deles"},{"verse":27,"text":"haviam seguido."},{"verse":28,"text":"Por isso, porei fogo em Judá,"},{"verse":29,"text":"fogo que consumirá"},{"verse":30,"text":"as fortalezas de Jerusalém.\""},{"verse":31,"text":"Israel"},{"verse":32,"text":"Assim diz o"},{"verse":33,"text":"\"Por três transgressões de Israel,"},{"verse":34,"text":"sim, por causa de quatro,"},{"verse":35,"text":"não suspenderei o castigo."},{"verse":36,"text":"Porque vendem o justo"},{"verse":37,"text":"por dinheiro"},{"verse":38,"text":"e condenam o necessitado"},{"verse":39,"text":"por causa de"},{"verse":40,"text":"um par de sandálias."},{"verse":41,"text":"Esmagam no pó da terra"},{"verse":42,"text":"a cabeça dos pobres"},{"verse":43,"text":"e pervertem o caminho"},{"verse":44,"text":"dos necessitados."},{"verse":45,"text":"Um homem e seu pai têm relações"},{"verse":46,"text":"com a mesma jovem"},{"verse":47,"text":"e, assim, profanam"},{"verse":48,"text":"o meu santo nome."},{"verse":49,"text":"Eles se deitam ao lado"},{"verse":50,"text":"de qualquer altar"},{"verse":51,"text":"sobre roupas"},{"verse":52,"text":"recebidas como penhor"},{"verse":53,"text":"e, no templo do seu deus,"},{"verse":54,"text":"bebem o vinho"},{"verse":55,"text":"dos que foram multados.\""},{"verse":56,"text":"\"Todavia, fui eu que destruí"},{"verse":57,"text":"diante deles os amorreus,"},{"verse":58,"text":"que eram tão altos como os cedros"},{"verse":59,"text":"e tão fortes como os carvalhos;"},{"verse":60,"text":"destruí os seus frutos por cima"},{"verse":61,"text":"e as suas raízes por baixo."},{"verse":62,"text":"Também fui eu que tirei vocês"},{"verse":63,"text":"da terra do Egito"},{"verse":64,"text":"e durante quarenta anos"},{"verse":65,"text":"os conduzi pelo deserto,"},{"verse":66,"text":"para que vocês pudessem tomar"},{"verse":67,"text":"posse da terra dos amorreus."},{"verse":68,"text":"Escolhi alguns dos seus filhos"},{"verse":69,"text":"para serem profetas"},{"verse":70,"text":"e alguns dos seus jovens"},{"verse":71,"text":"para serem nazireus."},{"verse":72,"text":"Não é isto assim, filhos de Israel?\" —"},{"verse":73,"text":"diz o"},{"verse":74,"text":"\"Mas vocês deram"},{"verse":75,"text":"vinho aos nazireus"},{"verse":76,"text":"e ordenaram aos profetas"},{"verse":77,"text":"que não profetizassem.\""},{"verse":78,"text":"\"Como faz um carro"},{"verse":79,"text":"carregado de feixes,"},{"verse":80,"text":"eu os esmagarei ali"},{"verse":81,"text":"onde vocês se encontram."},{"verse":82,"text":"Os mais ágeis não encontrarão"},{"verse":83,"text":"refúgio,"},{"verse":84,"text":"os fortes não poderão usar"},{"verse":85,"text":"a sua força,"},{"verse":86,"text":"e os valentes não conseguirão"},{"verse":87,"text":"salvar a sua vida."},{"verse":88,"text":"Os que manejam o arco"},{"verse":89,"text":"não resistirão,"},{"verse":90,"text":"os mais velozes"},{"verse":91,"text":"não conseguirão fugir,"},{"verse":92,"text":"e os que vão montados a cavalo"},{"verse":93,"text":"não conseguirão"},{"verse":94,"text":"salvar a sua vida."},{"verse":95,"text":"Até mesmo os mais corajosos"},{"verse":96,"text":"entre os valentes"},{"verse":97,"text":"fugirão nus naquele dia\","},{"verse":98,"text":"diz o"}]},{"chapter":3,"verses":[{"verse":0,"text":"O castigo contra a maldade de Israel"},{"verse":1,"text":"Ouçam a palavra que o"},{"verse":2,"text":"\"De todas as famílias da terra,"},{"verse":3,"text":"somente a vocês eu escolhi;"},{"verse":4,"text":"portanto, eu os punirei"},{"verse":5,"text":"por todas as suas iniquidades."},{"verse":6,"text":"Será que dois andarão juntos,"},{"verse":7,"text":"se não estiverem de acordo?"},{"verse":8,"text":"Será que o leão"},{"verse":9,"text":"vai rugir na floresta,"},{"verse":10,"text":"sem que tenha encontrado presa?"},{"verse":11,"text":"Será que o leãozinho"},{"verse":12,"text":"fará ouvir a sua voz no covil,"},{"verse":13,"text":"se não tiver apanhado nada?"},{"verse":14,"text":"Será que a ave"},{"verse":15,"text":"cairá na armadilha,"},{"verse":16,"text":"se o laço não estiver armado?"},{"verse":17,"text":"Será que o laço se levanta do chão,"},{"verse":18,"text":"sem que tenha apanhado"},{"verse":19,"text":"alguma coisa?"},{"verse":20,"text":"Será possível tocar a trombeta"},{"verse":21,"text":"na cidade,"},{"verse":22,"text":"sem que o povo comece a tremer?"},{"verse":23,"text":"Será que sobrevirá algum mal"},{"verse":24,"text":"à cidade,"},{"verse":25,"text":"sem que o"},{"verse":26,"text":"\"Certamente o"},{"verse":27,"text":"não fará coisa alguma,"},{"verse":28,"text":"sem primeiro revelar o seu segredo"},{"verse":29,"text":"aos seus servos, os profetas."},{"verse":30,"text":"O leão rugiu,"},{"verse":31,"text":"quem não ficará com medo?"},{"verse":32,"text":"O"},{"verse":33,"text":"quem não profetizará?\""},{"verse":34,"text":"\"Proclamem nas fortalezas"},{"verse":35,"text":"de Asdode"},{"verse":36,"text":"e nos palácios"},{"verse":37,"text":"da terra do Egito o seguinte:"},{"verse":38,"text":"‘Reúnam-se nos montes"},{"verse":39,"text":"de Samaria"},{"verse":40,"text":"e vejam que grandes tumultos"},{"verse":41,"text":"lá existem"},{"verse":42,"text":"e que opressões há no meio dela.’"},{"verse":43,"text":"Porque o povo de Samaria"},{"verse":44,"text":"não sabe fazer o que é reto\","},{"verse":45,"text":"diz o"},{"verse":46,"text":"\"e entesoura nos seus palácios"},{"verse":47,"text":"a violência e a devastação.\""},{"verse":48,"text":"Portanto, assim diz o"},{"verse":49,"text":"\"Um inimigo cercará a sua terra,"},{"verse":50,"text":"destruirá o seu poder,"},{"verse":51,"text":"e os seus palácios"},{"verse":52,"text":"serão saqueados.\""},{"verse":53,"text":"Assim diz o"},{"verse":54,"text":"— Como o pastor livra da boca do leão as duas pernas ou um pedacinho da orelha de um animal, assim serão salvos os filhos de Israel que vivem em Samaria com apenas o canto da cama e parte do leito."},{"verse":55,"text":"\"Ouçam e deem testemunho"},{"verse":56,"text":"contra a casa de Jacó\","},{"verse":57,"text":"diz o"},{"verse":58,"text":"o Deus dos Exércitos:"},{"verse":59,"text":"\"No dia em que eu punir Israel,"},{"verse":60,"text":"por causa das suas transgressões,"},{"verse":61,"text":"visitarei também"},{"verse":62,"text":"os altares de Betel;"},{"verse":63,"text":"e as pontas do altar serão cortadas"},{"verse":64,"text":"e cairão por terra."},{"verse":65,"text":"Derrubarei a casa de inverno"},{"verse":66,"text":"com a casa de verão;"},{"verse":67,"text":"as casas de marfim"},{"verse":68,"text":"ficarão em ruínas,"},{"verse":69,"text":"e as grandes casas"},{"verse":70,"text":"serão destruídas\","},{"verse":71,"text":"diz o"}]},{"chapter":4,"verses":[{"verse":0,"text":"Ameaças contra as mulheres de Samaria"},{"verse":1,"text":"\"Ouçam esta palavra,"},{"verse":2,"text":"vacas de Basã,"},{"verse":3,"text":"vocês que estão"},{"verse":4,"text":"no monte de Samaria,"},{"verse":5,"text":"que oprimem os pobres,"},{"verse":6,"text":"esmagam os necessitados"},{"verse":7,"text":"e dizem aos maridos:"},{"verse":8,"text":"‘Tragam vinho, e vamos beber!’"},{"verse":9,"text":"O"},{"verse":10,"text":"pela sua santidade"},{"verse":11,"text":"que virão dias em que vocês"},{"verse":12,"text":"serão arrastadas com ganchos;"},{"verse":13,"text":"até as últimas de vocês"},{"verse":14,"text":"serão levadas"},{"verse":15,"text":"com anzóis de pesca."},{"verse":16,"text":"Vocês sairão em fila pelas brechas"},{"verse":17,"text":"e serão lançadas"},{"verse":18,"text":"na direção do monte Hermom\","},{"verse":19,"text":"diz o"},{"verse":20,"text":"A cegueira espiritual de Israel"},{"verse":21,"text":"\"Venham a Betel e pequem!"},{"verse":22,"text":"Venham a Gilgal"},{"verse":23,"text":"e pequem ainda mais!"},{"verse":24,"text":"Cada manhã,"},{"verse":25,"text":"tragam os seus sacrifícios"},{"verse":26,"text":"e, de três em três dias,"},{"verse":27,"text":"os seus dízimos!"},{"verse":28,"text":"Ofereçam sacrifícios de louvor"},{"verse":29,"text":"com pão levedado"},{"verse":30,"text":"e proclamem ofertas voluntárias!"},{"verse":31,"text":"Tornem isso público,"},{"verse":32,"text":"porque é disso que vocês gostam,"},{"verse":33,"text":"ó filhos de Israel\","},{"verse":34,"text":"diz o"},{"verse":35,"text":"\"Também deixei"},{"verse":36,"text":"que vocês ficassem"},{"verse":37,"text":"sem ter o que mastigar"},{"verse":38,"text":"em todas as suas cidades"},{"verse":39,"text":"e com falta de pão"},{"verse":40,"text":"em todos os lugares,"},{"verse":41,"text":"mas vocês não se converteram"},{"verse":42,"text":"a mim\","},{"verse":43,"text":"diz o"},{"verse":44,"text":"\"Além disso, retive a chuva,"},{"verse":45,"text":"faltando ainda três meses"},{"verse":46,"text":"para a colheita."},{"verse":47,"text":"Fiz chover sobre uma cidade"},{"verse":48,"text":"e sobre a outra, não;"},{"verse":49,"text":"um campo teve chuva,"},{"verse":50,"text":"mas o outro, que ficou sem chuva,"},{"verse":51,"text":"secou."},{"verse":52,"text":"Pessoas de duas ou três cidades"},{"verse":53,"text":"se dirigiram a outra cidade"},{"verse":54,"text":"para beber água,"},{"verse":55,"text":"sem conseguirem matar a sede,"},{"verse":56,"text":"mas vocês não se converteram"},{"verse":57,"text":"a mim\","},{"verse":58,"text":"diz o"},{"verse":59,"text":"\"Eu os castiguei"},{"verse":60,"text":"com o crestamento"},{"verse":61,"text":"e a ferrugem."},{"verse":62,"text":"Os gafanhotos devoraram"},{"verse":63,"text":"as hortas e as vinhas,"},{"verse":64,"text":"as figueiras e as oliveiras,"},{"verse":65,"text":"mas vocês não se converteram"},{"verse":66,"text":"a mim\","},{"verse":67,"text":"diz o"},{"verse":68,"text":"\"Enviei a peste contra vocês,"},{"verse":69,"text":"assim como havia feito no Egito."},{"verse":70,"text":"Matei os seus jovens à espada,"},{"verse":71,"text":"deixei que os seus cavalos"},{"verse":72,"text":"fossem capturados,"},{"verse":73,"text":"e fiz com que o mau cheiro"},{"verse":74,"text":"dos acampamentos"},{"verse":75,"text":"chegasse aos seus narizes,"},{"verse":76,"text":"mas vocês não se converteram"},{"verse":77,"text":"a mim\","},{"verse":78,"text":"diz o"},{"verse":79,"text":"\"Destruí alguns de vocês,"},{"verse":80,"text":"como Deus destruiu Sodoma"},{"verse":81,"text":"e Gomorra."},{"verse":82,"text":"Vocês foram como um toco de lenha"},{"verse":83,"text":"tirado do fogo,"},{"verse":84,"text":"mas não se converteram a mim\","},{"verse":85,"text":"diz o"},{"verse":86,"text":"\"Portanto, assim farei"},{"verse":87,"text":"com você, Israel!"},{"verse":88,"text":"E, porque farei isso com você,"},{"verse":89,"text":"prepare-se, ó Israel,"},{"verse":90,"text":"para se encontrar com o seu Deus!"},{"verse":91,"text":"Porque é ele"},{"verse":92,"text":"quem forma os montes,"},{"verse":93,"text":"cria o vento"},{"verse":94,"text":"e declara aos seres humanos"},{"verse":95,"text":"qual é o seu pensamento;"},{"verse":96,"text":"ele faz da manhã trevas"},{"verse":97,"text":"e anda sobre os altos da terra;"},{"verse":98,"text":"Senhor"},{"verse":99,"text":"é o seu nome.\""}]},{"chapter":5,"verses":[{"verse":0,"text":"Busquem o Senhor e vocês viverão"},{"verse":1,"text":"Ouçam esta palavra que falo contra vocês, ó casa de Israel. É uma lamentação."},{"verse":2,"text":"\"Caiu a virgem de Israel,"},{"verse":3,"text":"para nunca mais se levantar!"},{"verse":4,"text":"Está estendida na sua própria terra,"},{"verse":5,"text":"e não há quem a levante.\""},{"verse":6,"text":"Porque assim diz o"},{"verse":7,"text":"\"A cidade da qual saem mil"},{"verse":8,"text":"conservará apenas cem,"},{"verse":9,"text":"e aquela da qual saem cem"},{"verse":10,"text":"conservará apenas dez"},{"verse":11,"text":"para a casa de Israel.\""},{"verse":12,"text":"Pois assim diz o"},{"verse":13,"text":"\"Busquem a mim e vocês viverão."},{"verse":14,"text":"Porém não busquem Betel,"},{"verse":15,"text":"nem venham a Gilgal,"},{"verse":16,"text":"nem passem a Berseba."},{"verse":17,"text":"Porque Gilgal certamente"},{"verse":18,"text":"será levada cativa,"},{"verse":19,"text":"e Betel será reduzida a nada."},{"verse":20,"text":"Busquem o"},{"verse":21,"text":"e vocês viverão."},{"verse":22,"text":"Do contrário, ele irromperá"},{"verse":23,"text":"na casa de José"},{"verse":24,"text":"como um fogo que a consome,"},{"verse":25,"text":"e não haverá em Betel"},{"verse":26,"text":"quem consiga apagá-lo."},{"verse":27,"text":"Vocês que transformam"},{"verse":28,"text":"o juízo em veneno"},{"verse":29,"text":"e lançam por terra a justiça,"},{"verse":30,"text":"busquem aquele que fez"},{"verse":31,"text":"o Sete-estrelo e o Órion;"},{"verse":32,"text":"aquele que torna"},{"verse":33,"text":"as densas trevas em manhã"},{"verse":34,"text":"e muda o dia em noite;"},{"verse":35,"text":"aquele que chama as águas do mar"},{"verse":36,"text":"e as derrama sobre a terra;"},{"verse":37,"text":"Senhor"},{"verse":38,"text":"É ele que faz vir"},{"verse":39,"text":"súbita destruição sobre o forte"},{"verse":40,"text":"e ruína contra a fortaleza.\""},{"verse":41,"text":"\"Vocês odeiam"},{"verse":42,"text":"quem os repreende no tribunal"},{"verse":43,"text":"e detestam quem fala"},{"verse":44,"text":"com sinceridade."},{"verse":45,"text":"Portanto, visto que pisam"},{"verse":46,"text":"os pobres"},{"verse":47,"text":"e deles exigem tributo de trigo,"},{"verse":48,"text":"vocês não habitarão nas casas"},{"verse":49,"text":"de pedras lavradas"},{"verse":50,"text":"que construíram,"},{"verse":51,"text":"nem beberão o vinho"},{"verse":52,"text":"das belas videiras"},{"verse":53,"text":"que plantaram."},{"verse":54,"text":"Porque sei que são muitas"},{"verse":55,"text":"as suas transgressões"},{"verse":56,"text":"e que são graves os pecados"},{"verse":57,"text":"que vocês cometem."},{"verse":58,"text":"Vocês afligem os justos,"},{"verse":59,"text":"aceitam suborno"},{"verse":60,"text":"e rejeitam as causas"},{"verse":61,"text":"dos necessitados no tribunal."},{"verse":62,"text":"Por isso, numa época"},{"verse":63,"text":"de tanta corrupção,"},{"verse":64,"text":"quem é prudente"},{"verse":65,"text":"prefere ficar calado.\""},{"verse":66,"text":"\"Busquem o bem e não o mal,"},{"verse":67,"text":"para que vocês vivam."},{"verse":68,"text":"E assim o"},{"verse":69,"text":"o Deus dos Exércitos,"},{"verse":70,"text":"estará com vocês,"},{"verse":71,"text":"como vocês dizem."},{"verse":72,"text":"Odeiem o mal e amem o bem."},{"verse":73,"text":"Promovam a justiça nos tribunais."},{"verse":74,"text":"Talvez o"},{"verse":75,"text":"o Deus dos Exércitos,"},{"verse":76,"text":"se compadeça do remanescente"},{"verse":77,"text":"de José.\""},{"verse":78,"text":"Portanto, assim diz o Senhor, o"},{"verse":79,"text":"\"Em todas as praças haverá pranto,"},{"verse":80,"text":"e em todas as ruas dirão: ‘Ai! Ai!’"},{"verse":81,"text":"Chamarão os lavradores"},{"verse":82,"text":"para o pranto"},{"verse":83,"text":"e, para o choro,"},{"verse":84,"text":"os que sabem prantear."},{"verse":85,"text":"Em todas as vinhas"},{"verse":86,"text":"haverá pranto,"},{"verse":87,"text":"porque passarei"},{"verse":88,"text":"pelo meio de vocês\","},{"verse":89,"text":"diz o"},{"verse":90,"text":"O Dia do Senhor"},{"verse":91,"text":"\"Ai dos que desejam"},{"verse":92,"text":"o Dia do"},{"verse":93,"text":"Para que vocês desejam"},{"verse":94,"text":"o Dia do"},{"verse":95,"text":"Será um dia de trevas"},{"verse":96,"text":"e não de luz."},{"verse":97,"text":"Será como se um homem"},{"verse":98,"text":"fugisse de um leão"},{"verse":99,"text":"e lhe saísse ao encontro um urso;"},{"verse":100,"text":"ou como se, entrando em casa"},{"verse":101,"text":"e encostando a mão na parede,"},{"verse":102,"text":"fosse mordido por uma cobra."},{"verse":103,"text":"O dia do"},{"verse":104,"text":"um dia de trevas e não de luz!"},{"verse":105,"text":"Será um dia"},{"verse":106,"text":"de completa escuridão,"},{"verse":107,"text":"sem nenhuma claridade!\""},{"verse":108,"text":"Deus exige justiça e não sacrifícios"},{"verse":109,"text":"\"Eu odeio e desprezo"},{"verse":110,"text":"as suas festas"},{"verse":111,"text":"e com as suas reuniões solenes"},{"verse":112,"text":"não tenho nenhum prazer."},{"verse":113,"text":"Mesmo que vocês me ofereçam"},{"verse":114,"text":"holocaustos e ofertas de cereais,"},{"verse":115,"text":"não me agradarei deles."},{"verse":116,"text":"Quanto às suas ofertas pacíficas"},{"verse":117,"text":"de animais gordos,"},{"verse":118,"text":"nem sequer olharei para elas."},{"verse":119,"text":"Afastem de mim"},{"verse":120,"text":"o barulho dos seus cânticos,"},{"verse":121,"text":"porque não ouvirei"},{"verse":122,"text":"as melodias das suas liras."},{"verse":123,"text":"Em vez disso,"},{"verse":124,"text":"corra o juízo como as águas,"},{"verse":125,"text":"e a justiça,"},{"verse":126,"text":"como um ribeiro perene.\""},{"verse":127,"text":"— Casa de Israel, por acaso vocês me apresentaram sacrifícios e ofertas de cereais durante os quarenta anos no deserto?"}]},{"chapter":6,"verses":[{"verse":0,"text":"A corrupção e a destruição de Israel"},{"verse":1,"text":"\"Ai dos que andam"},{"verse":2,"text":"à vontade em Sião"},{"verse":3,"text":"e dos que vivem sem receio"},{"verse":4,"text":"no monte de Samaria,"},{"verse":5,"text":"homens notáveis"},{"verse":6,"text":"da principal das nações,"},{"verse":7,"text":"aos quais se dirige a casa de Israel!"},{"verse":8,"text":"Vão à cidade de Calné e olhem."},{"verse":9,"text":"Dali, vão à grande cidade"},{"verse":10,"text":"de Hamate"},{"verse":11,"text":"e, depois, desçam até"},{"verse":12,"text":"Gate dos filisteus."},{"verse":13,"text":"Será que eles são melhores"},{"verse":14,"text":"do que os reinos de vocês?"},{"verse":15,"text":"Ou será que o território deles"},{"verse":16,"text":"é maior do que o de vocês?"},{"verse":17,"text":"Vocês imaginam que o dia mau"},{"verse":18,"text":"está longe,"},{"verse":19,"text":"mas estão fazendo com que"},{"verse":20,"text":"o trono da violência"},{"verse":21,"text":"se aproxime."},{"verse":22,"text":"Vocês dormem"},{"verse":23,"text":"em camas de marfim"},{"verse":24,"text":"e se espreguiçam"},{"verse":25,"text":"sobre os seus leitos."},{"verse":26,"text":"Comem os cordeiros do rebanho"},{"verse":27,"text":"e os bezerros"},{"verse":28,"text":"que estão na engorda."},{"verse":29,"text":"Ficam cantando à toa"},{"verse":30,"text":"ao som da lira"},{"verse":31,"text":"e, como Davi, inventam"},{"verse":32,"text":"instrumentos musicais."},{"verse":33,"text":"Bebem vinho em taças"},{"verse":34,"text":"e se ungem"},{"verse":35,"text":"com o mais excelente óleo,"},{"verse":36,"text":"mas não se afligem"},{"verse":37,"text":"com a ruína de José."},{"verse":38,"text":"Portanto, vocês estarão"},{"verse":39,"text":"entre os primeiros que serão"},{"verse":40,"text":"levados para o cativeiro,"},{"verse":41,"text":"e cessarão as festanças"},{"verse":42,"text":"dos que gostam"},{"verse":43,"text":"de se espreguiçar.\""},{"verse":44,"text":"O"},{"verse":45,"text":"\"Eu detesto o orgulho de Jacó"},{"verse":46,"text":"e odeio os seus palácios."},{"verse":47,"text":"Abandonarei a cidade"},{"verse":48,"text":"e tudo o que nela há.\""},{"verse":49,"text":"Se numa casa ficarem dez homens, também esses morrerão."},{"verse":50,"text":"Pois eis que o"},{"verse":51,"text":"e será destroçada"},{"verse":52,"text":"a casa grande,"},{"verse":53,"text":"e a pequena será feita"},{"verse":54,"text":"em pedaços."},{"verse":55,"text":"\"Será que os cavalos podem"},{"verse":56,"text":"correr sobre as rochas?"},{"verse":57,"text":"Será que é possível lavrá-las"},{"verse":58,"text":"com bois?"},{"verse":59,"text":"No entanto, vocês transformaram"},{"verse":60,"text":"o juízo em veneno"},{"verse":61,"text":"e o fruto da justiça, em alosna."},{"verse":62,"text":"Vocês se alegram por terem"},{"verse":63,"text":"conquistado Lo-Debar, e dizem:"},{"verse":64,"text":"‘Não é fato que,"},{"verse":65,"text":"com as nossas próprias forças,"},{"verse":66,"text":"nos apoderamos de Carnaim?’"},{"verse":67,"text":"Pois eis que trarei contra vocês,"},{"verse":68,"text":"ó casa de Israel, uma nação"},{"verse":69,"text":"que os oprimirá,"},{"verse":70,"text":"desde a entrada de Hamate"},{"verse":71,"text":"até o ribeiro da Arabá\","},{"verse":72,"text":"diz o"},{"verse":73,"text":"o Deus dos Exércitos."}]},{"chapter":7,"verses":[{"verse":0,"text":"A visão do gafanhoto, do fogo e do prumo"},{"verse":1,"text":"O"},{"verse":2,"text":"—"},{"verse":3,"text":"Então o"},{"verse":4,"text":"— Isso não vai acontecer."},{"verse":5,"text":"Depois, o"},{"verse":6,"text":"—"},{"verse":7,"text":"E o"},{"verse":8,"text":"— Também isso não vai acontecer."},{"verse":9,"text":"Mostrou-me também isto: eis que o Senhor estava sobre um muro levantado a prumo, e tinha um prumo na mão."},{"verse":10,"text":"— O que você está vendo, Amós?"},{"verse":11,"text":"Respondi:"},{"verse":12,"text":"— Um prumo."},{"verse":13,"text":"Então o Senhor disse:"},{"verse":14,"text":"— Eis que eu porei o prumo no meio do meu povo de Israel; não posso mais ignorar o que fazem."},{"verse":15,"text":"Amós e o sacerdote Amazias"},{"verse":16,"text":"Então Amazias, o sacerdote de Betel, mandou dizer a Jeroboão, rei de Israel:"},{"verse":17,"text":"— Amós está conspirando contra o rei no meio da casa de Israel. A terra não pode suportar todas as suas palavras."},{"verse":18,"text":"Depois Amazias disse a Amós:"},{"verse":19,"text":"— Saia daqui, vidente! Fuja para a terra de Judá e vá ganhar a vida por lá. Em Judá você pode profetizar."},{"verse":20,"text":"Amós respondeu e disse a Amazias:"},{"verse":21,"text":"— Eu não sou profeta nem discípulo de profeta. Eu cuido de gado e colho sicômoros."},{"verse":22,"text":"\"A sua mulher se prostituirá"},{"verse":23,"text":"na cidade,"},{"verse":24,"text":"e os seus filhos e as suas filhas"},{"verse":25,"text":"cairão à espada."},{"verse":26,"text":"A sua terra será repartida a cordel,"},{"verse":27,"text":"e você morrerá numa terra impura."},{"verse":28,"text":"E Israel certamente"},{"verse":29,"text":"será levado cativo"},{"verse":30,"text":"para fora da sua terra.\""}]},{"chapter":8,"verses":[{"verse":0,"text":"A visão de um cesto de frutos"},{"verse":1,"text":"O"},{"verse":2,"text":"— O que você está vendo, Amós?"},{"verse":3,"text":"E eu respondi:"},{"verse":4,"text":"— Um cesto de frutos de verão."},{"verse":5,"text":"Então o"},{"verse":6,"text":"\"Chegou o fim para o meu povo"},{"verse":7,"text":"de Israel;"},{"verse":8,"text":"não posso mais ignorar"},{"verse":9,"text":"o que fazem."},{"verse":10,"text":"Naquele dia\","},{"verse":11,"text":"diz o"},{"verse":12,"text":"\"os cânticos do templo"},{"verse":13,"text":"serão gritos de dor."},{"verse":14,"text":"Muitos cadáveres!"},{"verse":15,"text":"Cadáveres jogados por toda parte!"},{"verse":16,"text":"Silêncio!\""},{"verse":17,"text":"A ruína de Israel está perto"},{"verse":18,"text":"Ouçam isto, vocês que pisam"},{"verse":19,"text":"os necessitados"},{"verse":20,"text":"e destroem os miseráveis da terra,"},{"verse":21,"text":"dizendo: \"Quando passará"},{"verse":22,"text":"a Festa da Lua Nova,"},{"verse":23,"text":"para vendermos os cereais?"},{"verse":24,"text":"E o sábado, para abrirmos"},{"verse":25,"text":"os celeiros de trigo,"},{"verse":26,"text":"diminuindo a quantidade,"},{"verse":27,"text":"aumentando o peso"},{"verse":28,"text":"e enganando com balanças"},{"verse":29,"text":"desonestas,"},{"verse":30,"text":"para comprarmos os pobres"},{"verse":31,"text":"por dinheiro"},{"verse":32,"text":"e os necessitados"},{"verse":33,"text":"por um par de sandálias"},{"verse":34,"text":"e vendermos o refugo do trigo?\""},{"verse":35,"text":"O"},{"verse":36,"text":"pela glória de Jacó, dizendo:"},{"verse":37,"text":"\"Nunca me esquecerei"},{"verse":38,"text":"de nenhuma das suas obras!"},{"verse":39,"text":"Por causa disto, será que"},{"verse":40,"text":"a terra não vai tremer?"},{"verse":41,"text":"E não estarão enlutados"},{"verse":42,"text":"todos os seus moradores?"},{"verse":43,"text":"Toda a terra se levantará"},{"verse":44,"text":"como o Nilo,"},{"verse":45,"text":"será agitada e abaixará"},{"verse":46,"text":"como o rio do Egito.\""},{"verse":47,"text":"\"Naquele dia\","},{"verse":48,"text":"diz o"},{"verse":49,"text":"\"farei com que o sol"},{"verse":50,"text":"se ponha ao meio-dia"},{"verse":51,"text":"e com que a terra se cubra"},{"verse":52,"text":"de trevas em pleno dia."},{"verse":53,"text":"Transformarei as suas festas"},{"verse":54,"text":"em luto"},{"verse":55,"text":"e todos os seus cânticos"},{"verse":56,"text":"em lamentações."},{"verse":57,"text":"Vou fazer com que todos vistam"},{"verse":58,"text":"roupas feitas de pano de saco"},{"verse":59,"text":"e rapem a cabeça."},{"verse":60,"text":"Farei com que isso seja"},{"verse":61,"text":"como luto por um filho único,"},{"verse":62,"text":"luto cujo fim será"},{"verse":63,"text":"como dia de amargura.\""},{"verse":64,"text":"\"Eis que vêm dias\","},{"verse":65,"text":"diz o"},{"verse":66,"text":"\"em que enviarei sobre a terra"},{"verse":67,"text":"fome — não de pão,"},{"verse":68,"text":"e sede — não de água,"},{"verse":69,"text":"mas de ouvir as palavras"},{"verse":70,"text":"do"},{"verse":71,"text":"Andarão de mar a mar"},{"verse":72,"text":"e do Norte até o Oriente;"},{"verse":73,"text":"correrão por toda parte,"},{"verse":74,"text":"procurando a palavra do"},{"verse":75,"text":"mas não a acharão."},{"verse":76,"text":"Naquele dia, as moças bonitas"},{"verse":77,"text":"e os jovens desmaiarão de sede,"},{"verse":78,"text":"os que agora juram"},{"verse":79,"text":"pelo ídolo de Samaria"},{"verse":80,"text":"e dizem: ‘Tão certo como vive"},{"verse":81,"text":"o seu deus, ó Dã!’"},{"verse":82,"text":"E: ‘Tão certo como vive"},{"verse":83,"text":"o culto de Berseba!’"},{"verse":84,"text":"Esses mesmos cairão"},{"verse":85,"text":"e nunca mais se levantarão.\""}]},{"chapter":9,"verses":[{"verse":0,"text":"Os juízos de Deus são inevitáveis"},{"verse":1,"text":"Vi o Senhor, que estava em pé junto ao altar. Ele me disse:"},{"verse":2,"text":"\"Bata nos capitéis das colunas,"},{"verse":3,"text":"para que os umbrais"},{"verse":4,"text":"comecem a tremer"},{"verse":5,"text":"e os pedaços caiam"},{"verse":6,"text":"sobre a cabeça de todos eles."},{"verse":7,"text":"Matarei à espada os que restarem."},{"verse":8,"text":"Nenhum deles fugirá,"},{"verse":9,"text":"e nenhum escapará."},{"verse":10,"text":"Ainda que cavem para chegar"},{"verse":11,"text":"ao mais profundo abismo,"},{"verse":12,"text":"a minha mão os tirará de lá."},{"verse":13,"text":"Se subirem ao céu,"},{"verse":14,"text":"de lá os farei descer."},{"verse":15,"text":"Se eles se esconderem"},{"verse":16,"text":"no alto do Carmelo,"},{"verse":17,"text":"irei atrás deles e de lá os tirarei."},{"verse":18,"text":"E, caso se ocultarem"},{"verse":19,"text":"dos meus olhos"},{"verse":20,"text":"no fundo do mar,"},{"verse":21,"text":"ali darei ordem à serpente,"},{"verse":22,"text":"e ela os morderá."},{"verse":23,"text":"Se forem levados para o cativeiro"},{"verse":24,"text":"pelos seus inimigos,"},{"verse":25,"text":"ali darei ordem à espada,"},{"verse":26,"text":"e ela os matará;"},{"verse":27,"text":"porei os meus olhos sobre eles"},{"verse":28,"text":"para o mal e não para o bem.\""},{"verse":29,"text":"Porque o Senhor,"},{"verse":30,"text":"o"},{"verse":31,"text":"é o que toca na terra,"},{"verse":32,"text":"e ela se derrete,"},{"verse":33,"text":"e todos os seus moradores"},{"verse":34,"text":"estarão de luto."},{"verse":35,"text":"Toda a terra subirá como o Nilo"},{"verse":36,"text":"e abaixará como o rio do Egito."},{"verse":37,"text":"Deus é o que edifica"},{"verse":38,"text":"as suas câmaras no céu"},{"verse":39,"text":"e firmou a sua abóbada"},{"verse":40,"text":"sobre a terra."},{"verse":41,"text":"Ele é o que chama as águas do mar"},{"verse":42,"text":"e as derrama sobre a terra;"},{"verse":43,"text":"Senhor"},{"verse":44,"text":"\"Filhos de Israel,"},{"verse":45,"text":"não é verdade que vocês"},{"verse":46,"text":"são para mim"},{"verse":47,"text":"como os filhos dos etíopes?\" —"},{"verse":48,"text":"diz o"},{"verse":49,"text":"\"Não é fato que eu tirei Israel"},{"verse":50,"text":"da terra do Egito,"},{"verse":51,"text":"os filisteus de Caftor,"},{"verse":52,"text":"e os sírios de Quir?"},{"verse":53,"text":"Eis que os olhos do"},{"verse":54,"text":"estão contra este reino pecador,"},{"verse":55,"text":"e eu o destruirei da face da terra."},{"verse":56,"text":"Mas não destruirei por completo"},{"verse":57,"text":"a casa de Jacó\","},{"verse":58,"text":"diz o"},{"verse":59,"text":"\"Porque eis que darei ordens"},{"verse":60,"text":"e sacudirei a casa de Israel"},{"verse":61,"text":"entre todas as nações,"},{"verse":62,"text":"assim como se sacode trigo"},{"verse":63,"text":"na peneira,"},{"verse":64,"text":"sem que um só grão caia na terra."},{"verse":65,"text":"Todos os pecadores"},{"verse":66,"text":"do meu povo"},{"verse":67,"text":"morrerão à espada,"},{"verse":68,"text":"os que dizem:"},{"verse":69,"text":"‘O mal não nos alcançará"},{"verse":70,"text":"nem nos encontrará.’\""},{"verse":71,"text":"Restauração do Israel espiritual"},{"verse":72,"text":"\"Naquele dia, levantarei"},{"verse":73,"text":"o tabernáculo caído de Davi."},{"verse":74,"text":"Vou reparar as suas brechas"},{"verse":75,"text":"e levantá-lo das suas ruínas."},{"verse":76,"text":"Vou restaurá-lo,"},{"verse":77,"text":"para que volte a ser como era"},{"verse":78,"text":"nos dias da antiguidade,"},{"verse":79,"text":"para que o meu povo tome posse"},{"verse":80,"text":"do restante de Edom"},{"verse":81,"text":"e de todas as nações"},{"verse":82,"text":"que são chamadas pelo meu nome\","},{"verse":83,"text":"diz o"},{"verse":84,"text":"que faz estas coisas."},{"verse":85,"text":"\"Eis que vêm dias\","},{"verse":86,"text":"diz o"},{"verse":87,"text":"\"em que o que lavra"},{"verse":88,"text":"virá logo após o que colhe,"},{"verse":89,"text":"e o que pisa as uvas"},{"verse":90,"text":"virá logo após"},{"verse":91,"text":"o que lança semente."},{"verse":92,"text":"Os montes destilarão vinho,"},{"verse":93,"text":"e todas as colinas se derreterão."},{"verse":94,"text":"Mudarei a sorte"},{"verse":95,"text":"do meu povo de Israel."},{"verse":96,"text":"Eles reedificarão as cidades destruídas"},{"verse":97,"text":"e nelas habitarão."},{"verse":98,"text":"Plantarão vinhas"},{"verse":99,"text":"e beberão o seu vinho;"},{"verse":100,"text":"farão pomares"},{"verse":101,"text":"e comerão dos seus frutos."},{"verse":102,"text":"Eu os plantarei na sua terra,"},{"verse":103,"text":"e, dessa terra que lhes dei,"},{"verse":104,"text":"nunca mais serão arrancados\","},{"verse":105,"text":"diz o"}]}]}