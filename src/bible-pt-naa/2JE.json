[[{"verse":"","text":"Jerusalém destruída"},{"verse":"1","text":"Álefe —"},{"verse":"","text":"a cidade outrora populosa!"},{"verse":"","text":"Tornou-se como viúva"},{"verse":"","text":"a que foi grande entre as nações!"},{"verse":"","text":"Princesa entre as províncias,"},{"verse":"","text":"ficou sujeita a trabalhos forçados!"},{"verse":"2","text":"Bete —"},{"verse":"","text":"de noite,"},{"verse":"","text":"e as lágrimas lhe correm"},{"verse":"","text":"pelo rosto."},{"verse":"","text":"Entre todos os seus amantes"},{"verse":"","text":"não tem quem a console."},{"verse":"","text":"Todos os seus amigos a traíram;"},{"verse":"","text":"tornaram-se seus inimigos."},{"verse":"3","text":"Guímel —"},{"verse":"","text":"afligido e sob grande servidão;"},{"verse":"","text":"agora habita entre as nações,"},{"verse":"","text":"sem encontrar descanso."},{"verse":"","text":"Todos os seus perseguidores"},{"verse":"","text":"o apanharam nas suas angústias."},{"verse":"4","text":"Dálete —"},{"verse":"","text":"estão de luto,"},{"verse":"","text":"porque não há quem venha"},{"verse":"","text":"à reunião solene."},{"verse":"","text":"Todas as suas portas"},{"verse":"","text":"estão desertas,"},{"verse":"","text":"os seus sacerdotes"},{"verse":"","text":"vivem gemendo,"},{"verse":"","text":"as suas virgens estão tristes,"},{"verse":"","text":"e ela mesma se acha em amargura."},{"verse":"5","text":"Hê —"},{"verse":"","text":"a dominam,"},{"verse":"","text":"os seus inimigos prosperam."},{"verse":"","text":"Porque o"},{"verse":"","text":"por causa da multidão"},{"verse":"","text":"das suas transgressões;"},{"verse":"","text":"os seus filhinhos tiveram de ir"},{"verse":"","text":"para o exílio,"},{"verse":"","text":"na frente dos adversários."},{"verse":"6","text":"Vau —"},{"verse":"","text":"todo o esplendor."},{"verse":"","text":"Os seus príncipes ficaram sendo"},{"verse":"","text":"como corços que não acham pasto"},{"verse":"","text":"e caminham exaustos"},{"verse":"","text":"na frente do perseguidor."},{"verse":"7","text":"Zaine —"},{"verse":"","text":"e andando sem rumo,"},{"verse":"","text":"Jerusalém se lembra"},{"verse":"","text":"de todas as coisas preciosas"},{"verse":"","text":"que teve nos tempos antigos."},{"verse":"","text":"Ela se recorda de como o seu povo"},{"verse":"","text":"caiu nas mãos do adversário,"},{"verse":"","text":"sem que ninguém"},{"verse":"","text":"viesse socorrê-la,"},{"verse":"","text":"e de como os adversários a viram"},{"verse":"","text":"e deram risada da sua queda."},{"verse":"8","text":"Hete —"},{"verse":"","text":"gravemente;"},{"verse":"","text":"por isso, se tornou repugnante."},{"verse":"","text":"Todos os que a honravam"},{"verse":"","text":"agora a desprezam,"},{"verse":"","text":"porque viram a sua nudez;"},{"verse":"","text":"ela também geme"},{"verse":"","text":"e se retira envergonhada."},{"verse":"9","text":"Tete —"},{"verse":"","text":"nas suas saias."},{"verse":"","text":"Ela não pensava"},{"verse":"","text":"no que poderia acontecer;"},{"verse":"","text":"por isso, caiu de modo espantoso"},{"verse":"","text":"e não tem quem a console."},{"verse":"","text":"Vê,"},{"verse":"","text":"porque o inimigo se exalta."},{"verse":"10","text":"Iode —"},{"verse":"","text":"em todas as coisas preciosas dela."},{"verse":"","text":"Ela viu as nações entrarem"},{"verse":"","text":"no seu santuário,"},{"verse":"","text":"apesar de teres proibido"},{"verse":"","text":"que entrassem"},{"verse":"","text":"na tua congregação."},{"verse":"11","text":"Cafe —"},{"verse":"","text":"anda gemendo"},{"verse":"","text":"e à procura de pão;"},{"verse":"","text":"trocaram as suas coisas preciosas"},{"verse":"","text":"por mantimento,"},{"verse":"","text":"para poderem restaurar as forças."},{"verse":"","text":"Vê,"},{"verse":"","text":"pois me tornei desprezível."},{"verse":"12","text":"Lâmede —"},{"verse":"","text":"pelo caminho,"},{"verse":"","text":"será que isto não os comove?"},{"verse":"","text":"Olhem e vejam se há dor"},{"verse":"","text":"igual à minha,"},{"verse":"","text":"essa dor que me sobreveio,"},{"verse":"","text":"com que o"},{"verse":"","text":"no dia do furor da sua ira."},{"verse":"13","text":"Mem —"},{"verse":"","text":"aos meus ossos,"},{"verse":"","text":"o qual se apoderou deles;"},{"verse":"","text":"estendeu uma rede aos meus pés,"},{"verse":"","text":"e me fez voltar para trás;"},{"verse":"","text":"deixou-me desolada"},{"verse":"","text":"e sofrendo todo o dia."},{"verse":"14","text":"Num —"},{"verse":"","text":"fez das minhas transgressões"},{"verse":"","text":"um jugo;"},{"verse":"","text":"elas foram entretecidas"},{"verse":"","text":"e penduradas no meu pescoço."},{"verse":"","text":"O Senhor abateu a minha força;"},{"verse":"","text":"ele me entregou"},{"verse":"","text":"nas mãos daqueles"},{"verse":"","text":"contra os quais não posso resistir."},{"verse":"15","text":"Sâmeque —"},{"verse":"","text":"todos os valentes"},{"verse":"","text":"que estavam comigo;"},{"verse":"","text":"convocou um exército contra mim,"},{"verse":"","text":"para esmagar os meus jovens;"},{"verse":"","text":"o Senhor pisou, como num lagar,"},{"verse":"","text":"a virgem filha de Judá."},{"verse":"16","text":"Aim —"},{"verse":"","text":"os meus olhos, os meus olhos"},{"verse":"","text":"se desfazem em lágrimas."},{"verse":"","text":"Porque o consolador,"},{"verse":"","text":"que devia restaurar"},{"verse":"","text":"as minhas forças,"},{"verse":"","text":"se afastou de mim."},{"verse":"","text":"Os meus filhos estão desolados,"},{"verse":"","text":"porque o inimigo prevaleceu."},{"verse":"17","text":"Pê —"},{"verse":"","text":"e não há quem a console."},{"verse":"","text":"O"},{"verse":"","text":"a respeito de Jacó"},{"verse":"","text":"que os seus vizinhos se tornem"},{"verse":"","text":"seus inimigos;"},{"verse":"","text":"para eles, Jerusalém"},{"verse":"","text":"se tornou coisa imunda."},{"verse":"18","text":"Tsadê —"},{"verse":"","text":"pois me rebelei"},{"verse":"","text":"contra a sua palavra."},{"verse":"","text":"Escutem, todos os povos,"},{"verse":"","text":"e vejam a minha dor;"},{"verse":"","text":"as minhas virgens e os meus jovens"},{"verse":"","text":"foram levados para o cativeiro."},{"verse":"19","text":"Cofe —"},{"verse":"","text":"mas eles me enganaram;"},{"verse":"","text":"os meus sacerdotes"},{"verse":"","text":"e os meus anciãos"},{"verse":"","text":"morreram na cidade,"},{"verse":"","text":"quando estavam"},{"verse":"","text":"à procura de mantimento"},{"verse":"","text":"para restaurarem as suas forças."},{"verse":"20","text":"Rexe —"},{"verse":"","text":"porque estou angustiada!"},{"verse":"","text":"A minha alma se agita,"},{"verse":"","text":"o meu coração está transtornado"},{"verse":"","text":"dentro de mim,"},{"verse":"","text":"porque gravemente"},{"verse":"","text":"me rebelei contra ti."},{"verse":"","text":"Lá fora, a espada mata os filhos;"},{"verse":"","text":"aqui dentro, a morte se propaga."},{"verse":"21","text":"Chim —"},{"verse":"","text":"gemidos,"},{"verse":"","text":"mas não tenho quem me console."},{"verse":"","text":"Todos os meus inimigos"},{"verse":"","text":"que souberam"},{"verse":"","text":"da minha desgraça"},{"verse":"","text":"se alegram, porque tu a fizeste"},{"verse":"","text":"cair sobre mim;"},{"verse":"","text":"mas, quando trouxeres"},{"verse":"","text":"o dia que anunciaste,"},{"verse":"","text":"eles serão semelhantes a mim."},{"verse":"22","text":"Tau —"},{"verse":"","text":"à tua presença,"},{"verse":"","text":"e faze com eles"},{"verse":"","text":"como fizeste comigo"},{"verse":"","text":"por causa de todas"},{"verse":"","text":"as minhas transgressões;"},{"verse":"","text":"porque os meus gemidos"},{"verse":"","text":"são muitos,"},{"verse":"","text":"e o meu coração desfalece."}],[{"verse":"","text":"As tristezas de Sião provêm de Deus"},{"verse":"1","text":"Álefe —"},{"verse":"","text":"cobriu de nuvens a filha de Sião!"},{"verse":"","text":"Precipitou do céu à terra"},{"verse":"","text":"a glória de Israel"},{"verse":"","text":"e, no dia da sua ira,"},{"verse":"","text":"não se lembrou"},{"verse":"","text":"do estrado de seus pés."},{"verse":"2","text":"Bete —"},{"verse":"","text":"todas as moradas de Jacó"},{"verse":"","text":"e não teve piedade;"},{"verse":"","text":"no seu furor, derrubou"},{"verse":"","text":"as fortalezas da filha de Judá;"},{"verse":"","text":"lançou por terra e profanou"},{"verse":"","text":"o reino e os seus príncipes."},{"verse":"3","text":"Guímel —"},{"verse":"","text":"cortou toda a força de Israel;"},{"verse":"","text":"retirou a sua mão direita"},{"verse":"","text":"em face do inimigo."},{"verse":"","text":"Consumiu Jacó"},{"verse":"","text":"como labareda de fogo"},{"verse":"","text":"que devora tudo ao seu redor."},{"verse":"4","text":"Dálete —"},{"verse":"","text":"como se fosse um inimigo;"},{"verse":"","text":"firmou a sua mão direita,"},{"verse":"","text":"como se fosse um adversário."},{"verse":"","text":"Destruiu tudo"},{"verse":"","text":"o que era formoso à vista;"},{"verse":"","text":"derramou o seu furor, como fogo,"},{"verse":"","text":"sobre a tenda da filha de Sião."},{"verse":"5","text":"Hê —"},{"verse":"","text":"como inimigo,"},{"verse":"","text":"devorando Israel;"},{"verse":"","text":"devorou todos os seus palácios,"},{"verse":"","text":"destruiu as suas fortalezas"},{"verse":"","text":"e multiplicou na filha de Judá"},{"verse":"","text":"o pranto e a lamentação."},{"verse":"6","text":"Vau —"},{"verse":"","text":"o seu tabernáculo,"},{"verse":"","text":"como se fosse uma horta;"},{"verse":"","text":"destruiu o lugar"},{"verse":"","text":"da sua congregação."},{"verse":"","text":"O"},{"verse":"","text":"entregou ao esquecimento"},{"verse":"","text":"as festas e o sábado"},{"verse":"","text":"e, na indignação da sua ira,"},{"verse":"","text":"rejeitou com desprezo"},{"verse":"","text":"o rei e o sacerdote."},{"verse":"7","text":"Zaine —"},{"verse":"","text":"o seu altar"},{"verse":"","text":"e detestou o seu santuário."},{"verse":"","text":"Entregou nas mãos dos inimigos"},{"verse":"","text":"os muros dos seus castelos;"},{"verse":"","text":"eles deram gritos"},{"verse":"","text":"na Casa do"},{"verse":"","text":"como se fosse dia de festa."},{"verse":"8","text":"Hete —"},{"verse":"","text":"destruir a muralha da filha de Sião;"},{"verse":"","text":"estendeu o cordel"},{"verse":"","text":"e não retirou"},{"verse":"","text":"a sua mão destruidora."},{"verse":"","text":"Fez gemer a muralha e as paredes;"},{"verse":"","text":"juntas enfraqueceram."},{"verse":"9","text":"Tete —"},{"verse":"","text":"caíram por terra;"},{"verse":"","text":"ele quebrou e despedaçou"},{"verse":"","text":"as suas trancas."},{"verse":"","text":"O seu rei e os seus príncipes"},{"verse":"","text":"estão entre as nações"},{"verse":"","text":"onde já não vigora a lei;"},{"verse":"","text":"os seus profetas não recebem"},{"verse":"","text":"mais visões do"},{"verse":"10","text":"Iode —"},{"verse":"","text":"estão sentados no chão,"},{"verse":"","text":"em silêncio;"},{"verse":"","text":"lançam pó sobre a cabeça,"},{"verse":"","text":"vestindo roupa feita"},{"verse":"","text":"de pano de saco;"},{"verse":"","text":"as virgens de Jerusalém"},{"verse":"","text":"abaixam a cabeça até o chão."},{"verse":"11","text":"Cafe —"},{"verse":"","text":"se consumiram"},{"verse":"","text":"os meus olhos,"},{"verse":"","text":"a minha alma se agita;"},{"verse":"","text":"o meu coração se derramou"},{"verse":"","text":"de angústia"},{"verse":"","text":"por causa da calamidade"},{"verse":"","text":"da filha do meu povo,"},{"verse":"","text":"porque crianças e bebês desmaiam"},{"verse":"","text":"pelas ruas da cidade."},{"verse":"12","text":"Lâmede —"},{"verse":"","text":"às suas mães:"},{"verse":"","text":"\"O que temos para"},{"verse":"","text":"comer e beber?\","},{"verse":"","text":"ao mesmo tempo"},{"verse":"","text":"em que desfalecem"},{"verse":"","text":"como o ferido pelas ruas da cidade"},{"verse":"","text":"ou quando dão o último suspiro"},{"verse":"","text":"nos braços de sua mãe."},{"verse":"13","text":"Mem —"},{"verse":"","text":"A quem você se assemelha,"},{"verse":"","text":"ó filha de Jerusalém?"},{"verse":"","text":"A quem posso compará-la,"},{"verse":"","text":"para lhe trazer consolo,"},{"verse":"","text":"ó virgem filha de Sião?"},{"verse":"","text":"Porque a sua calamidade"},{"verse":"","text":"é tão grande como o mar;"},{"verse":"","text":"quem poderá curá-la?"},{"verse":"14","text":"Num —"},{"verse":"","text":"os seus profetas"},{"verse":"","text":"lhe anunciaram"},{"verse":"","text":"eram falsas e enganosas."},{"verse":"","text":"Eles não expuseram"},{"verse":"","text":"a maldade do que você fazia,"},{"verse":"","text":"para restaurarem a sua sorte,"},{"verse":"","text":"mas anunciaram visões falsas,"},{"verse":"","text":"que a levaram ao cativeiro."},{"verse":"15","text":"Sâmeque —"},{"verse":"","text":"pelo caminho"},{"verse":"","text":"zombam, batendo palmas,"},{"verse":"","text":"vaiam e balançam a cabeça"},{"verse":"","text":"diante da filha de Jerusalém."},{"verse":"","text":"Perguntam: \"É esta a cidade"},{"verse":"","text":"que chamavam de"},{"verse":"","text":"Perfeição da Formosura,"},{"verse":"","text":"a alegria de toda a terra?\""},{"verse":"16","text":"Pê —"},{"verse":"","text":"abrem a boca contra você,"},{"verse":"","text":"vaiam, rangem os dentes e dizem:"},{"verse":"","text":"\"Nós acabamos com ela!"},{"verse":"","text":"Certamente este é"},{"verse":"","text":"o dia que esperávamos!"},{"verse":"","text":"Conseguimos! Esse dia chegou!\""},{"verse":"17","text":"Aim —"},{"verse":"","text":"o que tinha em vista;"},{"verse":"","text":"cumpriu a ameaça que pronunciou"},{"verse":"","text":"desde os dias da antiguidade."},{"verse":"","text":"Derrubou sem dó nem piedade;"},{"verse":"","text":"deixou que os inimigos"},{"verse":"","text":"se alegrassem"},{"verse":"","text":"por causa de você"},{"verse":"","text":"e exaltou o poder"},{"verse":"","text":"dos seus adversários."},{"verse":"18","text":"Tsadê —"},{"verse":"","text":"clama ao Senhor."},{"verse":"","text":"Ó muralha da filha de Sião,"},{"verse":"","text":"que as suas lágrimas corram"},{"verse":"","text":"como um ribeiro,"},{"verse":"","text":"de dia e de noite!"},{"verse":"","text":"Não descanse!"},{"verse":"","text":"Que a menina de seus olhos"},{"verse":"","text":"não pare de chorar!"},{"verse":"19","text":"Cofe —"},{"verse":"","text":"e clame de noite,"},{"verse":"","text":"no princípio das vigílias."},{"verse":"","text":"Derrame, como água,"},{"verse":"","text":"o coração diante do Senhor;"},{"verse":"","text":"levante a ele as mãos,"},{"verse":"","text":"pela vida de seus filhinhos,"},{"verse":"","text":"que desfalecem de fome"},{"verse":"","text":"nas esquinas de todas as ruas."},{"verse":"20","text":"Rexe —"},{"verse":"","text":"a quem trataste assim!"},{"verse":"","text":"Será que as mulheres"},{"verse":"","text":"deviam comer"},{"verse":"","text":"o fruto de si mesmas,"},{"verse":"","text":"as crianças que elas tanto amam?"},{"verse":"","text":"Ou será que os sacerdotes"},{"verse":"","text":"e profetas"},{"verse":"","text":"deviam ser mortos"},{"verse":"","text":"no santuário do Senhor?"},{"verse":"21","text":"Chim —"},{"verse":"","text":"jazem por terra pelas ruas;"},{"verse":"","text":"as minhas virgens e os meus jovens"},{"verse":"","text":"foram mortos à espada."},{"verse":"","text":"Tu os mataste no dia da tua ira;"},{"verse":"","text":"fizeste matança"},{"verse":"","text":"sem dó nem piedade."},{"verse":"22","text":"Tau —"},{"verse":"","text":"terrores contra mim,"},{"verse":"","text":"como se fosse um dia de festa;"},{"verse":"","text":"não houve quem escapasse"},{"verse":"","text":"ou ficasse com vida"},{"verse":"","text":"no dia da ira do"},{"verse":"","text":"Os filhos que tive e criei,"},{"verse":"","text":"o meu inimigo os consumiu."}],[{"verse":"","text":"Castigo, arrependimento e esperança"},{"verse":"1","text":"Álefe —"},{"verse":"","text":"que viu a aflição"},{"verse":"","text":"causada pela vara"},{"verse":"","text":"do furor de Deus."},{"verse":"2","text":"Ele me levou e me fez andar"},{"verse":"","text":"nas trevas e não na luz."},{"verse":"3","text":"Certamente ele voltou"},{"verse":"","text":"a sua mão contra mim,"},{"verse":"","text":"sem parar, todo o dia."},{"verse":"4","text":"Bete —"},{"verse":"","text":"a minha carne"},{"verse":"","text":"e a minha pele,"},{"verse":"","text":"e despedaçou os meus ossos."},{"verse":"5","text":"Construiu rampas de ataque"},{"verse":"","text":"contra mim"},{"verse":"","text":"e me cercou de amargura e dor."},{"verse":"6","text":"Ele me faz habitar na escuridão,"},{"verse":"","text":"como aqueles que morreram"},{"verse":"","text":"há muito tempo."},{"verse":"7","text":"Guímel —"},{"verse":"","text":"e já não posso sair;"},{"verse":"","text":"prendeu-me"},{"verse":"","text":"com pesadas correntes."},{"verse":"8","text":"Mesmo quando clamo e grito,"},{"verse":"","text":"ele fecha os ouvidos"},{"verse":"","text":"à minha oração."},{"verse":"9","text":"Fechou os meus caminhos"},{"verse":"","text":"com blocos de pedra,"},{"verse":"","text":"fez tortuosas as minhas veredas."},{"verse":"10","text":"Dálete —"},{"verse":"","text":"um urso à espreita,"},{"verse":"","text":"como um leão pronto para atacar."},{"verse":"11","text":"Desviou os meus caminhos"},{"verse":"","text":"e me fez em pedaços;"},{"verse":"","text":"depois me abandonou."},{"verse":"12","text":"Entesou o seu arco"},{"verse":"","text":"e me pôs como alvo"},{"verse":"","text":"de suas flechas."},{"verse":"13","text":"Hê —"},{"verse":"","text":"atingiram o meu coração."},{"verse":"14","text":"Fui feito motivo de riso"},{"verse":"","text":"para todo o meu povo,"},{"verse":"","text":"e a sua canção de deboche"},{"verse":"","text":"o dia inteiro."},{"verse":"15","text":"Fartou-me de amarguras,"},{"verse":"","text":"e me saciou de absinto."},{"verse":"16","text":"Vau —"},{"verse":"","text":"nas pedras,"},{"verse":"","text":"e cobriu-me de cinza."},{"verse":"17","text":"Já não sei o que é ter paz"},{"verse":"","text":"e esqueci o que é"},{"verse":"","text":"desfrutar do bem."},{"verse":"18","text":"Então eu disse:"},{"verse":"","text":"\"Não tenho mais forças."},{"verse":"","text":"A minha esperança"},{"verse":"","text":"no"},{"verse":"19","text":"Zaine —"},{"verse":"","text":"da minha aflição"},{"verse":"","text":"e do meu andar errante,"},{"verse":"","text":"do absinto e da amargura."},{"verse":"20","text":"Minha alma continuamente"},{"verse":"","text":"se lembra disso"},{"verse":"","text":"e se abate dentro de mim."},{"verse":"21","text":"Quero trazer à memória"},{"verse":"","text":"o que pode me dar esperança."},{"verse":"22","text":"Hete —"},{"verse":"","text":"do"},{"verse":"","text":"de não sermos"},{"verse":"","text":"consumidos,"},{"verse":"","text":"porque as suas misericórdias"},{"verse":"","text":"não têm fim;"},{"verse":"23","text":"renovam-se cada manhã."},{"verse":"","text":"Grande é a tua fidelidade."},{"verse":"24","text":"A minha porção é o"},{"verse":"","text":"diz a minha alma;"},{"verse":"","text":"portanto, esperarei nele."},{"verse":"25","text":"Tete —"},{"verse":"","text":"para os que esperam nele,"},{"verse":"","text":"para aqueles que o buscam."},{"verse":"26","text":"Bom é aguardar"},{"verse":"","text":"a salvação do"},{"verse":"","text":"e isso, em silêncio."},{"verse":"27","text":"Bom é para o homem"},{"verse":"","text":"suportar o jugo na sua mocidade."},{"verse":"28","text":"Iode —"},{"verse":"","text":"e fique em silêncio,"},{"verse":"","text":"porque esse jugo"},{"verse":"","text":"Deus pôs sobre ele."},{"verse":"29","text":"Ponha a sua boca no pó;"},{"verse":"","text":"talvez ainda haja esperança."},{"verse":"30","text":"Dê a face ao que o fere"},{"verse":"","text":"e suporte todas as afrontas."},{"verse":"31","text":"Cafe —"},{"verse":"","text":"para sempre."},{"verse":"32","text":"Ainda que entristeça alguém,"},{"verse":"","text":"terá compaixão"},{"verse":"","text":"segundo a grandeza"},{"verse":"","text":"das suas misericórdias."},{"verse":"33","text":"Porque não aflige"},{"verse":"","text":"nem entristece de bom grado"},{"verse":"","text":"os filhos dos homens."},{"verse":"34","text":"Lâmede —"},{"verse":"","text":"todos os prisioneiros da terra,"},{"verse":"35","text":"perverter o direito do homem"},{"verse":"","text":"diante do Altíssimo,"},{"verse":"36","text":"subverter a justiça num processo"},{"verse":"","text":"— será que o Senhor"},{"verse":"","text":"não veria tais coisas?"},{"verse":"37","text":"Mem —"},{"verse":"","text":"e assim acontece,"},{"verse":"","text":"sem que o Senhor"},{"verse":"","text":"o tenha ordenado?"},{"verse":"38","text":"Por acaso, não é"},{"verse":"","text":"da boca do Altíssimo"},{"verse":"","text":"que procedem"},{"verse":"","text":"tanto o mal como o bem?"},{"verse":"39","text":"Por que se queixa o homem?"},{"verse":"","text":"Queixe-se cada um"},{"verse":"","text":"dos seus próprios pecados."},{"verse":"40","text":"Num —"},{"verse":"","text":"os nossos caminhos"},{"verse":"","text":"e voltemos para o"},{"verse":"41","text":"Levantemos o coração,"},{"verse":"","text":"juntamente com as mãos,"},{"verse":"","text":"para Deus nos céus, dizendo:"},{"verse":"42","text":"\"Nós pecamos"},{"verse":"","text":"e fomos rebeldes,"},{"verse":"","text":"e tu não nos perdoaste.\""},{"verse":"43","text":"Sâmeque —"},{"verse":"","text":"e nos perseguiste;"},{"verse":"","text":"nos mataste sem dó"},{"verse":"","text":"nem piedade."},{"verse":"44","text":"De nuvens te encobriste"},{"verse":"","text":"para que a nossa oração"},{"verse":"","text":"não passe."},{"verse":"45","text":"Como lixo e refugo nos puseste"},{"verse":"","text":"no meio dos povos."},{"verse":"46","text":"Pê —"},{"verse":"","text":"abriram a boca contra nós."},{"verse":"47","text":"Sobre nós vieram"},{"verse":"","text":"o temor e a cova,"},{"verse":"","text":"a desolação e a ruína."},{"verse":"48","text":"Dos meus olhos"},{"verse":"","text":"correm rios de lágrimas,"},{"verse":"","text":"por causa da destruição"},{"verse":"","text":"da filha do meu povo."},{"verse":"49","text":"Aim —"},{"verse":"","text":"não cessam, e não há descanso,"},{"verse":"50","text":"até que o"},{"verse":"","text":"e veja lá do céu."},{"verse":"51","text":"O que vejo entristece"},{"verse":"","text":"a minha alma:"},{"verse":"","text":"o sofrimento de todas"},{"verse":"","text":"as filhas da minha cidade."},{"verse":"52","text":"Tsadê —"},{"verse":"","text":"são meus inimigos"},{"verse":"","text":"caçaram-me"},{"verse":"","text":"como se eu fosse uma ave."},{"verse":"53","text":"Lançaram-me vivo numa cova"},{"verse":"","text":"e atiraram pedras sobre mim."},{"verse":"54","text":"Águas correram"},{"verse":"","text":"sobre a minha cabeça;"},{"verse":"","text":"então eu disse: \"Estou perdido!\""},{"verse":"55","text":"Cofe —"},{"verse":"","text":"invoquei o teu nome."},{"verse":"56","text":"Ouviste a minha voz,"},{"verse":"","text":"quando pedi:"},{"verse":"","text":"\"Não feches os teus ouvidos"},{"verse":"","text":"aos meus lamentos,"},{"verse":"","text":"ao meu clamor.\""},{"verse":"57","text":"No dia em que te invoquei,"},{"verse":"","text":"chegaste perto de mim"},{"verse":"","text":"e disseste: \"Não tenha medo.\""},{"verse":"58","text":"Rexe —"},{"verse":"","text":"Senhor;"},{"verse":"","text":"remiste a minha vida."},{"verse":"59","text":"Viste,"},{"verse":"","text":"que me fizeram;"},{"verse":"","text":"julga a minha causa."},{"verse":"60","text":"Viste toda a sua vingança,"},{"verse":"","text":"todos os seus planos contra mim."},{"verse":"61","text":"Chim —"},{"verse":"","text":"Senhor"},{"verse":"","text":"todos os seus planos contra mim,"},{"verse":"62","text":"as acusações que me fazem"},{"verse":"","text":"e o que murmuram contra mim,"},{"verse":"","text":"o dia todo."},{"verse":"63","text":"Observa-os quando se assentam"},{"verse":"","text":"e quando se levantam;"},{"verse":"","text":"eu sou motivo de zombaria"},{"verse":"","text":"para eles."},{"verse":"64","text":"Tau —"},{"verse":"","text":"segundo a obra das mãos deles."},{"verse":"65","text":"Tu lhes darás dureza de coração,"},{"verse":"","text":"que é a tua maldição sobre eles."},{"verse":"66","text":"Na tua ira, os perseguirás,"},{"verse":"","text":"e eles serão eliminados"},{"verse":"","text":"de debaixo dos céus do"}],[{"verse":"","text":"Os sofrimentos do cerco"},{"verse":"1","text":"Álefe —"},{"verse":"","text":"Como o ouro refinado"},{"verse":"","text":"perdeu o seu brilho!"},{"verse":"","text":"Como estão espalhadas"},{"verse":"","text":"as pedras do santuário"},{"verse":"","text":"pelas esquinas de todas as ruas!"},{"verse":"2","text":"Bete —"},{"verse":"","text":"comparáveis a ouro puro,"},{"verse":"","text":"agora são tratados"},{"verse":"","text":"como simples objetos de barro,"},{"verse":"","text":"obra das mãos de oleiro!"},{"verse":"3","text":"Guímel —"},{"verse":"","text":"dão o peito,"},{"verse":"","text":"dão de mamar aos seus filhotes;"},{"verse":"","text":"mas a filha do meu povo"},{"verse":"","text":"tornou-se cruel"},{"verse":"","text":"como as avestruzes no deserto."},{"verse":"4","text":"Dálete —"},{"verse":"","text":"que mama"},{"verse":"","text":"fica pegada, pela sede,"},{"verse":"","text":"ao céu da boca;"},{"verse":"","text":"as crianças pedem pão,"},{"verse":"","text":"mas não há quem as alimente."},{"verse":"5","text":"Hê —"},{"verse":"","text":"de comidas finas"},{"verse":"","text":"desfalecem nas ruas;"},{"verse":"","text":"os que se criaram entre escarlate"},{"verse":"","text":"agora vivem entre montes de lixo."},{"verse":"6","text":"Vau —"},{"verse":"","text":"da filha do meu povo"},{"verse":"","text":"é maior do que o pecado"},{"verse":"","text":"de Sodoma,"},{"verse":"","text":"que foi destruída num momento,"},{"verse":"","text":"sem intervenção humana."},{"verse":"7","text":"Zaine —"},{"verse":"","text":"eram mais alvos do que a neve,"},{"verse":"","text":"mais brancos do que o leite;"},{"verse":"","text":"eram mais ruivos de corpo"},{"verse":"","text":"do que os corais"},{"verse":"","text":"e tinham a formosura da safira."},{"verse":"8","text":"Hete —"},{"verse":"","text":"é mais escuro do que a fuligem;"},{"verse":"","text":"não são reconhecidos nas ruas."},{"verse":"","text":"A sua pele grudou nos ossos,"},{"verse":"","text":"secou-se como a madeira."},{"verse":"9","text":"Tete —"},{"verse":"","text":"as vítimas da espada"},{"verse":"","text":"do que as vítimas da fome;"},{"verse":"","text":"porque estas se definham"},{"verse":"","text":"atingidas mortalmente"},{"verse":"","text":"pela falta do produto"},{"verse":"","text":"dos campos."},{"verse":"10","text":"Iode —"},{"verse":"","text":"que antes eram compassivas"},{"verse":"","text":"cozinharam"},{"verse":"","text":"os seus próprios filhos;"},{"verse":"","text":"estes lhes serviram de alimento"},{"verse":"","text":"quando a filha do meu povo"},{"verse":"","text":"foi destruída."},{"verse":"11","text":"Cafe —"},{"verse":"","text":"à sua indignação,"},{"verse":"","text":"derramou o furor da sua ira;"},{"verse":"","text":"acendeu fogo em Sião,"},{"verse":"","text":"que consumiu os seus alicerces."},{"verse":"12","text":"Lâmede —"},{"verse":"","text":"nem todos os moradores"},{"verse":"","text":"do mundo acreditavam"},{"verse":"","text":"que o adversário ou inimigo"},{"verse":"","text":"pudesse entrar"},{"verse":"","text":"pelos portões de Jerusalém."},{"verse":"13","text":"Mem —"},{"verse":"","text":"por causa dos pecados"},{"verse":"","text":"dos seus profetas"},{"verse":"","text":"e por causa das maldades"},{"verse":"","text":"dos seus sacerdotes,"},{"verse":"","text":"que derramaram no meio dela"},{"verse":"","text":"o sangue dos justos."},{"verse":"14","text":"Num —"},{"verse":"","text":"pelas ruas,"},{"verse":"","text":"andam contaminados de sangue,"},{"verse":"","text":"de maneira que ninguém"},{"verse":"","text":"pode tocar na roupa deles."},{"verse":"15","text":"Sâmeque —"},{"verse":"","text":"\"Afastem-se, imundos!"},{"verse":"","text":"Afastem-se, afastem-se,"},{"verse":"","text":"não toquem em nada!\""},{"verse":"","text":"Quando fugiram"},{"verse":"","text":"e andaram errantes,"},{"verse":"","text":"dizia-se entre as nações:"},{"verse":"","text":"\"Aqui eles não podem morar.\""},{"verse":"16","text":"Pê —"},{"verse":"","text":"ele já não dá atenção a eles."},{"verse":"","text":"Não respeitaram os sacerdotes,"},{"verse":"","text":"nem se compadeceram"},{"verse":"","text":"dos anciãos."},{"verse":"17","text":"Aim —"},{"verse":"","text":"ainda desfalecem,"},{"verse":"","text":"esperando socorro"},{"verse":"","text":"que nunca chega;"},{"verse":"","text":"de nossas torres,"},{"verse":"","text":"temos olhado para um povo"},{"verse":"","text":"que não nos pode livrar."},{"verse":"18","text":"Tsadê —"},{"verse":"","text":"os nossos passos,"},{"verse":"","text":"de maneira que"},{"verse":"","text":"não podíamos andar"},{"verse":"","text":"pelas nossas ruas."},{"verse":"","text":"Nosso fim se aproximava,"},{"verse":"","text":"os nossos dias estavam contados,"},{"verse":"","text":"era chegado o nosso fim."},{"verse":"19","text":"Cofe —"},{"verse":"","text":"foram mais ligeiros"},{"verse":"","text":"do que as águias nos céus;"},{"verse":"","text":"sobre os montes nos perseguiram,"},{"verse":"","text":"no deserto nos armaram ciladas."},{"verse":"20","text":"Rexe —"},{"verse":"","text":"que era o nosso alento,"},{"verse":"","text":"foi preso nas armadilhas deles."},{"verse":"","text":"Dele dizíamos:"},{"verse":"","text":"\"Debaixo da sua sombra,"},{"verse":"","text":"viveremos entre as nações.\""},{"verse":"21","text":"Chim —"},{"verse":"","text":"ó filha de Edom,"},{"verse":"","text":"você que habita na terra de Uz."},{"verse":"","text":"Logo chegará a sua hora"},{"verse":"","text":"de beber do cálice;"},{"verse":"","text":"você ficará embriagada e despida."},{"verse":"22","text":"Tau —"},{"verse":"","text":"da sua maldade"},{"verse":"","text":"está consumado,"},{"verse":"","text":"ó filha de Sião;"},{"verse":"","text":"o"},{"verse":"","text":"para o exílio."},{"verse":"","text":"Mas ele castigará a sua maldade,"},{"verse":"","text":"ó filha de Edom;"},{"verse":"","text":"porá a descoberto os pecados"},{"verse":"","text":"que você cometeu."}],[{"verse":"","text":"Oração pedindo misericórdia"},{"verse":"1","text":"Lembra-te,"},{"verse":"","text":"do que nos aconteceu;"},{"verse":"","text":"considera e olha"},{"verse":"","text":"para a nossa desgraça."},{"verse":"2","text":"A nossa herança foi entregue"},{"verse":"","text":"a estranhos,"},{"verse":"","text":"e as nossas casas,"},{"verse":"","text":"a estrangeiros."},{"verse":"3","text":"Somos órfãos,"},{"verse":"","text":"já não temos pai;"},{"verse":"","text":"as nossas mães"},{"verse":"","text":"são como viúvas."},{"verse":"4","text":"Temos de comprar"},{"verse":"","text":"a nossa própria água;"},{"verse":"","text":"temos de pagar"},{"verse":"","text":"pela nossa própria lenha."},{"verse":"5","text":"Os nossos perseguidores"},{"verse":"","text":"estão sobre o nosso pescoço;"},{"verse":"","text":"estamos exaustos"},{"verse":"","text":"e não temos descanso."},{"verse":"6","text":"Submetemo-nos aos egípcios"},{"verse":"","text":"e aos assírios,"},{"verse":"","text":"para nos fartarem de pão."},{"verse":"7","text":"Nossos pais pecaram"},{"verse":"","text":"e já não existem;"},{"verse":"","text":"nós é que recebemos o castigo"},{"verse":"","text":"pelas suas iniquidades."},{"verse":"8","text":"Escravos dominam sobre nós;"},{"verse":"","text":"não há ninguém"},{"verse":"","text":"que nos livre das suas mãos."},{"verse":"9","text":"Arriscamos a vida"},{"verse":"","text":"para conseguir o nosso pão,"},{"verse":"","text":"por causa da ameaça"},{"verse":"","text":"que vem do deserto."},{"verse":"10","text":"Nossa pele queima"},{"verse":"","text":"como um forno,"},{"verse":"","text":"por causa do ardor da fome."},{"verse":"11","text":"As mulheres foram"},{"verse":"","text":"violentadas em Sião;"},{"verse":"","text":"as virgens, nas cidades de Judá."},{"verse":"12","text":"Enforcaram os príncipes,"},{"verse":"","text":"não tiveram nenhum respeito"},{"verse":"","text":"pelos velhos."},{"verse":"13","text":"Os jovens são obrigados"},{"verse":"","text":"a virar os moinhos;"},{"verse":"","text":"os meninos tropeçam"},{"verse":"","text":"debaixo das cargas de lenha."},{"verse":"14","text":"Os anciãos já não se reúnem"},{"verse":"","text":"junto ao portão da cidade;"},{"verse":"","text":"os jovens já não cantam mais."},{"verse":"15","text":"Cessou a alegria"},{"verse":"","text":"de nosso coração;"},{"verse":"","text":"a nossa dança se transformou"},{"verse":"","text":"em lamentações."},{"verse":"16","text":"Caiu a coroa da nossa cabeça."},{"verse":"","text":"Ai de nós, porque pecamos!"},{"verse":"17","text":"Por causa disso,"},{"verse":"","text":"o nosso coração está doente;"},{"verse":"","text":"por causa dessas coisas,"},{"verse":"","text":"os nossos olhos se escureceram."},{"verse":"18","text":"Pelo monte Sião,"},{"verse":"","text":"que está abandonado,"},{"verse":"","text":"vagueiam os chacais."},{"verse":"19","text":"Tu,"},{"verse":"","text":"reinas eternamente,"},{"verse":"","text":"o teu trono subsiste"},{"verse":"","text":"de geração em geração."},{"verse":"20","text":"Por que te esquecerias"},{"verse":"","text":"de nós para sempre?"},{"verse":"","text":"Por que nos desampararias"},{"verse":"","text":"por tanto tempo?"},{"verse":"21","text":"Converte-nos a ti,"},{"verse":"","text":"e seremos convertidos;"},{"verse":"","text":"renova os nossos dias como"},{"verse":"","text":"antigamente."},{"verse":"22","text":"Por que nos rejeitarias de vez?"},{"verse":"","text":"Por que ficarias tão enfurecido"},{"verse":"","text":"contra nós?"}]]