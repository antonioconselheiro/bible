{"chapters":[{"chapter":1,"verses":[{"verse":0,"text":"Jerusalém destruída"},{"verse":1,"text":"Álefe —"},{"verse":2,"text":"a cidade outrora populosa!"},{"verse":3,"text":"Tornou-se como viúva"},{"verse":4,"text":"a que foi grande entre as nações!"},{"verse":5,"text":"Princesa entre as províncias,"},{"verse":6,"text":"ficou sujeita a trabalhos forçados!"},{"verse":7,"text":"Bete —"},{"verse":8,"text":"de noite,"},{"verse":9,"text":"e as lágrimas lhe correm"},{"verse":10,"text":"pelo rosto."},{"verse":11,"text":"Entre todos os seus amantes"},{"verse":12,"text":"não tem quem a console."},{"verse":13,"text":"Todos os seus amigos a traíram;"},{"verse":14,"text":"tornaram-se seus inimigos."},{"verse":15,"text":"Guímel —"},{"verse":16,"text":"afligido e sob grande servidão;"},{"verse":17,"text":"agora habita entre as nações,"},{"verse":18,"text":"sem encontrar descanso."},{"verse":19,"text":"Todos os seus perseguidores"},{"verse":20,"text":"o apanharam nas suas angústias."},{"verse":21,"text":"Dálete —"},{"verse":22,"text":"estão de luto,"},{"verse":23,"text":"porque não há quem venha"},{"verse":24,"text":"à reunião solene."},{"verse":25,"text":"Todas as suas portas"},{"verse":26,"text":"estão desertas,"},{"verse":27,"text":"os seus sacerdotes"},{"verse":28,"text":"vivem gemendo,"},{"verse":29,"text":"as suas virgens estão tristes,"},{"verse":30,"text":"e ela mesma se acha em amargura."},{"verse":31,"text":"Hê —"},{"verse":32,"text":"a dominam,"},{"verse":33,"text":"os seus inimigos prosperam."},{"verse":34,"text":"Porque o"},{"verse":35,"text":"por causa da multidão"},{"verse":36,"text":"das suas transgressões;"},{"verse":37,"text":"os seus filhinhos tiveram de ir"},{"verse":38,"text":"para o exílio,"},{"verse":39,"text":"na frente dos adversários."},{"verse":40,"text":"Vau —"},{"verse":41,"text":"todo o esplendor."},{"verse":42,"text":"Os seus príncipes ficaram sendo"},{"verse":43,"text":"como corços que não acham pasto"},{"verse":44,"text":"e caminham exaustos"},{"verse":45,"text":"na frente do perseguidor."},{"verse":46,"text":"Zaine —"},{"verse":47,"text":"e andando sem rumo,"},{"verse":48,"text":"Jerusalém se lembra"},{"verse":49,"text":"de todas as coisas preciosas"},{"verse":50,"text":"que teve nos tempos antigos."},{"verse":51,"text":"Ela se recorda de como o seu povo"},{"verse":52,"text":"caiu nas mãos do adversário,"},{"verse":53,"text":"sem que ninguém"},{"verse":54,"text":"viesse socorrê-la,"},{"verse":55,"text":"e de como os adversários a viram"},{"verse":56,"text":"e deram risada da sua queda."},{"verse":57,"text":"Hete —"},{"verse":58,"text":"gravemente;"},{"verse":59,"text":"por isso, se tornou repugnante."},{"verse":60,"text":"Todos os que a honravam"},{"verse":61,"text":"agora a desprezam,"},{"verse":62,"text":"porque viram a sua nudez;"},{"verse":63,"text":"ela também geme"},{"verse":64,"text":"e se retira envergonhada."},{"verse":65,"text":"Tete —"},{"verse":66,"text":"nas suas saias."},{"verse":67,"text":"Ela não pensava"},{"verse":68,"text":"no que poderia acontecer;"},{"verse":69,"text":"por isso, caiu de modo espantoso"},{"verse":70,"text":"e não tem quem a console."},{"verse":71,"text":"Vê,"},{"verse":72,"text":"porque o inimigo se exalta."},{"verse":73,"text":"Iode —"},{"verse":74,"text":"em todas as coisas preciosas dela."},{"verse":75,"text":"Ela viu as nações entrarem"},{"verse":76,"text":"no seu santuário,"},{"verse":77,"text":"apesar de teres proibido"},{"verse":78,"text":"que entrassem"},{"verse":79,"text":"na tua congregação."},{"verse":80,"text":"Cafe —"},{"verse":81,"text":"anda gemendo"},{"verse":82,"text":"e à procura de pão;"},{"verse":83,"text":"trocaram as suas coisas preciosas"},{"verse":84,"text":"por mantimento,"},{"verse":85,"text":"para poderem restaurar as forças."},{"verse":86,"text":"Vê,"},{"verse":87,"text":"pois me tornei desprezível."},{"verse":88,"text":"Lâmede —"},{"verse":89,"text":"pelo caminho,"},{"verse":90,"text":"será que isto não os comove?"},{"verse":91,"text":"Olhem e vejam se há dor"},{"verse":92,"text":"igual à minha,"},{"verse":93,"text":"essa dor que me sobreveio,"},{"verse":94,"text":"com que o"},{"verse":95,"text":"no dia do furor da sua ira."},{"verse":96,"text":"Mem —"},{"verse":97,"text":"aos meus ossos,"},{"verse":98,"text":"o qual se apoderou deles;"},{"verse":99,"text":"estendeu uma rede aos meus pés,"},{"verse":100,"text":"e me fez voltar para trás;"},{"verse":101,"text":"deixou-me desolada"},{"verse":102,"text":"e sofrendo todo o dia."},{"verse":103,"text":"Num —"},{"verse":104,"text":"fez das minhas transgressões"},{"verse":105,"text":"um jugo;"},{"verse":106,"text":"elas foram entretecidas"},{"verse":107,"text":"e penduradas no meu pescoço."},{"verse":108,"text":"O Senhor abateu a minha força;"},{"verse":109,"text":"ele me entregou"},{"verse":110,"text":"nas mãos daqueles"},{"verse":111,"text":"contra os quais não posso resistir."},{"verse":112,"text":"Sâmeque —"},{"verse":113,"text":"todos os valentes"},{"verse":114,"text":"que estavam comigo;"},{"verse":115,"text":"convocou um exército contra mim,"},{"verse":116,"text":"para esmagar os meus jovens;"},{"verse":117,"text":"o Senhor pisou, como num lagar,"},{"verse":118,"text":"a virgem filha de Judá."},{"verse":119,"text":"Aim —"},{"verse":120,"text":"os meus olhos, os meus olhos"},{"verse":121,"text":"se desfazem em lágrimas."},{"verse":122,"text":"Porque o consolador,"},{"verse":123,"text":"que devia restaurar"},{"verse":124,"text":"as minhas forças,"},{"verse":125,"text":"se afastou de mim."},{"verse":126,"text":"Os meus filhos estão desolados,"},{"verse":127,"text":"porque o inimigo prevaleceu."},{"verse":128,"text":"Pê —"},{"verse":129,"text":"e não há quem a console."},{"verse":130,"text":"O"},{"verse":131,"text":"a respeito de Jacó"},{"verse":132,"text":"que os seus vizinhos se tornem"},{"verse":133,"text":"seus inimigos;"},{"verse":134,"text":"para eles, Jerusalém"},{"verse":135,"text":"se tornou coisa imunda."},{"verse":136,"text":"Tsadê —"},{"verse":137,"text":"pois me rebelei"},{"verse":138,"text":"contra a sua palavra."},{"verse":139,"text":"Escutem, todos os povos,"},{"verse":140,"text":"e vejam a minha dor;"},{"verse":141,"text":"as minhas virgens e os meus jovens"},{"verse":142,"text":"foram levados para o cativeiro."},{"verse":143,"text":"Cofe —"},{"verse":144,"text":"mas eles me enganaram;"},{"verse":145,"text":"os meus sacerdotes"},{"verse":146,"text":"e os meus anciãos"},{"verse":147,"text":"morreram na cidade,"},{"verse":148,"text":"quando estavam"},{"verse":149,"text":"à procura de mantimento"},{"verse":150,"text":"para restaurarem as suas forças."},{"verse":151,"text":"Rexe —"},{"verse":152,"text":"porque estou angustiada!"},{"verse":153,"text":"A minha alma se agita,"},{"verse":154,"text":"o meu coração está transtornado"},{"verse":155,"text":"dentro de mim,"},{"verse":156,"text":"porque gravemente"},{"verse":157,"text":"me rebelei contra ti."},{"verse":158,"text":"Lá fora, a espada mata os filhos;"},{"verse":159,"text":"aqui dentro, a morte se propaga."},{"verse":160,"text":"Chim —"},{"verse":161,"text":"gemidos,"},{"verse":162,"text":"mas não tenho quem me console."},{"verse":163,"text":"Todos os meus inimigos"},{"verse":164,"text":"que souberam"},{"verse":165,"text":"da minha desgraça"},{"verse":166,"text":"se alegram, porque tu a fizeste"},{"verse":167,"text":"cair sobre mim;"},{"verse":168,"text":"mas, quando trouxeres"},{"verse":169,"text":"o dia que anunciaste,"},{"verse":170,"text":"eles serão semelhantes a mim."},{"verse":171,"text":"Tau —"},{"verse":172,"text":"à tua presença,"},{"verse":173,"text":"e faze com eles"},{"verse":174,"text":"como fizeste comigo"},{"verse":175,"text":"por causa de todas"},{"verse":176,"text":"as minhas transgressões;"},{"verse":177,"text":"porque os meus gemidos"},{"verse":178,"text":"são muitos,"},{"verse":179,"text":"e o meu coração desfalece."}]},{"chapter":2,"verses":[{"verse":0,"text":"As tristezas de Sião provêm de Deus"},{"verse":1,"text":"Álefe —"},{"verse":2,"text":"cobriu de nuvens a filha de Sião!"},{"verse":3,"text":"Precipitou do céu à terra"},{"verse":4,"text":"a glória de Israel"},{"verse":5,"text":"e, no dia da sua ira,"},{"verse":6,"text":"não se lembrou"},{"verse":7,"text":"do estrado de seus pés."},{"verse":8,"text":"Bete —"},{"verse":9,"text":"todas as moradas de Jacó"},{"verse":10,"text":"e não teve piedade;"},{"verse":11,"text":"no seu furor, derrubou"},{"verse":12,"text":"as fortalezas da filha de Judá;"},{"verse":13,"text":"lançou por terra e profanou"},{"verse":14,"text":"o reino e os seus príncipes."},{"verse":15,"text":"Guímel —"},{"verse":16,"text":"cortou toda a força de Israel;"},{"verse":17,"text":"retirou a sua mão direita"},{"verse":18,"text":"em face do inimigo."},{"verse":19,"text":"Consumiu Jacó"},{"verse":20,"text":"como labareda de fogo"},{"verse":21,"text":"que devora tudo ao seu redor."},{"verse":22,"text":"Dálete —"},{"verse":23,"text":"como se fosse um inimigo;"},{"verse":24,"text":"firmou a sua mão direita,"},{"verse":25,"text":"como se fosse um adversário."},{"verse":26,"text":"Destruiu tudo"},{"verse":27,"text":"o que era formoso à vista;"},{"verse":28,"text":"derramou o seu furor, como fogo,"},{"verse":29,"text":"sobre a tenda da filha de Sião."},{"verse":30,"text":"Hê —"},{"verse":31,"text":"como inimigo,"},{"verse":32,"text":"devorando Israel;"},{"verse":33,"text":"devorou todos os seus palácios,"},{"verse":34,"text":"destruiu as suas fortalezas"},{"verse":35,"text":"e multiplicou na filha de Judá"},{"verse":36,"text":"o pranto e a lamentação."},{"verse":37,"text":"Vau —"},{"verse":38,"text":"o seu tabernáculo,"},{"verse":39,"text":"como se fosse uma horta;"},{"verse":40,"text":"destruiu o lugar"},{"verse":41,"text":"da sua congregação."},{"verse":42,"text":"O"},{"verse":43,"text":"entregou ao esquecimento"},{"verse":44,"text":"as festas e o sábado"},{"verse":45,"text":"e, na indignação da sua ira,"},{"verse":46,"text":"rejeitou com desprezo"},{"verse":47,"text":"o rei e o sacerdote."},{"verse":48,"text":"Zaine —"},{"verse":49,"text":"o seu altar"},{"verse":50,"text":"e detestou o seu santuário."},{"verse":51,"text":"Entregou nas mãos dos inimigos"},{"verse":52,"text":"os muros dos seus castelos;"},{"verse":53,"text":"eles deram gritos"},{"verse":54,"text":"na Casa do"},{"verse":55,"text":"como se fosse dia de festa."},{"verse":56,"text":"Hete —"},{"verse":57,"text":"destruir a muralha da filha de Sião;"},{"verse":58,"text":"estendeu o cordel"},{"verse":59,"text":"e não retirou"},{"verse":60,"text":"a sua mão destruidora."},{"verse":61,"text":"Fez gemer a muralha e as paredes;"},{"verse":62,"text":"juntas enfraqueceram."},{"verse":63,"text":"Tete —"},{"verse":64,"text":"caíram por terra;"},{"verse":65,"text":"ele quebrou e despedaçou"},{"verse":66,"text":"as suas trancas."},{"verse":67,"text":"O seu rei e os seus príncipes"},{"verse":68,"text":"estão entre as nações"},{"verse":69,"text":"onde já não vigora a lei;"},{"verse":70,"text":"os seus profetas não recebem"},{"verse":71,"text":"mais visões do"},{"verse":72,"text":"Iode —"},{"verse":73,"text":"estão sentados no chão,"},{"verse":74,"text":"em silêncio;"},{"verse":75,"text":"lançam pó sobre a cabeça,"},{"verse":76,"text":"vestindo roupa feita"},{"verse":77,"text":"de pano de saco;"},{"verse":78,"text":"as virgens de Jerusalém"},{"verse":79,"text":"abaixam a cabeça até o chão."},{"verse":80,"text":"Cafe —"},{"verse":81,"text":"se consumiram"},{"verse":82,"text":"os meus olhos,"},{"verse":83,"text":"a minha alma se agita;"},{"verse":84,"text":"o meu coração se derramou"},{"verse":85,"text":"de angústia"},{"verse":86,"text":"por causa da calamidade"},{"verse":87,"text":"da filha do meu povo,"},{"verse":88,"text":"porque crianças e bebês desmaiam"},{"verse":89,"text":"pelas ruas da cidade."},{"verse":90,"text":"Lâmede —"},{"verse":91,"text":"às suas mães:"},{"verse":92,"text":"\"O que temos para"},{"verse":93,"text":"comer e beber?\","},{"verse":94,"text":"ao mesmo tempo"},{"verse":95,"text":"em que desfalecem"},{"verse":96,"text":"como o ferido pelas ruas da cidade"},{"verse":97,"text":"ou quando dão o último suspiro"},{"verse":98,"text":"nos braços de sua mãe."},{"verse":99,"text":"Mem —"},{"verse":100,"text":"A quem você se assemelha,"},{"verse":101,"text":"ó filha de Jerusalém?"},{"verse":102,"text":"A quem posso compará-la,"},{"verse":103,"text":"para lhe trazer consolo,"},{"verse":104,"text":"ó virgem filha de Sião?"},{"verse":105,"text":"Porque a sua calamidade"},{"verse":106,"text":"é tão grande como o mar;"},{"verse":107,"text":"quem poderá curá-la?"},{"verse":108,"text":"Num —"},{"verse":109,"text":"os seus profetas"},{"verse":110,"text":"lhe anunciaram"},{"verse":111,"text":"eram falsas e enganosas."},{"verse":112,"text":"Eles não expuseram"},{"verse":113,"text":"a maldade do que você fazia,"},{"verse":114,"text":"para restaurarem a sua sorte,"},{"verse":115,"text":"mas anunciaram visões falsas,"},{"verse":116,"text":"que a levaram ao cativeiro."},{"verse":117,"text":"Sâmeque —"},{"verse":118,"text":"pelo caminho"},{"verse":119,"text":"zombam, batendo palmas,"},{"verse":120,"text":"vaiam e balançam a cabeça"},{"verse":121,"text":"diante da filha de Jerusalém."},{"verse":122,"text":"Perguntam: \"É esta a cidade"},{"verse":123,"text":"que chamavam de"},{"verse":124,"text":"Perfeição da Formosura,"},{"verse":125,"text":"a alegria de toda a terra?\""},{"verse":126,"text":"Pê —"},{"verse":127,"text":"abrem a boca contra você,"},{"verse":128,"text":"vaiam, rangem os dentes e dizem:"},{"verse":129,"text":"\"Nós acabamos com ela!"},{"verse":130,"text":"Certamente este é"},{"verse":131,"text":"o dia que esperávamos!"},{"verse":132,"text":"Conseguimos! Esse dia chegou!\""},{"verse":133,"text":"Aim —"},{"verse":134,"text":"o que tinha em vista;"},{"verse":135,"text":"cumpriu a ameaça que pronunciou"},{"verse":136,"text":"desde os dias da antiguidade."},{"verse":137,"text":"Derrubou sem dó nem piedade;"},{"verse":138,"text":"deixou que os inimigos"},{"verse":139,"text":"se alegrassem"},{"verse":140,"text":"por causa de você"},{"verse":141,"text":"e exaltou o poder"},{"verse":142,"text":"dos seus adversários."},{"verse":143,"text":"Tsadê —"},{"verse":144,"text":"clama ao Senhor."},{"verse":145,"text":"Ó muralha da filha de Sião,"},{"verse":146,"text":"que as suas lágrimas corram"},{"verse":147,"text":"como um ribeiro,"},{"verse":148,"text":"de dia e de noite!"},{"verse":149,"text":"Não descanse!"},{"verse":150,"text":"Que a menina de seus olhos"},{"verse":151,"text":"não pare de chorar!"},{"verse":152,"text":"Cofe —"},{"verse":153,"text":"e clame de noite,"},{"verse":154,"text":"no princípio das vigílias."},{"verse":155,"text":"Derrame, como água,"},{"verse":156,"text":"o coração diante do Senhor;"},{"verse":157,"text":"levante a ele as mãos,"},{"verse":158,"text":"pela vida de seus filhinhos,"},{"verse":159,"text":"que desfalecem de fome"},{"verse":160,"text":"nas esquinas de todas as ruas."},{"verse":161,"text":"Rexe —"},{"verse":162,"text":"a quem trataste assim!"},{"verse":163,"text":"Será que as mulheres"},{"verse":164,"text":"deviam comer"},{"verse":165,"text":"o fruto de si mesmas,"},{"verse":166,"text":"as crianças que elas tanto amam?"},{"verse":167,"text":"Ou será que os sacerdotes"},{"verse":168,"text":"e profetas"},{"verse":169,"text":"deviam ser mortos"},{"verse":170,"text":"no santuário do Senhor?"},{"verse":171,"text":"Chim —"},{"verse":172,"text":"jazem por terra pelas ruas;"},{"verse":173,"text":"as minhas virgens e os meus jovens"},{"verse":174,"text":"foram mortos à espada."},{"verse":175,"text":"Tu os mataste no dia da tua ira;"},{"verse":176,"text":"fizeste matança"},{"verse":177,"text":"sem dó nem piedade."},{"verse":178,"text":"Tau —"},{"verse":179,"text":"terrores contra mim,"},{"verse":180,"text":"como se fosse um dia de festa;"},{"verse":181,"text":"não houve quem escapasse"},{"verse":182,"text":"ou ficasse com vida"},{"verse":183,"text":"no dia da ira do"},{"verse":184,"text":"Os filhos que tive e criei,"},{"verse":185,"text":"o meu inimigo os consumiu."}]},{"chapter":3,"verses":[{"verse":0,"text":"Castigo, arrependimento e esperança"},{"verse":1,"text":"Álefe —"},{"verse":2,"text":"que viu a aflição"},{"verse":3,"text":"causada pela vara"},{"verse":4,"text":"do furor de Deus."},{"verse":5,"text":"Ele me levou e me fez andar"},{"verse":6,"text":"nas trevas e não na luz."},{"verse":7,"text":"Certamente ele voltou"},{"verse":8,"text":"a sua mão contra mim,"},{"verse":9,"text":"sem parar, todo o dia."},{"verse":10,"text":"Bete —"},{"verse":11,"text":"a minha carne"},{"verse":12,"text":"e a minha pele,"},{"verse":13,"text":"e despedaçou os meus ossos."},{"verse":14,"text":"Construiu rampas de ataque"},{"verse":15,"text":"contra mim"},{"verse":16,"text":"e me cercou de amargura e dor."},{"verse":17,"text":"Ele me faz habitar na escuridão,"},{"verse":18,"text":"como aqueles que morreram"},{"verse":19,"text":"há muito tempo."},{"verse":20,"text":"Guímel —"},{"verse":21,"text":"e já não posso sair;"},{"verse":22,"text":"prendeu-me"},{"verse":23,"text":"com pesadas correntes."},{"verse":24,"text":"Mesmo quando clamo e grito,"},{"verse":25,"text":"ele fecha os ouvidos"},{"verse":26,"text":"à minha oração."},{"verse":27,"text":"Fechou os meus caminhos"},{"verse":28,"text":"com blocos de pedra,"},{"verse":29,"text":"fez tortuosas as minhas veredas."},{"verse":30,"text":"Dálete —"},{"verse":31,"text":"um urso à espreita,"},{"verse":32,"text":"como um leão pronto para atacar."},{"verse":33,"text":"Desviou os meus caminhos"},{"verse":34,"text":"e me fez em pedaços;"},{"verse":35,"text":"depois me abandonou."},{"verse":36,"text":"Entesou o seu arco"},{"verse":37,"text":"e me pôs como alvo"},{"verse":38,"text":"de suas flechas."},{"verse":39,"text":"Hê —"},{"verse":40,"text":"atingiram o meu coração."},{"verse":41,"text":"Fui feito motivo de riso"},{"verse":42,"text":"para todo o meu povo,"},{"verse":43,"text":"e a sua canção de deboche"},{"verse":44,"text":"o dia inteiro."},{"verse":45,"text":"Fartou-me de amarguras,"},{"verse":46,"text":"e me saciou de absinto."},{"verse":47,"text":"Vau —"},{"verse":48,"text":"nas pedras,"},{"verse":49,"text":"e cobriu-me de cinza."},{"verse":50,"text":"Já não sei o que é ter paz"},{"verse":51,"text":"e esqueci o que é"},{"verse":52,"text":"desfrutar do bem."},{"verse":53,"text":"Então eu disse:"},{"verse":54,"text":"\"Não tenho mais forças."},{"verse":55,"text":"A minha esperança"},{"verse":56,"text":"no"},{"verse":57,"text":"Zaine —"},{"verse":58,"text":"da minha aflição"},{"verse":59,"text":"e do meu andar errante,"},{"verse":60,"text":"do absinto e da amargura."},{"verse":61,"text":"Minha alma continuamente"},{"verse":62,"text":"se lembra disso"},{"verse":63,"text":"e se abate dentro de mim."},{"verse":64,"text":"Quero trazer à memória"},{"verse":65,"text":"o que pode me dar esperança."},{"verse":66,"text":"Hete —"},{"verse":67,"text":"do"},{"verse":68,"text":"de não sermos"},{"verse":69,"text":"consumidos,"},{"verse":70,"text":"porque as suas misericórdias"},{"verse":71,"text":"não têm fim;"},{"verse":72,"text":"renovam-se cada manhã."},{"verse":73,"text":"Grande é a tua fidelidade."},{"verse":74,"text":"A minha porção é o"},{"verse":75,"text":"diz a minha alma;"},{"verse":76,"text":"portanto, esperarei nele."},{"verse":77,"text":"Tete —"},{"verse":78,"text":"para os que esperam nele,"},{"verse":79,"text":"para aqueles que o buscam."},{"verse":80,"text":"Bom é aguardar"},{"verse":81,"text":"a salvação do"},{"verse":82,"text":"e isso, em silêncio."},{"verse":83,"text":"Bom é para o homem"},{"verse":84,"text":"suportar o jugo na sua mocidade."},{"verse":85,"text":"Iode —"},{"verse":86,"text":"e fique em silêncio,"},{"verse":87,"text":"porque esse jugo"},{"verse":88,"text":"Deus pôs sobre ele."},{"verse":89,"text":"Ponha a sua boca no pó;"},{"verse":90,"text":"talvez ainda haja esperança."},{"verse":91,"text":"Dê a face ao que o fere"},{"verse":92,"text":"e suporte todas as afrontas."},{"verse":93,"text":"Cafe —"},{"verse":94,"text":"para sempre."},{"verse":95,"text":"Ainda que entristeça alguém,"},{"verse":96,"text":"terá compaixão"},{"verse":97,"text":"segundo a grandeza"},{"verse":98,"text":"das suas misericórdias."},{"verse":99,"text":"Porque não aflige"},{"verse":100,"text":"nem entristece de bom grado"},{"verse":101,"text":"os filhos dos homens."},{"verse":102,"text":"Lâmede —"},{"verse":103,"text":"todos os prisioneiros da terra,"},{"verse":104,"text":"perverter o direito do homem"},{"verse":105,"text":"diante do Altíssimo,"},{"verse":106,"text":"subverter a justiça num processo"},{"verse":107,"text":"— será que o Senhor"},{"verse":108,"text":"não veria tais coisas?"},{"verse":109,"text":"Mem —"},{"verse":110,"text":"e assim acontece,"},{"verse":111,"text":"sem que o Senhor"},{"verse":112,"text":"o tenha ordenado?"},{"verse":113,"text":"Por acaso, não é"},{"verse":114,"text":"da boca do Altíssimo"},{"verse":115,"text":"que procedem"},{"verse":116,"text":"tanto o mal como o bem?"},{"verse":117,"text":"Por que se queixa o homem?"},{"verse":118,"text":"Queixe-se cada um"},{"verse":119,"text":"dos seus próprios pecados."},{"verse":120,"text":"Num —"},{"verse":121,"text":"os nossos caminhos"},{"verse":122,"text":"e voltemos para o"},{"verse":123,"text":"Levantemos o coração,"},{"verse":124,"text":"juntamente com as mãos,"},{"verse":125,"text":"para Deus nos céus, dizendo:"},{"verse":126,"text":"\"Nós pecamos"},{"verse":127,"text":"e fomos rebeldes,"},{"verse":128,"text":"e tu não nos perdoaste.\""},{"verse":129,"text":"Sâmeque —"},{"verse":130,"text":"e nos perseguiste;"},{"verse":131,"text":"nos mataste sem dó"},{"verse":132,"text":"nem piedade."},{"verse":133,"text":"De nuvens te encobriste"},{"verse":134,"text":"para que a nossa oração"},{"verse":135,"text":"não passe."},{"verse":136,"text":"Como lixo e refugo nos puseste"},{"verse":137,"text":"no meio dos povos."},{"verse":138,"text":"Pê —"},{"verse":139,"text":"abriram a boca contra nós."},{"verse":140,"text":"Sobre nós vieram"},{"verse":141,"text":"o temor e a cova,"},{"verse":142,"text":"a desolação e a ruína."},{"verse":143,"text":"Dos meus olhos"},{"verse":144,"text":"correm rios de lágrimas,"},{"verse":145,"text":"por causa da destruição"},{"verse":146,"text":"da filha do meu povo."},{"verse":147,"text":"Aim —"},{"verse":148,"text":"não cessam, e não há descanso,"},{"verse":149,"text":"até que o"},{"verse":150,"text":"e veja lá do céu."},{"verse":151,"text":"O que vejo entristece"},{"verse":152,"text":"a minha alma:"},{"verse":153,"text":"o sofrimento de todas"},{"verse":154,"text":"as filhas da minha cidade."},{"verse":155,"text":"Tsadê —"},{"verse":156,"text":"são meus inimigos"},{"verse":157,"text":"caçaram-me"},{"verse":158,"text":"como se eu fosse uma ave."},{"verse":159,"text":"Lançaram-me vivo numa cova"},{"verse":160,"text":"e atiraram pedras sobre mim."},{"verse":161,"text":"Águas correram"},{"verse":162,"text":"sobre a minha cabeça;"},{"verse":163,"text":"então eu disse: \"Estou perdido!\""},{"verse":164,"text":"Cofe —"},{"verse":165,"text":"invoquei o teu nome."},{"verse":166,"text":"Ouviste a minha voz,"},{"verse":167,"text":"quando pedi:"},{"verse":168,"text":"\"Não feches os teus ouvidos"},{"verse":169,"text":"aos meus lamentos,"},{"verse":170,"text":"ao meu clamor.\""},{"verse":171,"text":"No dia em que te invoquei,"},{"verse":172,"text":"chegaste perto de mim"},{"verse":173,"text":"e disseste: \"Não tenha medo.\""},{"verse":174,"text":"Rexe —"},{"verse":175,"text":"Senhor;"},{"verse":176,"text":"remiste a minha vida."},{"verse":177,"text":"Viste,"},{"verse":178,"text":"que me fizeram;"},{"verse":179,"text":"julga a minha causa."},{"verse":180,"text":"Viste toda a sua vingança,"},{"verse":181,"text":"todos os seus planos contra mim."},{"verse":182,"text":"Chim —"},{"verse":183,"text":"Senhor"},{"verse":184,"text":"todos os seus planos contra mim,"},{"verse":185,"text":"as acusações que me fazem"},{"verse":186,"text":"e o que murmuram contra mim,"},{"verse":187,"text":"o dia todo."},{"verse":188,"text":"Observa-os quando se assentam"},{"verse":189,"text":"e quando se levantam;"},{"verse":190,"text":"eu sou motivo de zombaria"},{"verse":191,"text":"para eles."},{"verse":192,"text":"Tau —"},{"verse":193,"text":"segundo a obra das mãos deles."},{"verse":194,"text":"Tu lhes darás dureza de coração,"},{"verse":195,"text":"que é a tua maldição sobre eles."},{"verse":196,"text":"Na tua ira, os perseguirás,"},{"verse":197,"text":"e eles serão eliminados"},{"verse":198,"text":"de debaixo dos céus do"}]},{"chapter":4,"verses":[{"verse":0,"text":"Os sofrimentos do cerco"},{"verse":1,"text":"Álefe —"},{"verse":2,"text":"Como o ouro refinado"},{"verse":3,"text":"perdeu o seu brilho!"},{"verse":4,"text":"Como estão espalhadas"},{"verse":5,"text":"as pedras do santuário"},{"verse":6,"text":"pelas esquinas de todas as ruas!"},{"verse":7,"text":"Bete —"},{"verse":8,"text":"comparáveis a ouro puro,"},{"verse":9,"text":"agora são tratados"},{"verse":10,"text":"como simples objetos de barro,"},{"verse":11,"text":"obra das mãos de oleiro!"},{"verse":12,"text":"Guímel —"},{"verse":13,"text":"dão o peito,"},{"verse":14,"text":"dão de mamar aos seus filhotes;"},{"verse":15,"text":"mas a filha do meu povo"},{"verse":16,"text":"tornou-se cruel"},{"verse":17,"text":"como as avestruzes no deserto."},{"verse":18,"text":"Dálete —"},{"verse":19,"text":"que mama"},{"verse":20,"text":"fica pegada, pela sede,"},{"verse":21,"text":"ao céu da boca;"},{"verse":22,"text":"as crianças pedem pão,"},{"verse":23,"text":"mas não há quem as alimente."},{"verse":24,"text":"Hê —"},{"verse":25,"text":"de comidas finas"},{"verse":26,"text":"desfalecem nas ruas;"},{"verse":27,"text":"os que se criaram entre escarlate"},{"verse":28,"text":"agora vivem entre montes de lixo."},{"verse":29,"text":"Vau —"},{"verse":30,"text":"da filha do meu povo"},{"verse":31,"text":"é maior do que o pecado"},{"verse":32,"text":"de Sodoma,"},{"verse":33,"text":"que foi destruída num momento,"},{"verse":34,"text":"sem intervenção humana."},{"verse":35,"text":"Zaine —"},{"verse":36,"text":"eram mais alvos do que a neve,"},{"verse":37,"text":"mais brancos do que o leite;"},{"verse":38,"text":"eram mais ruivos de corpo"},{"verse":39,"text":"do que os corais"},{"verse":40,"text":"e tinham a formosura da safira."},{"verse":41,"text":"Hete —"},{"verse":42,"text":"é mais escuro do que a fuligem;"},{"verse":43,"text":"não são reconhecidos nas ruas."},{"verse":44,"text":"A sua pele grudou nos ossos,"},{"verse":45,"text":"secou-se como a madeira."},{"verse":46,"text":"Tete —"},{"verse":47,"text":"as vítimas da espada"},{"verse":48,"text":"do que as vítimas da fome;"},{"verse":49,"text":"porque estas se definham"},{"verse":50,"text":"atingidas mortalmente"},{"verse":51,"text":"pela falta do produto"},{"verse":52,"text":"dos campos."},{"verse":53,"text":"Iode —"},{"verse":54,"text":"que antes eram compassivas"},{"verse":55,"text":"cozinharam"},{"verse":56,"text":"os seus próprios filhos;"},{"verse":57,"text":"estes lhes serviram de alimento"},{"verse":58,"text":"quando a filha do meu povo"},{"verse":59,"text":"foi destruída."},{"verse":60,"text":"Cafe —"},{"verse":61,"text":"à sua indignação,"},{"verse":62,"text":"derramou o furor da sua ira;"},{"verse":63,"text":"acendeu fogo em Sião,"},{"verse":64,"text":"que consumiu os seus alicerces."},{"verse":65,"text":"Lâmede —"},{"verse":66,"text":"nem todos os moradores"},{"verse":67,"text":"do mundo acreditavam"},{"verse":68,"text":"que o adversário ou inimigo"},{"verse":69,"text":"pudesse entrar"},{"verse":70,"text":"pelos portões de Jerusalém."},{"verse":71,"text":"Mem —"},{"verse":72,"text":"por causa dos pecados"},{"verse":73,"text":"dos seus profetas"},{"verse":74,"text":"e por causa das maldades"},{"verse":75,"text":"dos seus sacerdotes,"},{"verse":76,"text":"que derramaram no meio dela"},{"verse":77,"text":"o sangue dos justos."},{"verse":78,"text":"Num —"},{"verse":79,"text":"pelas ruas,"},{"verse":80,"text":"andam contaminados de sangue,"},{"verse":81,"text":"de maneira que ninguém"},{"verse":82,"text":"pode tocar na roupa deles."},{"verse":83,"text":"Sâmeque —"},{"verse":84,"text":"\"Afastem-se, imundos!"},{"verse":85,"text":"Afastem-se, afastem-se,"},{"verse":86,"text":"não toquem em nada!\""},{"verse":87,"text":"Quando fugiram"},{"verse":88,"text":"e andaram errantes,"},{"verse":89,"text":"dizia-se entre as nações:"},{"verse":90,"text":"\"Aqui eles não podem morar.\""},{"verse":91,"text":"Pê —"},{"verse":92,"text":"ele já não dá atenção a eles."},{"verse":93,"text":"Não respeitaram os sacerdotes,"},{"verse":94,"text":"nem se compadeceram"},{"verse":95,"text":"dos anciãos."},{"verse":96,"text":"Aim —"},{"verse":97,"text":"ainda desfalecem,"},{"verse":98,"text":"esperando socorro"},{"verse":99,"text":"que nunca chega;"},{"verse":100,"text":"de nossas torres,"},{"verse":101,"text":"temos olhado para um povo"},{"verse":102,"text":"que não nos pode livrar."},{"verse":103,"text":"Tsadê —"},{"verse":104,"text":"os nossos passos,"},{"verse":105,"text":"de maneira que"},{"verse":106,"text":"não podíamos andar"},{"verse":107,"text":"pelas nossas ruas."},{"verse":108,"text":"Nosso fim se aproximava,"},{"verse":109,"text":"os nossos dias estavam contados,"},{"verse":110,"text":"era chegado o nosso fim."},{"verse":111,"text":"Cofe —"},{"verse":112,"text":"foram mais ligeiros"},{"verse":113,"text":"do que as águias nos céus;"},{"verse":114,"text":"sobre os montes nos perseguiram,"},{"verse":115,"text":"no deserto nos armaram ciladas."},{"verse":116,"text":"Rexe —"},{"verse":117,"text":"que era o nosso alento,"},{"verse":118,"text":"foi preso nas armadilhas deles."},{"verse":119,"text":"Dele dizíamos:"},{"verse":120,"text":"\"Debaixo da sua sombra,"},{"verse":121,"text":"viveremos entre as nações.\""},{"verse":122,"text":"Chim —"},{"verse":123,"text":"ó filha de Edom,"},{"verse":124,"text":"você que habita na terra de Uz."},{"verse":125,"text":"Logo chegará a sua hora"},{"verse":126,"text":"de beber do cálice;"},{"verse":127,"text":"você ficará embriagada e despida."},{"verse":128,"text":"Tau —"},{"verse":129,"text":"da sua maldade"},{"verse":130,"text":"está consumado,"},{"verse":131,"text":"ó filha de Sião;"},{"verse":132,"text":"o"},{"verse":133,"text":"para o exílio."},{"verse":134,"text":"Mas ele castigará a sua maldade,"},{"verse":135,"text":"ó filha de Edom;"},{"verse":136,"text":"porá a descoberto os pecados"},{"verse":137,"text":"que você cometeu."}]},{"chapter":5,"verses":[{"verse":0,"text":"Oração pedindo misericórdia"},{"verse":1,"text":"Lembra-te,"},{"verse":2,"text":"do que nos aconteceu;"},{"verse":3,"text":"considera e olha"},{"verse":4,"text":"para a nossa desgraça."},{"verse":5,"text":"A nossa herança foi entregue"},{"verse":6,"text":"a estranhos,"},{"verse":7,"text":"e as nossas casas,"},{"verse":8,"text":"a estrangeiros."},{"verse":9,"text":"Somos órfãos,"},{"verse":10,"text":"já não temos pai;"},{"verse":11,"text":"as nossas mães"},{"verse":12,"text":"são como viúvas."},{"verse":13,"text":"Temos de comprar"},{"verse":14,"text":"a nossa própria água;"},{"verse":15,"text":"temos de pagar"},{"verse":16,"text":"pela nossa própria lenha."},{"verse":17,"text":"Os nossos perseguidores"},{"verse":18,"text":"estão sobre o nosso pescoço;"},{"verse":19,"text":"estamos exaustos"},{"verse":20,"text":"e não temos descanso."},{"verse":21,"text":"Submetemo-nos aos egípcios"},{"verse":22,"text":"e aos assírios,"},{"verse":23,"text":"para nos fartarem de pão."},{"verse":24,"text":"Nossos pais pecaram"},{"verse":25,"text":"e já não existem;"},{"verse":26,"text":"nós é que recebemos o castigo"},{"verse":27,"text":"pelas suas iniquidades."},{"verse":28,"text":"Escravos dominam sobre nós;"},{"verse":29,"text":"não há ninguém"},{"verse":30,"text":"que nos livre das suas mãos."},{"verse":31,"text":"Arriscamos a vida"},{"verse":32,"text":"para conseguir o nosso pão,"},{"verse":33,"text":"por causa da ameaça"},{"verse":34,"text":"que vem do deserto."},{"verse":35,"text":"Nossa pele queima"},{"verse":36,"text":"como um forno,"},{"verse":37,"text":"por causa do ardor da fome."},{"verse":38,"text":"As mulheres foram"},{"verse":39,"text":"violentadas em Sião;"},{"verse":40,"text":"as virgens, nas cidades de Judá."},{"verse":41,"text":"Enforcaram os príncipes,"},{"verse":42,"text":"não tiveram nenhum respeito"},{"verse":43,"text":"pelos velhos."},{"verse":44,"text":"Os jovens são obrigados"},{"verse":45,"text":"a virar os moinhos;"},{"verse":46,"text":"os meninos tropeçam"},{"verse":47,"text":"debaixo das cargas de lenha."},{"verse":48,"text":"Os anciãos já não se reúnem"},{"verse":49,"text":"junto ao portão da cidade;"},{"verse":50,"text":"os jovens já não cantam mais."},{"verse":51,"text":"Cessou a alegria"},{"verse":52,"text":"de nosso coração;"},{"verse":53,"text":"a nossa dança se transformou"},{"verse":54,"text":"em lamentações."},{"verse":55,"text":"Caiu a coroa da nossa cabeça."},{"verse":56,"text":"Ai de nós, porque pecamos!"},{"verse":57,"text":"Por causa disso,"},{"verse":58,"text":"o nosso coração está doente;"},{"verse":59,"text":"por causa dessas coisas,"},{"verse":60,"text":"os nossos olhos se escureceram."},{"verse":61,"text":"Pelo monte Sião,"},{"verse":62,"text":"que está abandonado,"},{"verse":63,"text":"vagueiam os chacais."},{"verse":64,"text":"Tu,"},{"verse":65,"text":"reinas eternamente,"},{"verse":66,"text":"o teu trono subsiste"},{"verse":67,"text":"de geração em geração."},{"verse":68,"text":"Por que te esquecerias"},{"verse":69,"text":"de nós para sempre?"},{"verse":70,"text":"Por que nos desampararias"},{"verse":71,"text":"por tanto tempo?"},{"verse":72,"text":"Converte-nos a ti,"},{"verse":73,"text":"e seremos convertidos;"},{"verse":74,"text":"renova os nossos dias como"},{"verse":75,"text":"antigamente."},{"verse":76,"text":"Por que nos rejeitarias de vez?"},{"verse":77,"text":"Por que ficarias tão enfurecido"},{"verse":78,"text":"contra nós?"}]}]}