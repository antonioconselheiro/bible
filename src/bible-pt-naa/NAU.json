{"chapters":[[{"verse":"1","text":"Sentença contra Nínive. Livro da visão de Naum, da cidade de Elcos."},{"verse":"","text":"A ira e a misericórdia de Deus"},{"verse":"2","text":"O"},{"verse":"","text":"e vingador,"},{"verse":"","text":"o"},{"verse":"","text":"e cheio de ira;"},{"verse":"","text":"o"},{"verse":"","text":"contra os seus adversários"},{"verse":"","text":"e reserva indignação"},{"verse":"","text":"para os seus inimigos."},{"verse":"3","text":"O"},{"verse":"","text":"mas grande em poder"},{"verse":"","text":"e jamais inocenta o culpado."},{"verse":"","text":"O"},{"verse":"","text":"na tormenta e na tempestade,"},{"verse":"","text":"e as nuvens são a poeira"},{"verse":"","text":"dos seus pés."},{"verse":"4","text":"Repreende o mar, e ele seca;"},{"verse":"","text":"faz com que todos os rios"},{"verse":"","text":"fiquem secos."},{"verse":"","text":"Basã e o Carmelo desfalecem,"},{"verse":"","text":"e as flores do Líbano murcham."},{"verse":"5","text":"Os montes tremem diante dele,"},{"verse":"","text":"e as colinas se derretem."},{"verse":"","text":"A terra se levanta diante dele,"},{"verse":"","text":"sim, o mundo"},{"verse":"","text":"e todos os seus moradores."},{"verse":"6","text":"Quem pode suportar"},{"verse":"","text":"a sua indignação?"},{"verse":"","text":"E quem subsistirá diante do furor"},{"verse":"","text":"da sua ira?"},{"verse":"","text":"A sua cólera se derrama"},{"verse":"","text":"como fogo,"},{"verse":"","text":"e as rochas são por ele demolidas."},{"verse":"7","text":"O"},{"verse":"","text":"é fortaleza no dia da angústia"},{"verse":"","text":"e conhece os que nele se refugiam."},{"verse":"8","text":"Mas, com inundação"},{"verse":"","text":"transbordante,"},{"verse":"","text":"acabará de uma vez"},{"verse":"","text":"com o lugar dessa cidade;"},{"verse":"","text":"com trevas, o"},{"verse":"","text":"os seus inimigos."},{"verse":"9","text":"O que é que vocês estão"},{"verse":"","text":"planejando contra o"},{"verse":"","text":"Ele mesmo os"},{"verse":"","text":"consumirá completamente;"},{"verse":"","text":"a angústia não se levantará"},{"verse":"","text":"duas vezes!"},{"verse":"10","text":"Porque, ainda que eles"},{"verse":"","text":"se entrelacem"},{"verse":"","text":"como os espinhos"},{"verse":"","text":"e se saturem de vinho"},{"verse":"","text":"como bêbados,"},{"verse":"","text":"serão inteiramente consumidos"},{"verse":"","text":"como palha seca."},{"verse":"11","text":"De você, Nínive, saiu um"},{"verse":"","text":"que planeja o mal contra o"},{"verse":"","text":"alguém que aconselha a maldade."},{"verse":"12","text":"Assim diz o"},{"verse":"","text":"\"Por mais seguros que estejam"},{"verse":"","text":"e por mais numerosos que eles sejam,"},{"verse":"","text":"ainda assim serão exterminados"},{"verse":"","text":"e passarão."},{"verse":"","text":"Meu povo, embora eu"},{"verse":"","text":"o tenha afligido,"},{"verse":"","text":"não o afligirei mais."},{"verse":"13","text":"Quebrarei o jugo deles"},{"verse":"","text":"que pesa sobre você"},{"verse":"","text":"e romperei os laços"},{"verse":"","text":"que o prendem.\""},{"verse":"14","text":"Porém contra você, Assíria,"},{"verse":"","text":"o"},{"verse":"","text":"para que não haja posteridade"},{"verse":"","text":"que leve o seu nome;"},{"verse":"","text":"do templo dos seus deuses"},{"verse":"","text":"exterminarei as imagens"},{"verse":"","text":"de escultura"},{"verse":"","text":"e de fundição."},{"verse":"","text":"Farei a sua sepultura,"},{"verse":"","text":"porque você é desprezível."},{"verse":"15","text":"Eis sobre os montes"},{"verse":"","text":"os pés do que anuncia boas-novas,"},{"verse":"","text":"do que anuncia a paz!"},{"verse":"","text":"Celebre as suas festas, ó Judá,"},{"verse":"","text":"cumpra os seus votos,"},{"verse":"","text":"porque o ímpio"},{"verse":"","text":"não mais passará por você;"},{"verse":"","text":"ele foi inteiramente exterminado."}],[{"verse":"","text":"A queda de Nínive"},{"verse":"1","text":"O destruidor avança"},{"verse":"","text":"contra você, Nínive!"},{"verse":"","text":"Guarde a fortaleza,"},{"verse":"","text":"vigie o caminho,"},{"verse":"","text":"prepare-se para lutar,"},{"verse":"","text":"reúna todas as suas forças!"},{"verse":"2","text":"Porque o"},{"verse":"","text":"a glória de Jacó,"},{"verse":"","text":"como a glória de Israel;"},{"verse":"","text":"porque saqueadores os saquearam"},{"verse":"","text":"e destruíram os seus ramos."},{"verse":"3","text":"Os escudos dos seus heróis"},{"verse":"","text":"são vermelhos;"},{"verse":"","text":"os homens valentes"},{"verse":"","text":"vestem escarlate."},{"verse":"","text":"Os carros de guerra"},{"verse":"","text":"brilham como fogo"},{"verse":"","text":"no dia da sua preparação,"},{"verse":"","text":"e as lanças são agitadas."},{"verse":"4","text":"Os carros de guerra passam"},{"verse":"","text":"furiosamente pelas ruas"},{"verse":"","text":"e se cruzam velozes pelas praças;"},{"verse":"","text":"parecem tochas,"},{"verse":"","text":"correm como relâmpago."},{"verse":"5","text":"Os nobres são chamados,"},{"verse":"","text":"mas tropeçam no seu caminho;"},{"verse":"","text":"apressam-se para chegar à muralha"},{"verse":"","text":"e preparam a defesa."},{"verse":"6","text":"As comportas dos rios se abrem,"},{"verse":"","text":"e o palácio é destruído."},{"verse":"7","text":"Está decretado:"},{"verse":"","text":"a cidade-rainha está despida,"},{"verse":"","text":"levada em cativeiro;"},{"verse":"","text":"as suas servas gemem"},{"verse":"","text":"como pombas"},{"verse":"","text":"e batem no peito."},{"verse":"8","text":"Nínive, desde que existe,"},{"verse":"","text":"tem sido como um tanque de águas;"},{"verse":"","text":"mas, agora, o seu povo foge."},{"verse":"","text":"Alguém grita: \"Parem! Parem!\","},{"verse":"","text":"mas ninguém se volta."},{"verse":"9","text":"Saqueiem a prata,"},{"verse":"","text":"saqueiem o ouro,"},{"verse":"","text":"porque os tesouros não têm fim;"},{"verse":"","text":"a cidade está repleta de objetos de valor."},{"verse":"10","text":"Vazio, desolação, ruína!"},{"verse":"","text":"O coração se derrete,"},{"verse":"","text":"os joelhos tremem,"},{"verse":"","text":"acabam-se as forças,"},{"verse":"","text":"e o rosto de todos empalidece."},{"verse":"11","text":"Onde está, agora,"},{"verse":"","text":"o covil dos leões"},{"verse":"","text":"e o lugar onde os leõezinhos"},{"verse":"","text":"se alimentavam,"},{"verse":"","text":"onde passeavam o leão,"},{"verse":"","text":"a leoa e o filhote do leão,"},{"verse":"","text":"sem que ninguém os espantasse?"},{"verse":"12","text":"O leão arrebatava o bastante"},{"verse":"","text":"para os seus filhotes,"},{"verse":"","text":"estrangulava a presa"},{"verse":"","text":"para as suas leoas,"},{"verse":"","text":"e enchia de vítimas"},{"verse":"","text":"as suas cavernas,"},{"verse":"","text":"e os seus covis, de rapina."},{"verse":"13","text":"\"Eis que eu estou contra você\","},{"verse":"","text":"diz o"},{"verse":"","text":"\"queimarei os seus carros de guerra,"},{"verse":"","text":"a espada devorará"},{"verse":"","text":"os seus leõezinhos,"},{"verse":"","text":"arrancarei da terra a sua presa,"},{"verse":"","text":"e nunca mais se ouvirá a voz"},{"verse":"","text":"dos seus embaixadores.\""}],[{"verse":"","text":"A ruína completa de Nínive"},{"verse":"1","text":"Ai da cidade sanguinária,"},{"verse":"","text":"toda cheia de mentiras e de roubo"},{"verse":"","text":"e que não solta a sua presa!"},{"verse":"2","text":"Eis o estalo dos açoites,"},{"verse":"","text":"o estrondo das rodas,"},{"verse":"","text":"o galope dos cavalos"},{"verse":"","text":"e os carros que vão saltando!"},{"verse":"3","text":"Os cavaleiros que esporeiam,"},{"verse":"","text":"as espadas brilhantes,"},{"verse":"","text":"as lanças reluzentes,"},{"verse":"","text":"uma multidão de feridos,"},{"verse":"","text":"massa de cadáveres,"},{"verse":"","text":"mortos sem fim"},{"verse":"","text":"— chegam a tropeçar"},{"verse":"","text":"sobre os mortos."},{"verse":"4","text":"Tudo isso por causa"},{"verse":"","text":"da grande prostituição"},{"verse":"","text":"da bela e encantadora prostituta,"},{"verse":"","text":"da mestra de feitiçarias,"},{"verse":"","text":"que seduzia as nações"},{"verse":"","text":"com a sua prostituição"},{"verse":"","text":"e os povos, com as suas feitiçarias."},{"verse":"5","text":"\"Eis que eu estou contra você\","},{"verse":"","text":"diz o"},{"verse":"","text":"\"Levantarei as abas de sua saia"},{"verse":"","text":"sobre o seu rosto,"},{"verse":"","text":"e mostrarei às nações a sua nudez,"},{"verse":"","text":"e aos reinos, as suas vergonhas."},{"verse":"6","text":"Vou jogar sujeira sobre você,"},{"verse":"","text":"tratá-la com desprezo"},{"verse":"","text":"e transformá-la em espetáculo."},{"verse":"7","text":"Todos os que a virem"},{"verse":"","text":"fugirão de você"},{"verse":"","text":"e dirão: ‘Nínive está destruída!’"},{"verse":"","text":"Quem terá compaixão dela?"},{"verse":"","text":"De onde buscarei"},{"verse":"","text":"quem a console?\""},{"verse":"8","text":"Será que você é melhor"},{"verse":"","text":"do que Tebas,"},{"verse":"","text":"que estava situada junto ao Nilo,"},{"verse":"","text":"cercada de águas,"},{"verse":"","text":"protegida pelo mar"},{"verse":"","text":"e tendo as águas por muralha?"},{"verse":"9","text":"A Etiópia e o Egito"},{"verse":"","text":"eram a sua força,"},{"verse":"","text":"força sem limites;"},{"verse":"","text":"Pute e Líbia eram seus aliados."},{"verse":"10","text":"Todavia, ela foi levada ao exílio,"},{"verse":"","text":"foi para o cativeiro."},{"verse":"","text":"Também os seus filhos"},{"verse":"","text":"foram despedaçados"},{"verse":"","text":"nas esquinas de todas as ruas."},{"verse":"","text":"Sobre os seus nobres"},{"verse":"","text":"lançaram sortes,"},{"verse":"","text":"e todos os seus grandes"},{"verse":"","text":"foram presos com correntes."},{"verse":"11","text":"Também você, Nínive,"},{"verse":"","text":"será embriagada e se esconderá."},{"verse":"","text":"Também você procurará"},{"verse":"","text":"um refúgio contra o inimigo."},{"verse":"12","text":"Todas as suas fortalezas"},{"verse":"","text":"são como figueiras"},{"verse":"","text":"com figos prematuros:"},{"verse":"","text":"é só sacudir a figueira,"},{"verse":"","text":"que os figos caem na boca"},{"verse":"","text":"de quem os há de comer."},{"verse":"13","text":"Eis que os seus soldados"},{"verse":"","text":"são como mulheres."},{"verse":"","text":"Os portões do seu país estão"},{"verse":"","text":"completamente abertos"},{"verse":"","text":"para os seus inimigos;"},{"verse":"","text":"o fogo destruiu as trancas."},{"verse":"14","text":"Tire água para o tempo do cerco,"},{"verse":"","text":"reforce as suas fortalezas,"},{"verse":"","text":"entre no lodo e pise o barro,"},{"verse":"","text":"pegue as formas para fazer tijolos."},{"verse":"15","text":"No entanto, você será"},{"verse":"","text":"consumida pelo fogo"},{"verse":"","text":"e exterminada pela espada"},{"verse":"","text":"como folhas devoradas"},{"verse":"","text":"pelos gafanhotos."},{"verse":"","text":"Multipliquem-se"},{"verse":"","text":"como os gafanhotos!"},{"verse":"","text":"Tornem-se tão numerosos como eles!"},{"verse":"16","text":"Os seus negociantes eram"},{"verse":"","text":"mais numerosos"},{"verse":"","text":"do que as estrelas do céu,"},{"verse":"","text":"mas como gafanhotos"},{"verse":"","text":"bateram asas e voaram."},{"verse":"17","text":"Os seus príncipes eram"},{"verse":"","text":"como gafanhotos,"},{"verse":"","text":"e os seus chefes,"},{"verse":"","text":"como gafanhotos grandes,"},{"verse":"","text":"que pousam nos muros"},{"verse":"","text":"em dias de frio;"},{"verse":"","text":"quando o sol aparece,"},{"verse":"","text":"voam embora,"},{"verse":"","text":"e não se sabe para onde vão."},{"verse":"18","text":"Os seus pastores dormem,"},{"verse":"","text":"ó rei da Assíria;"},{"verse":"","text":"os seus nobres cochilam."},{"verse":"","text":"O seu povo está espalhado"},{"verse":"","text":"pelos montes,"},{"verse":"","text":"e não há quem possa ajuntá-lo."},{"verse":"19","text":"Não há remédio para o seu mal;"},{"verse":"","text":"o seu ferimento é grave."},{"verse":"","text":"Todos os que ouvirem falar"},{"verse":"","text":"do que aconteceu com você"},{"verse":"","text":"baterão palmas."},{"verse":"","text":"Pois quem não foi vítima"},{"verse":"","text":"da sua crueldade sem fim?"}]]}