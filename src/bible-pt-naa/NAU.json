{"chapters":[{"chapter":1,"verses":[{"verse":1,"text":"Sentença contra Nínive. Livro da visão de Naum, da cidade de Elcos."},{"verse":2,"text":"A ira e a misericórdia de Deus"},{"verse":3,"text":"O"},{"verse":4,"text":"e vingador,"},{"verse":5,"text":"o"},{"verse":6,"text":"e cheio de ira;"},{"verse":7,"text":"o"},{"verse":8,"text":"contra os seus adversários"},{"verse":9,"text":"e reserva indignação"},{"verse":10,"text":"para os seus inimigos."},{"verse":11,"text":"O"},{"verse":12,"text":"mas grande em poder"},{"verse":13,"text":"e jamais inocenta o culpado."},{"verse":14,"text":"O"},{"verse":15,"text":"na tormenta e na tempestade,"},{"verse":16,"text":"e as nuvens são a poeira"},{"verse":17,"text":"dos seus pés."},{"verse":18,"text":"Repreende o mar, e ele seca;"},{"verse":19,"text":"faz com que todos os rios"},{"verse":20,"text":"fiquem secos."},{"verse":21,"text":"Basã e o Carmelo desfalecem,"},{"verse":22,"text":"e as flores do Líbano murcham."},{"verse":23,"text":"Os montes tremem diante dele,"},{"verse":24,"text":"e as colinas se derretem."},{"verse":25,"text":"A terra se levanta diante dele,"},{"verse":26,"text":"sim, o mundo"},{"verse":27,"text":"e todos os seus moradores."},{"verse":28,"text":"Quem pode suportar"},{"verse":29,"text":"a sua indignação?"},{"verse":30,"text":"E quem subsistirá diante do furor"},{"verse":31,"text":"da sua ira?"},{"verse":32,"text":"A sua cólera se derrama"},{"verse":33,"text":"como fogo,"},{"verse":34,"text":"e as rochas são por ele demolidas."},{"verse":35,"text":"O"},{"verse":36,"text":"é fortaleza no dia da angústia"},{"verse":37,"text":"e conhece os que nele se refugiam."},{"verse":38,"text":"Mas, com inundação"},{"verse":39,"text":"transbordante,"},{"verse":40,"text":"acabará de uma vez"},{"verse":41,"text":"com o lugar dessa cidade;"},{"verse":42,"text":"com trevas, o"},{"verse":43,"text":"os seus inimigos."},{"verse":44,"text":"O que é que vocês estão"},{"verse":45,"text":"planejando contra o"},{"verse":46,"text":"Ele mesmo os"},{"verse":47,"text":"consumirá completamente;"},{"verse":48,"text":"a angústia não se levantará"},{"verse":49,"text":"duas vezes!"},{"verse":50,"text":"Porque, ainda que eles"},{"verse":51,"text":"se entrelacem"},{"verse":52,"text":"como os espinhos"},{"verse":53,"text":"e se saturem de vinho"},{"verse":54,"text":"como bêbados,"},{"verse":55,"text":"serão inteiramente consumidos"},{"verse":56,"text":"como palha seca."},{"verse":57,"text":"De você, Nínive, saiu um"},{"verse":58,"text":"que planeja o mal contra o"},{"verse":59,"text":"alguém que aconselha a maldade."},{"verse":60,"text":"Assim diz o"},{"verse":61,"text":"\"Por mais seguros que estejam"},{"verse":62,"text":"e por mais numerosos que eles sejam,"},{"verse":63,"text":"ainda assim serão exterminados"},{"verse":64,"text":"e passarão."},{"verse":65,"text":"Meu povo, embora eu"},{"verse":66,"text":"o tenha afligido,"},{"verse":67,"text":"não o afligirei mais."},{"verse":68,"text":"Quebrarei o jugo deles"},{"verse":69,"text":"que pesa sobre você"},{"verse":70,"text":"e romperei os laços"},{"verse":71,"text":"que o prendem.\""},{"verse":72,"text":"Porém contra você, Assíria,"},{"verse":73,"text":"o"},{"verse":74,"text":"para que não haja posteridade"},{"verse":75,"text":"que leve o seu nome;"},{"verse":76,"text":"do templo dos seus deuses"},{"verse":77,"text":"exterminarei as imagens"},{"verse":78,"text":"de escultura"},{"verse":79,"text":"e de fundição."},{"verse":80,"text":"Farei a sua sepultura,"},{"verse":81,"text":"porque você é desprezível."},{"verse":82,"text":"Eis sobre os montes"},{"verse":83,"text":"os pés do que anuncia boas-novas,"},{"verse":84,"text":"do que anuncia a paz!"},{"verse":85,"text":"Celebre as suas festas, ó Judá,"},{"verse":86,"text":"cumpra os seus votos,"},{"verse":87,"text":"porque o ímpio"},{"verse":88,"text":"não mais passará por você;"},{"verse":89,"text":"ele foi inteiramente exterminado."}]},{"chapter":2,"verses":[{"verse":0,"text":"A queda de Nínive"},{"verse":1,"text":"O destruidor avança"},{"verse":2,"text":"contra você, Nínive!"},{"verse":3,"text":"Guarde a fortaleza,"},{"verse":4,"text":"vigie o caminho,"},{"verse":5,"text":"prepare-se para lutar,"},{"verse":6,"text":"reúna todas as suas forças!"},{"verse":7,"text":"Porque o"},{"verse":8,"text":"a glória de Jacó,"},{"verse":9,"text":"como a glória de Israel;"},{"verse":10,"text":"porque saqueadores os saquearam"},{"verse":11,"text":"e destruíram os seus ramos."},{"verse":12,"text":"Os escudos dos seus heróis"},{"verse":13,"text":"são vermelhos;"},{"verse":14,"text":"os homens valentes"},{"verse":15,"text":"vestem escarlate."},{"verse":16,"text":"Os carros de guerra"},{"verse":17,"text":"brilham como fogo"},{"verse":18,"text":"no dia da sua preparação,"},{"verse":19,"text":"e as lanças são agitadas."},{"verse":20,"text":"Os carros de guerra passam"},{"verse":21,"text":"furiosamente pelas ruas"},{"verse":22,"text":"e se cruzam velozes pelas praças;"},{"verse":23,"text":"parecem tochas,"},{"verse":24,"text":"correm como relâmpago."},{"verse":25,"text":"Os nobres são chamados,"},{"verse":26,"text":"mas tropeçam no seu caminho;"},{"verse":27,"text":"apressam-se para chegar à muralha"},{"verse":28,"text":"e preparam a defesa."},{"verse":29,"text":"As comportas dos rios se abrem,"},{"verse":30,"text":"e o palácio é destruído."},{"verse":31,"text":"Está decretado:"},{"verse":32,"text":"a cidade-rainha está despida,"},{"verse":33,"text":"levada em cativeiro;"},{"verse":34,"text":"as suas servas gemem"},{"verse":35,"text":"como pombas"},{"verse":36,"text":"e batem no peito."},{"verse":37,"text":"Nínive, desde que existe,"},{"verse":38,"text":"tem sido como um tanque de águas;"},{"verse":39,"text":"mas, agora, o seu povo foge."},{"verse":40,"text":"Alguém grita: \"Parem! Parem!\","},{"verse":41,"text":"mas ninguém se volta."},{"verse":42,"text":"Saqueiem a prata,"},{"verse":43,"text":"saqueiem o ouro,"},{"verse":44,"text":"porque os tesouros não têm fim;"},{"verse":45,"text":"a cidade está repleta de objetos de valor."},{"verse":46,"text":"Vazio, desolação, ruína!"},{"verse":47,"text":"O coração se derrete,"},{"verse":48,"text":"os joelhos tremem,"},{"verse":49,"text":"acabam-se as forças,"},{"verse":50,"text":"e o rosto de todos empalidece."},{"verse":51,"text":"Onde está, agora,"},{"verse":52,"text":"o covil dos leões"},{"verse":53,"text":"e o lugar onde os leõezinhos"},{"verse":54,"text":"se alimentavam,"},{"verse":55,"text":"onde passeavam o leão,"},{"verse":56,"text":"a leoa e o filhote do leão,"},{"verse":57,"text":"sem que ninguém os espantasse?"},{"verse":58,"text":"O leão arrebatava o bastante"},{"verse":59,"text":"para os seus filhotes,"},{"verse":60,"text":"estrangulava a presa"},{"verse":61,"text":"para as suas leoas,"},{"verse":62,"text":"e enchia de vítimas"},{"verse":63,"text":"as suas cavernas,"},{"verse":64,"text":"e os seus covis, de rapina."},{"verse":65,"text":"\"Eis que eu estou contra você\","},{"verse":66,"text":"diz o"},{"verse":67,"text":"\"queimarei os seus carros de guerra,"},{"verse":68,"text":"a espada devorará"},{"verse":69,"text":"os seus leõezinhos,"},{"verse":70,"text":"arrancarei da terra a sua presa,"},{"verse":71,"text":"e nunca mais se ouvirá a voz"},{"verse":72,"text":"dos seus embaixadores.\""}]},{"chapter":3,"verses":[{"verse":0,"text":"A ruína completa de Nínive"},{"verse":1,"text":"Ai da cidade sanguinária,"},{"verse":2,"text":"toda cheia de mentiras e de roubo"},{"verse":3,"text":"e que não solta a sua presa!"},{"verse":4,"text":"Eis o estalo dos açoites,"},{"verse":5,"text":"o estrondo das rodas,"},{"verse":6,"text":"o galope dos cavalos"},{"verse":7,"text":"e os carros que vão saltando!"},{"verse":8,"text":"Os cavaleiros que esporeiam,"},{"verse":9,"text":"as espadas brilhantes,"},{"verse":10,"text":"as lanças reluzentes,"},{"verse":11,"text":"uma multidão de feridos,"},{"verse":12,"text":"massa de cadáveres,"},{"verse":13,"text":"mortos sem fim"},{"verse":14,"text":"— chegam a tropeçar"},{"verse":15,"text":"sobre os mortos."},{"verse":16,"text":"Tudo isso por causa"},{"verse":17,"text":"da grande prostituição"},{"verse":18,"text":"da bela e encantadora prostituta,"},{"verse":19,"text":"da mestra de feitiçarias,"},{"verse":20,"text":"que seduzia as nações"},{"verse":21,"text":"com a sua prostituição"},{"verse":22,"text":"e os povos, com as suas feitiçarias."},{"verse":23,"text":"\"Eis que eu estou contra você\","},{"verse":24,"text":"diz o"},{"verse":25,"text":"\"Levantarei as abas de sua saia"},{"verse":26,"text":"sobre o seu rosto,"},{"verse":27,"text":"e mostrarei às nações a sua nudez,"},{"verse":28,"text":"e aos reinos, as suas vergonhas."},{"verse":29,"text":"Vou jogar sujeira sobre você,"},{"verse":30,"text":"tratá-la com desprezo"},{"verse":31,"text":"e transformá-la em espetáculo."},{"verse":32,"text":"Todos os que a virem"},{"verse":33,"text":"fugirão de você"},{"verse":34,"text":"e dirão: ‘Nínive está destruída!’"},{"verse":35,"text":"Quem terá compaixão dela?"},{"verse":36,"text":"De onde buscarei"},{"verse":37,"text":"quem a console?\""},{"verse":38,"text":"Será que você é melhor"},{"verse":39,"text":"do que Tebas,"},{"verse":40,"text":"que estava situada junto ao Nilo,"},{"verse":41,"text":"cercada de águas,"},{"verse":42,"text":"protegida pelo mar"},{"verse":43,"text":"e tendo as águas por muralha?"},{"verse":44,"text":"A Etiópia e o Egito"},{"verse":45,"text":"eram a sua força,"},{"verse":46,"text":"força sem limites;"},{"verse":47,"text":"Pute e Líbia eram seus aliados."},{"verse":48,"text":"Todavia, ela foi levada ao exílio,"},{"verse":49,"text":"foi para o cativeiro."},{"verse":50,"text":"Também os seus filhos"},{"verse":51,"text":"foram despedaçados"},{"verse":52,"text":"nas esquinas de todas as ruas."},{"verse":53,"text":"Sobre os seus nobres"},{"verse":54,"text":"lançaram sortes,"},{"verse":55,"text":"e todos os seus grandes"},{"verse":56,"text":"foram presos com correntes."},{"verse":57,"text":"Também você, Nínive,"},{"verse":58,"text":"será embriagada e se esconderá."},{"verse":59,"text":"Também você procurará"},{"verse":60,"text":"um refúgio contra o inimigo."},{"verse":61,"text":"Todas as suas fortalezas"},{"verse":62,"text":"são como figueiras"},{"verse":63,"text":"com figos prematuros:"},{"verse":64,"text":"é só sacudir a figueira,"},{"verse":65,"text":"que os figos caem na boca"},{"verse":66,"text":"de quem os há de comer."},{"verse":67,"text":"Eis que os seus soldados"},{"verse":68,"text":"são como mulheres."},{"verse":69,"text":"Os portões do seu país estão"},{"verse":70,"text":"completamente abertos"},{"verse":71,"text":"para os seus inimigos;"},{"verse":72,"text":"o fogo destruiu as trancas."},{"verse":73,"text":"Tire água para o tempo do cerco,"},{"verse":74,"text":"reforce as suas fortalezas,"},{"verse":75,"text":"entre no lodo e pise o barro,"},{"verse":76,"text":"pegue as formas para fazer tijolos."},{"verse":77,"text":"No entanto, você será"},{"verse":78,"text":"consumida pelo fogo"},{"verse":79,"text":"e exterminada pela espada"},{"verse":80,"text":"como folhas devoradas"},{"verse":81,"text":"pelos gafanhotos."},{"verse":82,"text":"Multipliquem-se"},{"verse":83,"text":"como os gafanhotos!"},{"verse":84,"text":"Tornem-se tão numerosos como eles!"},{"verse":85,"text":"Os seus negociantes eram"},{"verse":86,"text":"mais numerosos"},{"verse":87,"text":"do que as estrelas do céu,"},{"verse":88,"text":"mas como gafanhotos"},{"verse":89,"text":"bateram asas e voaram."},{"verse":90,"text":"Os seus príncipes eram"},{"verse":91,"text":"como gafanhotos,"},{"verse":92,"text":"e os seus chefes,"},{"verse":93,"text":"como gafanhotos grandes,"},{"verse":94,"text":"que pousam nos muros"},{"verse":95,"text":"em dias de frio;"},{"verse":96,"text":"quando o sol aparece,"},{"verse":97,"text":"voam embora,"},{"verse":98,"text":"e não se sabe para onde vão."},{"verse":99,"text":"Os seus pastores dormem,"},{"verse":100,"text":"ó rei da Assíria;"},{"verse":101,"text":"os seus nobres cochilam."},{"verse":102,"text":"O seu povo está espalhado"},{"verse":103,"text":"pelos montes,"},{"verse":104,"text":"e não há quem possa ajuntá-lo."},{"verse":105,"text":"Não há remédio para o seu mal;"},{"verse":106,"text":"o seu ferimento é grave."},{"verse":107,"text":"Todos os que ouvirem falar"},{"verse":108,"text":"do que aconteceu com você"},{"verse":109,"text":"baterão palmas."},{"verse":110,"text":"Pois quem não foi vítima"},{"verse":111,"text":"da sua crueldade sem fim?"}]}]}