{"chapters":[{"chapter":1,"verses":[{"verse":1,"text":"Sentença revelada ao profeta Habacuque."},{"verse":2,"text":"A queixa de Habacuque"},{"verse":3,"text":"Até quando,"},{"verse":4,"text":"clamarei pedindo ajuda,"},{"verse":5,"text":"e tu não me ouvirás?"},{"verse":6,"text":"Até quando gritarei:"},{"verse":7,"text":"\"Violência!\","},{"verse":8,"text":"e tu não salvarás?"},{"verse":9,"text":"Por que me fazes ver"},{"verse":10,"text":"a iniquidade?"},{"verse":11,"text":"Por que toleras a opressão?"},{"verse":12,"text":"Pois a destruição e a violência"},{"verse":13,"text":"estão diante de mim;"},{"verse":14,"text":"há litígios e surgem discórdias."},{"verse":15,"text":"Por isso, a lei se afrouxa"},{"verse":16,"text":"e a justiça nunca se manifesta."},{"verse":17,"text":"Porque os ímpios cercam os justos,"},{"verse":18,"text":"e assim a justiça é torcida."},{"verse":19,"text":"A resposta de Deus"},{"verse":20,"text":"\"Olhem entre as nações e vejam;"},{"verse":21,"text":"fiquem maravilhados e admirados."},{"verse":22,"text":"Porque, no tempo de vocês,"},{"verse":23,"text":"eu realizo obra tal"},{"verse":24,"text":"que vocês não acreditarão"},{"verse":25,"text":"se alguém lhes contar."},{"verse":26,"text":"Pois eis que trago os caldeus,"},{"verse":27,"text":"nação cruel e impetuosa,"},{"verse":28,"text":"que marcham pela largura da terra,"},{"verse":29,"text":"para apoderar-se de moradas"},{"verse":30,"text":"que não são suas."},{"verse":31,"text":"Eles são pavorosos e terríveis;"},{"verse":32,"text":"fazem as suas próprias leis"},{"verse":33,"text":"e impõem a sua dignidade."},{"verse":34,"text":"Os seus cavalos são mais ligeiros"},{"verse":35,"text":"do que os leopardos,"},{"verse":36,"text":"mais ferozes do que"},{"verse":37,"text":"os lobos ao anoitecer."},{"verse":38,"text":"Os seus cavaleiros se espalham"},{"verse":39,"text":"por toda parte;"},{"verse":40,"text":"sim, os seus cavaleiros"},{"verse":41,"text":"chegam de longe,"},{"verse":42,"text":"voam como a águia"},{"verse":43,"text":"que se precipita para devorar."},{"verse":44,"text":"Eles todos vêm"},{"verse":45,"text":"para fazer violência."},{"verse":46,"text":"Estão determinados"},{"verse":47,"text":"a seguir em frente."},{"verse":48,"text":"Reúnem os cativos"},{"verse":49,"text":"como se ajunta areia."},{"verse":50,"text":"Zombam dos reis;"},{"verse":51,"text":"os príncipes são motivo de riso"},{"verse":52,"text":"para eles."},{"verse":53,"text":"Riem de todas as fortalezas,"},{"verse":54,"text":"porque, amontoando terra,"},{"verse":55,"text":"as conquistam."},{"verse":56,"text":"Então passam"},{"verse":57,"text":"como passa o vento"},{"verse":58,"text":"e seguem adiante."},{"verse":59,"text":"Tornam-se culpados estes"},{"verse":60,"text":"cujo deus é a própria força.\""},{"verse":61,"text":"Habacuque se queixa de novo"},{"verse":62,"text":"Não és tu desde a eternidade,"},{"verse":63,"text":"ó"},{"verse":64,"text":"ó meu Santo?"},{"verse":65,"text":"Não morreremos."},{"verse":66,"text":"Ó"},{"verse":67,"text":"para executar juízo;"},{"verse":68,"text":"tu, ó Rocha, o estabeleceste"},{"verse":69,"text":"para servir de disciplina."},{"verse":70,"text":"Tu és tão puro de olhos,"},{"verse":71,"text":"que não podes suportar o mal"},{"verse":72,"text":"nem tolerar a opressão."},{"verse":73,"text":"Por que, então, toleras os traidores"},{"verse":74,"text":"e te calas quando"},{"verse":75,"text":"os perversos devoram"},{"verse":76,"text":"aqueles que são mais justos"},{"verse":77,"text":"do que eles?"},{"verse":78,"text":"Por que tratas as pessoas"},{"verse":79,"text":"como se fossem peixes do mar,"},{"verse":80,"text":"como se fossem animais que rastejam,"},{"verse":81,"text":"que não têm quem os governe?"},{"verse":82,"text":"O inimigo pesca todos"},{"verse":83,"text":"com o anzol,"},{"verse":84,"text":"apanha-os na sua rede"},{"verse":85,"text":"e os ajunta na sua"},{"verse":86,"text":"rede de arrastão;"},{"verse":87,"text":"então ele se alegra e fica contente."},{"verse":88,"text":"Por isso, ele oferece sacrifício"},{"verse":89,"text":"à sua rede"},{"verse":90,"text":"e queima incenso"},{"verse":91,"text":"à sua rede de arrastão,"},{"verse":92,"text":"pois é por meio delas"},{"verse":93,"text":"que aumentou as suas riquezas"},{"verse":94,"text":"e tem abundância de comida."},{"verse":95,"text":"Mas será que ele continuará"},{"verse":96,"text":"a esvaziar a sua rede?"},{"verse":97,"text":"Será que continuará a matar"},{"verse":98,"text":"os povos sem dó nem piedade?"}]},{"chapter":2,"verses":[{"verse":1,"text":"Estarei na minha torre de vigia,"},{"verse":2,"text":"ficarei na fortaleza"},{"verse":3,"text":"e vigiarei para ver"},{"verse":4,"text":"o que Deus me dirá"},{"verse":5,"text":"e que resposta eu terei"},{"verse":6,"text":"à minha queixa."},{"verse":7,"text":"Nova resposta de Deus"},{"verse":8,"text":"O"},{"verse":9,"text":"\"Escreva a visão,"},{"verse":10,"text":"torne-a bem legível sobre tábuas,"},{"verse":11,"text":"para que possa ser lida"},{"verse":12,"text":"até por quem passa correndo."},{"verse":13,"text":"Porque a visão ainda está"},{"verse":14,"text":"para se cumprir"},{"verse":15,"text":"no tempo determinado;"},{"verse":16,"text":"ela se apressa para o fim"},{"verse":17,"text":"e não falhará."},{"verse":18,"text":"Mesmo que pareça demorar,"},{"verse":19,"text":"espere,"},{"verse":20,"text":"porque certamente virá;"},{"verse":21,"text":"não tardará.\""},{"verse":22,"text":"\"Eis que a sua alma"},{"verse":23,"text":"está orgulhosa!"},{"verse":24,"text":"A sua alma não é reta nele;"},{"verse":25,"text":"mas o justo viverá pela sua fé."},{"verse":26,"text":"Assim como o vinho é enganoso,"},{"verse":27,"text":"também o arrogante"},{"verse":28,"text":"não se contém."},{"verse":29,"text":"O seu apetite é como a sepultura;"},{"verse":30,"text":"ele é como a morte,"},{"verse":31,"text":"que nunca se farta."},{"verse":32,"text":"Ele ajunta para si todas as nações"},{"verse":33,"text":"e congrega todos os povos.\""},{"verse":34,"text":"Cinco ais sobre os caldeus"},{"verse":35,"text":"Não é fato que todos esses povos proferirão contra ele um provérbio, um dito em tom de zombaria? Eles dirão:"},{"verse":36,"text":"Ai daquele que acumula"},{"verse":37,"text":"o que não é seu"},{"verse":38,"text":"— até quando? —,"},{"verse":39,"text":"e daquele que se enche"},{"verse":40,"text":"de coisas penhoradas!"},{"verse":41,"text":"Será que não se levantarão"},{"verse":42,"text":"de repente contra você"},{"verse":43,"text":"os seus credores?"},{"verse":44,"text":"E não despertarão aqueles"},{"verse":45,"text":"que farão você tremer?"},{"verse":46,"text":"Você lhes servirá de despojo."},{"verse":47,"text":"Visto que você despojou"},{"verse":48,"text":"muitas nações,"},{"verse":49,"text":"todos os povos que restaram"},{"verse":50,"text":"virão despojá-lo."},{"verse":51,"text":"Porque você derramou"},{"verse":52,"text":"muito sangue"},{"verse":53,"text":"e cometeu violência contra a terra,"},{"verse":54,"text":"contra as cidades"},{"verse":55,"text":"e contra todos os seus moradores."},{"verse":56,"text":"Ai daquele que ajunta"},{"verse":57,"text":"em sua casa"},{"verse":58,"text":"bens mal-adquiridos,"},{"verse":59,"text":"para pôr o seu ninho"},{"verse":60,"text":"num lugar bem alto,"},{"verse":61,"text":"a fim de livrar-se"},{"verse":62,"text":"das garras do mal!"},{"verse":63,"text":"Os seus planos resultarão"},{"verse":64,"text":"em vergonha para a sua casa."},{"verse":65,"text":"Ao destruir muitos povos,"},{"verse":66,"text":"você pecou contra a sua própria vida."},{"verse":67,"text":"Porque as pedras das paredes"},{"verse":68,"text":"clamarão contra você,"},{"verse":69,"text":"e as vigas do madeiramento"},{"verse":70,"text":"farão eco."},{"verse":71,"text":"Ai daquele que edifica"},{"verse":72,"text":"uma cidade com sangue"},{"verse":73,"text":"e a fundamenta na iniquidade!"},{"verse":74,"text":"Será que não é a vontade"},{"verse":75,"text":"do"},{"verse":76,"text":"que os povos trabalhem"},{"verse":77,"text":"para o fogo"},{"verse":78,"text":"e que as nações se fatiguem"},{"verse":79,"text":"em vão?"},{"verse":80,"text":"Porque a terra se encherá"},{"verse":81,"text":"do conhecimento"},{"verse":82,"text":"da glória do"},{"verse":83,"text":"como as águas cobrem o mar."},{"verse":84,"text":"Ai daquele que dá"},{"verse":85,"text":"ao seu companheiro"},{"verse":86,"text":"vinho misturado com o seu furor,"},{"verse":87,"text":"e que o embebeda"},{"verse":88,"text":"para lhe contemplar a nudez!"},{"verse":89,"text":"Você ficará coberto de vergonha"},{"verse":90,"text":"em vez de honra."},{"verse":91,"text":"Beba você também"},{"verse":92,"text":"e mostre a sua incircuncisão!"},{"verse":93,"text":"Chegará a sua vez de pegar o cálice"},{"verse":94,"text":"da mão direita do"},{"verse":95,"text":"e a sua glória se transformará"},{"verse":96,"text":"em vergonha."},{"verse":97,"text":"Porque a violência"},{"verse":98,"text":"contra o Líbano"},{"verse":99,"text":"cairá sobre você,"},{"verse":100,"text":"e você ficará apavorado"},{"verse":101,"text":"por ter destruído os animais."},{"verse":102,"text":"Porque você derramou"},{"verse":103,"text":"muito sangue"},{"verse":104,"text":"e cometeu violência contra a terra,"},{"verse":105,"text":"contra as cidades"},{"verse":106,"text":"e contra todos os seus moradores."},{"verse":107,"text":"Para que serve o ídolo,"},{"verse":108,"text":"visto que o seu artífice o esculpiu?"},{"verse":109,"text":"E de que serve a"},{"verse":110,"text":"imagem de fundição,"},{"verse":111,"text":"mestra de mentiras,"},{"verse":112,"text":"para que o artífice"},{"verse":113,"text":"confie na sua obra,"},{"verse":114,"text":"fazendo ídolos mudos?"},{"verse":115,"text":"Ai daquele que diz à madeira:"},{"verse":116,"text":"\"Acorde!\""},{"verse":117,"text":"E à pedra muda: \"Levante-se!\""},{"verse":118,"text":"Pode o ídolo ensinar?"},{"verse":119,"text":"Eis que está coberto de ouro"},{"verse":120,"text":"e de prata,"},{"verse":121,"text":"mas, no seu interior,"},{"verse":122,"text":"não há fôlego nenhum."},{"verse":123,"text":"O"},{"verse":124,"text":"está no seu santo templo;"},{"verse":125,"text":"cale-se diante dele toda a terra."}]},{"chapter":3,"verses":[{"verse":0,"text":"A oração de Habacuque"},{"verse":1,"text":"Oração do profeta Habacuque sob a forma de canto."},{"verse":2,"text":"Senhor"},{"verse":3,"text":"e me sinto alarmado."},{"verse":4,"text":"Aviva a tua obra, ó"},{"verse":5,"text":"no decorrer dos anos,"},{"verse":6,"text":"e, no decurso dos anos,"},{"verse":7,"text":"faze-a conhecida."},{"verse":8,"text":"Na tua ira, lembra-te"},{"verse":9,"text":"da misericórdia."},{"verse":10,"text":"Deus vem de Temã,"},{"verse":11,"text":"o Santo vem do monte Parã."},{"verse":12,"text":"A sua glória cobre os céus,"},{"verse":13,"text":"e a terra se enche do seu louvor."},{"verse":14,"text":"O seu resplendor é como a luz,"},{"verse":15,"text":"e raios brilham da sua mão;"},{"verse":16,"text":"o seu poder se esconde ali."},{"verse":17,"text":"Adiante dele vai a peste,"},{"verse":18,"text":"e a pestilência"},{"verse":19,"text":"segue os seus passos."},{"verse":20,"text":"Ele para e faz a terra tremer;"},{"verse":21,"text":"olha e sacode as nações."},{"verse":22,"text":"Esmigalham-se"},{"verse":23,"text":"os montes primitivos;"},{"verse":24,"text":"as colinas antigas se abatem."},{"verse":25,"text":"Os caminhos de Deus são eternos."},{"verse":26,"text":"Vejo as tendas de Cusã"},{"verse":27,"text":"em aflição;"},{"verse":28,"text":"os acampamentos"},{"verse":29,"text":"da terra de Midiã tremem."},{"verse":30,"text":"Acaso é contra os rios,"},{"verse":31,"text":"que estás irado?"},{"verse":32,"text":"É contra os ribeiros a tua ira"},{"verse":33,"text":"ou contra o mar, o teu furor,"},{"verse":34,"text":"já que andas montado"},{"verse":35,"text":"nos teus cavalos,"},{"verse":36,"text":"nos teus carros de vitória?"},{"verse":37,"text":"Preparas o teu arco;"},{"verse":38,"text":"a tua aljava está cheia de flechas."},{"verse":39,"text":"Tu fendes a terra com rios."},{"verse":40,"text":"Os montes te veem"},{"verse":41,"text":"e se contorcem;"},{"verse":42,"text":"torrentes de água passam."},{"verse":43,"text":"As profundezas do mar"},{"verse":44,"text":"fazem ouvir a sua voz"},{"verse":45,"text":"e levantam bem alto as suas mãos."},{"verse":46,"text":"O sol e a lua param"},{"verse":47,"text":"nas suas moradas,"},{"verse":48,"text":"ao resplandecer a luz"},{"verse":49,"text":"das tuas flechas sibilantes,"},{"verse":50,"text":"ao fulgor do relâmpago"},{"verse":51,"text":"da tua lança."},{"verse":52,"text":"Na tua indignação,"},{"verse":53,"text":"marchas pela terra;"},{"verse":54,"text":"na tua ira, pisas as nações."},{"verse":55,"text":"Tu sais para salvar o teu povo,"},{"verse":56,"text":"para salvar o teu ungido."},{"verse":57,"text":"Feres o chefe da casa dos ímpios,"},{"verse":58,"text":"deixando-o descoberto"},{"verse":59,"text":"dos pés à cabeça."},{"verse":60,"text":"Traspassas a cabeça"},{"verse":61,"text":"dos guerreiros do inimigo"},{"verse":62,"text":"com as suas próprias lanças,"},{"verse":63,"text":"os quais, como tempestade,"},{"verse":64,"text":"avançam para me destruir;"},{"verse":65,"text":"alegram-se, como se estivessem"},{"verse":66,"text":"para devorar o pobre"},{"verse":67,"text":"em segredo."},{"verse":68,"text":"Marchas com os teus cavalos"},{"verse":69,"text":"pelo mar,"},{"verse":70,"text":"pela massa de grandes águas."},{"verse":71,"text":"Ouvi isso, e o meu íntimo"},{"verse":72,"text":"se comoveu;"},{"verse":73,"text":"os meus lábios tremeram"},{"verse":74,"text":"ao ouvir a sua voz."},{"verse":75,"text":"A podridão entrou nos meus ossos,"},{"verse":76,"text":"e os meus joelhos vacilaram,"},{"verse":77,"text":"pois, em silêncio, devo esperar"},{"verse":78,"text":"o dia da angústia,"},{"verse":79,"text":"que virá contra o povo"},{"verse":80,"text":"que nos ataca."},{"verse":81,"text":"Ainda que a figueira"},{"verse":82,"text":"não floresça,"},{"verse":83,"text":"nem haja fruto na videira;"},{"verse":84,"text":"ainda que a colheita da oliveira"},{"verse":85,"text":"decepcione,"},{"verse":86,"text":"e os campos não produzam"},{"verse":87,"text":"mantimento;"},{"verse":88,"text":"ainda que as ovelhas"},{"verse":89,"text":"desapareçam do aprisco,"},{"verse":90,"text":"e nos currais não haja mais gado,"},{"verse":91,"text":"mesmo assim"},{"verse":92,"text":"eu me alegro no"},{"verse":93,"text":"e exulto no Deus"},{"verse":94,"text":"da minha salvação."},{"verse":95,"text":"O"},{"verse":96,"text":"é a minha fortaleza."},{"verse":97,"text":"Ele dá aos meus pés"},{"verse":98,"text":"a ligeireza das corças,"},{"verse":99,"text":"e me faz andar"},{"verse":100,"text":"nas minhas alturas."},{"verse":101,"text":"Ao mestre de canto. Para instrumentos de cordas."}]}]}