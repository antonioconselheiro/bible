{"chapters":[[{"verse":"1","text":"Sentença revelada ao profeta Habacuque."},{"verse":"","text":"A queixa de Habacuque"},{"verse":"2","text":"Até quando,"},{"verse":"","text":"clamarei pedindo ajuda,"},{"verse":"","text":"e tu não me ouvirás?"},{"verse":"","text":"Até quando gritarei:"},{"verse":"","text":"\"Violência!\","},{"verse":"","text":"e tu não salvarás?"},{"verse":"3","text":"Por que me fazes ver"},{"verse":"","text":"a iniquidade?"},{"verse":"","text":"Por que toleras a opressão?"},{"verse":"","text":"Pois a destruição e a violência"},{"verse":"","text":"estão diante de mim;"},{"verse":"","text":"há litígios e surgem discórdias."},{"verse":"4","text":"Por isso, a lei se afrouxa"},{"verse":"","text":"e a justiça nunca se manifesta."},{"verse":"","text":"Porque os ímpios cercam os justos,"},{"verse":"","text":"e assim a justiça é torcida."},{"verse":"","text":"A resposta de Deus"},{"verse":"5","text":"\"Olhem entre as nações e vejam;"},{"verse":"","text":"fiquem maravilhados e admirados."},{"verse":"","text":"Porque, no tempo de vocês,"},{"verse":"","text":"eu realizo obra tal"},{"verse":"","text":"que vocês não acreditarão"},{"verse":"","text":"se alguém lhes contar."},{"verse":"6","text":"Pois eis que trago os caldeus,"},{"verse":"","text":"nação cruel e impetuosa,"},{"verse":"","text":"que marcham pela largura da terra,"},{"verse":"","text":"para apoderar-se de moradas"},{"verse":"","text":"que não são suas."},{"verse":"7","text":"Eles são pavorosos e terríveis;"},{"verse":"","text":"fazem as suas próprias leis"},{"verse":"","text":"e impõem a sua dignidade."},{"verse":"8","text":"Os seus cavalos são mais ligeiros"},{"verse":"","text":"do que os leopardos,"},{"verse":"","text":"mais ferozes do que"},{"verse":"","text":"os lobos ao anoitecer."},{"verse":"","text":"Os seus cavaleiros se espalham"},{"verse":"","text":"por toda parte;"},{"verse":"","text":"sim, os seus cavaleiros"},{"verse":"","text":"chegam de longe,"},{"verse":"","text":"voam como a águia"},{"verse":"","text":"que se precipita para devorar."},{"verse":"9","text":"Eles todos vêm"},{"verse":"","text":"para fazer violência."},{"verse":"","text":"Estão determinados"},{"verse":"","text":"a seguir em frente."},{"verse":"","text":"Reúnem os cativos"},{"verse":"","text":"como se ajunta areia."},{"verse":"10","text":"Zombam dos reis;"},{"verse":"","text":"os príncipes são motivo de riso"},{"verse":"","text":"para eles."},{"verse":"","text":"Riem de todas as fortalezas,"},{"verse":"","text":"porque, amontoando terra,"},{"verse":"","text":"as conquistam."},{"verse":"11","text":"Então passam"},{"verse":"","text":"como passa o vento"},{"verse":"","text":"e seguem adiante."},{"verse":"","text":"Tornam-se culpados estes"},{"verse":"","text":"cujo deus é a própria força.\""},{"verse":"","text":"Habacuque se queixa de novo"},{"verse":"12","text":"Não és tu desde a eternidade,"},{"verse":"","text":"ó"},{"verse":"","text":"ó meu Santo?"},{"verse":"","text":"Não morreremos."},{"verse":"","text":"Ó"},{"verse":"","text":"para executar juízo;"},{"verse":"","text":"tu, ó Rocha, o estabeleceste"},{"verse":"","text":"para servir de disciplina."},{"verse":"13","text":"Tu és tão puro de olhos,"},{"verse":"","text":"que não podes suportar o mal"},{"verse":"","text":"nem tolerar a opressão."},{"verse":"","text":"Por que, então, toleras os traidores"},{"verse":"","text":"e te calas quando"},{"verse":"","text":"os perversos devoram"},{"verse":"","text":"aqueles que são mais justos"},{"verse":"","text":"do que eles?"},{"verse":"14","text":"Por que tratas as pessoas"},{"verse":"","text":"como se fossem peixes do mar,"},{"verse":"","text":"como se fossem animais que rastejam,"},{"verse":"","text":"que não têm quem os governe?"},{"verse":"15","text":"O inimigo pesca todos"},{"verse":"","text":"com o anzol,"},{"verse":"","text":"apanha-os na sua rede"},{"verse":"","text":"e os ajunta na sua"},{"verse":"","text":"rede de arrastão;"},{"verse":"","text":"então ele se alegra e fica contente."},{"verse":"16","text":"Por isso, ele oferece sacrifício"},{"verse":"","text":"à sua rede"},{"verse":"","text":"e queima incenso"},{"verse":"","text":"à sua rede de arrastão,"},{"verse":"","text":"pois é por meio delas"},{"verse":"","text":"que aumentou as suas riquezas"},{"verse":"","text":"e tem abundância de comida."},{"verse":"17","text":"Mas será que ele continuará"},{"verse":"","text":"a esvaziar a sua rede?"},{"verse":"","text":"Será que continuará a matar"},{"verse":"","text":"os povos sem dó nem piedade?"}],[{"verse":"1","text":"Estarei na minha torre de vigia,"},{"verse":"","text":"ficarei na fortaleza"},{"verse":"","text":"e vigiarei para ver"},{"verse":"","text":"o que Deus me dirá"},{"verse":"","text":"e que resposta eu terei"},{"verse":"","text":"à minha queixa."},{"verse":"","text":"Nova resposta de Deus"},{"verse":"2","text":"O"},{"verse":"","text":"\"Escreva a visão,"},{"verse":"","text":"torne-a bem legível sobre tábuas,"},{"verse":"","text":"para que possa ser lida"},{"verse":"","text":"até por quem passa correndo."},{"verse":"3","text":"Porque a visão ainda está"},{"verse":"","text":"para se cumprir"},{"verse":"","text":"no tempo determinado;"},{"verse":"","text":"ela se apressa para o fim"},{"verse":"","text":"e não falhará."},{"verse":"","text":"Mesmo que pareça demorar,"},{"verse":"","text":"espere,"},{"verse":"","text":"porque certamente virá;"},{"verse":"","text":"não tardará.\""},{"verse":"4","text":"\"Eis que a sua alma"},{"verse":"","text":"está orgulhosa!"},{"verse":"","text":"A sua alma não é reta nele;"},{"verse":"","text":"mas o justo viverá pela sua fé."},{"verse":"5","text":"Assim como o vinho é enganoso,"},{"verse":"","text":"também o arrogante"},{"verse":"","text":"não se contém."},{"verse":"","text":"O seu apetite é como a sepultura;"},{"verse":"","text":"ele é como a morte,"},{"verse":"","text":"que nunca se farta."},{"verse":"","text":"Ele ajunta para si todas as nações"},{"verse":"","text":"e congrega todos os povos.\""},{"verse":"","text":"Cinco ais sobre os caldeus"},{"verse":"6","text":"Não é fato que todos esses povos proferirão contra ele um provérbio, um dito em tom de zombaria? Eles dirão:"},{"verse":"","text":"Ai daquele que acumula"},{"verse":"","text":"o que não é seu"},{"verse":"","text":"— até quando? —,"},{"verse":"","text":"e daquele que se enche"},{"verse":"","text":"de coisas penhoradas!"},{"verse":"7","text":"Será que não se levantarão"},{"verse":"","text":"de repente contra você"},{"verse":"","text":"os seus credores?"},{"verse":"","text":"E não despertarão aqueles"},{"verse":"","text":"que farão você tremer?"},{"verse":"","text":"Você lhes servirá de despojo."},{"verse":"8","text":"Visto que você despojou"},{"verse":"","text":"muitas nações,"},{"verse":"","text":"todos os povos que restaram"},{"verse":"","text":"virão despojá-lo."},{"verse":"","text":"Porque você derramou"},{"verse":"","text":"muito sangue"},{"verse":"","text":"e cometeu violência contra a terra,"},{"verse":"","text":"contra as cidades"},{"verse":"","text":"e contra todos os seus moradores."},{"verse":"9","text":"Ai daquele que ajunta"},{"verse":"","text":"em sua casa"},{"verse":"","text":"bens mal-adquiridos,"},{"verse":"","text":"para pôr o seu ninho"},{"verse":"","text":"num lugar bem alto,"},{"verse":"","text":"a fim de livrar-se"},{"verse":"","text":"das garras do mal!"},{"verse":"10","text":"Os seus planos resultarão"},{"verse":"","text":"em vergonha para a sua casa."},{"verse":"","text":"Ao destruir muitos povos,"},{"verse":"","text":"você pecou contra a sua própria vida."},{"verse":"11","text":"Porque as pedras das paredes"},{"verse":"","text":"clamarão contra você,"},{"verse":"","text":"e as vigas do madeiramento"},{"verse":"","text":"farão eco."},{"verse":"12","text":"Ai daquele que edifica"},{"verse":"","text":"uma cidade com sangue"},{"verse":"","text":"e a fundamenta na iniquidade!"},{"verse":"13","text":"Será que não é a vontade"},{"verse":"","text":"do"},{"verse":"","text":"que os povos trabalhem"},{"verse":"","text":"para o fogo"},{"verse":"","text":"e que as nações se fatiguem"},{"verse":"","text":"em vão?"},{"verse":"14","text":"Porque a terra se encherá"},{"verse":"","text":"do conhecimento"},{"verse":"","text":"da glória do"},{"verse":"","text":"como as águas cobrem o mar."},{"verse":"15","text":"Ai daquele que dá"},{"verse":"","text":"ao seu companheiro"},{"verse":"","text":"vinho misturado com o seu furor,"},{"verse":"","text":"e que o embebeda"},{"verse":"","text":"para lhe contemplar a nudez!"},{"verse":"16","text":"Você ficará coberto de vergonha"},{"verse":"","text":"em vez de honra."},{"verse":"","text":"Beba você também"},{"verse":"","text":"e mostre a sua incircuncisão!"},{"verse":"","text":"Chegará a sua vez de pegar o cálice"},{"verse":"","text":"da mão direita do"},{"verse":"","text":"e a sua glória se transformará"},{"verse":"","text":"em vergonha."},{"verse":"17","text":"Porque a violência"},{"verse":"","text":"contra o Líbano"},{"verse":"","text":"cairá sobre você,"},{"verse":"","text":"e você ficará apavorado"},{"verse":"","text":"por ter destruído os animais."},{"verse":"","text":"Porque você derramou"},{"verse":"","text":"muito sangue"},{"verse":"","text":"e cometeu violência contra a terra,"},{"verse":"","text":"contra as cidades"},{"verse":"","text":"e contra todos os seus moradores."},{"verse":"18","text":"Para que serve o ídolo,"},{"verse":"","text":"visto que o seu artífice o esculpiu?"},{"verse":"","text":"E de que serve a"},{"verse":"","text":"imagem de fundição,"},{"verse":"","text":"mestra de mentiras,"},{"verse":"","text":"para que o artífice"},{"verse":"","text":"confie na sua obra,"},{"verse":"","text":"fazendo ídolos mudos?"},{"verse":"19","text":"Ai daquele que diz à madeira:"},{"verse":"","text":"\"Acorde!\""},{"verse":"","text":"E à pedra muda: \"Levante-se!\""},{"verse":"","text":"Pode o ídolo ensinar?"},{"verse":"","text":"Eis que está coberto de ouro"},{"verse":"","text":"e de prata,"},{"verse":"","text":"mas, no seu interior,"},{"verse":"","text":"não há fôlego nenhum."},{"verse":"20","text":"O"},{"verse":"","text":"está no seu santo templo;"},{"verse":"","text":"cale-se diante dele toda a terra."}],[{"verse":"","text":"A oração de Habacuque"},{"verse":"1","text":"Oração do profeta Habacuque sob a forma de canto."},{"verse":"2","text":"Senhor"},{"verse":"","text":"e me sinto alarmado."},{"verse":"","text":"Aviva a tua obra, ó"},{"verse":"","text":"no decorrer dos anos,"},{"verse":"","text":"e, no decurso dos anos,"},{"verse":"","text":"faze-a conhecida."},{"verse":"","text":"Na tua ira, lembra-te"},{"verse":"","text":"da misericórdia."},{"verse":"3","text":"Deus vem de Temã,"},{"verse":"","text":"o Santo vem do monte Parã."},{"verse":"","text":"A sua glória cobre os céus,"},{"verse":"","text":"e a terra se enche do seu louvor."},{"verse":"4","text":"O seu resplendor é como a luz,"},{"verse":"","text":"e raios brilham da sua mão;"},{"verse":"","text":"o seu poder se esconde ali."},{"verse":"5","text":"Adiante dele vai a peste,"},{"verse":"","text":"e a pestilência"},{"verse":"","text":"segue os seus passos."},{"verse":"6","text":"Ele para e faz a terra tremer;"},{"verse":"","text":"olha e sacode as nações."},{"verse":"","text":"Esmigalham-se"},{"verse":"","text":"os montes primitivos;"},{"verse":"","text":"as colinas antigas se abatem."},{"verse":"","text":"Os caminhos de Deus são eternos."},{"verse":"7","text":"Vejo as tendas de Cusã"},{"verse":"","text":"em aflição;"},{"verse":"","text":"os acampamentos"},{"verse":"","text":"da terra de Midiã tremem."},{"verse":"8","text":"Acaso é contra os rios,"},{"verse":"","text":"que estás irado?"},{"verse":"","text":"É contra os ribeiros a tua ira"},{"verse":"","text":"ou contra o mar, o teu furor,"},{"verse":"","text":"já que andas montado"},{"verse":"","text":"nos teus cavalos,"},{"verse":"","text":"nos teus carros de vitória?"},{"verse":"9","text":"Preparas o teu arco;"},{"verse":"","text":"a tua aljava está cheia de flechas."},{"verse":"","text":"Tu fendes a terra com rios."},{"verse":"10","text":"Os montes te veem"},{"verse":"","text":"e se contorcem;"},{"verse":"","text":"torrentes de água passam."},{"verse":"","text":"As profundezas do mar"},{"verse":"","text":"fazem ouvir a sua voz"},{"verse":"","text":"e levantam bem alto as suas mãos."},{"verse":"11","text":"O sol e a lua param"},{"verse":"","text":"nas suas moradas,"},{"verse":"","text":"ao resplandecer a luz"},{"verse":"","text":"das tuas flechas sibilantes,"},{"verse":"","text":"ao fulgor do relâmpago"},{"verse":"","text":"da tua lança."},{"verse":"12","text":"Na tua indignação,"},{"verse":"","text":"marchas pela terra;"},{"verse":"","text":"na tua ira, pisas as nações."},{"verse":"13","text":"Tu sais para salvar o teu povo,"},{"verse":"","text":"para salvar o teu ungido."},{"verse":"","text":"Feres o chefe da casa dos ímpios,"},{"verse":"","text":"deixando-o descoberto"},{"verse":"","text":"dos pés à cabeça."},{"verse":"14","text":"Traspassas a cabeça"},{"verse":"","text":"dos guerreiros do inimigo"},{"verse":"","text":"com as suas próprias lanças,"},{"verse":"","text":"os quais, como tempestade,"},{"verse":"","text":"avançam para me destruir;"},{"verse":"","text":"alegram-se, como se estivessem"},{"verse":"","text":"para devorar o pobre"},{"verse":"","text":"em segredo."},{"verse":"15","text":"Marchas com os teus cavalos"},{"verse":"","text":"pelo mar,"},{"verse":"","text":"pela massa de grandes águas."},{"verse":"16","text":"Ouvi isso, e o meu íntimo"},{"verse":"","text":"se comoveu;"},{"verse":"","text":"os meus lábios tremeram"},{"verse":"","text":"ao ouvir a sua voz."},{"verse":"","text":"A podridão entrou nos meus ossos,"},{"verse":"","text":"e os meus joelhos vacilaram,"},{"verse":"","text":"pois, em silêncio, devo esperar"},{"verse":"","text":"o dia da angústia,"},{"verse":"","text":"que virá contra o povo"},{"verse":"","text":"que nos ataca."},{"verse":"17","text":"Ainda que a figueira"},{"verse":"","text":"não floresça,"},{"verse":"","text":"nem haja fruto na videira;"},{"verse":"","text":"ainda que a colheita da oliveira"},{"verse":"","text":"decepcione,"},{"verse":"","text":"e os campos não produzam"},{"verse":"","text":"mantimento;"},{"verse":"","text":"ainda que as ovelhas"},{"verse":"","text":"desapareçam do aprisco,"},{"verse":"","text":"e nos currais não haja mais gado,"},{"verse":"18","text":"mesmo assim"},{"verse":"","text":"eu me alegro no"},{"verse":"","text":"e exulto no Deus"},{"verse":"","text":"da minha salvação."},{"verse":"19","text":"O"},{"verse":"","text":"é a minha fortaleza."},{"verse":"","text":"Ele dá aos meus pés"},{"verse":"","text":"a ligeireza das corças,"},{"verse":"","text":"e me faz andar"},{"verse":"","text":"nas minhas alturas."},{"verse":"","text":"Ao mestre de canto. Para instrumentos de cordas."}]]}