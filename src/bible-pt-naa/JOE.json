{"chapters":[[{"verse":"1","text":"Palavra do"},{"verse":"","text":"A praga de gafanhotos e a seca"},{"verse":"2","text":"\"Prestem atenção, velhos,"},{"verse":"","text":"e escutem, todos os moradores"},{"verse":"","text":"da terra!"},{"verse":"","text":"Aconteceu algo assim"},{"verse":"","text":"no tempo de vocês"},{"verse":"","text":"ou nos dias de seus pais?"},{"verse":"3","text":"Contem isto aos filhos de vocês;"},{"verse":"","text":"que eles o contem aos filhos deles,"},{"verse":"","text":"e que estes falem sobre isso"},{"verse":"","text":"à geração seguinte.\""},{"verse":"4","text":"\"O que o gafanhoto cortador"},{"verse":"","text":"deixou,"},{"verse":"","text":"o gafanhoto migrador comeu;"},{"verse":"","text":"o que o migrador deixou,"},{"verse":"","text":"o gafanhoto devorador comeu;"},{"verse":"","text":"o que o devorador deixou,"},{"verse":"","text":"o gafanhoto destruidor comeu.\""},{"verse":"5","text":"\"Acordem, beberrões, e chorem!"},{"verse":"","text":"Lamentem, todos vocês"},{"verse":"","text":"que gostam de vinho,"},{"verse":"","text":"por causa do vinho novo,"},{"verse":"","text":"pois foi tirado da boca de vocês."},{"verse":"6","text":"Porque veio um povo"},{"verse":"","text":"contra a minha terra,"},{"verse":"","text":"poderoso e inumerável,"},{"verse":"","text":"com dentes como de leão"},{"verse":"","text":"e presas como de leoa."},{"verse":"7","text":"Destruiu as minhas videiras"},{"verse":"","text":"e destroçou as minhas figueiras."},{"verse":"","text":"Tirou as cascas das árvores"},{"verse":"","text":"e as jogou fora;"},{"verse":"","text":"os galhos ficaram brancos.\""},{"verse":"8","text":"\"Lamentem,"},{"verse":"","text":"assim como a virgem,"},{"verse":"","text":"vestida de roupa feita"},{"verse":"","text":"de pano de saco,"},{"verse":"","text":"lamenta a morte do seu noivo."},{"verse":"9","text":"Na Casa do"},{"verse":"","text":"foram cortadas"},{"verse":"","text":"as ofertas de cereais"},{"verse":"","text":"e as libações."},{"verse":"","text":"Os sacerdotes,"},{"verse":"","text":"ministros do"},{"verse":"","text":"estão enlutados."},{"verse":"10","text":"Os campos foram arrasados,"},{"verse":"","text":"e a terra está de luto,"},{"verse":"","text":"porque o cereal foi destruído,"},{"verse":"","text":"o vinho novo acabou,"},{"verse":"","text":"o azeite está no fim.\""},{"verse":"11","text":"\"Fiquem envergonhados,"},{"verse":"","text":"lavradores;"},{"verse":"","text":"lamentem, vinhateiros,"},{"verse":"","text":"por causa do trigo e da cevada,"},{"verse":"","text":"porque a colheita foi destruída."},{"verse":"12","text":"As videiras secaram,"},{"verse":"","text":"as figueiras murcharam,"},{"verse":"","text":"as romãzeiras, as palmeiras"},{"verse":"","text":"e as macieiras também."},{"verse":"","text":"Todas as árvores do campo"},{"verse":"","text":"secaram,"},{"verse":"","text":"e já não há alegria"},{"verse":"","text":"entre os filhos dos homens.\""},{"verse":"","text":"Chamado ao arrependimento"},{"verse":"13","text":"\"Sacerdotes, vistam roupa"},{"verse":"","text":"feita de pano de saco"},{"verse":"","text":"e pranteiem."},{"verse":"","text":"Ministros do altar, lamentem."},{"verse":"","text":"Ministros do meu Deus, venham"},{"verse":"","text":"e passem a noite vestidos"},{"verse":"","text":"de panos de saco."},{"verse":"","text":"Porque no templo de seu Deus"},{"verse":"","text":"não há mais ofertas de cereais"},{"verse":"","text":"e libações."},{"verse":"14","text":"Proclamem um santo jejum,"},{"verse":"","text":"convoquem uma reunião solene."},{"verse":"","text":"Reúnam os anciãos"},{"verse":"","text":"e todos os moradores"},{"verse":"","text":"desta terra"},{"verse":"","text":"na Casa do"},{"verse":"","text":"e clamem ao"},{"verse":"15","text":"\"Ah! Que dia!"},{"verse":"","text":"Porque o Dia do"},{"verse":"","text":"e ele vem como destruição"},{"verse":"","text":"da parte do Todo-Poderoso.\""},{"verse":"16","text":"Por acaso, o alimento"},{"verse":"","text":"não foi destruído"},{"verse":"","text":"diante dos nossos olhos?"},{"verse":"","text":"E, do templo do nosso Deus,"},{"verse":"","text":"não desapareceram"},{"verse":"","text":"a alegria e o regozijo?"},{"verse":"17","text":"As sementes secaram"},{"verse":"","text":"debaixo dos seus torrões;"},{"verse":"","text":"os celeiros foram destruídos,"},{"verse":"","text":"os armazéns, derrubados,"},{"verse":"","text":"porque o cereal se perdeu."},{"verse":"18","text":"Como geme o gado!"},{"verse":"","text":"As manadas de bois"},{"verse":"","text":"estão inquietas,"},{"verse":"","text":"porque não têm pasto;"},{"verse":"","text":"também os rebanhos de ovelhas"},{"verse":"","text":"estão sofrendo."},{"verse":"19","text":"A ti, ó"},{"verse":"","text":"porque o fogo devorou"},{"verse":"","text":"as pastagens,"},{"verse":"","text":"e as chamas consumiram"},{"verse":"","text":"todas as árvores do campo."},{"verse":"20","text":"Também todos os animais selvagens"},{"verse":"","text":"suspiram por ti,"},{"verse":"","text":"porque os rios secaram,"},{"verse":"","text":"e o fogo devorou as pastagens."}],[{"verse":"","text":"O Dia do Senhor"},{"verse":"1","text":"Toquem a trombeta em Sião"},{"verse":"","text":"e deem o alarme"},{"verse":"","text":"no meu santo monte."},{"verse":"","text":"Que todos os moradores"},{"verse":"","text":"da terra tremam,"},{"verse":"","text":"porque o Dia do"},{"verse":"","text":"está chegando;"},{"verse":"","text":"já está próximo."},{"verse":"2","text":"É dia de trevas e escuridão,"},{"verse":"","text":"dia de nuvens e densas trevas!"},{"verse":"","text":"Como a luz do amanhecer"},{"verse":"","text":"sobre os montes,"},{"verse":"","text":"assim se difunde um povo grande"},{"verse":"","text":"e poderoso,"},{"verse":"","text":"como nunca houve igual"},{"verse":"","text":"desde os tempos antigos,"},{"verse":"","text":"nem haverá outro depois dele"},{"verse":"","text":"pelos anos seguintes,"},{"verse":"","text":"de geração em geração."},{"verse":"3","text":"À frente dele vai fogo devorador,"},{"verse":"","text":"atrás dele vêm"},{"verse":"","text":"chamas destruidoras."},{"verse":"","text":"Diante desse povo,"},{"verse":"","text":"a terra é como o jardim do Éden;"},{"verse":"","text":"mas, atrás dele, fica devastada"},{"verse":"","text":"como um deserto."},{"verse":"","text":"Nada lhe escapa."},{"verse":"4","text":"A sua aparência é"},{"verse":"","text":"como a de cavalos;"},{"verse":"","text":"e, como cavaleiros, assim correm."},{"verse":"5","text":"Com um estrondo semelhante"},{"verse":"","text":"ao de carros de guerra,"},{"verse":"","text":"eles vêm saltando"},{"verse":"","text":"no alto dos montes,"},{"verse":"","text":"crepitando como chamas de fogo"},{"verse":"","text":"que devoram a palha,"},{"verse":"","text":"como um povo poderoso"},{"verse":"","text":"posto em ordem de combate."},{"verse":"6","text":"Diante deles, os povos tremem;"},{"verse":"","text":"todos os rostos empalidecem."},{"verse":"7","text":"Correm como valentes;"},{"verse":"","text":"como homens de guerra,"},{"verse":"","text":"sobem muros."},{"verse":"","text":"Cada um vai no seu caminho"},{"verse":"","text":"e não se desvia da sua fileira."},{"verse":"8","text":"Não empurram uns aos outros;"},{"verse":"","text":"cada um segue o seu rumo."},{"verse":"","text":"Avançam entre as lanças"},{"verse":"","text":"e não se detêm no seu caminho."},{"verse":"9","text":"Invadem a cidade,"},{"verse":"","text":"correm pelas muralhas,"},{"verse":"","text":"sobem pelas paredes das casas,"},{"verse":"","text":"entram pelas janelas como ladrões."},{"verse":"10","text":"Diante deles, a terra treme"},{"verse":"","text":"e os céus se abalam;"},{"verse":"","text":"o sol e a lua se escurecem,"},{"verse":"","text":"e as estrelas deixam de brilhar."},{"verse":"11","text":"O"},{"verse":"","text":"diante do seu exército."},{"verse":"","text":"Porque o seu arraial é enorme,"},{"verse":"","text":"e quem executa as suas ordens"},{"verse":"","text":"é poderoso."},{"verse":"","text":"Sim, grande e mui terrível"},{"verse":"","text":"é o Dia do"},{"verse":"","text":"Quem o poderá suportar?"},{"verse":"","text":"A misericórdia do Senhor"},{"verse":"12","text":"Ainda assim, agora mesmo,"},{"verse":"","text":"diz o"},{"verse":"","text":"\"Convertam-se a mim"},{"verse":"","text":"de todo o coração;"},{"verse":"","text":"com jejuns, com choro"},{"verse":"","text":"e com pranto."},{"verse":"13","text":"Rasguem o coração,"},{"verse":"","text":"e não as suas roupas.\""},{"verse":"","text":"Convertam-se ao"},{"verse":"","text":"seu Deus,"},{"verse":"","text":"porque ele é bondoso"},{"verse":"","text":"e compassivo,"},{"verse":"","text":"tardio em irar-se"},{"verse":"","text":"e grande em misericórdia,"},{"verse":"","text":"e muda de ideia quanto ao mal"},{"verse":"","text":"que havia anunciado."},{"verse":"14","text":"Quem sabe se ele não se voltará"},{"verse":"","text":"e mudará de ideia,"},{"verse":"","text":"e, ao passar, deixe uma bênção,"},{"verse":"","text":"para que vocês possam trazer"},{"verse":"","text":"ofertas de cereais e libações"},{"verse":"","text":"ao"},{"verse":"15","text":"Toquem a trombeta em Sião,"},{"verse":"","text":"proclamem um santo jejum,"},{"verse":"","text":"convoquem uma reunião solene."},{"verse":"16","text":"Reúnam o povo,"},{"verse":"","text":"santifiquem a congregação,"},{"verse":"","text":"congreguem os anciãos,"},{"verse":"","text":"reúnam as crianças"},{"verse":"","text":"e os que mamam no peito."},{"verse":"","text":"Que o noivo saia do seu quarto,"},{"verse":"","text":"e a noiva, dos seus aposentos."},{"verse":"17","text":"Que os sacerdotes,"},{"verse":"","text":"ministros do"},{"verse":"","text":"chorem entre o pórtico e o altar,"},{"verse":"","text":"e orem:"},{"verse":"","text":"\"Poupa o teu povo, ó"},{"verse":"","text":"e não faças da tua herança"},{"verse":"","text":"um objeto de deboche"},{"verse":"","text":"e de zombaria entre as nações."},{"verse":"","text":"Por que hão de dizer"},{"verse":"","text":"entre os povos:"},{"verse":"","text":"‘Onde está o Deus deles?’\""},{"verse":"","text":"A compaixão de Deus"},{"verse":"18","text":"Então o"},{"verse":"","text":"teve grande amor pela sua terra"},{"verse":"","text":"e se compadeceu do seu povo."},{"verse":"19","text":"O"},{"verse":"","text":"ao seu povo:"},{"verse":"","text":"\"Eis que lhes envio o cereal,"},{"verse":"","text":"o vinho e o azeite,"},{"verse":"","text":"e vocês ficarão satisfeitos."},{"verse":"","text":"Nunca mais farei de vocês"},{"verse":"","text":"motivo de zombaria"},{"verse":"","text":"entre as nações."},{"verse":"20","text":"Mas o invasor que vem do Norte,"},{"verse":"","text":"eu o removerei"},{"verse":"","text":"para longe de vocês"},{"verse":"","text":"e o lançarei para uma terra seca"},{"verse":"","text":"e deserta."},{"verse":"","text":"Lançarei a sua vanguarda"},{"verse":"","text":"para o mar oriental,"},{"verse":"","text":"e a sua retaguarda,"},{"verse":"","text":"para o mar ocidental."},{"verse":"","text":"Subirá o seu mau cheiro,"},{"verse":"","text":"e subirá a sua podridão;"},{"verse":"","text":"porque agiu poderosamente.\""},{"verse":"21","text":"\"Não tenha medo, ó terra;"},{"verse":"","text":"alegre-se e exulte,"},{"verse":"","text":"porque o"},{"verse":"","text":"faz grandes coisas."},{"verse":"22","text":"Não tenham medo,"},{"verse":"","text":"animais selvagens,"},{"verse":"","text":"porque os pastos do deserto"},{"verse":"","text":"reverdecerão,"},{"verse":"","text":"porque as árvores"},{"verse":"","text":"darão os seus frutos,"},{"verse":"","text":"as figueiras e as videiras"},{"verse":"","text":"produzirão com vigor."},{"verse":"23","text":"Filhos de Sião, alegrem-se"},{"verse":"","text":"e exultem no"},{"verse":"","text":"porque ele lhes dará as chuvas"},{"verse":"","text":"em justa medida;"},{"verse":"","text":"fará descer, como no passado,"},{"verse":"","text":"as primeiras e as últimas chuvas."},{"verse":"24","text":"As eiras se encherão de trigo,"},{"verse":"","text":"e os lagares transbordarão"},{"verse":"","text":"de vinho e de azeite."},{"verse":"25","text":"Restituirei os anos"},{"verse":"","text":"que foram consumidos"},{"verse":"","text":"pelos gafanhotos"},{"verse":"","text":"— o migrador, o devorador"},{"verse":"","text":"e o destruidor —,"},{"verse":"","text":"o meu grande exército"},{"verse":"","text":"que enviei contra vocês."},{"verse":"26","text":"Vocês terão comida"},{"verse":"","text":"em abundância"},{"verse":"","text":"e ficarão satisfeitos,"},{"verse":"","text":"e louvarão o nome do"},{"verse":"","text":"seu Deus,"},{"verse":"","text":"que fez maravilhas"},{"verse":"","text":"em favor de vocês."},{"verse":"","text":"E nunca mais o meu povo"},{"verse":"","text":"será envergonhado."},{"verse":"27","text":"Vocês saberão que eu estou"},{"verse":"","text":"no meio de Israel,"},{"verse":"","text":"e que eu sou o"},{"verse":"","text":"o Deus de vocês,"},{"verse":"","text":"e que não há outro."},{"verse":"","text":"E nunca mais o meu povo"},{"verse":"","text":"será envergonhado.\""},{"verse":"","text":"A promessa do derramamento do Espírito"},{"verse":"28","text":"\"E acontecerá, depois disso,"},{"verse":"","text":"que derramarei o meu Espírito"},{"verse":"","text":"sobre toda a humanidade."},{"verse":"","text":"Os filhos e as filhas de vocês"},{"verse":"","text":"profetizarão,"},{"verse":"","text":"os seus velhos sonharão,"},{"verse":"","text":"e os seus jovens terão visões."},{"verse":"29","text":"Até sobre os servos"},{"verse":"","text":"e sobre as servas"},{"verse":"","text":"derramarei o meu Espírito"},{"verse":"","text":"naqueles dias."},{"verse":"30","text":"Mostrarei prodígios no céu"},{"verse":"","text":"e na terra:"},{"verse":"","text":"sangue, fogo e colunas de fumaça."},{"verse":"31","text":"O sol se transformará em trevas,"},{"verse":"","text":"e a lua, em sangue,"},{"verse":"","text":"antes que venha o grande"},{"verse":"","text":"e terrível Dia do"},{"verse":"32","text":"E acontecerá que todo aquele que invocar o nome do"}],[{"verse":"","text":"Os juízos de Deus sobre as nações inimigas"},{"verse":"1","text":"— Eis que, naqueles dias e naquele tempo, em que mudarei a sorte de Judá e de Jerusalém,"},{"verse":"9","text":"— Proclamem isto"},{"verse":"","text":"entre as nações:"},{"verse":"","text":"\"Declarem guerra santa"},{"verse":"","text":"e convoquem os valentes."},{"verse":"","text":"Que todos os homens de guerra"},{"verse":"","text":"se apresentem e se preparem."},{"verse":"10","text":"Transformem as suas lâminas"},{"verse":"","text":"de arado em espadas,"},{"verse":"","text":"e as suas foices, em lanças."},{"verse":"","text":"Que o fraco diga: ‘Eu sou forte.’\""},{"verse":"11","text":"\"Todos vocês, povos vizinhos,"},{"verse":"","text":"apressem-se e venham depressa,"},{"verse":"","text":"e reúnam-se ali.\""},{"verse":"","text":"Faze descer os teus valentes,"},{"verse":"","text":"ó"},{"verse":"12","text":"\"Que todas as nações"},{"verse":"","text":"se levantem"},{"verse":"","text":"e sigam para o vale de Josafá,"},{"verse":"","text":"porque ali me assentarei"},{"verse":"","text":"para julgar todas"},{"verse":"","text":"as nações vizinhas."},{"verse":"13","text":"Peguem a foice"},{"verse":"","text":"e comecem a colher,"},{"verse":"","text":"porque a plantação está madura."},{"verse":"","text":"Venham, pisem as uvas,"},{"verse":"","text":"porque o lagar está cheio,"},{"verse":"","text":"os seus compartimentos"},{"verse":"","text":"transbordam."},{"verse":"","text":"Porque é grande a maldade"},{"verse":"","text":"dessas nações!\""},{"verse":"14","text":"\"Multidões, multidões"},{"verse":"","text":"no vale da Decisão!"},{"verse":"","text":"Porque o Dia do"},{"verse":"","text":"está perto,"},{"verse":"","text":"no vale da Decisão."},{"verse":"15","text":"O sol e a lua se escurecem,"},{"verse":"","text":"e as estrelas deixam de brilhar."},{"verse":"16","text":"O"},{"verse":"","text":"e de Jerusalém fará ouvir"},{"verse":"","text":"a sua voz."},{"verse":"","text":"Os céus e a terra tremerão,"},{"verse":"","text":"mas o"},{"verse":"","text":"do seu povo"},{"verse":"","text":"e a fortaleza dos filhos de Israel.\""},{"verse":"","text":"A restauração de Israel"},{"verse":"17","text":"\"Assim vocês saberão"},{"verse":"","text":"que eu sou o"},{"verse":"","text":"o Deus de vocês,"},{"verse":"","text":"que habito em Sião,"},{"verse":"","text":"o meu santo monte."},{"verse":"","text":"Jerusalém será santa;"},{"verse":"","text":"estranhos não passarão"},{"verse":"","text":"mais por ela."},{"verse":"18","text":"E acontecerá que, naquele dia,"},{"verse":"","text":"os montes destilarão vinho,"},{"verse":"","text":"e as colinas manarão leite,"},{"verse":"","text":"e todos os rios de Judá"},{"verse":"","text":"estarão cheios de água."},{"verse":"","text":"Uma fonte sairá"},{"verse":"","text":"da Casa do"},{"verse":"","text":"e regará o vale de Sitim."},{"verse":"19","text":"O Egito se tornará"},{"verse":"","text":"uma desolação,"},{"verse":"","text":"e Edom se fará"},{"verse":"","text":"um deserto abandonado,"},{"verse":"","text":"por causa da violência que fizeram"},{"verse":"","text":"aos filhos de Judá,"},{"verse":"","text":"em cuja terra derramaram"},{"verse":"","text":"sangue inocente."},{"verse":"20","text":"Judá, porém, será habitada"},{"verse":"","text":"para sempre,"},{"verse":"","text":"e Jerusalém,"},{"verse":"","text":"de geração em geração."},{"verse":"21","text":"Eu vingarei o sangue deles,"},{"verse":"","text":"que ainda não foi vingado.\""},{"verse":"","text":"E o"}]]}