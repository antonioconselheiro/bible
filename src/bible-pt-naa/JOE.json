0},"text":"Os céus e a terra tremerão,"},{"verse":{"start":0,"end":0},"text":"mas o"},{"verse":{"start":0,"end":0},"text":"do seu povo"},{"verse":{"start":0,"end":0},"text":"e a fortaleza dos filhos de Israel.\""},{"verse":{"start":0,"end":0},"text":"A restauração de Israel"},{"verse":{"start":17,"end":17},"text":"\"Assim vocês saberão"},{"verse":{"start":0,"end":0},"text":"que eu sou o"},{"verse":{"start":0,"end":0},"text":"o Deus de vocês,"},{"verse":{"start":0,"end":0},"text":"que habito em Sião,"},{"verse":{"start":0,"end":0},"text":"o meu santo monte."},{"verse":{"start":0,"end":0},"text":"Jerusalém será santa;"},{"verse":{"start":0,"end":0},"text":"estranhos não passarão"},{"verse":{"start":0,"end":0},"text":"mais por ela."},{"verse":{"start":18,"end":18},"text":"E acontecerá que, naquele dia,"},{"verse":{"start":0,"end":0},"text":"os montes destilarão vinho,"},{"verse":{"start":0,"end":0},"text":"e as colinas manarão leite,"},{"verse":{"start":0,"end":0},"text":"e todos os rios de Judá"},{"verse":{"start":0,"end":0},"text":"estarão cheios de água."},{"verse":{"start":0,"end":0},"text":"Uma fonte sairá"},{"verse":{"start":0,"end":0},"text":"da Casa do"},{"verse":{"start":0,"end":0},"text":"e regará o vale de Sitim."},{"verse":{"start":19,"end":19},"text":"O Egito se tornará"},{"verse":{"start":0,"end":0},"text":"uma desolação,"},{"verse":{"start":0,"end":0},"text":"e Edom se fará"},{"verse":{"start":0,"end":0},"text":"um deserto abandonado,"},{"verse":{"start":0,"end":0},"text":"por causa da violência que fizeram"},{"verse":{"start":0,"end":0},"text":"aos filhos de Judá,"},{"verse":{"start":0,"end":0},"text":"em cuja terra derramaram"},{"verse":{"start":0,"end":0},"text":"sangue inocente."},{"verse":{"start":20,"end":20},"text":"Judá, porém, será habitada"},{"verse":{"start":0,"end":0},"text":"para sempre,"},{"verse":{"start":0,"end":0},"text":"e Jerusalém,"},{"verse":{"start":0,"end":0},"text":"de geração em geração."},{"verse":{"start":21,"end":21},"text":"Eu vingarei o sangue deles,"},{"verse":{"start":0,"end":0},"text":"que ainda não foi vingado.\""},{"verse":{"start":0,"end":0},"text":"E o"}]}]}