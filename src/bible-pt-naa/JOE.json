{"chapters":[{"chapter":1,"verses":[{"verse":1,"text":"Palavra do"},{"verse":2,"text":"A praga de gafanhotos e a seca"},{"verse":3,"text":"\"Prestem atenção, velhos,"},{"verse":4,"text":"e escutem, todos os moradores"},{"verse":5,"text":"da terra!"},{"verse":6,"text":"Aconteceu algo assim"},{"verse":7,"text":"no tempo de vocês"},{"verse":8,"text":"ou nos dias de seus pais?"},{"verse":9,"text":"Contem isto aos filhos de vocês;"},{"verse":10,"text":"que eles o contem aos filhos deles,"},{"verse":11,"text":"e que estes falem sobre isso"},{"verse":12,"text":"à geração seguinte.\""},{"verse":13,"text":"\"O que o gafanhoto cortador"},{"verse":14,"text":"deixou,"},{"verse":15,"text":"o gafanhoto migrador comeu;"},{"verse":16,"text":"o que o migrador deixou,"},{"verse":17,"text":"o gafanhoto devorador comeu;"},{"verse":18,"text":"o que o devorador deixou,"},{"verse":19,"text":"o gafanhoto destruidor comeu.\""},{"verse":20,"text":"\"Acordem, beberrões, e chorem!"},{"verse":21,"text":"Lamentem, todos vocês"},{"verse":22,"text":"que gostam de vinho,"},{"verse":23,"text":"por causa do vinho novo,"},{"verse":24,"text":"pois foi tirado da boca de vocês."},{"verse":25,"text":"Porque veio um povo"},{"verse":26,"text":"contra a minha terra,"},{"verse":27,"text":"poderoso e inumerável,"},{"verse":28,"text":"com dentes como de leão"},{"verse":29,"text":"e presas como de leoa."},{"verse":30,"text":"Destruiu as minhas videiras"},{"verse":31,"text":"e destroçou as minhas figueiras."},{"verse":32,"text":"Tirou as cascas das árvores"},{"verse":33,"text":"e as jogou fora;"},{"verse":34,"text":"os galhos ficaram brancos.\""},{"verse":35,"text":"\"Lamentem,"},{"verse":36,"text":"assim como a virgem,"},{"verse":37,"text":"vestida de roupa feita"},{"verse":38,"text":"de pano de saco,"},{"verse":39,"text":"lamenta a morte do seu noivo."},{"verse":40,"text":"Na Casa do"},{"verse":41,"text":"foram cortadas"},{"verse":42,"text":"as ofertas de cereais"},{"verse":43,"text":"e as libações."},{"verse":44,"text":"Os sacerdotes,"},{"verse":45,"text":"ministros do"},{"verse":46,"text":"estão enlutados."},{"verse":47,"text":"Os campos foram arrasados,"},{"verse":48,"text":"e a terra está de luto,"},{"verse":49,"text":"porque o cereal foi destruído,"},{"verse":50,"text":"o vinho novo acabou,"},{"verse":51,"text":"o azeite está no fim.\""},{"verse":52,"text":"\"Fiquem envergonhados,"},{"verse":53,"text":"lavradores;"},{"verse":54,"text":"lamentem, vinhateiros,"},{"verse":55,"text":"por causa do trigo e da cevada,"},{"verse":56,"text":"porque a colheita foi destruída."},{"verse":57,"text":"As videiras secaram,"},{"verse":58,"text":"as figueiras murcharam,"},{"verse":59,"text":"as romãzeiras, as palmeiras"},{"verse":60,"text":"e as macieiras também."},{"verse":61,"text":"Todas as árvores do campo"},{"verse":62,"text":"secaram,"},{"verse":63,"text":"e já não há alegria"},{"verse":64,"text":"entre os filhos dos homens.\""},{"verse":65,"text":"Chamado ao arrependimento"},{"verse":66,"text":"\"Sacerdotes, vistam roupa"},{"verse":67,"text":"feita de pano de saco"},{"verse":68,"text":"e pranteiem."},{"verse":69,"text":"Ministros do altar, lamentem."},{"verse":70,"text":"Ministros do meu Deus, venham"},{"verse":71,"text":"e passem a noite vestidos"},{"verse":72,"text":"de panos de saco."},{"verse":73,"text":"Porque no templo de seu Deus"},{"verse":74,"text":"não há mais ofertas de cereais"},{"verse":75,"text":"e libações."},{"verse":76,"text":"Proclamem um santo jejum,"},{"verse":77,"text":"convoquem uma reunião solene."},{"verse":78,"text":"Reúnam os anciãos"},{"verse":79,"text":"e todos os moradores"},{"verse":80,"text":"desta terra"},{"verse":81,"text":"na Casa do"},{"verse":82,"text":"e clamem ao"},{"verse":83,"text":"\"Ah! Que dia!"},{"verse":84,"text":"Porque o Dia do"},{"verse":85,"text":"e ele vem como destruição"},{"verse":86,"text":"da parte do Todo-Poderoso.\""},{"verse":87,"text":"Por acaso, o alimento"},{"verse":88,"text":"não foi destruído"},{"verse":89,"text":"diante dos nossos olhos?"},{"verse":90,"text":"E, do templo do nosso Deus,"},{"verse":91,"text":"não desapareceram"},{"verse":92,"text":"a alegria e o regozijo?"},{"verse":93,"text":"As sementes secaram"},{"verse":94,"text":"debaixo dos seus torrões;"},{"verse":95,"text":"os celeiros foram destruídos,"},{"verse":96,"text":"os armazéns, derrubados,"},{"verse":97,"text":"porque o cereal se perdeu."},{"verse":98,"text":"Como geme o gado!"},{"verse":99,"text":"As manadas de bois"},{"verse":100,"text":"estão inquietas,"},{"verse":101,"text":"porque não têm pasto;"},{"verse":102,"text":"também os rebanhos de ovelhas"},{"verse":103,"text":"estão sofrendo."},{"verse":104,"text":"A ti, ó"},{"verse":105,"text":"porque o fogo devorou"},{"verse":106,"text":"as pastagens,"},{"verse":107,"text":"e as chamas consumiram"},{"verse":108,"text":"todas as árvores do campo."},{"verse":109,"text":"Também todos os animais selvagens"},{"verse":110,"text":"suspiram por ti,"},{"verse":111,"text":"porque os rios secaram,"},{"verse":112,"text":"e o fogo devorou as pastagens."}]},{"chapter":2,"verses":[{"verse":0,"text":"O Dia do Senhor"},{"verse":1,"text":"Toquem a trombeta em Sião"},{"verse":2,"text":"e deem o alarme"},{"verse":3,"text":"no meu santo monte."},{"verse":4,"text":"Que todos os moradores"},{"verse":5,"text":"da terra tremam,"},{"verse":6,"text":"porque o Dia do"},{"verse":7,"text":"está chegando;"},{"verse":8,"text":"já está próximo."},{"verse":9,"text":"É dia de trevas e escuridão,"},{"verse":10,"text":"dia de nuvens e densas trevas!"},{"verse":11,"text":"Como a luz do amanhecer"},{"verse":12,"text":"sobre os montes,"},{"verse":13,"text":"assim se difunde um povo grande"},{"verse":14,"text":"e poderoso,"},{"verse":15,"text":"como nunca houve igual"},{"verse":16,"text":"desde os tempos antigos,"},{"verse":17,"text":"nem haverá outro depois dele"},{"verse":18,"text":"pelos anos seguintes,"},{"verse":19,"text":"de geração em geração."},{"verse":20,"text":"À frente dele vai fogo devorador,"},{"verse":21,"text":"atrás dele vêm"},{"verse":22,"text":"chamas destruidoras."},{"verse":23,"text":"Diante desse povo,"},{"verse":24,"text":"a terra é como o jardim do Éden;"},{"verse":25,"text":"mas, atrás dele, fica devastada"},{"verse":26,"text":"como um deserto."},{"verse":27,"text":"Nada lhe escapa."},{"verse":28,"text":"A sua aparência é"},{"verse":29,"text":"como a de cavalos;"},{"verse":30,"text":"e, como cavaleiros, assim correm."},{"verse":31,"text":"Com um estrondo semelhante"},{"verse":32,"text":"ao de carros de guerra,"},{"verse":33,"text":"eles vêm saltando"},{"verse":34,"text":"no alto dos montes,"},{"verse":35,"text":"crepitando como chamas de fogo"},{"verse":36,"text":"que devoram a palha,"},{"verse":37,"text":"como um povo poderoso"},{"verse":38,"text":"posto em ordem de combate."},{"verse":39,"text":"Diante deles, os povos tremem;"},{"verse":40,"text":"todos os rostos empalidecem."},{"verse":41,"text":"Correm como valentes;"},{"verse":42,"text":"como homens de guerra,"},{"verse":43,"text":"sobem muros."},{"verse":44,"text":"Cada um vai no seu caminho"},{"verse":45,"text":"e não se desvia da sua fileira."},{"verse":46,"text":"Não empurram uns aos outros;"},{"verse":47,"text":"cada um segue o seu rumo."},{"verse":48,"text":"Avançam entre as lanças"},{"verse":49,"text":"e não se detêm no seu caminho."},{"verse":50,"text":"Invadem a cidade,"},{"verse":51,"text":"correm pelas muralhas,"},{"verse":52,"text":"sobem pelas paredes das casas,"},{"verse":53,"text":"entram pelas janelas como ladrões."},{"verse":54,"text":"Diante deles, a terra treme"},{"verse":55,"text":"e os céus se abalam;"},{"verse":56,"text":"o sol e a lua se escurecem,"},{"verse":57,"text":"e as estrelas deixam de brilhar."},{"verse":58,"text":"O"},{"verse":59,"text":"diante do seu exército."},{"verse":60,"text":"Porque o seu arraial é enorme,"},{"verse":61,"text":"e quem executa as suas ordens"},{"verse":62,"text":"é poderoso."},{"verse":63,"text":"Sim, grande e mui terrível"},{"verse":64,"text":"é o Dia do"},{"verse":65,"text":"Quem o poderá suportar?"},{"verse":66,"text":"A misericórdia do Senhor"},{"verse":67,"text":"Ainda assim, agora mesmo,"},{"verse":68,"text":"diz o"},{"verse":69,"text":"\"Convertam-se a mim"},{"verse":70,"text":"de todo o coração;"},{"verse":71,"text":"com jejuns, com choro"},{"verse":72,"text":"e com pranto."},{"verse":73,"text":"Rasguem o coração,"},{"verse":74,"text":"e não as suas roupas.\""},{"verse":75,"text":"Convertam-se ao"},{"verse":76,"text":"seu Deus,"},{"verse":77,"text":"porque ele é bondoso"},{"verse":78,"text":"e compassivo,"},{"verse":79,"text":"tardio em irar-se"},{"verse":80,"text":"e grande em misericórdia,"},{"verse":81,"text":"e muda de ideia quanto ao mal"},{"verse":82,"text":"que havia anunciado."},{"verse":83,"text":"Quem sabe se ele não se voltará"},{"verse":84,"text":"e mudará de ideia,"},{"verse":85,"text":"e, ao passar, deixe uma bênção,"},{"verse":86,"text":"para que vocês possam trazer"},{"verse":87,"text":"ofertas de cereais e libações"},{"verse":88,"text":"ao"},{"verse":89,"text":"Toquem a trombeta em Sião,"},{"verse":90,"text":"proclamem um santo jejum,"},{"verse":91,"text":"convoquem uma reunião solene."},{"verse":92,"text":"Reúnam o povo,"},{"verse":93,"text":"santifiquem a congregação,"},{"verse":94,"text":"congreguem os anciãos,"},{"verse":95,"text":"reúnam as crianças"},{"verse":96,"text":"e os que mamam no peito."},{"verse":97,"text":"Que o noivo saia do seu quarto,"},{"verse":98,"text":"e a noiva, dos seus aposentos."},{"verse":99,"text":"Que os sacerdotes,"},{"verse":100,"text":"ministros do"},{"verse":101,"text":"chorem entre o pórtico e o altar,"},{"verse":102,"text":"e orem:"},{"verse":103,"text":"\"Poupa o teu povo, ó"},{"verse":104,"text":"e não faças da tua herança"},{"verse":105,"text":"um objeto de deboche"},{"verse":106,"text":"e de zombaria entre as nações."},{"verse":107,"text":"Por que hão de dizer"},{"verse":108,"text":"entre os povos:"},{"verse":109,"text":"‘Onde está o Deus deles?’\""},{"verse":110,"text":"A compaixão de Deus"},{"verse":111,"text":"Então o"},{"verse":112,"text":"teve grande amor pela sua terra"},{"verse":113,"text":"e se compadeceu do seu povo."},{"verse":114,"text":"O"},{"verse":115,"text":"ao seu povo:"},{"verse":116,"text":"\"Eis que lhes envio o cereal,"},{"verse":117,"text":"o vinho e o azeite,"},{"verse":118,"text":"e vocês ficarão satisfeitos."},{"verse":119,"text":"Nunca mais farei de vocês"},{"verse":120,"text":"motivo de zombaria"},{"verse":121,"text":"entre as nações."},{"verse":122,"text":"Mas o invasor que vem do Norte,"},{"verse":123,"text":"eu o removerei"},{"verse":124,"text":"para longe de vocês"},{"verse":125,"text":"e o lançarei para uma terra seca"},{"verse":126,"text":"e deserta."},{"verse":127,"text":"Lançarei a sua vanguarda"},{"verse":128,"text":"para o mar oriental,"},{"verse":129,"text":"e a sua retaguarda,"},{"verse":130,"text":"para o mar ocidental."},{"verse":131,"text":"Subirá o seu mau cheiro,"},{"verse":132,"text":"e subirá a sua podridão;"},{"verse":133,"text":"porque agiu poderosamente.\""},{"verse":134,"text":"\"Não tenha medo, ó terra;"},{"verse":135,"text":"alegre-se e exulte,"},{"verse":136,"text":"porque o"},{"verse":137,"text":"faz grandes coisas."},{"verse":138,"text":"Não tenham medo,"},{"verse":139,"text":"animais selvagens,"},{"verse":140,"text":"porque os pastos do deserto"},{"verse":141,"text":"reverdecerão,"},{"verse":142,"text":"porque as árvores"},{"verse":143,"text":"darão os seus frutos,"},{"verse":144,"text":"as figueiras e as videiras"},{"verse":145,"text":"produzirão com vigor."},{"verse":146,"text":"Filhos de Sião, alegrem-se"},{"verse":147,"text":"e exultem no"},{"verse":148,"text":"porque ele lhes dará as chuvas"},{"verse":149,"text":"em justa medida;"},{"verse":150,"text":"fará descer, como no passado,"},{"verse":151,"text":"as primeiras e as últimas chuvas."},{"verse":152,"text":"As eiras se encherão de trigo,"},{"verse":153,"text":"e os lagares transbordarão"},{"verse":154,"text":"de vinho e de azeite."},{"verse":155,"text":"Restituirei os anos"},{"verse":156,"text":"que foram consumidos"},{"verse":157,"text":"pelos gafanhotos"},{"verse":158,"text":"— o migrador, o devorador"},{"verse":159,"text":"e o destruidor —,"},{"verse":160,"text":"o meu grande exército"},{"verse":161,"text":"que enviei contra vocês."},{"verse":162,"text":"Vocês terão comida"},{"verse":163,"text":"em abundância"},{"verse":164,"text":"e ficarão satisfeitos,"},{"verse":165,"text":"e louvarão o nome do"},{"verse":166,"text":"seu Deus,"},{"verse":167,"text":"que fez maravilhas"},{"verse":168,"text":"em favor de vocês."},{"verse":169,"text":"E nunca mais o meu povo"},{"verse":170,"text":"será envergonhado."},{"verse":171,"text":"Vocês saberão que eu estou"},{"verse":172,"text":"no meio de Israel,"},{"verse":173,"text":"e que eu sou o"},{"verse":174,"text":"o Deus de vocês,"},{"verse":175,"text":"e que não há outro."},{"verse":176,"text":"E nunca mais o meu povo"},{"verse":177,"text":"será envergonhado.\""},{"verse":178,"text":"A promessa do derramamento do Espírito"},{"verse":179,"text":"\"E acontecerá, depois disso,"},{"verse":180,"text":"que derramarei o meu Espírito"},{"verse":181,"text":"sobre toda a humanidade."},{"verse":182,"text":"Os filhos e as filhas de vocês"},{"verse":183,"text":"profetizarão,"},{"verse":184,"text":"os seus velhos sonharão,"},{"verse":185,"text":"e os seus jovens terão visões."},{"verse":186,"text":"Até sobre os servos"},{"verse":187,"text":"e sobre as servas"},{"verse":188,"text":"derramarei o meu Espírito"},{"verse":189,"text":"naqueles dias."},{"verse":190,"text":"Mostrarei prodígios no céu"},{"verse":191,"text":"e na terra:"},{"verse":192,"text":"sangue, fogo e colunas de fumaça."},{"verse":193,"text":"O sol se transformará em trevas,"},{"verse":194,"text":"e a lua, em sangue,"},{"verse":195,"text":"antes que venha o grande"},{"verse":196,"text":"e terrível Dia do"},{"verse":197,"text":"E acontecerá que todo aquele que invocar o nome do"}]},{"chapter":3,"verses":[{"verse":0,"text":"Os juízos de Deus sobre as nações inimigas"},{"verse":1,"text":"— Eis que, naqueles dias e naquele tempo, em que mudarei a sorte de Judá e de Jerusalém,"},{"verse":2,"text":"— Proclamem isto"},{"verse":3,"text":"entre as nações:"},{"verse":4,"text":"\"Declarem guerra santa"},{"verse":5,"text":"e convoquem os valentes."},{"verse":6,"text":"Que todos os homens de guerra"},{"verse":7,"text":"se apresentem e se preparem."},{"verse":8,"text":"Transformem as suas lâminas"},{"verse":9,"text":"de arado em espadas,"},{"verse":10,"text":"e as suas foices, em lanças."},{"verse":11,"text":"Que o fraco diga: ‘Eu sou forte.’\""},{"verse":12,"text":"\"Todos vocês, povos vizinhos,"},{"verse":13,"text":"apressem-se e venham depressa,"},{"verse":14,"text":"e reúnam-se ali.\""},{"verse":15,"text":"Faze descer os teus valentes,"},{"verse":16,"text":"ó"},{"verse":17,"text":"\"Que todas as nações"},{"verse":18,"text":"se levantem"},{"verse":19,"text":"e sigam para o vale de Josafá,"},{"verse":20,"text":"porque ali me assentarei"},{"verse":21,"text":"para julgar todas"},{"verse":22,"text":"as nações vizinhas."},{"verse":23,"text":"Peguem a foice"},{"verse":24,"text":"e comecem a colher,"},{"verse":25,"text":"porque a plantação está madura."},{"verse":26,"text":"Venham, pisem as uvas,"},{"verse":27,"text":"porque o lagar está cheio,"},{"verse":28,"text":"os seus compartimentos"},{"verse":29,"text":"transbordam."},{"verse":30,"text":"Porque é grande a maldade"},{"verse":31,"text":"dessas nações!\""},{"verse":32,"text":"\"Multidões, multidões"},{"verse":33,"text":"no vale da Decisão!"},{"verse":34,"text":"Porque o Dia do"},{"verse":35,"text":"está perto,"},{"verse":36,"text":"no vale da Decisão."},{"verse":37,"text":"O sol e a lua se escurecem,"},{"verse":38,"text":"e as estrelas deixam de brilhar."},{"verse":39,"text":"O"},{"verse":40,"text":"e de Jerusalém fará ouvir"},{"verse":41,"text":"a sua voz."},{"verse":42,"text":"Os céus e a terra tremerão,"},{"verse":43,"text":"mas o"},{"verse":44,"text":"do seu povo"},{"verse":45,"text":"e a fortaleza dos filhos de Israel.\""},{"verse":46,"text":"A restauração de Israel"},{"verse":47,"text":"\"Assim vocês saberão"},{"verse":48,"text":"que eu sou o"},{"verse":49,"text":"o Deus de vocês,"},{"verse":50,"text":"que habito em Sião,"},{"verse":51,"text":"o meu santo monte."},{"verse":52,"text":"Jerusalém será santa;"},{"verse":53,"text":"estranhos não passarão"},{"verse":54,"text":"mais por ela."},{"verse":55,"text":"E acontecerá que, naquele dia,"},{"verse":56,"text":"os montes destilarão vinho,"},{"verse":57,"text":"e as colinas manarão leite,"},{"verse":58,"text":"e todos os rios de Judá"},{"verse":59,"text":"estarão cheios de água."},{"verse":60,"text":"Uma fonte sairá"},{"verse":61,"text":"da Casa do"},{"verse":62,"text":"e regará o vale de Sitim."},{"verse":63,"text":"O Egito se tornará"},{"verse":64,"text":"uma desolação,"},{"verse":65,"text":"e Edom se fará"},{"verse":66,"text":"um deserto abandonado,"},{"verse":67,"text":"por causa da violência que fizeram"},{"verse":68,"text":"aos filhos de Judá,"},{"verse":69,"text":"em cuja terra derramaram"},{"verse":70,"text":"sangue inocente."},{"verse":71,"text":"Judá, porém, será habitada"},{"verse":72,"text":"para sempre,"},{"verse":73,"text":"e Jerusalém,"},{"verse":74,"text":"de geração em geração."},{"verse":75,"text":"Eu vingarei o sangue deles,"},{"verse":76,"text":"que ainda não foi vingado.\""},{"verse":77,"text":"E o"}]}]}