{"chapters":[{"chapter":1,"verses":[{"verse":1,"text":"Palavra do"},{"verse":2,"text":"A mulher e os filhos de Oseias"},{"verse":3,"text":"Quando, pela primeira vez, o"},{"verse":4,"text":"— Vá e case com uma prostituta, e tenha com ela filhos de uma prostituta. Porque a terra se prostituiu, desviando-se do"},{"verse":5,"text":"Então Oseias foi e casou com Gômer, filha de Diblaim, que ficou grávida e lhe deu um filho."},{"verse":6,"text":"— Ponha nele o nome de Jezreel, porque daqui a pouco castigarei a casa de Jeú por causa do sangue derramado em Jezreel. Vou acabar com o reino da casa de Israel."},{"verse":7,"text":"Gômer ficou grávida outra vez e deu à luz uma filha. Então o"},{"verse":8,"text":"— Ponha nela o nome de Lo-Ruamá, porque não voltarei a ter compaixão da casa de Israel, para lhe perdoar."},{"verse":9,"text":"Depois de ter desmamado Lo-Ruamá, Gômer ficou grávida mais uma vez e deu à luz um filho."},{"verse":10,"text":"— Ponha nele o nome de Lo-Ami, porque vocês não são o meu povo, nem eu serei o seu Deus."},{"verse":11,"text":"A futura grandeza de Israel"},{"verse":12,"text":"Todavia, o número dos filhos de Israel será como a areia do mar, que não se pode medir, nem contar. E acontecerá que, no lugar em que lhes foi dito: \"Vocês não são o meu povo\", ali mesmo se dirá a eles: \"Vocês são filhos do Deus vivo.\""}]},{"chapter":2,"verses":[{"verse":1,"text":"Chamem seus irmãos de Ami, e suas irmãs de Ruamá."},{"verse":2,"text":"A infidelidade de Israel"},{"verse":3,"text":"\"Acusem a mãe de vocês,"},{"verse":4,"text":"acusem-na,"},{"verse":5,"text":"porque ela não é minha mulher,"},{"verse":6,"text":"e eu não sou seu marido."},{"verse":7,"text":"Que ela afaste as suas prostituições"},{"verse":8,"text":"de sua presença"},{"verse":9,"text":"e os seus adultérios"},{"verse":10,"text":"de entre os seus seios."},{"verse":11,"text":"Do contrário, eu a deixarei"},{"verse":12,"text":"sem roupa"},{"verse":13,"text":"e nua como no dia"},{"verse":14,"text":"em que nasceu."},{"verse":15,"text":"Eu a tornarei semelhante"},{"verse":16,"text":"a um deserto, a uma terra seca,"},{"verse":17,"text":"e deixarei que morra de sede."},{"verse":18,"text":"E não terei compaixão"},{"verse":19,"text":"de seus filhos,"},{"verse":20,"text":"porque são filhos"},{"verse":21,"text":"de uma prostituta."},{"verse":22,"text":"Pois a mãe deles se prostituiu;"},{"verse":23,"text":"aquela que os concebeu"},{"verse":24,"text":"agiu de forma vergonhosa."},{"verse":25,"text":"Porque disse:"},{"verse":26,"text":"‘Irei atrás dos meus amantes,"},{"verse":27,"text":"que me dão o meu pão"},{"verse":28,"text":"e a minha água,"},{"verse":29,"text":"a minha lã e o meu linho,"},{"verse":30,"text":"o meu azeite"},{"verse":31,"text":"e as minhas bebidas.’\""},{"verse":32,"text":"\"Portanto, eis que cercarei"},{"verse":33,"text":"o seu caminho com espinhos"},{"verse":34,"text":"e levantarei um muro contra ela,"},{"verse":35,"text":"para que ela não ache"},{"verse":36,"text":"as suas veredas."},{"verse":37,"text":"Ela correrá atrás dos seus amantes,"},{"verse":38,"text":"mas não os alcançará;"},{"verse":39,"text":"irá procurá-los,"},{"verse":40,"text":"mas não os encontrará."},{"verse":41,"text":"Então dirá: ‘Vou voltar"},{"verse":42,"text":"para o meu primeiro marido,"},{"verse":43,"text":"porque a minha vida era melhor"},{"verse":44,"text":"naquele tempo do que agora.’"},{"verse":45,"text":"Ela não reconheceu"},{"verse":46,"text":"que fui eu que lhe dei o trigo,"},{"verse":47,"text":"o vinho e o azeite;"},{"verse":48,"text":"fui eu que lhe multipliquei"},{"verse":49,"text":"a prata e o ouro,"},{"verse":50,"text":"que eles usaram para Baal."},{"verse":51,"text":"Portanto, farei com que,"},{"verse":52,"text":"no devido tempo,"},{"verse":53,"text":"ela devolva o meu trigo"},{"verse":54,"text":"e o meu vinho."},{"verse":55,"text":"Tirarei dela a minha lã"},{"verse":56,"text":"e o meu linho,"},{"verse":57,"text":"que deviam cobrir a sua nudez."},{"verse":58,"text":"Agora descobrirei"},{"verse":59,"text":"as suas vergonhas"},{"verse":60,"text":"aos olhos dos seus amantes,"},{"verse":61,"text":"e ninguém a livrará da minha mão."},{"verse":62,"text":"Farei cessar toda a sua alegria,"},{"verse":63,"text":"as suas festas,"},{"verse":64,"text":"as Festas de Lua Nova,"},{"verse":65,"text":"os seus sábados"},{"verse":66,"text":"e todas as suas solenidades."},{"verse":67,"text":"Devastarei as suas videiras"},{"verse":68,"text":"e as suas figueiras,"},{"verse":69,"text":"das quais ela diz:"},{"verse":70,"text":"‘Este é o pagamento que recebi"},{"verse":71,"text":"dos meus amantes.’"},{"verse":72,"text":"Farei com que virem mato,"},{"verse":73,"text":"e os animais selvagens"},{"verse":74,"text":"as devorarão."},{"verse":75,"text":"Eu a castigarei pelos dias"},{"verse":76,"text":"dos baalins,"},{"verse":77,"text":"nos quais lhes queimou incenso,"},{"verse":78,"text":"e se enfeitou"},{"verse":79,"text":"com os seus pendentes"},{"verse":80,"text":"e com as suas joias,"},{"verse":81,"text":"e andou atrás de seus amantes,"},{"verse":82,"text":"mas de mim se esqueceu\","},{"verse":83,"text":"diz o"},{"verse":84,"text":"A misericórdia de Deus"},{"verse":85,"text":"\"Portanto, eis que eu a atrairei,"},{"verse":86,"text":"e a levarei para o deserto,"},{"verse":87,"text":"e lhe falarei ao coração."},{"verse":88,"text":"E ali eu lhe devolverei"},{"verse":89,"text":"as suas vinhas"},{"verse":90,"text":"e farei do vale de Acor"},{"verse":91,"text":"uma porta de esperança."},{"verse":92,"text":"Ali ela me responderá"},{"verse":93,"text":"como nos dias da sua mocidade"},{"verse":94,"text":"e como no dia em que saiu"},{"verse":95,"text":"da terra do Egito."},{"verse":96,"text":"Naquele dia\","},{"verse":97,"text":"diz o"},{"verse":98,"text":"\"ela me chamará de ‘Meu Marido’,"},{"verse":99,"text":"e não me chamará mais de"},{"verse":100,"text":"‘Meu Baal’."},{"verse":101,"text":"Removerei da sua boca"},{"verse":102,"text":"os nomes dos baalins,"},{"verse":103,"text":"e ela não mais se lembrará"},{"verse":104,"text":"desses nomes."},{"verse":105,"text":"Naquele dia, farei a favor dela"},{"verse":106,"text":"uma aliança"},{"verse":107,"text":"com os animais selvagens,"},{"verse":108,"text":"com as aves do céu"},{"verse":109,"text":"e com os animais que rastejam"},{"verse":110,"text":"sobre a terra."},{"verse":111,"text":"Tirarei da terra o arco,"},{"verse":112,"text":"a espada e a guerra"},{"verse":113,"text":"e farei com que o meu povo"},{"verse":114,"text":"repouse em segurança."},{"verse":115,"text":"Farei de você a minha esposa"},{"verse":116,"text":"para sempre."},{"verse":117,"text":"Farei de você a minha esposa"},{"verse":118,"text":"em justiça,"},{"verse":119,"text":"em juízo, em bondade"},{"verse":120,"text":"e em misericórdia."},{"verse":121,"text":"Farei de você a minha esposa"},{"verse":122,"text":"em fidelidade,"},{"verse":123,"text":"e você conhecerá o"},{"verse":124,"text":"\"Naquele dia, eu responderei\","},{"verse":125,"text":"diz o"},{"verse":126,"text":"\"responderei aos céus,"},{"verse":127,"text":"e estes responderão à terra;"},{"verse":128,"text":"a terra responderá ao trigo,"},{"verse":129,"text":"ao vinho e ao azeite;"},{"verse":130,"text":"e estes responderão a Jezreel."},{"verse":131,"text":"Semearei Israel"},{"verse":132,"text":"para mim mesmo na terra"},{"verse":133,"text":"e terei compaixão de Lo-Ruamá."},{"verse":134,"text":"E para Lo-Ami direi:"},{"verse":135,"text":"‘Você é o meu povo!’"},{"verse":136,"text":"Ele responderá:"},{"verse":137,"text":"‘Tu és o meu Deus!’\""}]},{"chapter":3,"verses":[{"verse":0,"text":"O amor de Deus pelo povo infiel"},{"verse":1,"text":"O"},{"verse":2,"text":"— Vá outra vez e ame uma mulher, que é amada por outro e é adúltera, assim como o"},{"verse":3,"text":"Assim, comprei-a por quinze peças de prata e cento e cinquenta quilos de cevada."},{"verse":4,"text":"— Você vai ficar comigo por muito tempo. Você não deve se prostituir, nem se entregar a outro homem. E eu farei o mesmo em relação a você."},{"verse":5,"text":"Porque os filhos de Israel ficarão por muito tempo sem rei, sem príncipe, sem sacrifício, sem coluna, sem estola sacerdotal ou ídolos do lar."}]},{"chapter":4,"verses":[{"verse":0,"text":"Deus acusa Israel"},{"verse":1,"text":"Filhos de Israel, escutem"},{"verse":2,"text":"a palavra do"},{"verse":3,"text":"Porque o"},{"verse":4,"text":"uma controvérsia"},{"verse":5,"text":"com os moradores da terra:"},{"verse":6,"text":"\"Não há verdade, nem amor,"},{"verse":7,"text":"nem conhecimento de Deus"},{"verse":8,"text":"na terra,"},{"verse":9,"text":"mas apenas juramento falso,"},{"verse":10,"text":"mentira e assassinato,"},{"verse":11,"text":"roubo e adultério."},{"verse":12,"text":"Há violência e homicídios"},{"verse":13,"text":"sobre homicídios."},{"verse":14,"text":"Por isso, a terra está de luto,"},{"verse":15,"text":"e todos os seus moradores"},{"verse":16,"text":"desfalecem,"},{"verse":17,"text":"juntamente com os animais"},{"verse":18,"text":"do campo"},{"verse":19,"text":"e com as aves do céu;"},{"verse":20,"text":"e até os peixes do mar estão morrendo.\""},{"verse":21,"text":"Deus acusa os sacerdotes"},{"verse":22,"text":"\"Todavia, que ninguém acuse,"},{"verse":23,"text":"nem repreenda,"},{"verse":24,"text":"porque a minha acusação"},{"verse":25,"text":"é contra vocês, sacerdotes."},{"verse":26,"text":"Por isso, vocês tropeçarão de dia,"},{"verse":27,"text":"e os profetas,"},{"verse":28,"text":"juntamente com vocês,"},{"verse":29,"text":"tropeçarão de noite;"},{"verse":30,"text":"e eu destruirei a mãe de vocês."},{"verse":31,"text":"O meu povo"},{"verse":32,"text":"está sendo destruído,"},{"verse":33,"text":"pois lhe falta o conhecimento."},{"verse":34,"text":"Pelo fato de vocês, sacerdotes,"},{"verse":35,"text":"rejeitarem o conhecimento,"},{"verse":36,"text":"também eu os rejeitarei,"},{"verse":37,"text":"para que não sejam mais"},{"verse":38,"text":"sacerdotes diante de mim;"},{"verse":39,"text":"visto que se esqueceram"},{"verse":40,"text":"da lei do seu Deus,"},{"verse":41,"text":"também eu me esquecerei"},{"verse":42,"text":"dos seus filhos.\""},{"verse":43,"text":"\"Quanto mais estes"},{"verse":44,"text":"se multiplicaram,"},{"verse":45,"text":"tanto mais contra mim pecaram;"},{"verse":46,"text":"eu mudarei a sua honra"},{"verse":47,"text":"em vergonha."},{"verse":48,"text":"Alimentam-se do pecado"},{"verse":49,"text":"do meu povo"},{"verse":50,"text":"e o seu maior desejo"},{"verse":51,"text":"é que o povo continue a pecar."},{"verse":52,"text":"Por isso, tal povo, tal sacerdote;"},{"verse":53,"text":"eu os castigarei pela sua conduta"},{"verse":54,"text":"e lhes darei o que merecem"},{"verse":55,"text":"por seus atos."},{"verse":56,"text":"Comerão,"},{"verse":57,"text":"mas não ficarão satisfeitos;"},{"verse":58,"text":"eles se entregarão à prostituição,"},{"verse":59,"text":"mas não se multiplicarão,"},{"verse":60,"text":"porque deixaram de adorar"},{"verse":61,"text":"o"},{"verse":62,"text":"\"A prostituição,"},{"verse":63,"text":"o vinho envelhecido"},{"verse":64,"text":"e o vinho novo"},{"verse":65,"text":"tiram o entendimento."},{"verse":66,"text":"O meu povo consulta"},{"verse":67,"text":"os seus ídolos de madeira,"},{"verse":68,"text":"e um pedaço de pau"},{"verse":69,"text":"lhes dá resposta."},{"verse":70,"text":"Porque um espírito de prostituição"},{"verse":71,"text":"os enganou,"},{"verse":72,"text":"e eles, prostituindo-se,"},{"verse":73,"text":"abandonaram o seu Deus."},{"verse":74,"text":"Sacrificam no alto dos montes"},{"verse":75,"text":"e queimam incenso"},{"verse":76,"text":"sobre as colinas,"},{"verse":77,"text":"debaixo dos carvalhos,"},{"verse":78,"text":"dos álamos e dos terebintos,"},{"verse":79,"text":"porque é boa a sua sombra."},{"verse":80,"text":"Por isso, as filhas de vocês"},{"verse":81,"text":"se prostituem,"},{"verse":82,"text":"e as suas noras adulteram.\""},{"verse":83,"text":"\"Não castigarei"},{"verse":84,"text":"as filhas de vocês,"},{"verse":85,"text":"que se prostituem,"},{"verse":86,"text":"nem as suas noras,"},{"verse":87,"text":"quando adulteram,"},{"verse":88,"text":"porque os próprios homens"},{"verse":89,"text":"se retiram com as meretrizes"},{"verse":90,"text":"e oferecem sacrifícios"},{"verse":91,"text":"com as prostitutas cultuais."},{"verse":92,"text":"E um povo que não tem"},{"verse":93,"text":"entendimento"},{"verse":94,"text":"corre para a sua perdição.\""},{"verse":95,"text":"\"Se você, Israel,"},{"verse":96,"text":"quer se prostituir,"},{"verse":97,"text":"pelo menos não faça"},{"verse":98,"text":"com que Judá se torne culpado."},{"verse":99,"text":"Não venham a Gilgal,"},{"verse":100,"text":"nem subam a Bete-Áven."},{"verse":101,"text":"E não jurem, dizendo:"},{"verse":102,"text":"‘Tão certo como vive o"},{"verse":103,"text":"Como vaca rebelde,"},{"verse":104,"text":"Israel se rebelou."},{"verse":105,"text":"Será que o"},{"verse":106,"text":"pode apascentá-los"},{"verse":107,"text":"num lugar espaçoso"},{"verse":108,"text":"como se fossem cordeiros?\""},{"verse":109,"text":"\"Efraim está entregue aos ídolos;"},{"verse":110,"text":"é deixá-lo."},{"verse":111,"text":"Tendo acabado de beber,"},{"verse":112,"text":"eles se entregam à prostituição;"},{"verse":113,"text":"os seus príncipes amam"},{"verse":114,"text":"apaixonadamente a desonra."},{"verse":115,"text":"O vento os envolveu"},{"verse":116,"text":"nas suas asas,"},{"verse":117,"text":"e eles ficarão envergonhados"},{"verse":118,"text":"por causa dos seus sacrifícios.\""}]},{"chapter":5,"verses":[{"verse":0,"text":"Sentença contra Israel e Judá"},{"verse":1,"text":"\"Ouçam isto, sacerdotes!"},{"verse":2,"text":"Fique atenta, ó casa de Israel!"},{"verse":3,"text":"Dê ouvidos, ó casa do rei!"},{"verse":4,"text":"Porque a sentença é contra vocês!"},{"verse":5,"text":"Pois vocês foram"},{"verse":6,"text":"um laço em Mispa"},{"verse":7,"text":"e uma rede estendida"},{"verse":8,"text":"sobre o Tabor."},{"verse":9,"text":"Os rebeldes se aprofundaram"},{"verse":10,"text":"na matança,"},{"verse":11,"text":"mas eu castigarei todos eles.\""},{"verse":12,"text":"\"Eu conheço Efraim,"},{"verse":13,"text":"e Israel não me está oculto."},{"verse":14,"text":"Porque você, Efraim, se prostituiu,"},{"verse":15,"text":"e Israel está contaminado."},{"verse":16,"text":"O que eles fazem"},{"verse":17,"text":"não lhes permitem"},{"verse":18,"text":"voltar para o seu Deus,"},{"verse":19,"text":"porque um espírito"},{"verse":20,"text":"de prostituição"},{"verse":21,"text":"está no meio deles,"},{"verse":22,"text":"e não conhecem o"},{"verse":23,"text":"\"A arrogância de Israel"},{"verse":24,"text":"abertamente dá testemunho"},{"verse":25,"text":"contra eles;"},{"verse":26,"text":"Israel e Efraim cairão"},{"verse":27,"text":"por causa da sua iniquidade,"},{"verse":28,"text":"e Judá cairá juntamente com eles."},{"verse":29,"text":"Com os seus rebanhos"},{"verse":30,"text":"e o seu gado"},{"verse":31,"text":"irão em busca do"},{"verse":32,"text":"mas não o acharão;"},{"verse":33,"text":"ele se afastou deles."},{"verse":34,"text":"Foram infiéis ao"},{"verse":35,"text":"porque tiveram filhos bastardos;"},{"verse":36,"text":"agora a Festa da Lua Nova"},{"verse":37,"text":"os consumirá"},{"verse":38,"text":"com as suas plantações.\""},{"verse":39,"text":"\"Toquem a trombeta em Gibeá"},{"verse":40,"text":"e façam soar o alarme em Ramá!"},{"verse":41,"text":"Comecem a gritar em Bete-Áven!"},{"verse":42,"text":"Cuidado, Benjamim!"},{"verse":43,"text":"Efraim se tornará em desolação"},{"verse":44,"text":"no dia do castigo;"},{"verse":45,"text":"entre as tribos de Israel,"},{"verse":46,"text":"tornei conhecido"},{"verse":47,"text":"o que se cumprirá."},{"verse":48,"text":"Os príncipes de Judá são como"},{"verse":49,"text":"os que mudam os marcos;"},{"verse":50,"text":"derramarei o meu furor"},{"verse":51,"text":"sobre eles como água."},{"verse":52,"text":"Efraim está oprimido"},{"verse":53,"text":"e esmagado pelo juízo,"},{"verse":54,"text":"porque preferiu seguir a vaidade."},{"verse":55,"text":"Portanto, para Efraim eu serei"},{"verse":56,"text":"como a traça"},{"verse":57,"text":"e para a casa de Judá,"},{"verse":58,"text":"como a podridão.\""},{"verse":59,"text":"\"Quando Efraim viu"},{"verse":60,"text":"a sua enfermidade"},{"verse":61,"text":"e Judá notou a sua ferida,"},{"verse":62,"text":"Efraim se dirigiu à Assíria"},{"verse":63,"text":"e enviou mensageiros"},{"verse":64,"text":"ao grande rei."},{"verse":65,"text":"Mas ele não tem condições"},{"verse":66,"text":"de curá-los,"},{"verse":67,"text":"nem de sarar a sua ferida."},{"verse":68,"text":"Porque para Efraim"},{"verse":69,"text":"eu serei como um leão,"},{"verse":70,"text":"e para a casa de Judá,"},{"verse":71,"text":"como um leãozinho."},{"verse":72,"text":"Eu, eu mesmo, os despedaçarei"},{"verse":73,"text":"e depois irei embora;"},{"verse":74,"text":"vou arrastá-los comigo,"},{"verse":75,"text":"e não haverá quem possa livrá-los.\""},{"verse":76,"text":"\"Irei e voltarei para o meu lugar,"},{"verse":77,"text":"até que se reconheçam culpados"},{"verse":78,"text":"e busquem a minha face;"},{"verse":79,"text":"estando angustiados,"},{"verse":80,"text":"eles me buscarão ansiosamente.\""}]},{"chapter":6,"verses":[{"verse":0,"text":"Arrependimento fingido"},{"verse":1,"text":"\"Venham e voltemos"},{"verse":2,"text":"para o"},{"verse":3,"text":"Porque ele nos despedaçou,"},{"verse":4,"text":"mas vai nos curar;"},{"verse":5,"text":"ele nos feriu,"},{"verse":6,"text":"mas vai atar as feridas."},{"verse":7,"text":"Depois de dois dias,"},{"verse":8,"text":"nos dará vida;"},{"verse":9,"text":"ao terceiro dia, nos ressuscitará,"},{"verse":10,"text":"e viveremos diante dele."},{"verse":11,"text":"Conheçamos e prossigamos"},{"verse":12,"text":"em conhecer o"},{"verse":13,"text":"Como o amanhecer,"},{"verse":14,"text":"a sua vinda é certa;"},{"verse":15,"text":"ele descerá sobre nós"},{"verse":16,"text":"como a chuva,"},{"verse":17,"text":"como chuva fora de época"},{"verse":18,"text":"que rega a terra.\""},{"verse":19,"text":"\"Que farei com você, Efraim?"},{"verse":20,"text":"Que farei com você, Judá?"},{"verse":21,"text":"Porque o amor de vocês é"},{"verse":22,"text":"como a névoa da manhã"},{"verse":23,"text":"e como o orvalho da madrugada,"},{"verse":24,"text":"que logo desaparece."},{"verse":25,"text":"Por isso, os abati"},{"verse":26,"text":"por meio dos profetas;"},{"verse":27,"text":"pela palavra da minha boca,"},{"verse":28,"text":"os matei;"},{"verse":29,"text":"e os meus juízos sairão como a luz."},{"verse":30,"text":"Pois quero misericórdia,"},{"verse":31,"text":"e não sacrifício;"},{"verse":32,"text":"conhecimento de Deus,"},{"verse":33,"text":"mais do que holocaustos.\""},{"verse":34,"text":"\"Mas eles transgrediram"},{"verse":35,"text":"a aliança, como Adão;"},{"verse":36,"text":"eles foram infiéis a mim."},{"verse":37,"text":"Gileade é a cidade"},{"verse":38,"text":"dos que praticam a injustiça,"},{"verse":39,"text":"manchada de sangue."},{"verse":40,"text":"Como bandos de assaltantes"},{"verse":41,"text":"que espreitam alguém,"},{"verse":42,"text":"assim é a companhia"},{"verse":43,"text":"dos sacerdotes,"},{"verse":44,"text":"pois matam no caminho"},{"verse":45,"text":"para Siquém;"},{"verse":46,"text":"praticam perversidades."},{"verse":47,"text":"Vejo uma coisa horrenda"},{"verse":48,"text":"na casa de Israel:"},{"verse":49,"text":"ali está a prostituição de Efraim;"},{"verse":50,"text":"Israel se contaminou.\""},{"verse":51,"text":"\"Também você, Judá,"},{"verse":52,"text":"será ceifado,"},{"verse":53,"text":"quando eu remover o cativeiro"},{"verse":54,"text":"do meu povo."}]},{"chapter":7,"verses":[{"verse":1,"text":"Quando tento sarar Israel,"},{"verse":2,"text":"se descobre a iniquidade de Efraim"},{"verse":3,"text":"e a maldade de Samaria,"},{"verse":4,"text":"porque praticam a falsidade;"},{"verse":5,"text":"ladrões invadem as casas"},{"verse":6,"text":"e bandos assaltam nas ruas."},{"verse":7,"text":"Não se dão conta de que"},{"verse":8,"text":"eu me lembro de todas"},{"verse":9,"text":"as suas maldades."},{"verse":10,"text":"Agora estão rodeados"},{"verse":11,"text":"pelas suas más ações,"},{"verse":12,"text":"que estão sempre diante de mim."},{"verse":13,"text":"Alegram o rei"},{"verse":14,"text":"com as suas maldades,"},{"verse":15,"text":"e os príncipes,"},{"verse":16,"text":"com as suas mentiras."},{"verse":17,"text":"Todos eles são adúlteros."},{"verse":18,"text":"São semelhantes ao forno"},{"verse":19,"text":"aceso pelo padeiro,"},{"verse":20,"text":"que não precisa atiçar o fogo"},{"verse":21,"text":"desde que sovou a massa"},{"verse":22,"text":"até que seja levedada."},{"verse":23,"text":"No dia da festa do nosso rei,"},{"verse":24,"text":"os príncipes adoeceram"},{"verse":25,"text":"de tanto beber vinho,"},{"verse":26,"text":"e o rei estendeu a mão"},{"verse":27,"text":"aos zombadores."},{"verse":28,"text":"Enquanto estão à espreita,"},{"verse":29,"text":"preparam o coração"},{"verse":30,"text":"como um forno:"},{"verse":31,"text":"durante a noite"},{"verse":32,"text":"o seu furor se abranda,"},{"verse":33,"text":"mas, pela manhã, queima"},{"verse":34,"text":"como um fogo abrasador."},{"verse":35,"text":"Todos eles são quentes"},{"verse":36,"text":"como um forno"},{"verse":37,"text":"e consomem os seus juízes."},{"verse":38,"text":"Todos os seus reis caem,"},{"verse":39,"text":"mas não há ninguém entre eles"},{"verse":40,"text":"que me invoque.\""},{"verse":41,"text":"\"Efraim se mistura com os povos"},{"verse":42,"text":"e é um pão que não foi virado"},{"verse":43,"text":"na hora de assar."},{"verse":44,"text":"Estrangeiros sugam"},{"verse":45,"text":"as suas forças,"},{"verse":46,"text":"mas ele não percebe;"},{"verse":47,"text":"cabelos brancos"},{"verse":48,"text":"se espalham pela cabeça,"},{"verse":49,"text":"mas ele não o sabe."},{"verse":50,"text":"A arrogância de Israel"},{"verse":51,"text":"abertamente dá testemunho"},{"verse":52,"text":"contra eles,"},{"verse":53,"text":"mas eles não voltam"},{"verse":54,"text":"para o"},{"verse":55,"text":"nem o buscam em tudo isso.\""},{"verse":56,"text":"\"Porque Efraim é como"},{"verse":57,"text":"uma pomba ingênua,"},{"verse":58,"text":"sem entendimento:"},{"verse":59,"text":"chamam o Egito"},{"verse":60,"text":"e se voltam para a Assíria."},{"verse":61,"text":"Quando forem,"},{"verse":62,"text":"estenderei a minha rede sobre eles"},{"verse":63,"text":"e farei com que desçam"},{"verse":64,"text":"como as aves do céu."},{"verse":65,"text":"Eu os castigarei de acordo"},{"verse":66,"text":"com o que ouviram"},{"verse":67,"text":"na sua congregação."},{"verse":68,"text":"— Ai deles!"},{"verse":69,"text":"Porque fugiram de mim."},{"verse":70,"text":"Destruição sobre eles,"},{"verse":71,"text":"porque se rebelaram"},{"verse":72,"text":"contra mim!"},{"verse":73,"text":"Eu os remiria,"},{"verse":74,"text":"mas eles falam mentiras"},{"verse":75,"text":"contra mim.\""},{"verse":76,"text":"\"Não clamam a mim de coração,"},{"verse":77,"text":"mas dão uivos nas suas camas."},{"verse":78,"text":"Eles se ajuntam para o trigo"},{"verse":79,"text":"e para o vinho,"},{"verse":80,"text":"mas se rebelam contra mim."},{"verse":81,"text":"Eu treinei e fortaleci"},{"verse":82,"text":"os seus braços,"},{"verse":83,"text":"mas eles planejam"},{"verse":84,"text":"o mal contra mim."},{"verse":85,"text":"Eles voltam,"},{"verse":86,"text":"mas não para o Altíssimo."},{"verse":87,"text":"Fizeram-se"},{"verse":88,"text":"como um arco defeituoso."},{"verse":89,"text":"Os seus príncipes"},{"verse":90,"text":"serão mortos à espada,"},{"verse":91,"text":"por causa da insolência"},{"verse":92,"text":"da sua língua."},{"verse":93,"text":"Serão motivo de zombaria"},{"verse":94,"text":"na terra do Egito.\""}]},{"chapter":8,"verses":[{"verse":0,"text":"O castigo está próximo"},{"verse":1,"text":"\"Toque a trombeta!"},{"verse":2,"text":"Ele vem como a águia"},{"verse":3,"text":"contra a casa do"},{"verse":4,"text":"porque transgrediram"},{"verse":5,"text":"a minha aliança"},{"verse":6,"text":"e se rebelaram contra a minha lei."},{"verse":7,"text":"Eles me invocam, dizendo:"},{"verse":8,"text":"‘Nosso Deus!"},{"verse":9,"text":"Nós, Israel, te conhecemos.’"},{"verse":10,"text":"Mas Israel rejeitou o que é bom;"},{"verse":11,"text":"o inimigo o perseguirá.\""},{"verse":12,"text":"\"Eles estabeleceram reis,"},{"verse":13,"text":"mas não da minha parte;"},{"verse":14,"text":"constituíram príncipes,"},{"verse":15,"text":"mas eu não o soube."},{"verse":16,"text":"Com a sua prata e com o seu ouro"},{"verse":17,"text":"fizeram ídolos para si,"},{"verse":18,"text":"para a sua própria destruição."},{"verse":19,"text":"O seu bezerro, ó Samaria,"},{"verse":20,"text":"é rejeitado."},{"verse":21,"text":"A minha ira se acende contra eles."},{"verse":22,"text":"Até quando eles serão incapazes"},{"verse":23,"text":"da inocência?"},{"verse":24,"text":"Porque esse bezerro"},{"verse":25,"text":"vem de Israel;"},{"verse":26,"text":"é obra de artífice, não é Deus."},{"verse":27,"text":"Esse bezerro de Samaria"},{"verse":28,"text":"será quebrado em pedaços.\""},{"verse":29,"text":"\"Porque semeiam ventos"},{"verse":30,"text":"e colherão tempestades."},{"verse":31,"text":"O cereal que estiver por ser colhido"},{"verse":32,"text":"não terá espigas,"},{"verse":33,"text":"e não haverá farinha;"},{"verse":34,"text":"e, se houver, os estrangeiros"},{"verse":35,"text":"a comerão."},{"verse":36,"text":"Israel foi devorado."},{"verse":37,"text":"Agora está entre as nações"},{"verse":38,"text":"como coisa de que ninguém"},{"verse":39,"text":"se agrada."},{"verse":40,"text":"Porque foram pedir ajuda"},{"verse":41,"text":"à Assíria,"},{"verse":42,"text":"como um jumento selvagem"},{"verse":43,"text":"que segue o seu próprio rumo."},{"verse":44,"text":"Efraim contratou amantes."},{"verse":45,"text":"Todavia, ainda que contratem"},{"verse":46,"text":"amantes entre as nações"},{"verse":47,"text":"para socorrê-los,"},{"verse":48,"text":"eu os reunirei para juízo."},{"verse":49,"text":"Já começaram a definhar"},{"verse":50,"text":"sob a opressão do poderoso rei.\""},{"verse":51,"text":"\"Visto que Efraim multiplicou"},{"verse":52,"text":"altares para pecar,"},{"verse":53,"text":"estes altares lhe serviram"},{"verse":54,"text":"para pecar."},{"verse":55,"text":"Embora eu lhe escreva"},{"verse":56,"text":"a minha lei"},{"verse":57,"text":"em dez mil preceitos,"},{"verse":58,"text":"estes seriam tidos"},{"verse":59,"text":"como coisa estranha."},{"verse":60,"text":"Amam o sacrifício;"},{"verse":61,"text":"por isso, sacrificam,"},{"verse":62,"text":"pois gostam de carne e a comem,"},{"verse":63,"text":"mas o"},{"verse":64,"text":"Agora ele se lembrará"},{"verse":65,"text":"da iniquidade deles"},{"verse":66,"text":"e castigará os pecados"},{"verse":67,"text":"que cometeram."},{"verse":68,"text":"Vou mandá-los de volta"},{"verse":69,"text":"para o Egito!"},{"verse":70,"text":"Porque Israel se esqueceu"},{"verse":71,"text":"do seu Criador"},{"verse":72,"text":"e edificou palácios,"},{"verse":73,"text":"e Judá multiplicou"},{"verse":74,"text":"cidades fortificadas;"},{"verse":75,"text":"mas eu enviarei fogo"},{"verse":76,"text":"contra as suas cidades,"},{"verse":77,"text":"fogo que consumirá"},{"verse":78,"text":"os seus palácios.\""}]},{"chapter":9,"verses":[{"verse":0,"text":"O castigo de Israel"},{"verse":1,"text":"\"Não se alegre, Israel,"},{"verse":2,"text":"nem exulte como os outros povos."},{"verse":3,"text":"Porque você se prostituiu,"},{"verse":4,"text":"abandonando o seu Deus."},{"verse":5,"text":"Você gostou de receber"},{"verse":6,"text":"o pagamento de prostituta"},{"verse":7,"text":"em todas as eiras de cereais."},{"verse":8,"text":"A eira e o lagar"},{"verse":9,"text":"não os alimentarão;"},{"verse":10,"text":"e o vinho novo lhes faltará."},{"verse":11,"text":"Não permanecerão"},{"verse":12,"text":"na terra do"},{"verse":13,"text":"Efraim voltará para o Egito,"},{"verse":14,"text":"e na Assíria comerão"},{"verse":15,"text":"comida impura.\""},{"verse":16,"text":"\"Não oferecerão"},{"verse":17,"text":"libações de vinho ao"},{"verse":18,"text":"nem os seus sacrifícios"},{"verse":19,"text":"lhe serão agradáveis."},{"verse":20,"text":"O pão que comerem será"},{"verse":21,"text":"como pão de pranteadores,"},{"verse":22,"text":"e todos os que dele comerem"},{"verse":23,"text":"ficarão impuros."},{"verse":24,"text":"Esse pão será exclusivamente"},{"verse":25,"text":"para eles;"},{"verse":26,"text":"não entrará na Casa do"},{"verse":27,"text":"\"O que vocês farão"},{"verse":28,"text":"no dia da solenidade"},{"verse":29,"text":"e no dia da festa do"},{"verse":30,"text":"Porque eis que eles fugiram"},{"verse":31,"text":"por causa da destruição."},{"verse":32,"text":"O Egito os reunirá,"},{"verse":33,"text":"e Mênfis os sepultará."},{"verse":34,"text":"Os seus tesouros de prata"},{"verse":35,"text":"ficarão para as urtigas;"},{"verse":36,"text":"espinhos tomarão conta"},{"verse":37,"text":"das suas moradas.\""},{"verse":38,"text":"\"Chegaram os dias do castigo,"},{"verse":39,"text":"chegaram os dias da retribuição."},{"verse":40,"text":"Israel ficará sabendo."},{"verse":41,"text":"O profeta é um tolo,"},{"verse":42,"text":"e o homem de espírito é um louco,"},{"verse":43,"text":"por causa da abundância"},{"verse":44,"text":"da sua iniquidade,"},{"verse":45,"text":"ó Israel, e do seu imenso ódio."},{"verse":46,"text":"O profeta é sentinela"},{"verse":47,"text":"contra Efraim,"},{"verse":48,"text":"ao lado de meu Deus,"},{"verse":49,"text":"mas o laço do passarinheiro"},{"verse":50,"text":"se encontra"},{"verse":51,"text":"em todos os seus caminhos,"},{"verse":52,"text":"e inimizade no templo"},{"verse":53,"text":"do seu Deus."},{"verse":54,"text":"Eles se afundaram na corrupção,"},{"verse":55,"text":"como nos dias de Gibeá."},{"verse":56,"text":"O"},{"verse":57,"text":"das suas injustiças"},{"verse":58,"text":"e castigará os pecados"},{"verse":59,"text":"que eles cometeram.\""},{"verse":60,"text":"\"Encontrei Israel"},{"verse":61,"text":"como uvas no deserto;"},{"verse":62,"text":"vi os pais de vocês como"},{"verse":63,"text":"as primícias da figueira nova."},{"verse":64,"text":"Mas eles foram para Baal-Peor,"},{"verse":65,"text":"consagraram-se"},{"verse":66,"text":"à vergonhosa idolatria"},{"verse":67,"text":"e se tornaram tão abomináveis"},{"verse":68,"text":"como aquilo que amaram."},{"verse":69,"text":"Quanto a Efraim,"},{"verse":70,"text":"a sua glória voará como ave;"},{"verse":71,"text":"não haverá nascimento,"},{"verse":72,"text":"nem gravidez, nem concepção."},{"verse":73,"text":"Ainda que venham"},{"verse":74,"text":"a criar os seus filhos,"},{"verse":75,"text":"eu os privarei deles,"},{"verse":76,"text":"para que não fique nem um sequer."},{"verse":77,"text":"Ai deles, quando deles"},{"verse":78,"text":"eu me afastar!"},{"verse":79,"text":"Aos meus olhos,"},{"verse":80,"text":"Efraim era como Tiro,"},{"verse":81,"text":"plantado num lugar agradável;"},{"verse":82,"text":"mas Efraim levará os seus filhos"},{"verse":83,"text":"ao matador."},{"verse":84,"text":"Dá-lhes, ó"},{"verse":85,"text":"O que lhes darás?"},{"verse":86,"text":"Dá-lhes um ventre estéril"},{"verse":87,"text":"e seios sem leite.\""},{"verse":88,"text":"\"Toda a maldade deles"},{"verse":89,"text":"se acha em Gilgal;"},{"verse":90,"text":"foi ali que comecei a odiá-los."},{"verse":91,"text":"Por causa da maldade"},{"verse":92,"text":"das suas ações,"},{"verse":93,"text":"eu os expulsarei da minha casa."},{"verse":94,"text":"Não os amarei mais."},{"verse":95,"text":"Todos os seus príncipes"},{"verse":96,"text":"são rebeldes.\""},{"verse":97,"text":"\"Efraim está ferido."},{"verse":98,"text":"Secaram-se as suas raízes;"},{"verse":99,"text":"não dará fruto."},{"verse":100,"text":"E mesmo que as mulheres"},{"verse":101,"text":"voltem a dar à luz,"},{"verse":102,"text":"eu matarei esses filhos queridos."},{"verse":103,"text":"O meu Deus os rejeitará,"},{"verse":104,"text":"porque não lhe dão ouvidos;"},{"verse":105,"text":"e andarão sem rumo"},{"verse":106,"text":"entre as nações.\""}]},{"chapter":10,"verses":[{"verse":0,"text":"Israel semeou maldade e colherá destruição"},{"verse":1,"text":"\"Israel era uma videira"},{"verse":2,"text":"de ramagem viçosa,"},{"verse":3,"text":"que dava o seu fruto."},{"verse":4,"text":"Quanto mais abundantes os frutos,"},{"verse":5,"text":"maior o número de altares;"},{"verse":6,"text":"quanto mais a terra produzia,"},{"verse":7,"text":"tanto mais embelezavam"},{"verse":8,"text":"as colunas sagradas."},{"verse":9,"text":"O coração deles está dividido"},{"verse":10,"text":"e agora terão de pagar por isso."},{"verse":11,"text":"O"},{"verse":12,"text":"e destruirá as colunas sagradas.\""},{"verse":13,"text":"\"Agora eles vão dizer:"},{"verse":14,"text":"‘Não temos rei,"},{"verse":15,"text":"porque não tememos o"},{"verse":16,"text":"E o rei, que poderia fazer por nós?’"},{"verse":17,"text":"Falam palavras vãs,"},{"verse":18,"text":"juram falsamente e fazem alianças;"},{"verse":19,"text":"por isso, o juízo brota"},{"verse":20,"text":"como erva venenosa"},{"verse":21,"text":"nos sulcos dos campos."},{"verse":22,"text":"Os moradores de Samaria"},{"verse":23,"text":"ficarão com medo"},{"verse":24,"text":"por causa do bezerro"},{"verse":25,"text":"de Bete-Áven;"},{"verse":26,"text":"o seu povo se lamentará"},{"verse":27,"text":"por causa dele,"},{"verse":28,"text":"e os sacerdotes idólatras tremerão"},{"verse":29,"text":"por causa da sua glória,"},{"verse":30,"text":"que já se foi."},{"verse":31,"text":"Também o bezerro"},{"verse":32,"text":"será levado à Assíria"},{"verse":33,"text":"como presente para o grande rei."},{"verse":34,"text":"Efraim se cobrirá de vexame,"},{"verse":35,"text":"e Israel ficará com vergonha"},{"verse":36,"text":"do seu ídolo de madeira.\""},{"verse":37,"text":"\"O rei de Samaria será"},{"verse":38,"text":"como lasca de madeira"},{"verse":39,"text":"na superfície da água."},{"verse":40,"text":"Os lugares altos de Áven,"},{"verse":41,"text":"que são o pecado de Israel,"},{"verse":42,"text":"serão destruídos;"},{"verse":43,"text":"espinhos e ervas daninhas"},{"verse":44,"text":"crescerão sobre os seus altares."},{"verse":45,"text":"E o povo dirá aos montes:"},{"verse":46,"text":"‘Cubram-nos!’"},{"verse":47,"text":"E às colinas:"},{"verse":48,"text":"‘Caiam em cima de nós!’\""},{"verse":49,"text":"Deus dá a sentença contra Israel"},{"verse":50,"text":"\"Desde os dias de Gibeá,"},{"verse":51,"text":"você pecou, ó Israel,"},{"verse":52,"text":"e nesse pecado você permaneceu."},{"verse":53,"text":"Será que a batalha"},{"verse":54,"text":"contra os filhos da perversidade"},{"verse":55,"text":"não há de alcançá-los em Gibeá?"},{"verse":56,"text":"Eu os castigarei"},{"verse":57,"text":"na medida do meu desejo."},{"verse":58,"text":"Os povos se ajuntarão contra eles,"},{"verse":59,"text":"quando eu os punir por causa"},{"verse":60,"text":"de sua dupla transgressão."},{"verse":61,"text":"Porque Efraim"},{"verse":62,"text":"era uma bezerra domada,"},{"verse":63,"text":"que gostava de pisar"},{"verse":64,"text":"o trigo na eira."},{"verse":65,"text":"Coloquei o jugo"},{"verse":66,"text":"sobre o seu belo pescoço;"},{"verse":67,"text":"atrelei Efraim ao carro."},{"verse":68,"text":"Judá lavrará,"},{"verse":69,"text":"Jacó lhe desfará os torrões."},{"verse":70,"text":"Então eu disse:"},{"verse":71,"text":"‘Semeiem a justiça"},{"verse":72,"text":"e colham a misericórdia."},{"verse":73,"text":"Lavrem o campo não cultivado,"},{"verse":74,"text":"porque é tempo"},{"verse":75,"text":"de buscar o"},{"verse":76,"text":"até que ele venha,"},{"verse":77,"text":"e chova a justiça sobre vocês.’\""},{"verse":78,"text":"\"Vocês lavraram para a maldade,"},{"verse":79,"text":"colheram a injustiça"},{"verse":80,"text":"e comeram os frutos da mentira."},{"verse":81,"text":"Vocês confiaram"},{"verse":82,"text":"nos seus carros de guerra"},{"verse":83,"text":"e na multidão dos seus valentes,"},{"verse":84,"text":"e por isso entre o seu povo"},{"verse":85,"text":"se levantará o tumulto de guerra,"},{"verse":86,"text":"e todas as suas fortalezas"},{"verse":87,"text":"serão destruídas,"},{"verse":88,"text":"como Salmã destruiu Bete-Arbel"},{"verse":89,"text":"no dia da batalha."},{"verse":90,"text":"As mães foram despedaçadas"},{"verse":91,"text":"com os seus filhos."},{"verse":92,"text":"Assim se fará com você, ó Betel,"},{"verse":93,"text":"por causa da sua grande maldade."},{"verse":94,"text":"Ao amanhecer, o rei de Israel"},{"verse":95,"text":"será totalmente destruído.\""}]},{"chapter":11,"verses":[{"verse":0,"text":"O amor de Deus e a ingratidão de Israel"},{"verse":1,"text":"\"Quando Israel era menino,"},{"verse":2,"text":"eu o amei;"},{"verse":3,"text":"e do Egito chamei o meu filho."},{"verse":4,"text":"Quanto mais eu os chamava,"},{"verse":5,"text":"tanto mais se afastavam de mim;"},{"verse":6,"text":"sacrificavam a baalins"},{"verse":7,"text":"e queimavam incenso"},{"verse":8,"text":"às imagens de escultura."},{"verse":9,"text":"Mas fui eu que ensinei"},{"verse":10,"text":"Efraim a andar;"},{"verse":11,"text":"tomei-os nos meus braços,"},{"verse":12,"text":"mas eles não entenderam"},{"verse":13,"text":"que era eu que os curava."},{"verse":14,"text":"Atraí-os com cordas humanas,"},{"verse":15,"text":"com laços de amor;"},{"verse":16,"text":"fui para eles como quem alivia"},{"verse":17,"text":"o jugo de sobre o pescoço"},{"verse":18,"text":"e me inclinei"},{"verse":19,"text":"para dar-lhes de comer.\""},{"verse":20,"text":"\"Não voltarão"},{"verse":21,"text":"para a terra do Egito,"},{"verse":22,"text":"mas o assírio será o seu rei,"},{"verse":23,"text":"porque se recusam"},{"verse":24,"text":"a voltar para mim."},{"verse":25,"text":"A espada cairá"},{"verse":26,"text":"sobre as suas cidades,"},{"verse":27,"text":"consumirá os seus ferrolhos,"},{"verse":28,"text":"e as devorará,"},{"verse":29,"text":"por causa dos seus caprichos."},{"verse":30,"text":"Porque o meu povo é inclinado"},{"verse":31,"text":"a rebelar-se contra mim;"},{"verse":32,"text":"se são chamados a dirigir-se"},{"verse":33,"text":"para o alto, ninguém o faz."},{"verse":34,"text":"Como poderia eu abandoná-lo,"},{"verse":35,"text":"Efraim?"},{"verse":36,"text":"Como poderia entregá-lo, Israel?"},{"verse":37,"text":"Como faria com você"},{"verse":38,"text":"o que fiz com Admá?"},{"verse":39,"text":"Como poderia fazer de você"},{"verse":40,"text":"outra Zeboim?"},{"verse":41,"text":"Meu coração se comove"},{"verse":42,"text":"dentro de mim;"},{"verse":43,"text":"toda a minha compaixão"},{"verse":44,"text":"se manifesta."},{"verse":45,"text":"Não executarei o furor"},{"verse":46,"text":"da minha ira;"},{"verse":47,"text":"não voltarei para destruir Efraim."},{"verse":48,"text":"Porque eu sou Deus e não homem;"},{"verse":49,"text":"sou o Santo no meio de vocês."},{"verse":50,"text":"Não virei com ira.\""},{"verse":51,"text":"\"Seguirão o"},{"verse":52,"text":"que rugirá como leão."},{"verse":53,"text":"E, quando ele rugir,"},{"verse":54,"text":"os filhos, tremendo,"},{"verse":55,"text":"virão do Ocidente;"},{"verse":56,"text":"tremendo, como passarinhos,"},{"verse":57,"text":"virão os do Egito,"},{"verse":58,"text":"e, como pombas,"},{"verse":59,"text":"os da terra da Assíria."},{"verse":60,"text":"Eu os farei habitar"},{"verse":61,"text":"em suas próprias casas\","},{"verse":62,"text":"diz o"},{"verse":63,"text":"A condenação de Israel e de Judá"},{"verse":64,"text":"\"Efraim me cercou com mentiras,"},{"verse":65,"text":"e a casa de Israel, com engano;"},{"verse":66,"text":"mas Judá ainda está"},{"verse":67,"text":"do lado de Deus"},{"verse":68,"text":"e permanece fiel ao Santo."}]},{"chapter":12,"verses":[{"verse":1,"text":"Efraim apascenta o vento"},{"verse":2,"text":"e persegue o vento leste"},{"verse":3,"text":"o dia inteiro."},{"verse":4,"text":"Multiplica mentiras e destruição."},{"verse":5,"text":"Faz aliança com a Assíria,"},{"verse":6,"text":"mas o azeite é levado"},{"verse":7,"text":"para o Egito.\""},{"verse":8,"text":"A acusação contra Judá"},{"verse":9,"text":"\"O"},{"verse":10,"text":"com Judá"},{"verse":11,"text":"e castigará Jacó"},{"verse":12,"text":"segundo a sua conduta;"},{"verse":13,"text":"ele lhe dará o que merece"},{"verse":14,"text":"por seus atos."},{"verse":15,"text":"No ventre, Jacó pegou"},{"verse":16,"text":"no calcanhar de seu irmão;"},{"verse":17,"text":"no vigor da sua idade,"},{"verse":18,"text":"lutou com Deus."},{"verse":19,"text":"Lutou com o anjo e venceu;"},{"verse":20,"text":"chorou e pediu que o abençoasse."},{"verse":21,"text":"Em Betel, encontrou Deus,"},{"verse":22,"text":"e ali Deus falou com ele."},{"verse":23,"text":"O"},{"verse":24,"text":"o"},{"verse":25,"text":"Quanto a você,"},{"verse":26,"text":"volte para o seu Deus,"},{"verse":27,"text":"siga o amor e a justiça,"},{"verse":28,"text":"e espere sempre no seu Deus.\""},{"verse":29,"text":"\"Como mercador"},{"verse":30,"text":"que tem nas mãos"},{"verse":31,"text":"uma balança desonesta"},{"verse":32,"text":"e ama a opressão,"},{"verse":33,"text":"Efraim diz:"},{"verse":34,"text":"‘Certamente fiquei rico!"},{"verse":35,"text":"Encontrei muitas riquezas!"},{"verse":36,"text":"Em todos esses meus esforços,"},{"verse":37,"text":"não encontrarão em mim"},{"verse":38,"text":"nenhum delito,"},{"verse":39,"text":"nada que seja pecado.’"},{"verse":40,"text":"Mas eu sou o"},{"verse":41,"text":"seu Deus,"},{"verse":42,"text":"desde a terra do Egito;"},{"verse":43,"text":"eu ainda os farei habitar"},{"verse":44,"text":"em tendas,"},{"verse":45,"text":"como nos dias da festa.\""},{"verse":46,"text":"\"Falei aos profetas"},{"verse":47,"text":"e multipliquei as visões;"},{"verse":48,"text":"e, pelo ministério dos profetas,"},{"verse":49,"text":"propus símiles."},{"verse":50,"text":"Será que há transgressão"},{"verse":51,"text":"em Gileade?"},{"verse":52,"text":"Eles são pura vaidade!"},{"verse":53,"text":"Em Gilgal sacrificam bois;"},{"verse":54,"text":"os seus altares serão"},{"verse":55,"text":"como montões de pedra"},{"verse":56,"text":"nos sulcos dos campos."},{"verse":57,"text":"Jacó fugiu para a terra da Síria;"},{"verse":58,"text":"ali Israel trabalhou"},{"verse":59,"text":"para conseguir uma esposa"},{"verse":60,"text":"e por ela guardou o gado."},{"verse":61,"text":"Mas o"},{"verse":62,"text":"por meio de um profeta,"},{"verse":63,"text":"tirou Israel do Egito"},{"verse":64,"text":"e, por um profeta,"},{"verse":65,"text":"cuidou do seu povo."},{"verse":66,"text":"Efraim amargamente"},{"verse":67,"text":"o provocou à ira;"},{"verse":68,"text":"por isso, o seu Senhor fará"},{"verse":69,"text":"com que ele pague"},{"verse":70,"text":"pelo sangue que derramou"},{"verse":71,"text":"e lhe retribuirá"},{"verse":72,"text":"pelas suas afrontas.\""}]},{"chapter":13,"verses":[{"verse":0,"text":"Castigo definitivo"},{"verse":1,"text":"\"Quando Efraim falava,"},{"verse":2,"text":"havia tremor;"},{"verse":3,"text":"foi exaltado em Israel."},{"verse":4,"text":"Mas ele se fez culpado"},{"verse":5,"text":"por causa de Baal e morreu."},{"verse":6,"text":"Agora, pecam cada vez mais,"},{"verse":7,"text":"e da sua prata"},{"verse":8,"text":"fazem imagens de fundição,"},{"verse":9,"text":"ídolos segundo o seu conceito,"},{"verse":10,"text":"todos obra de artífices, e dizem:"},{"verse":11,"text":"‘Ofereçam sacrifícios a eles.’"},{"verse":12,"text":"Chegam até a beijar esses bezerros!"},{"verse":13,"text":"Por isso, serão"},{"verse":14,"text":"como a névoa da manhã,"},{"verse":15,"text":"como o orvalho da madrugada,"},{"verse":16,"text":"que logo desaparece,"},{"verse":17,"text":"como a palha"},{"verse":18,"text":"que o vento leva da eira"},{"verse":19,"text":"e como a fumaça"},{"verse":20,"text":"que sai por uma janela.\""},{"verse":21,"text":"\"Mas eu sou o"},{"verse":22,"text":"desde a terra do Egito."},{"verse":23,"text":"Portanto, vocês não conhecerão"},{"verse":24,"text":"outro deus além de mim,"},{"verse":25,"text":"porque não há salvador, a não ser eu."},{"verse":26,"text":"Eu os conheci no deserto,"},{"verse":27,"text":"em terra muito seca."},{"verse":28,"text":"Quando tinham comida,"},{"verse":29,"text":"eles se fartaram,"},{"verse":30,"text":"e, uma vez fartos,"},{"verse":31,"text":"seu coração se encheu de orgulho;"},{"verse":32,"text":"por isso, se esqueceram de mim."},{"verse":33,"text":"Portanto, serei para eles"},{"verse":34,"text":"como um leão;"},{"verse":35,"text":"como um leopardo,"},{"verse":36,"text":"ficarei espreitando no caminho."},{"verse":37,"text":"Como ursa,"},{"verse":38,"text":"roubada dos seus filhotes,"},{"verse":39,"text":"eu os atacarei"},{"verse":40,"text":"e lhes rasgarei o peito."},{"verse":41,"text":"Como leão,"},{"verse":42,"text":"eu os devorarei ali mesmo;"},{"verse":43,"text":"como um animal selvagem,"},{"verse":44,"text":"os farei em pedaços.\""},{"verse":45,"text":"\"A sua ruína, ó Israel,"},{"verse":46,"text":"vem de você,"},{"verse":47,"text":"e só de mim, o seu socorro."},{"verse":48,"text":"Onde está, agora, o seu rei,"},{"verse":49,"text":"para que o salve"},{"verse":50,"text":"em todas as suas cidades?"},{"verse":51,"text":"E os seus juízes,"},{"verse":52,"text":"dos quais você disse:"},{"verse":53,"text":"‘Dê-me um rei e príncipes’?"},{"verse":54,"text":"Eu lhe dei um rei na minha ira,"},{"verse":55,"text":"e o tirei de você no meu furor.\""},{"verse":56,"text":"\"As iniquidades de Efraim"},{"verse":57,"text":"estão atadas juntas;"},{"verse":58,"text":"o seu pecado está armazenado."},{"verse":59,"text":"As dores de parto virão,"},{"verse":60,"text":"mas ele é filho insensato;"},{"verse":61,"text":"porque será tempo de nascer,"},{"verse":62,"text":"mas ele não estará no lugar"},{"verse":63,"text":"por onde deve vir ao mundo.\""},{"verse":64,"text":"\"Eu os remirei"},{"verse":65,"text":"do poder do inferno"},{"verse":66,"text":"e os resgatarei da morte."},{"verse":67,"text":"Onde estão, ó morte,"},{"verse":68,"text":"as suas pragas?"},{"verse":69,"text":"Onde está, ó inferno,"},{"verse":70,"text":"a sua destruição?"},{"verse":71,"text":"Meus olhos estarão fechados"},{"verse":72,"text":"para a compaixão.\""},{"verse":73,"text":"\"Ainda que Efraim dê frutos"},{"verse":74,"text":"entre os irmãos,"},{"verse":75,"text":"virá o vento leste, vento do"},{"verse":76,"text":"subindo do deserto;"},{"verse":77,"text":"ele secará a sua nascente"},{"verse":78,"text":"e estancará a sua fonte;"},{"verse":79,"text":"ele saqueará o tesouro"},{"verse":80,"text":"de todas as coisas preciosas."},{"verse":81,"text":"Samaria levará sobre si"},{"verse":82,"text":"a sua culpa,"},{"verse":83,"text":"porque se rebelou"},{"verse":84,"text":"contra o seu Deus;"},{"verse":85,"text":"cairá à espada,"},{"verse":86,"text":"seus filhos serão despedaçados,"},{"verse":87,"text":"e as suas mulheres grávidas"},{"verse":88,"text":"serão abertas pelo meio.\""}]},{"chapter":14,"verses":[{"verse":0,"text":"Chamado para voltar ao Senhor"},{"verse":1,"text":"\"Israel, volte para o"},{"verse":2,"text":"seu Deus,"},{"verse":3,"text":"porque você caiu"},{"verse":4,"text":"por causa dos seus pecados."},{"verse":5,"text":"Tragam palavras"},{"verse":6,"text":"de arrependimento"},{"verse":7,"text":"e convertam-se"},{"verse":8,"text":"ao"},{"verse":9,"text":"‘Perdoa toda a nossa iniquidade,"},{"verse":10,"text":"aceita o que é bom"},{"verse":11,"text":"e, em vez de novilhos,"},{"verse":12,"text":"os sacrifícios dos nossos lábios."},{"verse":13,"text":"A Assíria não nos salvará."},{"verse":14,"text":"Não iremos montados em cavalos"},{"verse":15,"text":"e não mais diremos"},{"verse":16,"text":"às obras das nossas mãos"},{"verse":17,"text":"que elas são o nosso Deus."},{"verse":18,"text":"Porque só em ti"},{"verse":19,"text":"o órfão encontra misericórdia.’\""},{"verse":20,"text":"\"Vou curar a rebeldia deles."},{"verse":21,"text":"Vou amá-los de boa vontade,"},{"verse":22,"text":"porque a minha ira"},{"verse":23,"text":"se afastou deles."},{"verse":24,"text":"Serei para Israel como orvalho;"},{"verse":25,"text":"ele florescerá como o lírio"},{"verse":26,"text":"e lançará as suas raízes"},{"verse":27,"text":"como o cedro do Líbano."},{"verse":28,"text":"Os seus ramos se estenderão,"},{"verse":29,"text":"o seu esplendor"},{"verse":30,"text":"será como o da oliveira,"},{"verse":31,"text":"e a sua fragrância,"},{"verse":32,"text":"como a do cedro do Líbano."},{"verse":33,"text":"Os que se assentavam"},{"verse":34,"text":"à sua sombra voltarão;"},{"verse":35,"text":"serão vivificados como o trigo"},{"verse":36,"text":"e florescerão como a videira;"},{"verse":37,"text":"a sua fama será"},{"verse":38,"text":"como a do vinho do Líbano.\""},{"verse":39,"text":"\"Ó Efraim, que tenho eu"},{"verse":40,"text":"a ver com os ídolos?"},{"verse":41,"text":"Sou eu que ouço as suas orações"},{"verse":42,"text":"e cuido de você!"},{"verse":43,"text":"Eu sou como o cipreste verde;"},{"verse":44,"text":"de mim procede o seu fruto.\""},{"verse":45,"text":"Apelo final"},{"verse":46,"text":"Quem é sábio,"},{"verse":47,"text":"que entenda estas coisas!"},{"verse":48,"text":"Quem é inteligente,"},{"verse":49,"text":"que as compreenda!"},{"verse":50,"text":"Porque os caminhos do"},{"verse":51,"text":"são retos,"},{"verse":52,"text":"e os justos andarão neles,"},{"verse":53,"text":"mas os transgressores neles cairão."}]}]}