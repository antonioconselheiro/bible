[[{"verse":"1","text":"Palavra do"},{"verse":"","text":"Ameaças contra Samaria e Jerusalém"},{"verse":"2","text":"\"Escutem, todos os povos!"},{"verse":"","text":"Prestem atenção, ó terra"},{"verse":"","text":"e todos os seus moradores!"},{"verse":"","text":"O"},{"verse":"","text":"contra vocês;"},{"verse":"","text":"do seu santo templo,"},{"verse":"","text":"o Senhor falará."},{"verse":"3","text":"Porque eis que o"},{"verse":"","text":"sai do seu lugar;"},{"verse":"","text":"ele desce e anda"},{"verse":"","text":"sobre os altos da terra."},{"verse":"4","text":"Os montes debaixo dele"},{"verse":"","text":"se derretem,"},{"verse":"","text":"e os vales se fendem;"},{"verse":"","text":"são como a cera diante do fogo,"},{"verse":"","text":"como as águas que se precipitam"},{"verse":"","text":"num abismo.\""},{"verse":"5","text":"\"Tudo isso por causa"},{"verse":"","text":"da transgressão de Jacó"},{"verse":"","text":"e dos pecados da casa de Israel."},{"verse":"","text":"Qual é a transgressão de Jacó?"},{"verse":"","text":"Será que não é Samaria?"},{"verse":"","text":"E quais são os lugares altos"},{"verse":"","text":"de Judá?"},{"verse":"","text":"Será que não é Jerusalém?"},{"verse":"6","text":"Por isso, farei de Samaria"},{"verse":"","text":"um montão de pedras"},{"verse":"","text":"no campo,"},{"verse":"","text":"uma terra de plantar vinhas."},{"verse":"","text":"Farei com que as pedras rolem"},{"verse":"","text":"para o vale"},{"verse":"","text":"e deixarei descobertos"},{"verse":"","text":"os seus alicerces."},{"verse":"7","text":"Todas as suas imagens"},{"verse":"","text":"de escultura"},{"verse":"","text":"serão despedaçadas,"},{"verse":"","text":"e tudo o que ela ganhou"},{"verse":"","text":"com a sua impureza"},{"verse":"","text":"será queimado."},{"verse":"","text":"De todos os seus ídolos"},{"verse":"","text":"eu farei uma ruína."},{"verse":"","text":"Visto que ela os ajuntou"},{"verse":"","text":"com pagamento"},{"verse":"","text":"por prostituição,"},{"verse":"","text":"em pagamento por prostituição"},{"verse":"","text":"eles serão transformados.\""},{"verse":"8","text":"\"Por isso, lamento e choro;"},{"verse":"","text":"ando descalço e nu;"},{"verse":"","text":"faço lamentações como os chacais"},{"verse":"","text":"e pranteio como os avestruzes."},{"verse":"9","text":"Porque as feridas de Samaria"},{"verse":"","text":"são incuráveis;"},{"verse":"","text":"o mal chegou até Judá;"},{"verse":"","text":"estendeu-se até a porta"},{"verse":"","text":"do meu povo,"},{"verse":"","text":"até Jerusalém."},{"verse":"10","text":"Não anunciem isso em Gate,"},{"verse":"","text":"nem chorem;"},{"verse":"","text":"rolem no pó, em Bete-Leafra."},{"verse":"11","text":"Moradores de Safir,"},{"verse":"","text":"sigam para o exílio"},{"verse":"","text":"em vergonhosa nudez."},{"verse":"","text":"Os moradores de Zaanã"},{"verse":"","text":"não podem sair da cidade;"},{"verse":"","text":"o pranto do povo de Bete-Ezel"},{"verse":"","text":"tira de vocês"},{"verse":"","text":"o lugar de refúgio."},{"verse":"12","text":"Os moradores de Marote"},{"verse":"","text":"suspiram pelo bem,"},{"verse":"","text":"porque o"},{"verse":"","text":"até as portas de Jerusalém."},{"verse":"13","text":"Moradores de Laquis,"},{"verse":"","text":"atrelem os ginetes aos carros!"},{"verse":"","text":"Com vocês teve início"},{"verse":"","text":"o pecado da filha de Sião;"},{"verse":"","text":"entre vocês se encontraram"},{"verse":"","text":"as transgressões de Israel."},{"verse":"14","text":"Portanto, vocês darão presentes"},{"verse":"","text":"de despedida a Moresete-Gate;"},{"verse":"","text":"as casas de Aczibe serão algo"},{"verse":"","text":"enganoso para os reis de Israel."},{"verse":"15","text":"Enviarei ainda quem tomará"},{"verse":"","text":"posse de vocês,"},{"verse":"","text":"moradores de Maressa;"},{"verse":"","text":"a glória de Israel chegará"},{"verse":"","text":"até Adulão."},{"verse":"16","text":"Cortem os cabelos"},{"verse":"","text":"e rapem a cabeça"},{"verse":"","text":"por causa dos seus filhos queridos;"},{"verse":"","text":"alarguem a sua calva como a águia,"},{"verse":"","text":"porque esses filhos serão levados"},{"verse":"","text":"para o cativeiro.\""}],[{"verse":"","text":"Ai dos opressores gananciosos"},{"verse":"1","text":"\"Ai daqueles que,"},{"verse":"","text":"ainda no seu leito,"},{"verse":"","text":"imaginam a iniquidade"},{"verse":"","text":"e planejam o mal!"},{"verse":"","text":"Ao amanhecer, eles o praticam,"},{"verse":"","text":"porque têm poder para tanto."},{"verse":"2","text":"Cobiçam campos"},{"verse":"","text":"e se apossam deles;"},{"verse":"","text":"cobiçam casas e as tomam;"},{"verse":"","text":"assim, fazem violência"},{"verse":"","text":"a um homem e à sua casa,"},{"verse":"","text":"a uma pessoa e à sua herança.\""},{"verse":"3","text":"Portanto, assim diz o"},{"verse":"","text":"\"Eis que estou forjando"},{"verse":"","text":"uma calamidade"},{"verse":"","text":"contra esta família,"},{"verse":"","text":"da qual vocês não livrarão"},{"verse":"","text":"o seu pescoço."},{"verse":"","text":"Vocês não andarão mais"},{"verse":"","text":"de cabeça erguida,"},{"verse":"","text":"porque será um tempo"},{"verse":"","text":"de calamidade."},{"verse":"4","text":"Naquele dia, se criará"},{"verse":"","text":"um provérbio"},{"verse":"","text":"a respeito de vocês"},{"verse":"","text":"e se entoará"},{"verse":"","text":"a seguinte lamentação:"},{"verse":"","text":"‘Estamos completamente"},{"verse":"","text":"arruinados!"},{"verse":"","text":"A porção do meu povo,"},{"verse":"","text":"Deus a trocou!"},{"verse":"","text":"Como ele tirou o que era nosso!"},{"verse":"","text":"Entregou os nossos campos"},{"verse":"","text":"aos rebeldes!’"},{"verse":"5","text":"Portanto, na congregação"},{"verse":"","text":"do"},{"verse":"","text":"quando a terra for dividida"},{"verse":"","text":"por sorteio,"},{"verse":"","text":"vocês não receberão"},{"verse":"","text":"nem uma parte dela.\""},{"verse":"","text":"Contra os falsos profetas"},{"verse":"6","text":"\"Eles dizem:"},{"verse":"","text":"‘Não profetizem."},{"verse":"","text":"Não profetizem tais coisas,"},{"verse":"","text":"porque a desgraça"},{"verse":"","text":"não cairá sobre nós."},{"verse":"7","text":"Tais coisas anunciadas"},{"verse":"","text":"não alcançarão a casa de Jacó."},{"verse":"","text":"Estaria o Espírito"},{"verse":"","text":"do"},{"verse":"","text":"Será que ele agiria assim?’\""},{"verse":"","text":"\"De fato, as minhas palavras"},{"verse":"","text":"fazem o bem"},{"verse":"","text":"ao que anda retamente."},{"verse":"8","text":"Mas, há pouco, o meu povo"},{"verse":"","text":"se levantou como um inimigo."},{"verse":"","text":"Além da roupa,"},{"verse":"","text":"vocês arrancam a capa"},{"verse":"","text":"daqueles que passam seguros,"},{"verse":"","text":"sem pensar em guerra."},{"verse":"9","text":"Vocês expulsam"},{"verse":"","text":"do seu lar querido"},{"verse":"","text":"as mulheres de meu povo;"},{"verse":"","text":"dos filhinhos delas vocês tiram"},{"verse":"","text":"a minha glória, para sempre."},{"verse":"10","text":"Levantem-se e vão embora!"},{"verse":"","text":"Porque este não é"},{"verse":"","text":"o lugar de descanso."},{"verse":"","text":"Vão embora"},{"verse":"","text":"por causa da impureza"},{"verse":"","text":"que traz destruição,"},{"verse":"","text":"sim, destruição enorme."},{"verse":"11","text":"Se alguém, seguindo o vento"},{"verse":"","text":"e a falsidade,"},{"verse":"","text":"inventar uma mentira do tipo:"},{"verse":"","text":"‘Eu lhes profetizarei"},{"verse":"","text":"a respeito de vinho"},{"verse":"","text":"e de bebida forte’,"},{"verse":"","text":"esse tal será o profeta deste povo.\""},{"verse":"","text":"O Senhor congrega o remanescente de Israel"},{"verse":"12","text":"\"Certamente eu ajuntarei"},{"verse":"","text":"todos vocês, casa de Jacó;"},{"verse":"","text":"certamente congregarei"},{"verse":"","text":"o remanescente de Israel."},{"verse":"","text":"Eu os porei todos juntos,"},{"verse":"","text":"como ovelhas no aprisco,"},{"verse":"","text":"como rebanho"},{"verse":"","text":"no meio de sua pastagem;"},{"verse":"","text":"farão muito barulho,"},{"verse":"","text":"por causa da multidão"},{"verse":"","text":"de pessoas."},{"verse":"13","text":"Diante deles virá"},{"verse":"","text":"o que abre caminho;"},{"verse":"","text":"eles abrirão caminho,"},{"verse":"","text":"entrarão pelo portão"},{"verse":"","text":"e sairão por ele;"},{"verse":"","text":"e o seu Rei irá adiante deles;"},{"verse":"","text":"sim, o"},{"verse":"","text":"à frente deles.\""}],[{"verse":"","text":"Ameaças contra os maus governantes e os falsos profetas"},{"verse":"1","text":"Eu disse:"},{"verse":"","text":"Escutem agora,"},{"verse":"","text":"governantes de Jacó"},{"verse":"","text":"e chefes da casa de Israel:"},{"verse":"","text":"Por acaso não é a vocês"},{"verse":"","text":"que compete"},{"verse":"","text":"conhecer a justiça?"},{"verse":"2","text":"Mas vocês odeiam o bem"},{"verse":"","text":"e amam o mal;"},{"verse":"","text":"arrancam a pele do meu povo"},{"verse":"","text":"e a carne de cima dos seus ossos."},{"verse":"3","text":"Vocês comem a carne"},{"verse":"","text":"do meu povo"},{"verse":"","text":"e lhes arrancam a pele;"},{"verse":"","text":"quebram os seus ossos,"},{"verse":"","text":"e os repartem em pedaços"},{"verse":"","text":"que vão para a panela"},{"verse":"","text":"e em carne que vai"},{"verse":"","text":"para o caldeirão."},{"verse":"4","text":"Um dia eles hão de invocar"},{"verse":"","text":"o"},{"verse":"","text":"mas ele não os ouvirá;"},{"verse":"","text":"naquele tempo, esconderá deles"},{"verse":"","text":"a sua face,"},{"verse":"","text":"por causa do mal que praticaram."},{"verse":"5","text":"Assim diz o"},{"verse":"","text":"a respeito dos profetas"},{"verse":"","text":"que fazem o meu povo"},{"verse":"","text":"andar errante"},{"verse":"","text":"e que clamam: \"Paz\","},{"verse":"","text":"quando têm o que mastigar,"},{"verse":"","text":"mas apregoam guerra santa"},{"verse":"","text":"contra aqueles"},{"verse":"","text":"que não lhes dão nada para comer:"},{"verse":"6","text":"\"Por isso, vocês terão noites"},{"verse":"","text":"sem visões;"},{"verse":"","text":"vocês terão trevas"},{"verse":"","text":"sem adivinhações."},{"verse":"","text":"O sol se porá sobre os profetas,"},{"verse":"","text":"e o dia se transformará em escuridão."},{"verse":"7","text":"Os videntes serão envergonhados,"},{"verse":"","text":"e os adivinhos serão humilhados."},{"verse":"","text":"Todos eles colocarão a mão"},{"verse":"","text":"sobre a boca,"},{"verse":"","text":"porque não haverá resposta"},{"verse":"","text":"de Deus.\""},{"verse":"8","text":"Quanto a mim, estou cheio"},{"verse":"","text":"do poder do Espírito do"},{"verse":"","text":"cheio de justiça e de força,"},{"verse":"","text":"para declarar a Jacó"},{"verse":"","text":"a sua transgressão"},{"verse":"","text":"e a Israel, o seu pecado."},{"verse":"9","text":"Escutem agora isto,"},{"verse":"","text":"governantes da casa de Jacó"},{"verse":"","text":"e chefes da casa de Israel,"},{"verse":"","text":"vocês que detestam a justiça"},{"verse":"","text":"e pervertem tudo o que é correto,"},{"verse":"10","text":"que edificam Sião com sangue"},{"verse":"","text":"e Jerusalém, com iniquidade."},{"verse":"11","text":"Os seus cabeças dão"},{"verse":"","text":"as sentenças por suborno,"},{"verse":"","text":"os seus sacerdotes ensinam"},{"verse":"","text":"por interesse,"},{"verse":"","text":"e os seus profetas adivinham"},{"verse":"","text":"por dinheiro."},{"verse":"","text":"E ainda se apoiam no"},{"verse":"","text":"dizendo:"},{"verse":"","text":"\"Não está o"},{"verse":"","text":"no meio de nós?"},{"verse":"","text":"Nenhum mal nos sobrevirá.\""},{"verse":"12","text":"Portanto, por causa de vocês,"},{"verse":"","text":"Sião será lavrada como um campo,"},{"verse":"","text":"e Jerusalém se tornará"},{"verse":"","text":"um montão de ruínas,"},{"verse":"","text":"e o monte do templo,"},{"verse":"","text":"numa colina coberta de mato."}],[{"verse":"","text":"O monte do Senhor"},{"verse":"1","text":"Nos últimos dias,"},{"verse":"","text":"o monte do templo do"},{"verse":"","text":"será estabelecido"},{"verse":"","text":"no alto dos montes"},{"verse":"","text":"e se elevará sobre as colinas,"},{"verse":"","text":"e para ele afluirão os povos."},{"verse":"2","text":"Muitas nações virão e dirão:"},{"verse":"","text":"\"Venham, subamos"},{"verse":"","text":"ao monte do"},{"verse":"","text":"e ao templo do Deus de Jacó,"},{"verse":"","text":"para que nos ensine"},{"verse":"","text":"os seus caminhos,"},{"verse":"","text":"e andemos nas suas veredas.\""},{"verse":"","text":"Porque de Sião sairá a lei,"},{"verse":"","text":"e a palavra do"},{"verse":"","text":"de Jerusalém."},{"verse":"3","text":"Ele julgará entre muitos povos"},{"verse":"","text":"e corrigirá nações poderosas"},{"verse":"","text":"e distantes."},{"verse":"","text":"Estas transformarão as suas espadas"},{"verse":"","text":"em lâminas de arados"},{"verse":"","text":"e as suas lanças, em foices."},{"verse":"","text":"Nação não levantará a espada"},{"verse":"","text":"contra nação,"},{"verse":"","text":"nem aprenderão mais a guerra."},{"verse":"4","text":"Mas cada um se assentará"},{"verse":"","text":"debaixo da sua videira"},{"verse":"","text":"e debaixo da sua figueira,"},{"verse":"","text":"e não haverá quem os atemorize,"},{"verse":"","text":"porque a boca do"},{"verse":"","text":"Senhor"},{"verse":"5","text":"Porque todos os povos andam,"},{"verse":"","text":"cada um em nome do seu deus;"},{"verse":"","text":"mas, quanto a nós, andaremos"},{"verse":"","text":"em nome do"},{"verse":"","text":"para todo o sempre."},{"verse":"","text":"Deus salvará o seu povo"},{"verse":"6","text":"\"Naquele dia\","},{"verse":"","text":"diz o"},{"verse":"","text":"\"congregarei os que coxeiam"},{"verse":"","text":"e recolherei"},{"verse":"","text":"os que foram expulsos"},{"verse":"","text":"e os que eu tinha afligido."},{"verse":"7","text":"Dos que coxeiam"},{"verse":"","text":"farei um remanescente"},{"verse":"","text":"e dos que foram lançados"},{"verse":"","text":"para longe,"},{"verse":"","text":"uma nação poderosa;"},{"verse":"","text":"e o"},{"verse":"","text":"no monte Sião,"},{"verse":"","text":"desde agora e para sempre."},{"verse":"8","text":"A você, ó torre do rebanho,"},{"verse":"","text":"monte da filha de Sião,"},{"verse":"","text":"a você virá, sim,"},{"verse":"","text":"virá o primeiro domínio,"},{"verse":"","text":"o reino da filha de Jerusalém.\""},{"verse":"9","text":"Agora, por que você está"},{"verse":"","text":"gritando tão alto?"},{"verse":"","text":"Será porque você não tem rei?"},{"verse":"","text":"Morreram os seus conselheiros?"},{"verse":"","text":"Apoderou-se de você a dor"},{"verse":"","text":"como da mulher"},{"verse":"","text":"que está dando à luz?"},{"verse":"10","text":"Suporte as dores e faça força,"},{"verse":"","text":"filha de Sião,"},{"verse":"","text":"como a mulher"},{"verse":"","text":"que está dando à luz."},{"verse":"","text":"Porque agora vocês terão"},{"verse":"","text":"de sair da cidade"},{"verse":"","text":"e morar nos campos;"},{"verse":"","text":"vocês irão para a Babilônia."},{"verse":"","text":"Ali, porém, vocês serão libertados;"},{"verse":"","text":"ali, o"},{"verse":"","text":"das mãos dos inimigos."},{"verse":"11","text":"Agora muitas nações se reuniram"},{"verse":"","text":"contra você, dizendo:"},{"verse":"","text":"\"Que Jerusalém seja profanada!"},{"verse":"","text":"Que os nossos olhos se deliciem"},{"verse":"","text":"com a ruína de Sião!\""},{"verse":"12","text":"Mas essas nações não conhecem"},{"verse":"","text":"os pensamentos do"},{"verse":"","text":"nem entendem o seu plano:"},{"verse":"","text":"ele as ajuntou como feixes"},{"verse":"","text":"a serem batidos na eira."},{"verse":"13","text":"Levante-se e comece a debulhar,"},{"verse":"","text":"ó filha de Sião,"},{"verse":"","text":"porque eu lhe darei chifres de ferro"},{"verse":"","text":"e cascos de bronze."},{"verse":"","text":"Você esmagará muitos povos,"},{"verse":"","text":"e as riquezas que eles adquiriram"},{"verse":"","text":"serão dedicadas ao"},{"verse":"","text":"e os bens que eles conquistaram"},{"verse":"","text":"pela força"},{"verse":"","text":"serão consagrados ao Senhor"},{"verse":"","text":"de toda a terra."}],[{"verse":"1","text":"Agora ajunte-se em tropas,"},{"verse":"","text":"ó filha de tropas,"},{"verse":"","text":"porque fomos sitiados,"},{"verse":"","text":"e ferirão com uma vara"},{"verse":"","text":"a face do juiz de Israel."},{"verse":"","text":"O nascimento do Messias e o seu reinado"},{"verse":"2","text":"\"E você, Belém-Efrata,"},{"verse":"","text":"que é pequena demais para figurar"},{"verse":"","text":"como grupo de milhares de Judá,"},{"verse":"","text":"de você me sairá aquele"},{"verse":"","text":"que há de reinar em Israel,"},{"verse":"","text":"e cujas origens são"},{"verse":"","text":"desde os tempos antigos,"},{"verse":"","text":"desde os dias da eternidade.\""},{"verse":"3","text":"Portanto, o"},{"verse":"","text":"até o tempo em que"},{"verse":"","text":"a que está em dores"},{"verse":"","text":"tiver dado à luz;"},{"verse":"","text":"então o restante de seus irmãos"},{"verse":"","text":"voltará aos filhos de Israel."},{"verse":"4","text":"Ele se manterá firme"},{"verse":"","text":"e apascentará o povo"},{"verse":"","text":"na força do"},{"verse":"","text":"na majestade do nome do"},{"verse":"","text":"seu Deus;"},{"verse":"","text":"e eles habitarão seguros,"},{"verse":"","text":"porque, agora,"},{"verse":"","text":"ele será engrandecido"},{"verse":"","text":"até os confins da terra."},{"verse":"5","text":"E ele será a nossa paz."},{"verse":"","text":"Quando a Assíria vier à nossa terra"},{"verse":"","text":"e quando entrar"},{"verse":"","text":"em nossas fortalezas,"},{"verse":"","text":"levantaremos contra ela"},{"verse":"","text":"sete pastores"},{"verse":"","text":"e oito chefes do povo."},{"verse":"6","text":"Estes dominarão a terra da Assíria"},{"verse":"","text":"com a espada,"},{"verse":"","text":"e a terra de Ninrode,"},{"verse":"","text":"dentro de suas próprias portas."},{"verse":"","text":"Assim, nos livrará da Assíria,"},{"verse":"","text":"quando esta vier à nossa terra"},{"verse":"","text":"e invadir as nossas fronteiras."},{"verse":"7","text":"O remanescente de Jacó estará"},{"verse":"","text":"no meio de muitos povos"},{"verse":"","text":"como orvalho do"},{"verse":"","text":"como chuvisco sobre a relva,"},{"verse":"","text":"que não espera pelo homem,"},{"verse":"","text":"nem depende"},{"verse":"","text":"dos filhos de homens."},{"verse":"8","text":"O remanescente de Jacó"},{"verse":"","text":"estará entre as nações,"},{"verse":"","text":"no meio de muitos povos,"},{"verse":"","text":"como um leão entre"},{"verse":"","text":"os animais da floresta,"},{"verse":"","text":"como um leãozinho"},{"verse":"","text":"entre os rebanhos de ovelhas,"},{"verse":"","text":"o qual, se passar,"},{"verse":"","text":"ataca e despedaça a presa,"},{"verse":"","text":"sem que ninguém a possa livrar."},{"verse":"9","text":"A sua mão se exaltará"},{"verse":"","text":"sobre os seus adversários,"},{"verse":"","text":"e todos os seus inimigos"},{"verse":"","text":"serão eliminados."},{"verse":"10","text":"\"Naquele dia\","},{"verse":"","text":"diz o"},{"verse":"","text":"\"eliminarei do meio de vocês"},{"verse":"","text":"os cavalos"},{"verse":"","text":"e destruirei os carros de guerra;"},{"verse":"11","text":"destruirei as cidades da sua terra"},{"verse":"","text":"e derrubarei todas as fortalezas"},{"verse":"","text":"de vocês;"},{"verse":"12","text":"arrancarei as feitiçarias"},{"verse":"","text":"das suas mãos,"},{"verse":"","text":"e vocês não mais terão adivinhos;"},{"verse":"13","text":"do meio de vocês eliminarei"},{"verse":"","text":"as imagens de escultura"},{"verse":"","text":"e as colunas,"},{"verse":"","text":"e vocês não mais se inclinarão"},{"verse":"","text":"diante do que fizeram"},{"verse":"","text":"com as suas próprias mãos;"},{"verse":"14","text":"eliminarei do meio de vocês"},{"verse":"","text":"os postes da deusa Aserá"},{"verse":"","text":"e destruirei as cidades de vocês."},{"verse":"15","text":"Com ira e furor,"},{"verse":"","text":"eu me vingarei das nações"},{"verse":"","text":"que não me obedeceram.\""}],[{"verse":"","text":"Deus entrará em juízo com o seu povo"},{"verse":"1","text":"Escutem agora"},{"verse":"","text":"o que diz o"},{"verse":"","text":"\"Levante-se, defenda a sua causa"},{"verse":"","text":"diante dos montes,"},{"verse":"","text":"e que as colinas ouçam a sua voz."},{"verse":"2","text":"Ó montes, escutem"},{"verse":"","text":"a controvérsia do"},{"verse":"","text":"e vocês, duráveis fundamentos"},{"verse":"","text":"da terra,"},{"verse":"","text":"prestem atenção, porque o"},{"verse":"","text":"tem uma controvérsia"},{"verse":"","text":"com o seu povo"},{"verse":"","text":"e entrará em juízo com Israel.\""},{"verse":"3","text":"\"Meu povo,"},{"verse":"","text":"o que foi que eu lhe fiz?"},{"verse":"","text":"E como foi que eu"},{"verse":"","text":"o levei a ficar cansado?"},{"verse":"","text":"Responda!"},{"verse":"4","text":"Pois eu o tirei da terra do Egito"},{"verse":"","text":"e o resgatei da casa da servidão,"},{"verse":"","text":"e enviei adiante de você"},{"verse":"","text":"Moisés, Arão e Miriã."},{"verse":"5","text":"Meu povo,"},{"verse":"","text":"lembre-se do que Balaque,"},{"verse":"","text":"rei de Moabe, havia planejado"},{"verse":"","text":"e do que Balaão, filho de Beor,"},{"verse":"","text":"lhe respondeu."},{"verse":"","text":"Lembre-se também"},{"verse":"","text":"do que aconteceu"},{"verse":"","text":"desde Sitim até Gilgal,"},{"verse":"","text":"para que você conheça"},{"verse":"","text":"os atos de justiça do"},{"verse":"","text":"O que Deus exige"},{"verse":"6","text":"Com que me apresentarei"},{"verse":"","text":"ao"},{"verse":"","text":"e me inclinarei diante"},{"verse":"","text":"do Deus excelso?"},{"verse":"","text":"Virei diante dele com holocaustos,"},{"verse":"","text":"com bezerros de um ano?"},{"verse":"7","text":"Será que o"},{"verse":"","text":"com milhares de carneiros,"},{"verse":"","text":"com dez mil ribeiros de azeite?"},{"verse":"","text":"Darei o meu primogênito"},{"verse":"","text":"pela minha transgressão,"},{"verse":"","text":"o fruto do meu corpo,"},{"verse":"","text":"pelo pecado da minha alma?"},{"verse":"8","text":"Ele já mostrou a você o que é bom;"},{"verse":"","text":"e o que o"},{"verse":"","text":"Que pratique a justiça,"},{"verse":"","text":"ame a misericórdia"},{"verse":"","text":"e ande humildemente"},{"verse":"","text":"com o seu Deus."},{"verse":"","text":"A injustiça terá seu castigo"},{"verse":"9","text":"A voz do"},{"verse":"","text":"se dirige à cidade,"},{"verse":"","text":"e é verdadeira sabedoria"},{"verse":"","text":"temer o seu nome."},{"verse":"","text":"\"Escutem, ó tribo"},{"verse":"","text":"e todos os moradores!"},{"verse":"10","text":"Ainda se encontram,"},{"verse":"","text":"na casa dos ímpios,"},{"verse":"","text":"os tesouros da impiedade"},{"verse":"","text":"e a medida falsa que eu detesto?"},{"verse":"11","text":"Poderei eu inocentar"},{"verse":"","text":"balanças desonestas"},{"verse":"","text":"e uma bolsa"},{"verse":"","text":"com pesos adulterados?"},{"verse":"12","text":"Porque os ricos da cidade"},{"verse":"","text":"estão cheios de violência;"},{"verse":"","text":"os seus habitantes falam mentiras"},{"verse":"","text":"e a língua deles é enganosa."},{"verse":"13","text":"Assim, também"},{"verse":"","text":"eu passarei a feri-los"},{"verse":"","text":"e os destruirei"},{"verse":"","text":"por causa dos seus pecados."},{"verse":"14","text":"Vocês comerão,"},{"verse":"","text":"mas não ficarão satisfeitos;"},{"verse":"","text":"a fome continuará"},{"verse":"","text":"nas suas entranhas."},{"verse":"","text":"Tentarão pôr os seus bens a salvo,"},{"verse":"","text":"mas não conseguirão preservá-los;"},{"verse":"","text":"e aquilo que preservarem,"},{"verse":"","text":"eu entregarei à espada."},{"verse":"15","text":"Vocês irão semear,"},{"verse":"","text":"mas não colherão nada;"},{"verse":"","text":"vocês esmagarão as azeitonas,"},{"verse":"","text":"mas não se ungirão com o azeite;"},{"verse":"","text":"pisarão as uvas,"},{"verse":"","text":"mas não beberão o vinho."},{"verse":"16","text":"Vocês observaram"},{"verse":"","text":"os estatutos de Onri"},{"verse":"","text":"e todas as obras da casa de Acabe"},{"verse":"","text":"e andaram nos conselhos deles."},{"verse":"","text":"Por isso, farei de Jerusalém"},{"verse":"","text":"um lugar desolado,"},{"verse":"","text":"e dos seus moradores"},{"verse":"","text":"um objeto de vaias."},{"verse":"","text":"E vocês terão de suportar"},{"verse":"","text":"a zombaria dos povos.\""}],[{"verse":"","text":"A corrupção moral de Israel"},{"verse":"1","text":"Ai de mim!"},{"verse":"","text":"Porque estou como quando"},{"verse":"","text":"são colhidas as frutas do verão,"},{"verse":"","text":"como quando se procuram uvas"},{"verse":"","text":"depois da vindima:"},{"verse":"","text":"não há cacho de uvas para chupar,"},{"verse":"","text":"nem figos temporãos"},{"verse":"","text":"que eu gostaria de comer."},{"verse":"2","text":"Desapareceram da terra"},{"verse":"","text":"os piedosos,"},{"verse":"","text":"e não há entre todos"},{"verse":"","text":"um só que seja reto."},{"verse":"","text":"Todos ficam à espreita"},{"verse":"","text":"para derramar sangue;"},{"verse":"","text":"cada um caça o seu irmão"},{"verse":"","text":"com rede."},{"verse":"3","text":"As suas mãos são hábeis"},{"verse":"","text":"na prática do mal."},{"verse":"","text":"As autoridades exigem,"},{"verse":"","text":"os juízes aceitam suborno,"},{"verse":"","text":"os poderosos manifestam"},{"verse":"","text":"os seus maus desejos"},{"verse":"","text":"e, assim, em conjunto"},{"verse":"","text":"tramam os seus projetos."},{"verse":"4","text":"O melhor deles"},{"verse":"","text":"é como um espinheiro;"},{"verse":"","text":"o mais reto é pior"},{"verse":"","text":"do que uma cerca de espinhos."},{"verse":"","text":"É chegado o dia anunciado"},{"verse":"","text":"por suas sentinelas,"},{"verse":"","text":"o dia em que vocês"},{"verse":"","text":"serão castigados;"},{"verse":"","text":"agora começará a confusão deles."},{"verse":"5","text":"Não acredite em seu amigo,"},{"verse":"","text":"nem confie no seu companheiro."},{"verse":"","text":"Não compartilhe os seus segredos"},{"verse":"","text":"nem mesmo com a sua mulher."},{"verse":"6","text":"Porque o filho despreza o pai,"},{"verse":"","text":"a filha se levanta contra a mãe,"},{"verse":"","text":"a nora, contra a sogra;"},{"verse":"","text":"os inimigos de uma pessoa"},{"verse":"","text":"são os da sua própria casa."},{"verse":"7","text":"Eu, porém, olharei para o"},{"verse":"","text":"e esperarei no Deus"},{"verse":"","text":"da minha salvação;"},{"verse":"","text":"o meu Deus me ouvirá."},{"verse":"","text":"Deus se compadece de Israel"},{"verse":"8","text":"Minha inimiga, não se alegre"},{"verse":"","text":"a respeito de mim;"},{"verse":"","text":"ainda que tenha caído,"},{"verse":"","text":"eu tornarei a me levantar;"},{"verse":"","text":"se morar nas trevas,"},{"verse":"","text":"o"},{"verse":"9","text":"Sofrerei a ira do"},{"verse":"","text":"porque pequei contra ele,"},{"verse":"","text":"até que julgue a minha causa"},{"verse":"","text":"e execute o meu direito;"},{"verse":"","text":"ele me levará para a luz,"},{"verse":"","text":"e eu verei a sua justiça."},{"verse":"10","text":"A minha inimiga verá isso;"},{"verse":"","text":"ficará coberta de vergonha"},{"verse":"","text":"aquela que me disse:"},{"verse":"","text":"\"Onde está o"},{"verse":"","text":"Os meus olhos a contemplarão;"},{"verse":"","text":"agora ela será pisada"},{"verse":"","text":"como a lama das ruas."},{"verse":"11","text":"No dia da reedificação"},{"verse":"","text":"das suas muralhas, ó Jerusalém,"},{"verse":"","text":"nesse dia, os seus limites"},{"verse":"","text":"serão ampliados."},{"verse":"12","text":"Nesse dia, virão a você"},{"verse":"","text":"desde a Assíria até o Egito,"},{"verse":"","text":"e do Egito até o Eufrates,"},{"verse":"","text":"e do mar até o mar,"},{"verse":"","text":"e da montanha até a montanha."},{"verse":"13","text":"Mas a terra se tornará em desolação,"},{"verse":"","text":"por causa dos seus moradores,"},{"verse":"","text":"por causa do fruto das suas ações."},{"verse":"14","text":"Ó"},{"verse":"","text":"com o teu bordão,"},{"verse":"","text":"o rebanho da tua herança,"},{"verse":"","text":"que mora a sós numa floresta,"},{"verse":"","text":"no meio da terra fértil;"},{"verse":"","text":"que ele seja apascentado"},{"verse":"","text":"em Basã e Gileade,"},{"verse":"","text":"como nos dias da antiguidade."},{"verse":"15","text":"Eu lhe mostrarei maravilhas,"},{"verse":"","text":"como nos dias em que você saiu"},{"verse":"","text":"da terra do Egito."},{"verse":"16","text":"As nações verão isso"},{"verse":"","text":"e se envergonharão"},{"verse":"","text":"de todo o seu poder;"},{"verse":"","text":"porão a mão sobre a boca,"},{"verse":"","text":"e os seus ouvidos ficarão surdos."},{"verse":"17","text":"Lamberão o pó como serpentes;"},{"verse":"","text":"como animais que se arrastam"},{"verse":"","text":"pelo chão,"},{"verse":"","text":"tremendo, sairão dos seus esconderijos"},{"verse":"","text":"e, tremendo, virão ao"},{"verse":"","text":"nosso Deus;"},{"verse":"","text":"e terão medo de ti."},{"verse":"18","text":"Quem é semelhante a ti, ó Deus,"},{"verse":"","text":"que perdoas a iniquidade"},{"verse":"","text":"e te esqueces da transgressão"},{"verse":"","text":"do remanescente"},{"verse":"","text":"da tua herança?"},{"verse":"","text":"O"},{"verse":"","text":"a sua ira para sempre,"},{"verse":"","text":"porque tem prazer"},{"verse":"","text":"na misericórdia."},{"verse":"19","text":"Ele voltará a ter"},{"verse":"","text":"compaixão de nós;"},{"verse":"","text":"pisará aos pés"},{"verse":"","text":"as nossas iniquidades"},{"verse":"","text":"e lançará todos os nossos pecados"},{"verse":"","text":"nas profundezas do mar."},{"verse":"20","text":"Mostrarás a Jacó a fidelidade"},{"verse":"","text":"e a Abraão, a misericórdia,"},{"verse":"","text":"as quais juraste aos nossos pais,"},{"verse":"","text":"desde os dias antigos."}]]