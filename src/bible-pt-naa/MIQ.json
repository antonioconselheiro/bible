{"chapters":[{"chapter":1,"verses":[{"verse":1,"text":"Palavra do"},{"verse":2,"text":"Ameaças contra Samaria e Jerusalém"},{"verse":3,"text":"\"Escutem, todos os povos!"},{"verse":4,"text":"Prestem atenção, ó terra"},{"verse":5,"text":"e todos os seus moradores!"},{"verse":6,"text":"O"},{"verse":7,"text":"contra vocês;"},{"verse":8,"text":"do seu santo templo,"},{"verse":9,"text":"o Senhor falará."},{"verse":10,"text":"Porque eis que o"},{"verse":11,"text":"sai do seu lugar;"},{"verse":12,"text":"ele desce e anda"},{"verse":13,"text":"sobre os altos da terra."},{"verse":14,"text":"Os montes debaixo dele"},{"verse":15,"text":"se derretem,"},{"verse":16,"text":"e os vales se fendem;"},{"verse":17,"text":"são como a cera diante do fogo,"},{"verse":18,"text":"como as águas que se precipitam"},{"verse":19,"text":"num abismo.\""},{"verse":20,"text":"\"Tudo isso por causa"},{"verse":21,"text":"da transgressão de Jacó"},{"verse":22,"text":"e dos pecados da casa de Israel."},{"verse":23,"text":"Qual é a transgressão de Jacó?"},{"verse":24,"text":"Será que não é Samaria?"},{"verse":25,"text":"E quais são os lugares altos"},{"verse":26,"text":"de Judá?"},{"verse":27,"text":"Será que não é Jerusalém?"},{"verse":28,"text":"Por isso, farei de Samaria"},{"verse":29,"text":"um montão de pedras"},{"verse":30,"text":"no campo,"},{"verse":31,"text":"uma terra de plantar vinhas."},{"verse":32,"text":"Farei com que as pedras rolem"},{"verse":33,"text":"para o vale"},{"verse":34,"text":"e deixarei descobertos"},{"verse":35,"text":"os seus alicerces."},{"verse":36,"text":"Todas as suas imagens"},{"verse":37,"text":"de escultura"},{"verse":38,"text":"serão despedaçadas,"},{"verse":39,"text":"e tudo o que ela ganhou"},{"verse":40,"text":"com a sua impureza"},{"verse":41,"text":"será queimado."},{"verse":42,"text":"De todos os seus ídolos"},{"verse":43,"text":"eu farei uma ruína."},{"verse":44,"text":"Visto que ela os ajuntou"},{"verse":45,"text":"com pagamento"},{"verse":46,"text":"por prostituição,"},{"verse":47,"text":"em pagamento por prostituição"},{"verse":48,"text":"eles serão transformados.\""},{"verse":49,"text":"\"Por isso, lamento e choro;"},{"verse":50,"text":"ando descalço e nu;"},{"verse":51,"text":"faço lamentações como os chacais"},{"verse":52,"text":"e pranteio como os avestruzes."},{"verse":53,"text":"Porque as feridas de Samaria"},{"verse":54,"text":"são incuráveis;"},{"verse":55,"text":"o mal chegou até Judá;"},{"verse":56,"text":"estendeu-se até a porta"},{"verse":57,"text":"do meu povo,"},{"verse":58,"text":"até Jerusalém."},{"verse":59,"text":"Não anunciem isso em Gate,"},{"verse":60,"text":"nem chorem;"},{"verse":61,"text":"rolem no pó, em Bete-Leafra."},{"verse":62,"text":"Moradores de Safir,"},{"verse":63,"text":"sigam para o exílio"},{"verse":64,"text":"em vergonhosa nudez."},{"verse":65,"text":"Os moradores de Zaanã"},{"verse":66,"text":"não podem sair da cidade;"},{"verse":67,"text":"o pranto do povo de Bete-Ezel"},{"verse":68,"text":"tira de vocês"},{"verse":69,"text":"o lugar de refúgio."},{"verse":70,"text":"Os moradores de Marote"},{"verse":71,"text":"suspiram pelo bem,"},{"verse":72,"text":"porque o"},{"verse":73,"text":"até as portas de Jerusalém."},{"verse":74,"text":"Moradores de Laquis,"},{"verse":75,"text":"atrelem os ginetes aos carros!"},{"verse":76,"text":"Com vocês teve início"},{"verse":77,"text":"o pecado da filha de Sião;"},{"verse":78,"text":"entre vocês se encontraram"},{"verse":79,"text":"as transgressões de Israel."},{"verse":80,"text":"Portanto, vocês darão presentes"},{"verse":81,"text":"de despedida a Moresete-Gate;"},{"verse":82,"text":"as casas de Aczibe serão algo"},{"verse":83,"text":"enganoso para os reis de Israel."},{"verse":84,"text":"Enviarei ainda quem tomará"},{"verse":85,"text":"posse de vocês,"},{"verse":86,"text":"moradores de Maressa;"},{"verse":87,"text":"a glória de Israel chegará"},{"verse":88,"text":"até Adulão."},{"verse":89,"text":"Cortem os cabelos"},{"verse":90,"text":"e rapem a cabeça"},{"verse":91,"text":"por causa dos seus filhos queridos;"},{"verse":92,"text":"alarguem a sua calva como a águia,"},{"verse":93,"text":"porque esses filhos serão levados"},{"verse":94,"text":"para o cativeiro.\""}]},{"chapter":2,"verses":[{"verse":0,"text":"Ai dos opressores gananciosos"},{"verse":1,"text":"\"Ai daqueles que,"},{"verse":2,"text":"ainda no seu leito,"},{"verse":3,"text":"imaginam a iniquidade"},{"verse":4,"text":"e planejam o mal!"},{"verse":5,"text":"Ao amanhecer, eles o praticam,"},{"verse":6,"text":"porque têm poder para tanto."},{"verse":7,"text":"Cobiçam campos"},{"verse":8,"text":"e se apossam deles;"},{"verse":9,"text":"cobiçam casas e as tomam;"},{"verse":10,"text":"assim, fazem violência"},{"verse":11,"text":"a um homem e à sua casa,"},{"verse":12,"text":"a uma pessoa e à sua herança.\""},{"verse":13,"text":"Portanto, assim diz o"},{"verse":14,"text":"\"Eis que estou forjando"},{"verse":15,"text":"uma calamidade"},{"verse":16,"text":"contra esta família,"},{"verse":17,"text":"da qual vocês não livrarão"},{"verse":18,"text":"o seu pescoço."},{"verse":19,"text":"Vocês não andarão mais"},{"verse":20,"text":"de cabeça erguida,"},{"verse":21,"text":"porque será um tempo"},{"verse":22,"text":"de calamidade."},{"verse":23,"text":"Naquele dia, se criará"},{"verse":24,"text":"um provérbio"},{"verse":25,"text":"a respeito de vocês"},{"verse":26,"text":"e se entoará"},{"verse":27,"text":"a seguinte lamentação:"},{"verse":28,"text":"‘Estamos completamente"},{"verse":29,"text":"arruinados!"},{"verse":30,"text":"A porção do meu povo,"},{"verse":31,"text":"Deus a trocou!"},{"verse":32,"text":"Como ele tirou o que era nosso!"},{"verse":33,"text":"Entregou os nossos campos"},{"verse":34,"text":"aos rebeldes!’"},{"verse":35,"text":"Portanto, na congregação"},{"verse":36,"text":"do"},{"verse":37,"text":"quando a terra for dividida"},{"verse":38,"text":"por sorteio,"},{"verse":39,"text":"vocês não receberão"},{"verse":40,"text":"nem uma parte dela.\""},{"verse":41,"text":"Contra os falsos profetas"},{"verse":42,"text":"\"Eles dizem:"},{"verse":43,"text":"‘Não profetizem."},{"verse":44,"text":"Não profetizem tais coisas,"},{"verse":45,"text":"porque a desgraça"},{"verse":46,"text":"não cairá sobre nós."},{"verse":47,"text":"Tais coisas anunciadas"},{"verse":48,"text":"não alcançarão a casa de Jacó."},{"verse":49,"text":"Estaria o Espírito"},{"verse":50,"text":"do"},{"verse":51,"text":"Será que ele agiria assim?’\""},{"verse":52,"text":"\"De fato, as minhas palavras"},{"verse":53,"text":"fazem o bem"},{"verse":54,"text":"ao que anda retamente."},{"verse":55,"text":"Mas, há pouco, o meu povo"},{"verse":56,"text":"se levantou como um inimigo."},{"verse":57,"text":"Além da roupa,"},{"verse":58,"text":"vocês arrancam a capa"},{"verse":59,"text":"daqueles que passam seguros,"},{"verse":60,"text":"sem pensar em guerra."},{"verse":61,"text":"Vocês expulsam"},{"verse":62,"text":"do seu lar querido"},{"verse":63,"text":"as mulheres de meu povo;"},{"verse":64,"text":"dos filhinhos delas vocês tiram"},{"verse":65,"text":"a minha glória, para sempre."},{"verse":66,"text":"Levantem-se e vão embora!"},{"verse":67,"text":"Porque este não é"},{"verse":68,"text":"o lugar de descanso."},{"verse":69,"text":"Vão embora"},{"verse":70,"text":"por causa da impureza"},{"verse":71,"text":"que traz destruição,"},{"verse":72,"text":"sim, destruição enorme."},{"verse":73,"text":"Se alguém, seguindo o vento"},{"verse":74,"text":"e a falsidade,"},{"verse":75,"text":"inventar uma mentira do tipo:"},{"verse":76,"text":"‘Eu lhes profetizarei"},{"verse":77,"text":"a respeito de vinho"},{"verse":78,"text":"e de bebida forte’,"},{"verse":79,"text":"esse tal será o profeta deste povo.\""},{"verse":80,"text":"O Senhor congrega o remanescente de Israel"},{"verse":81,"text":"\"Certamente eu ajuntarei"},{"verse":82,"text":"todos vocês, casa de Jacó;"},{"verse":83,"text":"certamente congregarei"},{"verse":84,"text":"o remanescente de Israel."},{"verse":85,"text":"Eu os porei todos juntos,"},{"verse":86,"text":"como ovelhas no aprisco,"},{"verse":87,"text":"como rebanho"},{"verse":88,"text":"no meio de sua pastagem;"},{"verse":89,"text":"farão muito barulho,"},{"verse":90,"text":"por causa da multidão"},{"verse":91,"text":"de pessoas."},{"verse":92,"text":"Diante deles virá"},{"verse":93,"text":"o que abre caminho;"},{"verse":94,"text":"eles abrirão caminho,"},{"verse":95,"text":"entrarão pelo portão"},{"verse":96,"text":"e sairão por ele;"},{"verse":97,"text":"e o seu Rei irá adiante deles;"},{"verse":98,"text":"sim, o"},{"verse":99,"text":"à frente deles.\""}]},{"chapter":3,"verses":[{"verse":0,"text":"Ameaças contra os maus governantes e os falsos profetas"},{"verse":1,"text":"Eu disse:"},{"verse":2,"text":"Escutem agora,"},{"verse":3,"text":"governantes de Jacó"},{"verse":4,"text":"e chefes da casa de Israel:"},{"verse":5,"text":"Por acaso não é a vocês"},{"verse":6,"text":"que compete"},{"verse":7,"text":"conhecer a justiça?"},{"verse":8,"text":"Mas vocês odeiam o bem"},{"verse":9,"text":"e amam o mal;"},{"verse":10,"text":"arrancam a pele do meu povo"},{"verse":11,"text":"e a carne de cima dos seus ossos."},{"verse":12,"text":"Vocês comem a carne"},{"verse":13,"text":"do meu povo"},{"verse":14,"text":"e lhes arrancam a pele;"},{"verse":15,"text":"quebram os seus ossos,"},{"verse":16,"text":"e os repartem em pedaços"},{"verse":17,"text":"que vão para a panela"},{"verse":18,"text":"e em carne que vai"},{"verse":19,"text":"para o caldeirão."},{"verse":20,"text":"Um dia eles hão de invocar"},{"verse":21,"text":"o"},{"verse":22,"text":"mas ele não os ouvirá;"},{"verse":23,"text":"naquele tempo, esconderá deles"},{"verse":24,"text":"a sua face,"},{"verse":25,"text":"por causa do mal que praticaram."},{"verse":26,"text":"Assim diz o"},{"verse":27,"text":"a respeito dos profetas"},{"verse":28,"text":"que fazem o meu povo"},{"verse":29,"text":"andar errante"},{"verse":30,"text":"e que clamam: \"Paz\","},{"verse":31,"text":"quando têm o que mastigar,"},{"verse":32,"text":"mas apregoam guerra santa"},{"verse":33,"text":"contra aqueles"},{"verse":34,"text":"que não lhes dão nada para comer:"},{"verse":35,"text":"\"Por isso, vocês terão noites"},{"verse":36,"text":"sem visões;"},{"verse":37,"text":"vocês terão trevas"},{"verse":38,"text":"sem adivinhações."},{"verse":39,"text":"O sol se porá sobre os profetas,"},{"verse":40,"text":"e o dia se transformará em escuridão."},{"verse":41,"text":"Os videntes serão envergonhados,"},{"verse":42,"text":"e os adivinhos serão humilhados."},{"verse":43,"text":"Todos eles colocarão a mão"},{"verse":44,"text":"sobre a boca,"},{"verse":45,"text":"porque não haverá resposta"},{"verse":46,"text":"de Deus.\""},{"verse":47,"text":"Quanto a mim, estou cheio"},{"verse":48,"text":"do poder do Espírito do"},{"verse":49,"text":"cheio de justiça e de força,"},{"verse":50,"text":"para declarar a Jacó"},{"verse":51,"text":"a sua transgressão"},{"verse":52,"text":"e a Israel, o seu pecado."},{"verse":53,"text":"Escutem agora isto,"},{"verse":54,"text":"governantes da casa de Jacó"},{"verse":55,"text":"e chefes da casa de Israel,"},{"verse":56,"text":"vocês que detestam a justiça"},{"verse":57,"text":"e pervertem tudo o que é correto,"},{"verse":58,"text":"que edificam Sião com sangue"},{"verse":59,"text":"e Jerusalém, com iniquidade."},{"verse":60,"text":"Os seus cabeças dão"},{"verse":61,"text":"as sentenças por suborno,"},{"verse":62,"text":"os seus sacerdotes ensinam"},{"verse":63,"text":"por interesse,"},{"verse":64,"text":"e os seus profetas adivinham"},{"verse":65,"text":"por dinheiro."},{"verse":66,"text":"E ainda se apoiam no"},{"verse":67,"text":"dizendo:"},{"verse":68,"text":"\"Não está o"},{"verse":69,"text":"no meio de nós?"},{"verse":70,"text":"Nenhum mal nos sobrevirá.\""},{"verse":71,"text":"Portanto, por causa de vocês,"},{"verse":72,"text":"Sião será lavrada como um campo,"},{"verse":73,"text":"e Jerusalém se tornará"},{"verse":74,"text":"um montão de ruínas,"},{"verse":75,"text":"e o monte do templo,"},{"verse":76,"text":"numa colina coberta de mato."}]},{"chapter":4,"verses":[{"verse":0,"text":"O monte do Senhor"},{"verse":1,"text":"Nos últimos dias,"},{"verse":2,"text":"o monte do templo do"},{"verse":3,"text":"será estabelecido"},{"verse":4,"text":"no alto dos montes"},{"verse":5,"text":"e se elevará sobre as colinas,"},{"verse":6,"text":"e para ele afluirão os povos."},{"verse":7,"text":"Muitas nações virão e dirão:"},{"verse":8,"text":"\"Venham, subamos"},{"verse":9,"text":"ao monte do"},{"verse":10,"text":"e ao templo do Deus de Jacó,"},{"verse":11,"text":"para que nos ensine"},{"verse":12,"text":"os seus caminhos,"},{"verse":13,"text":"e andemos nas suas veredas.\""},{"verse":14,"text":"Porque de Sião sairá a lei,"},{"verse":15,"text":"e a palavra do"},{"verse":16,"text":"de Jerusalém."},{"verse":17,"text":"Ele julgará entre muitos povos"},{"verse":18,"text":"e corrigirá nações poderosas"},{"verse":19,"text":"e distantes."},{"verse":20,"text":"Estas transformarão as suas espadas"},{"verse":21,"text":"em lâminas de arados"},{"verse":22,"text":"e as suas lanças, em foices."},{"verse":23,"text":"Nação não levantará a espada"},{"verse":24,"text":"contra nação,"},{"verse":25,"text":"nem aprenderão mais a guerra."},{"verse":26,"text":"Mas cada um se assentará"},{"verse":27,"text":"debaixo da sua videira"},{"verse":28,"text":"e debaixo da sua figueira,"},{"verse":29,"text":"e não haverá quem os atemorize,"},{"verse":30,"text":"porque a boca do"},{"verse":31,"text":"Senhor"},{"verse":32,"text":"Porque todos os povos andam,"},{"verse":33,"text":"cada um em nome do seu deus;"},{"verse":34,"text":"mas, quanto a nós, andaremos"},{"verse":35,"text":"em nome do"},{"verse":36,"text":"para todo o sempre."},{"verse":37,"text":"Deus salvará o seu povo"},{"verse":38,"text":"\"Naquele dia\","},{"verse":39,"text":"diz o"},{"verse":40,"text":"\"congregarei os que coxeiam"},{"verse":41,"text":"e recolherei"},{"verse":42,"text":"os que foram expulsos"},{"verse":43,"text":"e os que eu tinha afligido."},{"verse":44,"text":"Dos que coxeiam"},{"verse":45,"text":"farei um remanescente"},{"verse":46,"text":"e dos que foram lançados"},{"verse":47,"text":"para longe,"},{"verse":48,"text":"uma nação poderosa;"},{"verse":49,"text":"e o"},{"verse":50,"text":"no monte Sião,"},{"verse":51,"text":"desde agora e para sempre."},{"verse":52,"text":"A você, ó torre do rebanho,"},{"verse":53,"text":"monte da filha de Sião,"},{"verse":54,"text":"a você virá, sim,"},{"verse":55,"text":"virá o primeiro domínio,"},{"verse":56,"text":"o reino da filha de Jerusalém.\""},{"verse":57,"text":"Agora, por que você está"},{"verse":58,"text":"gritando tão alto?"},{"verse":59,"text":"Será porque você não tem rei?"},{"verse":60,"text":"Morreram os seus conselheiros?"},{"verse":61,"text":"Apoderou-se de você a dor"},{"verse":62,"text":"como da mulher"},{"verse":63,"text":"que está dando à luz?"},{"verse":64,"text":"Suporte as dores e faça força,"},{"verse":65,"text":"filha de Sião,"},{"verse":66,"text":"como a mulher"},{"verse":67,"text":"que está dando à luz."},{"verse":68,"text":"Porque agora vocês terão"},{"verse":69,"text":"de sair da cidade"},{"verse":70,"text":"e morar nos campos;"},{"verse":71,"text":"vocês irão para a Babilônia."},{"verse":72,"text":"Ali, porém, vocês serão libertados;"},{"verse":73,"text":"ali, o"},{"verse":74,"text":"das mãos dos inimigos."},{"verse":75,"text":"Agora muitas nações se reuniram"},{"verse":76,"text":"contra você, dizendo:"},{"verse":77,"text":"\"Que Jerusalém seja profanada!"},{"verse":78,"text":"Que os nossos olhos se deliciem"},{"verse":79,"text":"com a ruína de Sião!\""},{"verse":80,"text":"Mas essas nações não conhecem"},{"verse":81,"text":"os pensamentos do"},{"verse":82,"text":"nem entendem o seu plano:"},{"verse":83,"text":"ele as ajuntou como feixes"},{"verse":84,"text":"a serem batidos na eira."},{"verse":85,"text":"Levante-se e comece a debulhar,"},{"verse":86,"text":"ó filha de Sião,"},{"verse":87,"text":"porque eu lhe darei chifres de ferro"},{"verse":88,"text":"e cascos de bronze."},{"verse":89,"text":"Você esmagará muitos povos,"},{"verse":90,"text":"e as riquezas que eles adquiriram"},{"verse":91,"text":"serão dedicadas ao"},{"verse":92,"text":"e os bens que eles conquistaram"},{"verse":93,"text":"pela força"},{"verse":94,"text":"serão consagrados ao Senhor"},{"verse":95,"text":"de toda a terra."}]},{"chapter":5,"verses":[{"verse":1,"text":"Agora ajunte-se em tropas,"},{"verse":2,"text":"ó filha de tropas,"},{"verse":3,"text":"porque fomos sitiados,"},{"verse":4,"text":"e ferirão com uma vara"},{"verse":5,"text":"a face do juiz de Israel."},{"verse":6,"text":"O nascimento do Messias e o seu reinado"},{"verse":7,"text":"\"E você, Belém-Efrata,"},{"verse":8,"text":"que é pequena demais para figurar"},{"verse":9,"text":"como grupo de milhares de Judá,"},{"verse":10,"text":"de você me sairá aquele"},{"verse":11,"text":"que há de reinar em Israel,"},{"verse":12,"text":"e cujas origens são"},{"verse":13,"text":"desde os tempos antigos,"},{"verse":14,"text":"desde os dias da eternidade.\""},{"verse":15,"text":"Portanto, o"},{"verse":16,"text":"até o tempo em que"},{"verse":17,"text":"a que está em dores"},{"verse":18,"text":"tiver dado à luz;"},{"verse":19,"text":"então o restante de seus irmãos"},{"verse":20,"text":"voltará aos filhos de Israel."},{"verse":21,"text":"Ele se manterá firme"},{"verse":22,"text":"e apascentará o povo"},{"verse":23,"text":"na força do"},{"verse":24,"text":"na majestade do nome do"},{"verse":25,"text":"seu Deus;"},{"verse":26,"text":"e eles habitarão seguros,"},{"verse":27,"text":"porque, agora,"},{"verse":28,"text":"ele será engrandecido"},{"verse":29,"text":"até os confins da terra."},{"verse":30,"text":"E ele será a nossa paz."},{"verse":31,"text":"Quando a Assíria vier à nossa terra"},{"verse":32,"text":"e quando entrar"},{"verse":33,"text":"em nossas fortalezas,"},{"verse":34,"text":"levantaremos contra ela"},{"verse":35,"text":"sete pastores"},{"verse":36,"text":"e oito chefes do povo."},{"verse":37,"text":"Estes dominarão a terra da Assíria"},{"verse":38,"text":"com a espada,"},{"verse":39,"text":"e a terra de Ninrode,"},{"verse":40,"text":"dentro de suas próprias portas."},{"verse":41,"text":"Assim, nos livrará da Assíria,"},{"verse":42,"text":"quando esta vier à nossa terra"},{"verse":43,"text":"e invadir as nossas fronteiras."},{"verse":44,"text":"O remanescente de Jacó estará"},{"verse":45,"text":"no meio de muitos povos"},{"verse":46,"text":"como orvalho do"},{"verse":47,"text":"como chuvisco sobre a relva,"},{"verse":48,"text":"que não espera pelo homem,"},{"verse":49,"text":"nem depende"},{"verse":50,"text":"dos filhos de homens."},{"verse":51,"text":"O remanescente de Jacó"},{"verse":52,"text":"estará entre as nações,"},{"verse":53,"text":"no meio de muitos povos,"},{"verse":54,"text":"como um leão entre"},{"verse":55,"text":"os animais da floresta,"},{"verse":56,"text":"como um leãozinho"},{"verse":57,"text":"entre os rebanhos de ovelhas,"},{"verse":58,"text":"o qual, se passar,"},{"verse":59,"text":"ataca e despedaça a presa,"},{"verse":60,"text":"sem que ninguém a possa livrar."},{"verse":61,"text":"A sua mão se exaltará"},{"verse":62,"text":"sobre os seus adversários,"},{"verse":63,"text":"e todos os seus inimigos"},{"verse":64,"text":"serão eliminados."},{"verse":65,"text":"\"Naquele dia\","},{"verse":66,"text":"diz o"},{"verse":67,"text":"\"eliminarei do meio de vocês"},{"verse":68,"text":"os cavalos"},{"verse":69,"text":"e destruirei os carros de guerra;"},{"verse":70,"text":"destruirei as cidades da sua terra"},{"verse":71,"text":"e derrubarei todas as fortalezas"},{"verse":72,"text":"de vocês;"},{"verse":73,"text":"arrancarei as feitiçarias"},{"verse":74,"text":"das suas mãos,"},{"verse":75,"text":"e vocês não mais terão adivinhos;"},{"verse":76,"text":"do meio de vocês eliminarei"},{"verse":77,"text":"as imagens de escultura"},{"verse":78,"text":"e as colunas,"},{"verse":79,"text":"e vocês não mais se inclinarão"},{"verse":80,"text":"diante do que fizeram"},{"verse":81,"text":"com as suas próprias mãos;"},{"verse":82,"text":"eliminarei do meio de vocês"},{"verse":83,"text":"os postes da deusa Aserá"},{"verse":84,"text":"e destruirei as cidades de vocês."},{"verse":85,"text":"Com ira e furor,"},{"verse":86,"text":"eu me vingarei das nações"},{"verse":87,"text":"que não me obedeceram.\""}]},{"chapter":6,"verses":[{"verse":0,"text":"Deus entrará em juízo com o seu povo"},{"verse":1,"text":"Escutem agora"},{"verse":2,"text":"o que diz o"},{"verse":3,"text":"\"Levante-se, defenda a sua causa"},{"verse":4,"text":"diante dos montes,"},{"verse":5,"text":"e que as colinas ouçam a sua voz."},{"verse":6,"text":"Ó montes, escutem"},{"verse":7,"text":"a controvérsia do"},{"verse":8,"text":"e vocês, duráveis fundamentos"},{"verse":9,"text":"da terra,"},{"verse":10,"text":"prestem atenção, porque o"},{"verse":11,"text":"tem uma controvérsia"},{"verse":12,"text":"com o seu povo"},{"verse":13,"text":"e entrará em juízo com Israel.\""},{"verse":14,"text":"\"Meu povo,"},{"verse":15,"text":"o que foi que eu lhe fiz?"},{"verse":16,"text":"E como foi que eu"},{"verse":17,"text":"o levei a ficar cansado?"},{"verse":18,"text":"Responda!"},{"verse":19,"text":"Pois eu o tirei da terra do Egito"},{"verse":20,"text":"e o resgatei da casa da servidão,"},{"verse":21,"text":"e enviei adiante de você"},{"verse":22,"text":"Moisés, Arão e Miriã."},{"verse":23,"text":"Meu povo,"},{"verse":24,"text":"lembre-se do que Balaque,"},{"verse":25,"text":"rei de Moabe, havia planejado"},{"verse":26,"text":"e do que Balaão, filho de Beor,"},{"verse":27,"text":"lhe respondeu."},{"verse":28,"text":"Lembre-se também"},{"verse":29,"text":"do que aconteceu"},{"verse":30,"text":"desde Sitim até Gilgal,"},{"verse":31,"text":"para que você conheça"},{"verse":32,"text":"os atos de justiça do"},{"verse":33,"text":"O que Deus exige"},{"verse":34,"text":"Com que me apresentarei"},{"verse":35,"text":"ao"},{"verse":36,"text":"e me inclinarei diante"},{"verse":37,"text":"do Deus excelso?"},{"verse":38,"text":"Virei diante dele com holocaustos,"},{"verse":39,"text":"com bezerros de um ano?"},{"verse":40,"text":"Será que o"},{"verse":41,"text":"com milhares de carneiros,"},{"verse":42,"text":"com dez mil ribeiros de azeite?"},{"verse":43,"text":"Darei o meu primogênito"},{"verse":44,"text":"pela minha transgressão,"},{"verse":45,"text":"o fruto do meu corpo,"},{"verse":46,"text":"pelo pecado da minha alma?"},{"verse":47,"text":"Ele já mostrou a você o que é bom;"},{"verse":48,"text":"e o que o"},{"verse":49,"text":"Que pratique a justiça,"},{"verse":50,"text":"ame a misericórdia"},{"verse":51,"text":"e ande humildemente"},{"verse":52,"text":"com o seu Deus."},{"verse":53,"text":"A injustiça terá seu castigo"},{"verse":54,"text":"A voz do"},{"verse":55,"text":"se dirige à cidade,"},{"verse":56,"text":"e é verdadeira sabedoria"},{"verse":57,"text":"temer o seu nome."},{"verse":58,"text":"\"Escutem, ó tribo"},{"verse":59,"text":"e todos os moradores!"},{"verse":60,"text":"Ainda se encontram,"},{"verse":61,"text":"na casa dos ímpios,"},{"verse":62,"text":"os tesouros da impiedade"},{"verse":63,"text":"e a medida falsa que eu detesto?"},{"verse":64,"text":"Poderei eu inocentar"},{"verse":65,"text":"balanças desonestas"},{"verse":66,"text":"e uma bolsa"},{"verse":67,"text":"com pesos adulterados?"},{"verse":68,"text":"Porque os ricos da cidade"},{"verse":69,"text":"estão cheios de violência;"},{"verse":70,"text":"os seus habitantes falam mentiras"},{"verse":71,"text":"e a língua deles é enganosa."},{"verse":72,"text":"Assim, também"},{"verse":73,"text":"eu passarei a feri-los"},{"verse":74,"text":"e os destruirei"},{"verse":75,"text":"por causa dos seus pecados."},{"verse":76,"text":"Vocês comerão,"},{"verse":77,"text":"mas não ficarão satisfeitos;"},{"verse":78,"text":"a fome continuará"},{"verse":79,"text":"nas suas entranhas."},{"verse":80,"text":"Tentarão pôr os seus bens a salvo,"},{"verse":81,"text":"mas não conseguirão preservá-los;"},{"verse":82,"text":"e aquilo que preservarem,"},{"verse":83,"text":"eu entregarei à espada."},{"verse":84,"text":"Vocês irão semear,"},{"verse":85,"text":"mas não colherão nada;"},{"verse":86,"text":"vocês esmagarão as azeitonas,"},{"verse":87,"text":"mas não se ungirão com o azeite;"},{"verse":88,"text":"pisarão as uvas,"},{"verse":89,"text":"mas não beberão o vinho."},{"verse":90,"text":"Vocês observaram"},{"verse":91,"text":"os estatutos de Onri"},{"verse":92,"text":"e todas as obras da casa de Acabe"},{"verse":93,"text":"e andaram nos conselhos deles."},{"verse":94,"text":"Por isso, farei de Jerusalém"},{"verse":95,"text":"um lugar desolado,"},{"verse":96,"text":"e dos seus moradores"},{"verse":97,"text":"um objeto de vaias."},{"verse":98,"text":"E vocês terão de suportar"},{"verse":99,"text":"a zombaria dos povos.\""}]},{"chapter":7,"verses":[{"verse":0,"text":"A corrupção moral de Israel"},{"verse":1,"text":"Ai de mim!"},{"verse":2,"text":"Porque estou como quando"},{"verse":3,"text":"são colhidas as frutas do verão,"},{"verse":4,"text":"como quando se procuram uvas"},{"verse":5,"text":"depois da vindima:"},{"verse":6,"text":"não há cacho de uvas para chupar,"},{"verse":7,"text":"nem figos temporãos"},{"verse":8,"text":"que eu gostaria de comer."},{"verse":9,"text":"Desapareceram da terra"},{"verse":10,"text":"os piedosos,"},{"verse":11,"text":"e não há entre todos"},{"verse":12,"text":"um só que seja reto."},{"verse":13,"text":"Todos ficam à espreita"},{"verse":14,"text":"para derramar sangue;"},{"verse":15,"text":"cada um caça o seu irmão"},{"verse":16,"text":"com rede."},{"verse":17,"text":"As suas mãos são hábeis"},{"verse":18,"text":"na prática do mal."},{"verse":19,"text":"As autoridades exigem,"},{"verse":20,"text":"os juízes aceitam suborno,"},{"verse":21,"text":"os poderosos manifestam"},{"verse":22,"text":"os seus maus desejos"},{"verse":23,"text":"e, assim, em conjunto"},{"verse":24,"text":"tramam os seus projetos."},{"verse":25,"text":"O melhor deles"},{"verse":26,"text":"é como um espinheiro;"},{"verse":27,"text":"o mais reto é pior"},{"verse":28,"text":"do que uma cerca de espinhos."},{"verse":29,"text":"É chegado o dia anunciado"},{"verse":30,"text":"por suas sentinelas,"},{"verse":31,"text":"o dia em que vocês"},{"verse":32,"text":"serão castigados;"},{"verse":33,"text":"agora começará a confusão deles."},{"verse":34,"text":"Não acredite em seu amigo,"},{"verse":35,"text":"nem confie no seu companheiro."},{"verse":36,"text":"Não compartilhe os seus segredos"},{"verse":37,"text":"nem mesmo com a sua mulher."},{"verse":38,"text":"Porque o filho despreza o pai,"},{"verse":39,"text":"a filha se levanta contra a mãe,"},{"verse":40,"text":"a nora, contra a sogra;"},{"verse":41,"text":"os inimigos de uma pessoa"},{"verse":42,"text":"são os da sua própria casa."},{"verse":43,"text":"Eu, porém, olharei para o"},{"verse":44,"text":"e esperarei no Deus"},{"verse":45,"text":"da minha salvação;"},{"verse":46,"text":"o meu Deus me ouvirá."},{"verse":47,"text":"Deus se compadece de Israel"},{"verse":48,"text":"Minha inimiga, não se alegre"},{"verse":49,"text":"a respeito de mim;"},{"verse":50,"text":"ainda que tenha caído,"},{"verse":51,"text":"eu tornarei a me levantar;"},{"verse":52,"text":"se morar nas trevas,"},{"verse":53,"text":"o"},{"verse":54,"text":"Sofrerei a ira do"},{"verse":55,"text":"porque pequei contra ele,"},{"verse":56,"text":"até que julgue a minha causa"},{"verse":57,"text":"e execute o meu direito;"},{"verse":58,"text":"ele me levará para a luz,"},{"verse":59,"text":"e eu verei a sua justiça."},{"verse":60,"text":"A minha inimiga verá isso;"},{"verse":61,"text":"ficará coberta de vergonha"},{"verse":62,"text":"aquela que me disse:"},{"verse":63,"text":"\"Onde está o"},{"verse":64,"text":"Os meus olhos a contemplarão;"},{"verse":65,"text":"agora ela será pisada"},{"verse":66,"text":"como a lama das ruas."},{"verse":67,"text":"No dia da reedificação"},{"verse":68,"text":"das suas muralhas, ó Jerusalém,"},{"verse":69,"text":"nesse dia, os seus limites"},{"verse":70,"text":"serão ampliados."},{"verse":71,"text":"Nesse dia, virão a você"},{"verse":72,"text":"desde a Assíria até o Egito,"},{"verse":73,"text":"e do Egito até o Eufrates,"},{"verse":74,"text":"e do mar até o mar,"},{"verse":75,"text":"e da montanha até a montanha."},{"verse":76,"text":"Mas a terra se tornará em desolação,"},{"verse":77,"text":"por causa dos seus moradores,"},{"verse":78,"text":"por causa do fruto das suas ações."},{"verse":79,"text":"Ó"},{"verse":80,"text":"com o teu bordão,"},{"verse":81,"text":"o rebanho da tua herança,"},{"verse":82,"text":"que mora a sós numa floresta,"},{"verse":83,"text":"no meio da terra fértil;"},{"verse":84,"text":"que ele seja apascentado"},{"verse":85,"text":"em Basã e Gileade,"},{"verse":86,"text":"como nos dias da antiguidade."},{"verse":87,"text":"Eu lhe mostrarei maravilhas,"},{"verse":88,"text":"como nos dias em que você saiu"},{"verse":89,"text":"da terra do Egito."},{"verse":90,"text":"As nações verão isso"},{"verse":91,"text":"e se envergonharão"},{"verse":92,"text":"de todo o seu poder;"},{"verse":93,"text":"porão a mão sobre a boca,"},{"verse":94,"text":"e os seus ouvidos ficarão surdos."},{"verse":95,"text":"Lamberão o pó como serpentes;"},{"verse":96,"text":"como animais que se arrastam"},{"verse":97,"text":"pelo chão,"},{"verse":98,"text":"tremendo, sairão dos seus esconderijos"},{"verse":99,"text":"e, tremendo, virão ao"},{"verse":100,"text":"nosso Deus;"},{"verse":101,"text":"e terão medo de ti."},{"verse":102,"text":"Quem é semelhante a ti, ó Deus,"},{"verse":103,"text":"que perdoas a iniquidade"},{"verse":104,"text":"e te esqueces da transgressão"},{"verse":105,"text":"do remanescente"},{"verse":106,"text":"da tua herança?"},{"verse":107,"text":"O"},{"verse":108,"text":"a sua ira para sempre,"},{"verse":109,"text":"porque tem prazer"},{"verse":110,"text":"na misericórdia."},{"verse":111,"text":"Ele voltará a ter"},{"verse":112,"text":"compaixão de nós;"},{"verse":113,"text":"pisará aos pés"},{"verse":114,"text":"as nossas iniquidades"},{"verse":115,"text":"e lançará todos os nossos pecados"},{"verse":116,"text":"nas profundezas do mar."},{"verse":117,"text":"Mostrarás a Jacó a fidelidade"},{"verse":118,"text":"e a Abraão, a misericórdia,"},{"verse":119,"text":"as quais juraste aos nossos pais,"},{"verse":120,"text":"desde os dias antigos."}]}]}