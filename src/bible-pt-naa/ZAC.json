{"start":0,"end":0},"text":"A salvação de Jerusalém"},{"verse":{"start":1,"end":1},"text":"Sentença pronunciada pelo"},{"verse":{"start":2,"end":2},"text":"— Eis que eu farei de Jerusalém um cálice de atordoamento para todos os povos vizinhos e também para Judá, durante o sítio contra Jerusalém."},{"verse":{"start":0,"end":0},"text":"O arrependimento dos habitantes de Jerusalém"},{"verse":{"start":10,"end":10},"text":"E sobre a casa de Davi e sobre os moradores de Jerusalém derramarei o espírito da graça e de súplicas. Olharão para aquele a quem traspassaram. Prantearão por ele como quem pranteia por um filho único e chorarão por ele como se chora amargamente pelo primogênito."}]},{"chapter":13,"verses":[{"verse":{"start":1,"end":1},"text":"— Naquele dia, haverá uma fonte aberta para a casa de Davi e para os moradores de Jerusalém, para remover o pecado e a impureza."},{"verse":{"start":0,"end":0},"text":"A eliminação da idolatria"},{"verse":{"start":2,"end":2},"text":"— Naquele dia, diz o"},{"verse":{"start":0,"end":0},"text":"O pastor de Deus é ferido"},{"verse":{"start":7,"end":7},"text":"\"Levante-se, ó espada,"},{"verse":{"start":0,"end":0},"text":"e ataque o meu pastor"},{"verse":{"start":0,"end":0},"text":"e aquele que é"},{"verse":{"start":0,"end":0},"text":"o meu companheiro\","},{"verse":{"start":0,"end":0},"text":"diz o"},{"verse":{"start":0,"end":0},"text":"\"Fira o pastor,"},{"verse":{"start":0,"end":0},"text":"e as ovelhas ficarão dispersas."},{"verse":{"start":0,"end":0},"text":"E voltarei a minha mão"},{"verse":{"start":0,"end":0},"text":"para os pequeninos."},{"verse":{"start":8,"end":8},"text":"Em toda a terra\","},{"verse":{"start":0,"end":0},"text":"diz o"},{"verse":{"start":0,"end":0},"text":"\"dois terços dela serão eliminados"},{"verse":{"start":0,"end":0},"text":"e morrerão;"},{"verse":{"start":0,"end":0},"text":"mas uma terça parte irá sobreviver."},{"verse":{"start":9,"end":9},"text":"Farei essa terça parte"},{"verse":{"start":0,"end":0},"t